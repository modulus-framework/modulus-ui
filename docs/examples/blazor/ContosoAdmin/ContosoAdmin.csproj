<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>$(ModulusTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Synvro.Modulus.AspNetCore.Hosting" Version="2.1.0" />
    <PackageReference Include="Synvro.Modulus.Blazor" Version="2.1.0" />
    <PackageReference Include="Synvro.Modulus.Ui.Assets" Version="2.1.0" />
  </ItemGroup>

</Project>

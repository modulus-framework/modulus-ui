<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Transitive pins apply the patched versions below to packages pulled in by other packages (the advisories above). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Ant Design Blazor: the ONLY place its version is pinned (see docs/DOCUMENTATION.md#upgrading-ant-design-blazor-htmx-alpinejs-and-the-plugin-libraries). -->
    <PackageVersion Include="AntDesign" Version="1.6.2" />
    <!-- Official Pro layout (BasicLayout, PageContainer, GlobalHeader). Keep in lock-step with AntDesign. -->
    <PackageVersion Include="AntDesign.ProLayout" Version="1.6.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.12" />
    <!-- Reads and writes xlsx workbooks (the spreadsheet's import and export). -->
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <!-- The Open XML SDK ClosedXML is built on; Modulus.Documents also writes Word files with it. Keep in step with ClosedXML. -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <!-- PDF output of the document model (Modulus.Documents). Community licence: free under USD 1M annual gross revenue, not for
         public-sector or publicly traded companies; the host sets QuestPDF.Settings.License. Pinned exactly; 2026.9.0 was published 2026-09-14. -->
    <PackageVersion Include="QuestPDF" Version="2026.9.0" />
    <!-- Observability (Modulus.AspNetCore.Hosting): traces, metrics and logs through the OpenTelemetry SDK. Pinned exactly;
         1.19.1 was published 2026-09-21. Keep the three in step. -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <!-- Samples: saved views kept in a SQLite file (EfUiStateStore). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <!-- Liquid templates (Modulus.AspNetCore.Fluid): the parser and renderer. Pinned exactly; 2.40.0 was published 2026-08-20. -->
    <PackageVersion Include="Fluid.Core" Version="2.40.0" />
    <!-- System.Security.Cryptography.Pkcs 9.0.11 (pulled in transitively by the test host) has GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7; pin the patched 10.0 line, as the modulus repo does. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Test packages -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="bunit" Version="2.11.3" />
    <!-- Test-only: decodes the QR codes Modulus draws. -->
    <PackageVersion Include="ZXing.Net" Version="0.16.11" />
    <!-- Test-only: proves the pivot's grouped query translates to one SQL GROUP BY (ToQueryString, no database). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
  </ItemGroup>
</Project>

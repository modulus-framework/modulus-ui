<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Ant Design Blazor: the ONLY place its version is pinned (see docs/UPGRADING.md). -->
    <PackageVersion Include="AntDesign" Version="1.6.2" />
    <!-- Official Pro layout (BasicLayout, PageContainer, GlobalHeader). Keep in lock-step with AntDesign. -->
    <PackageVersion Include="AntDesign.ProLayout" Version="1.6.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.12" />
    <!-- Reads and writes xlsx workbooks (the spreadsheet's import and export). -->
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <!-- The Open XML SDK ClosedXML is built on; Modulus.Documents also writes Word files with it. Keep in step with ClosedXML. -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <!-- Samples: saved views kept in a SQLite file (EfUiStateStore). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <!-- Liquid templates (Modulus.AspNetCore.Fluid): the parser and renderer. Pinned exactly; 2.40.0 was published 2026-08-20. -->
    <PackageVersion Include="Fluid.Core" Version="2.40.0" />
    <!-- Test packages -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="bunit" Version="2.11.3" />
    <!-- Test-only: decodes the QR codes Modulus draws. -->
    <PackageVersion Include="ZXing.Net" Version="0.16.11" />
    <!-- Test-only: proves the pivot's grouped query translates to one SQL GROUP BY (ToQueryString, no database). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Description>Static assets of Modulus UI: the Ant Design based stylesheets and the shell, widget and plugin scripts shared by Blazor, MVC and Razor Pages.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The URL prefix of these assets stays _content/Modulus.Ui.Assets whether the package is referenced as a project or as a NuGet
         package (Synvro.Modulus.Ui.Assets); the tag helpers and the Blazor head write that prefix into their markup. -->
    <StaticWebAssetBasePath>_content/Synvro.Modulus.Ui.Assets</StaticWebAssetBasePath>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <!--
      The official Ant Design stylesheets (_content/AntDesign/css/*, _content/AntDesign.ProLayout/css/*)
      are the single source of component styling for EVERY flavor. MVC and Razor Pages render the same
      antd DOM through tag helpers, so they get these assets from here too.
    -->
    <PackageReference Include="AntDesign" />
    <PackageReference Include="AntDesign.ProLayout" />
  </ItemGroup>

</Project>

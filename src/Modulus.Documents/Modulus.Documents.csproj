<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>Office files for Modulus UI: xlsx in and out of the spreadsheet (ClosedXML), docx in and out of the document editor (Open XML SDK), and the editor-independent document model.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modulus.Ui.Abstractions\Modulus.Ui.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="DocumentFormat.OpenXml" />
  </ItemGroup>

</Project>

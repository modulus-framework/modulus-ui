@inherits ComponentBase

<footer @attributes="AdditionalAttributes" 
        style="height: 48px; background: white; border-top: 1px solid #d9d9d9; display: flex; align-items: center; justify-content: center; padding: 16px; text-align: center; font-size: 12px; color: rgba(0,0,0,0.65);">
    @ChildContent
</footer>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> AdditionalAttributes { get; set; } = [];
}

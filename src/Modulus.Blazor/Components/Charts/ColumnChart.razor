@* Grouped or stacked columns: <ColumnChart Labels="months" Series="series" Stacked /> *@
@inherits ChartBase
@using Modulus.Ui.Abstractions.Charts
@((MarkupString)ChartHtml.Columns(Labels, Series, Options(stacked: Stacked)))

@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Labels { get; set; } = [];

    [Parameter, EditorRequired] public IReadOnlyList<ChartSeries> Series { get; set; } = [];

    [Parameter] public bool Stacked { get; set; }
}

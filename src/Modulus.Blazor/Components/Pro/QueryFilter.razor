@*
    Search panel above a ProTable (Ant Design Pro QueryFilter): responsive grid of
    fields, Query/Reset, and an Expand toggle for rarely used fields.

    <QueryFilter Model="_query" OnSearch="Search" OnReset="Reset">
        <ChildContent><FormItem Label="Name"><Input @bind-Value="_query.Name" /></FormItem></ChildContent>
        <Advanced>...</Advanced>
    </QueryFilter>
*@
@typeparam TModel

<Card Bordered="false" Class="m-query-filter">
    <Form TModel="TModel" Model="Model" Layout="@FormLayout.Horizontal" OnFinish="SearchAsync" @ref="_form">
        <div class="m-query-filter-grid">
            @ChildContent
            @if (_expanded && Advanced is not null)
            {
                @Advanced
            }
            <div class="m-query-filter-actions">
                <Button OnClick="ResetAsync">Reset</Button>
                <Button Type="@ButtonType.Primary" HtmlType="submit" Loading="Loading">Query</Button>
                @if (Advanced is not null)
                {
                    <button type="button" class="ant-btn ant-btn-link m-query-filter-toggle" aria-expanded="@(_expanded ? "true" : "false")" @onclick="() => _expanded = !_expanded">
                        <span>@(_expanded ? "Collapse" : "Expand")</span> <Icon Type="@(_expanded ? "up" : "down")" />
                    </button>
                }
            </div>
        </div>
    </Form>
</Card>

@code {
    [Parameter, EditorRequired] public TModel Model { get; set; } = default!;

    /// <summary>Always-visible fields (FormItem elements).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Fields revealed by "Expand".</summary>
    [Parameter] public RenderFragment? Advanced { get; set; }

    [Parameter] public EventCallback OnSearch { get; set; }

    /// <summary>Called after the form is reset — clear your model here, then reload.</summary>
    [Parameter] public EventCallback OnReset { get; set; }

    [Parameter] public bool Loading { get; set; }

    private Form<TModel>? _form;
    private bool _expanded;

    private Task SearchAsync() => OnSearch.InvokeAsync();

    private async Task ResetAsync()
    {
        _form?.Reset();
        await OnReset.InvokeAsync();
    }
}

@* Sticky action bar at the bottom of long forms (Ant Design Pro FooterToolbar). *@

<div class="m-footer-toolbar">
    @if (Extra is not null)
    {
        <div>@Extra</div>
        <span class="m-spacer"></span>
    }
    @ChildContent
</div>

@code {
    /// <summary>Left-aligned content (e.g. a status line).</summary>
    [Parameter] public RenderFragment? Extra { get; set; }

    /// <summary>Right-aligned action buttons.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

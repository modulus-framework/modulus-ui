@using AntDesign
@using Modulus.Ui.Abstractions
@typeparam TItem

<AppCard Title="@Title" Bordered="false">
    <!-- Search & Toolbar -->
    <div class="pro-table-toolbar" style="margin-bottom: 16px;">
        <AppRow Gutter="16" Wrap="true">
            <AppCol Xs="24" Sm="12" Md="6">
                <Input TValue="string" Placeholder="Search..." Value="@searchText" ValueChanged="@((string val) => searchText = val)" ValueExpression="@(() => searchText)" />
            </AppCol>
            <AppCol Xs="24" Sm="12" Md="18" Class="d-flex gap-8">
                <AppButton Icon="reload" OnClick="@Refresh" Title="Refresh" />
                <AppButton Icon="plus" Type="@ButtonType.Primary" OnClick="@OnAddClick" Title="Add New" />
                @if (ExtraToolbar is not null)
                {
                    @ExtraToolbar
                }
            </AppCol>
        </AppRow>
    </div>

    <!-- Table -->
    <Table TItem="TItem" DataSource="@CurrentData" Striped="true" Bordered="true" Pagination="false" Loading="@IsLoading" Class="w-100">
        @ChildContent
        <ActionColumn Title="Actions" Width="150">
            <Space>
                <SpaceItem>
                    <AppButton Type="@ButtonType.Primary" Size="@ButtonSize.Small" OnClick="@(() => OnEditClick(context))">
                        Edit
                    </AppButton>
                </SpaceItem>
                <SpaceItem>
                    <Popconfirm Title="Delete?" OnConfirm="@(() => OnDeleteClick(context))" OkText="Yes" CancelText="No">
                        <AppButton Size="@ButtonSize.Small" Danger="true">
                            Delete
                        </AppButton>
                    </Popconfirm>
                </SpaceItem>
            </Space>
        </ActionColumn>
    </Table>

    <!-- Pagination -->
    <div style="margin-top: 16px; text-align: right;">
        <AppPagination Total="@Total" Current="@Current" PageSize="@PageSize" />
    </div>
</AppCard>

<style>
.pro-table-toolbar {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
}

.d-flex { display: flex; }
.gap-8 { gap: 8px; }
.w-100 { width: 100%; }
</style>

@code {
    [Parameter]
    public string? Title { get; set; } = "List";

    [Parameter]
    public List<TItem> DataSource { get; set; } = new();

    [Parameter]
    public int PageSize { get; set; } = 10;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? ExtraToolbar { get; set; }

    [Parameter]
    public EventCallback<ProTableRequest> OnRequest { get; set; }

    [Parameter]
    public EventCallback<TItem> OnEdit { get; set; }

    [Parameter]
    public EventCallback<TItem> OnDelete { get; set; }

    [Parameter]
    public EventCallback OnAdd { get; set; }

    private List<TItem> CurrentData = new();
    private bool IsLoading = false;
    private string? searchText;
    private int Current = 1;
    private int Total = 0;

    protected override async Task OnInitializedAsync()
    {
        CurrentData = DataSource.Take(PageSize).ToList();
        Total = DataSource.Count;
        await Refresh();
    }

    private async Task Refresh()
    {
        IsLoading = true;
        var request = new ProTableRequest
        {
            Current = Current,
            PageSize = PageSize,
            Filters = searchText != null ? new Dictionary<string, object?> { { "search", searchText } } : new()
        };

        if (OnRequest.HasDelegate)
        {
            await OnRequest.InvokeAsync(request);
        }

        IsLoading = false;
    }

    private async Task OnEditClick(TItem item)
    {
        if (OnEdit.HasDelegate)
        {
            await OnEdit.InvokeAsync(item);
        }
    }

    private async Task OnDeleteClick(TItem item)
    {
        if (OnDelete.HasDelegate)
        {
            await OnDelete.InvokeAsync(item);
        }
    }

    private async Task OnAddClick()
    {
        if (OnAdd.HasDelegate)
        {
            await OnAdd.InvokeAsync();
        }
    }
}

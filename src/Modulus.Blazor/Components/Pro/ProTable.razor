@*
    Server-driven data table in the Ant Design Pro ProTable pattern:
    toolbar (title, actions, density, reload) + table + paging + sorting + batch selection, with optional
    expandable rows (RowDetail) and columns resized by dragging a header edge.

    <ProTable TItem="Customer" HeaderTitle="Customers" Request="LoadAsync" RowKey="c => c.Id">
        <Columns>
            <PropertyColumn Property="c => c.Name" Sortable />
        </Columns>
        <ToolBar><Button Type="@ButtonType.Primary">New</Button></ToolBar>
    </ProTable>

    Search forms live outside (see QueryFilter); call ReloadAsync(resetPage: true) after a search.
    For the header of every Modulus table (sorter carets plus a column search), put a ColumnHeader in the column's
    TitleTemplate instead of Sortable: the request then carries SortField and Searches.
    With UrlState, the page, sort and column searches live in the URL (the MVC grids' keys, see ProTableUrl), beside the
    page's own filters (UrlQuery, read back in OnUrlChanged): back and forward step through them, a link opens the table
    as it was, and AppSavedViews can save the layout.
*@
@typeparam TItem
@attribute [CascadingTypeParameter(nameof(TItem))]
@using Modulus.Ui.Abstractions.Plugins
@using Microsoft.AspNetCore.Components.Routing
@using Modulus.Ui.Abstractions.State
@implements IColumnHeaderHost
@implements IDisposable
@inject NavigationManager Navigation

<Card Bordered="false" Id="@TableId" Class="@($"m-table-card{(Resizable ? " m-resizable" : "")} {Class}")">
    <div class="m-table-toolbar">
        <div class="m-table-toolbar-title">
            @HeaderTitle
            @TitleExtra
            @if (!string.IsNullOrEmpty(Tooltip))
            {
                <AntDesign.Tooltip Title="@Tooltip"><Icon Type="info-circle" Class="m-muted" /></AntDesign.Tooltip>
            }
        </div>
        <div class="m-table-toolbar-actions">
            @ToolBar
            @if (FiltersActive || _searches is not null)
            {
                @* One click clears the column searches and, through OnClearFilters, the page's own search and filters. *@
                <button type="button" class="ant-btn ant-btn-text m-table-clear" title="Clear the search and filters" @onclick="ClearFiltersAsync"><Icon Type="close-circle" /><span>Clear</span></button>
            }
            @* Columns and Export CSV work on the rendered table (modulus-shell.js), as in the MVC <app-table-settings>. *@
            @if (ColumnSettings)
            {
                <button type="button" class="ant-btn ant-btn-default m-table-columns" data-m-table-columns aria-haspopup="dialog" aria-expanded="false" title="Show or hide columns"><Icon Type="setting" /><span>Columns</span></button>
            }
            @if (Exportable)
            {
                <button type="button" class="ant-btn ant-btn-default m-table-export" data-m-table-export="@(ExportFileName ?? HeaderTitle ?? "export")" title="Export the rows shown to a CSV file"><Icon Type="download" /><span>Export CSV</span></button>
            }
            @if (FilterRow)
            {
                <button type="button" class="@($"ant-btn ant-btn-text ant-btn-icon-only m-table-filter-toggle{(_filterRow ? " active" : "")}")" aria-label="Filter row"
                        title="@(_filterRow ? "Hide the filter row" : "Show the filter row")" aria-pressed="@(_filterRow ? "true" : "false")" @onclick="() => _filterRow = !_filterRow"><Icon Type="filter" /></button>
            }
            <div class="m-table-toolbar-settings">
                <button type="button" class="ant-btn ant-btn-text ant-btn-icon-only" aria-label="Reload" title="Reload" @onclick="() => ReloadAsync()"><Icon Type="reload" /></button>
                <Dropdown Trigger="@(new[] { Trigger.Click })" Placement="Placement.BottomRight">
                    <Overlay>
                        <Menu SelectedKeys="@(new[] { _size.ToString() })" OnMenuItemClicked="OnDensity">
                            <MenuItem Key="@nameof(TableSize.Default)">Comfortable</MenuItem>
                            <MenuItem Key="@nameof(TableSize.Middle)">Standard</MenuItem>
                            <MenuItem Key="@nameof(TableSize.Small)">Compact</MenuItem>
                        </Menu>
                    </Overlay>
                    <ChildContent>
                        <button type="button" class="ant-btn ant-btn-text ant-btn-icon-only" aria-label="Table density" title="Density"><Icon Type="column-height" /></button>
                    </ChildContent>
                </Dropdown>
            </div>
        </div>
    </div>

    @if (Filters is not null)
    {
        <div class="m-table-filters">@Filters</div>
    }

    @if (Selectable && _selected.Any())
    {
        <Alert Type="@AlertType.Info" Class="m-table-alert" ShowIcon="false">
            <MessageTemplate>
                <span>Selected <strong>@_selected.Count()</strong> @(_selected.Count() == 1 ? "item" : "items")</span>
                <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" OnClick="ClearSelection">Clear</Button>
                <span class="m-spacer"></span>
                @BatchActions?.Invoke(_selected.ToList())
            </MessageTemplate>
        </Alert>
    }

    @* With OnRowMove, rows drag by their handle; modulus-plugins.js reports the move through the hidden input. *@
    <div class="m-sort-rows" data-m-sort-rows="@(Draggable ? TableId : null)" data-m-sort-root="@Draggable" data-m-sort-mode="@(Draggable ? "event" : null)"
         data-m-sort-disabled="@(Draggable && DragLocked)" data-m-sort-title="@(Draggable ? HeaderTitle : null)">
    @if (Draggable)
    {
        <input type="hidden" data-m-sort-result @onchange="RowMovedAsync" />
        @((MarkupString)SortableHtml.RowsHelp(HelpId))
    }
    <CascadingValue Value="HeaderScope">
    <Table TItem="TItem"
           DataSource="_data"
           Total="_total"
           RemoteDataSource="true"
           PageIndex="_pageIndex"
           PageIndexChanged="i => _pageIndex = i"
           PageSize="_pageSize"
           PageSizeChanged="s => _pageSize = s"
           OnChange="OnTableChange"
           Loading="_loading"
           Size="_size"
           RowKey="RowKey"
           ScrollX="@ScrollX"
           SelectedRows="_selected"
           SelectedRowsChanged="rows => _selected = rows"
           ExpandTemplate="ExpandFragment"
           RowExpandable="RowExpandableFor"
           PaginationTemplate="PaginationWithTotal">
        <ChildContent>
            @if (Draggable)
            {
                <ActionColumn Title="" Width="@SortableHtml.RowHandleWidth.ToString(System.Globalization.CultureInfo.InvariantCulture)" Align="ColumnAlign.Center" Class="m-row-drag-cell">
                    @((MarkupString)SortableHtml.RowHandle(IdOf(context), RowLabel?.Invoke(context) ?? "row", HelpId, DragLocked))
                </ActionColumn>
            }
            @if (Selectable)
            {
                <Selection Width="48" Disabled="@(RowSelectable is not null && !RowSelectable(context))" />
            }
            @Columns?.Invoke(context)
        </ChildContent>
    </Table>
    </CascadingValue>
    </div>
</Card>

@code {
    [Parameter] public string? HeaderTitle { get; set; }

    [Parameter] public string? Tooltip { get; set; }

    /// <summary>Content after the title (a count badge, a summary).</summary>
    [Parameter] public RenderFragment? TitleExtra { get; set; }

    /// <summary>Column definitions (PropertyColumn, ActionColumn …).</summary>
    [Parameter] public RenderFragment<TItem>? Columns { get; set; }

    /// <summary>Filter controls shown in a row under the toolbar (Tabler datagrid filters).</summary>
    [Parameter] public RenderFragment? Filters { get; set; }

    /// <summary>Buttons shown right of the title.</summary>
    [Parameter] public RenderFragment? ToolBar { get; set; }

    /// <summary>Loads one page. Called on first render, paging, sorting and <see cref="ReloadAsync"/>.</summary>
    [Parameter, EditorRequired] public Func<ProTableRequest, Task<ProTableResponse<TItem>>> Request { get; set; } = default!;

    [Parameter] public Func<TItem, object>? RowKey { get; set; }

    [Parameter] public int PageSize { get; set; } = 10;

    [Parameter] public TableSize Size { get; set; } = TableSize.Middle;

    [Parameter] public string? ScrollX { get; set; }

    /// <summary>Adds a checkbox column and the selection bar.</summary>
    [Parameter] public bool Selectable { get; set; }

    /// <summary>With <see cref="Selectable"/>: rows for which this returns false get a disabled checkbox.</summary>
    [Parameter] public Func<TItem, bool>? RowSelectable { get; set; }

    /// <summary>Actions for the selection bar; receives the selected rows.</summary>
    [Parameter] public RenderFragment<IReadOnlyList<TItem>>? BatchActions { get; set; }

    /// <summary>Content of an expanded row (an expand column is added). Without it rows do not expand.</summary>
    [Parameter] public RenderFragment<TItem>? RowDetail { get; set; }

    /// <summary>With <see cref="RowDetail"/>: which rows can expand (default: all).</summary>
    [Parameter] public Func<TItem, bool>? RowExpandable { get; set; }

    /// <summary>Drag a header's right edge to resize the column (modulus-shell.js).</summary>
    [Parameter] public bool Resizable { get; set; } = true;

    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// A filter button in the toolbar that shows each searchable <see cref="ColumnHeader"/>'s search as a box under
    /// its title (a filter row), instead of behind the header's search icon. Turn it on for tables whose columns use ColumnHeader.
    /// </summary>
    [Parameter] public bool FilterRow { get; set; }

    /// <summary>The page's own search or filters (outside the table) are set: shows the toolbar's Clear button.</summary>
    [Parameter] public bool FiltersActive { get; set; }

    /// <summary>Clears the page's own search and filters; the Clear button then clears the column searches and loads page 1.</summary>
    [Parameter] public EventCallback OnClearFilters { get; set; }

    /// <summary>A Columns button that shows or hides columns; the choice is remembered in the browser, per page and table.</summary>
    [Parameter] public bool ColumnSettings { get; set; } = true;

    /// <summary>An Export CSV button that saves the rows shown (this page, in the visible columns).</summary>
    [Parameter] public bool Exportable { get; set; } = true;

    /// <summary>File name of the export, without ".csv" (defaults to the title).</summary>
    [Parameter] public string? ExportFileName { get; set; }

    /// <summary>Id of the table's card; it also keys the remembered columns (defaults to one made from the title).</summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>
    /// Rows drag by a handle to a new place on the page (or move with Up, Down, Home, End on the handle); needs
    /// <see cref="RowKey"/>. Store <see cref="RowMove.Order"/>; the page reloads afterwards. Locked while a column sort is on.
    /// </summary>
    [Parameter] public EventCallback<RowMove> OnRowMove { get; set; }

    /// <summary>With <see cref="OnRowMove"/>: the name read out when a row moves (default "row").</summary>
    [Parameter] public Func<TItem, string>? RowLabel { get; set; }

    /// <summary>
    /// Keep the page, page size, sort and column searches in the URL (<see cref="ProTableUrl"/>'s keys, as the MVC grids):
    /// each change adds a history entry, and the table follows the URL when it changes from outside (back, forward, a
    /// saved view's link).
    /// </summary>
    [Parameter] public bool UrlState { get; set; }

    /// <summary>With <see cref="UrlState"/>: the page's own query pairs (its search, filters, hidden columns) written beside the table's.</summary>
    [Parameter] public Func<IEnumerable<KeyValuePair<string, string?>>>? UrlQuery { get; set; }

    /// <summary>
    /// With <see cref="UrlState"/>: the URL's query, on the first render and whenever the URL changes from outside; the page
    /// sets its own filters from it before the table loads.
    /// </summary>
    [Parameter] public EventCallback<IReadOnlyList<KeyValuePair<string, string?>>> OnUrlChanged { get; set; }

    private bool Draggable => OnRowMove.HasDelegate && RowKey is not null;

    // A column sort decides the order, so a drop would not stay where it was put.
    private bool DragLocked => _sortField is not null;

    private string HelpId => $"{TableId}-drag-help";

    private string IdOf(TItem item) => RowKey?.Invoke(item)?.ToString() ?? "";

    private async Task RowMovedAsync(ChangeEventArgs e)
    {
        if (!Draggable || DragLocked || !SortMove.TryParse(e.Value?.ToString(), out var move)) return;
        var rows = _data.ToList();
        var order = move.Within(rows.Select(IdOf));
        var byId = rows.GroupBy(IdOf).ToDictionary(g => g.Key, g => g.First());
        _data = order.Where(byId.ContainsKey).Select(id => byId[id]).ToList(); // shown at once, before the reload
        await OnRowMove.InvokeAsync(new RowMove(move.Id, move.Index, order));
        await LoadAsync();
    }

    private string TableId => Id ??"table-" + System.Text.RegularExpressions.Regex.Replace((HeaderTitle ?? "data").ToLowerInvariant(), "[^a-z0-9]+", "-").Trim('-');

    private bool _filterRow;

    private RenderFragment<AntDesign.TableModels.RowData<TItem>>? ExpandFragment => RowDetail is null ? null : row => RowDetail(row.Data);

    private bool RowExpandableFor(AntDesign.TableModels.RowData<TItem> row) => RowDetail is not null && (RowExpandable?.Invoke(row.Data) ?? true);

    private IEnumerable<TItem> _data = [];
    private IEnumerable<TItem> _selected = [];
    private int _total;
    private int _pageIndex = 1;
    private int _pageSize;
    private bool _loading;
    private TableSize _size;
    private string? _sortField;
    private Modulus.Ui.Abstractions.SortDirection _sortOrder;
    private int _loadVersion;

    protected override async Task OnInitializedAsync()
    {
        _pageSize = PageSize;
        _size = Size;
        if (!UrlState) return;
        Navigation.LocationChanged += OnLocationChanged;
        await ReadUrlAsync();
    }

    // ---- UrlState ----

    // The query the table last read or wrote, so its own navigations are not read back.
    private IReadOnlyList<KeyValuePair<string, string?>> _urlQuery = [];

    private static IReadOnlyList<KeyValuePair<string, string?>> QueryOf(string uri) => SavedViews.Parse(new Uri(uri).Query);

    private async Task ReadUrlAsync()
    {
        _urlQuery = QueryOf(Navigation.Uri);
        var request = ProTableUrl.Read(_urlQuery, PageSize);
        (_pageIndex, _pageSize, _sortField, _sortOrder, _searches) = (request.Current, request.PageSize, request.SortField, request.SortOrder, request.Searches);
        if (OnUrlChanged.HasDelegate) await OnUrlChanged.InvokeAsync(_urlQuery);
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (ProTableUrl.SameQuery(QueryOf(e.Location), _urlQuery)) return;
        try
        {
            await InvokeAsync(async () =>
            {
                await ReadUrlAsync();
                _selected = [];
                await LoadAsync();
            });
        }
        catch (ObjectDisposedException) { /* the circuit ended */ }
    }

    /// <summary>With <see cref="UrlState"/>: writes the current state to the URL (after a change the table does not load for, such as a hidden column).</summary>
    public void SyncUrl() => WriteUrl(new ProTableRequest { Current = _pageIndex, PageSize = _pageSize, SortField = _sortField, SortOrder = _sortOrder, Searches = _searches });

    private void WriteUrl(ProTableRequest request)
    {
        if (!UrlState) return;
        var query = (UrlQuery?.Invoke() ?? []).Where(q => !ProTableUrl.IsTableKey(q.Key)).Concat(ProTableUrl.Write(request, PageSize)).ToList();
        if (ProTableUrl.SameQuery(query, QueryOf(Navigation.Uri))) return;
        _urlQuery = query;
        var text = ProTableUrl.Query(query);
        Navigation.NavigateTo(new Uri(Navigation.Uri).GetLeftPart(UriPartial.Path) + (text.Length == 0 ? "" : "?" + text));
    }

    public void Dispose()
    {
        if (UrlState) Navigation.LocationChanged -= OnLocationChanged;
    }

    /// <summary>Reloads the current page, or page 1 when <paramref name="resetPage"/> is true (after a search).</summary>
    public async Task ReloadAsync(bool resetPage = false)
    {
        if (resetPage) _pageIndex = 1;
        await LoadAsync();
    }

    public void ClearSelection() => _selected = [];

    private async Task OnTableChange(AntDesign.TableModels.QueryModel<TItem> query)
    {
        _pageIndex = query.PageIndex;
        _pageSize = query.PageSize;
        // Columns with Ant Design's own Sortable sort through the table; with none, ColumnHeader keeps the sort here.
        if (query.SortModel.Count > 0)
        {
            var sort = query.SortModel.FirstOrDefault(s => s.SortDirection != AntDesign.SortDirection.None);
            _sortField = sort?.FieldName;
            _sortOrder = sort?.SortDirection switch
            {
                AntDesign.SortDirection.Ascending => Modulus.Ui.Abstractions.SortDirection.Ascending,
                AntDesign.SortDirection.Descending => Modulus.Ui.Abstractions.SortDirection.Descending,
                _ => Modulus.Ui.Abstractions.SortDirection.None,
            };
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // Drop responses from superseded requests (fast paging / typing).
        var version = ++_loadVersion;
        _loading = true;
        StateHasChanged();
        try
        {
            var request = new ProTableRequest
            {
                Current = _pageIndex,
                PageSize = _pageSize,
                SortField = _sortField,
                SortOrder = _sortOrder,
                Searches = _searches,
            };
            WriteUrl(request);
            var response = await Request(request);
            if (version != _loadVersion) return;
            _data = response.Data;
            _total = response.Total;
        }
        finally
        {
            if (version == _loadVersion) _loading = false;
        }
    }

    // Ant Design's pagination with the "1–10 of 57" range on the left (matches the server-rendered grid).
    private RenderFragment<(int PageSize, int PageIndex, int Total, string PaginationClass, EventCallback<PaginationEventArgs> HandlePageChange)> PaginationWithTotal => p =>
        @<Pagination Class="@p.PaginationClass" Total="p.Total" PageSize="p.PageSize" Current="p.PageIndex" Size="PaginationSize.Small"
                     ShowSizeChanger="true" OnChange="p.HandlePageChange" ShowTotal="ShowTotal" />;

    private static readonly Func<PaginationTotalContext, string> ShowTotal = ctx => $"{ctx.Range.Item1}–{ctx.Range.Item2} of {ctx.Total}";


    // ---- Column headers (ColumnHeader in a column's TitleTemplate): sort and column search on the server ----

    private IReadOnlyDictionary<string, string?>? _searches;
    private ColumnHeaderScope? _headerScope;
    private string? _headerState;
    private int _headerVersion;

    // A new scope whenever the sort or a search changes re-renders the headers.
    private ColumnHeaderScope HeaderScope
    {
        get
        {
            var state = $"{_filterRow}|{_sortField}|{_sortOrder}|{string.Join('|', (_searches ?? new Dictionary<string, string?>()).Select(s => $"{s.Key}={s.Value}"))}";
            if (_headerScope is null || state != _headerState)
            {
                _headerState = state;
                _headerScope = new ColumnHeaderScope(this, ++_headerVersion, _filterRow);
            }
            return _headerScope;
        }
    }

    public Modulus.Ui.Abstractions.SortDirection SortOf(string key) =>
        string.Equals(_sortField, key, StringComparison.OrdinalIgnoreCase) ? _sortOrder : Modulus.Ui.Abstractions.SortDirection.None;

    /// <summary>A header click: ascending, descending, then unsorted; back to page 1.</summary>
    public async Task SortAsync(string key)
    {
        _sortOrder = ColumnSearch.NextSort(SortOf(key));
        _sortField = _sortOrder == Modulus.Ui.Abstractions.SortDirection.None ? null : key;
        await ReloadAsync(resetPage: true);
    }

    public string? SearchOf(string key) => _searches?.GetValueOrDefault(key);

    /// <summary>Sets (or clears) a column search and loads page 1.</summary>
    public async Task SearchAsync(string key, string? value)
    {
        _searches = ColumnSearch.With(_searches, key, value);
        await ReloadAsync(resetPage: true);
    }

    /// <summary>The column searches applied (null when none), e.g. for an export link.</summary>
    public IReadOnlyDictionary<string, string?>? Searches => _searches;

    /// <summary>Clears every column search (with the page's own filters) and loads page 1.</summary>
    public async Task ClearSearchesAsync()
    {
        _searches = null;
        await ReloadAsync(resetPage: true);
    }
    private async Task ClearFiltersAsync()
    {
        _searches = null;
        if (OnClearFilters.HasDelegate) await OnClearFilters.InvokeAsync();
        await ReloadAsync(resetPage: true);
    }

    private void OnDensity(MenuItem item) => _size = Enum.Parse<TableSize>(item.Key);
}

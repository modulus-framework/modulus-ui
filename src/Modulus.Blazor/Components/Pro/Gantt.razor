@using Modulus.Ui.Abstractions.Gantt
@using Microsoft.AspNetCore.Components.Forms

@*
    A timeline: each task is a bar on the days it runs (filled to its progress), grouped under a heading, with weekly ticks along the
    top, a line for today, and an arrow for each dependency (a conflict is drawn red). A bar can be dragged to another day, or moved
    with the arrow keys; the new dates go to OnMove. The rows, bars and arrows come from GanttModel and GanttDrawing, the same the MVC
    app-gantt draws.

    <Gantt Tasks="_tasks" From="_from" To="_to" OnMove="ApplyMoveAsync" />
*@

<div class="m-gantt" data-m-gantt data-days="@_days">
    <div class="m-gantt-head" aria-hidden="true">
        <div class="m-gantt-name">Task</div>
        <div class="m-gantt-track">
            @foreach (var tick in _view.Ticks)
            {
                <span class="m-gantt-tick" style="left:@Pct(tick.LeftPct)">@tick.Label</span>
            }
        </div>
    </div>
    <div class="m-gantt-body" role="table" aria-label="Timeline">
        @if (_view.Links is { Count: > 0 } links)
        {
            <svg class="m-gantt-links" viewBox="@GanttDrawing.ViewBox(_view)" preserveAspectRatio="none" aria-hidden="true">
                @foreach (var link in links)
                {
                    <path class="m-gantt-link@(link.Conflict ? " conflict" : "")" d="@GanttDrawing.LinkPath(link)" />
                }
            </svg>
        }
        @foreach (var row in _view.Rows)
        {
            var task = row.Task;
            @if (row.NewGroup)
            {
                <div class="m-gantt-group" role="rowheader">@(string.IsNullOrEmpty(task.Group) ? "Ungrouped" : task.Group)</div>
            }
            <div class="m-gantt-row" role="row">
                <div class="m-gantt-name" role="cell">
                    <span class="m-heading m-medium m-truncate">@task.Name</span>
                    @if (task.Owner is { Length: > 0 }) { <span class="m-xsmall m-muted m-truncate">@task.Owner</span> }
                </div>
                <div class="m-gantt-track" role="cell">
                    <div class="@BarClass(row)" style="@BarStyle(row)" title="@Title(row)" aria-label="@Title(row)"
                         data-m-task="@task.Id" data-start="@GanttDrawing.Iso(task.Start)" data-end="@GanttDrawing.Iso(task.End)" tabindex="0">
                        <span class="m-gantt-fill" style="width:@row.Progress%"></span>
                        <span class="m-gantt-bar-label">@row.Progress%</span>
                    </div>
                    @if (_view.TodayPct is { } today)
                    {
                        <div class="m-gantt-today" style="left:@Pct(today)" aria-hidden="true"></div>
                    }
                </div>
            </div>
        }
    </div>
    @* The script writes the moves here (a JSON array) and raises change: OnMove receives each new date range. *@
    <input type="hidden" name="moves" data-m-gantt-value data-m-submit-change @onchange="MovedAsync" />
</div>

@code {
    /// <summary>The tasks to draw. Tasks outside the range are not shown.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<GanttTask> Tasks { get; set; } = [];

    /// <summary>The first day of the timeline.</summary>
    [Parameter, EditorRequired] public DateTime From { get; set; }

    /// <summary>The last day of the timeline (both days count).</summary>
    [Parameter, EditorRequired] public DateTime To { get; set; }

    /// <summary>The day the timeline is drawn for: tasks that ended before it and are not done are late. Defaults to today.</summary>
    [Parameter] public DateTime Today { get; set; } = DateTime.Today;

    /// <summary>Called with each task's new dates when a bar is dragged or moved with the keyboard. The page applies them.</summary>
    [Parameter] public EventCallback<GanttMove> OnMove { get; set; }

    private GanttView _view = GanttModel.Build([], DateTime.Today, DateTime.Today, DateTime.Today);
    private int _days = 1;

    protected override void OnParametersSet()
    {
        _view = GanttModel.Build(Tasks, From, To, Today);
        _days = (To.Date - From.Date).Days + 1;
    }

    private async Task MovedAsync(ChangeEventArgs e)
    {
        foreach (var move in GanttDrawing.ParseMoves(e.Value as string))
            await OnMove.InvokeAsync(move);
    }

    private static string Pct(double value) => value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) + "%";

    private static string BarClass(GanttRowView row)
    {
        var classes = $"m-gantt-bar m-gantt-{row.Task.Tone}";
        if (row.Late) classes += " late";
        if (row.ClippedStart) classes += " clip-start";
        if (row.ClippedEnd) classes += " clip-end";
        return classes;
    }

    private static string BarStyle(GanttRowView row) => $"left:{Pct(row.LeftPct)};width:{Pct(row.WidthPct)}";

    private static string Title(GanttRowView row)
    {
        var t = row.Task;
        var dates = $"{t.Start:MMM d} to {t.End:MMM d}";
        return $"{t.Name}: {dates}, {row.Progress}%" + (row.Late ? ", late" : "");
    }
}

@*
    The header of a table column as every Modulus table renders it: the title, Ant Design's sorter carets (a click
    cycles ascending, descending, unsorted; with Shift, the column joins the table's other sorts and shows its place
    among them) and a search icon that opens a column search box (ColumnSearch: contains,
    =exact, !exclude, and >, <=, a..b for numbers and dates). The table around it (ProTable, EditableGrid) does the
    sorting and searching. The MVC twin is ColumnHeader.cs, with the same DOM.

    <PropertyColumn Property="e => e.Name">
        <TitleTemplate><ColumnHeader Key="Name" Title="Employee" /></TitleTemplate>
    </PropertyColumn>
*@
@using SortDirection = Modulus.Ui.Abstractions.SortDirection

<span class="m-th" data-key="@Key">
    @if (Sortable && Host is not null)
    {
        var sort = Host.SortOf(Key);
        var rank = Host.SortRank(Key);
        <span class="ant-table-column-sorters m-th-sort" role="button" tabindex="0" title="@($"Sort by {Title}{(Host.MultiSort ? " (Shift+click to add)" : "")}")"
              aria-label="@($"Sort by {Title}{State(sort, rank)}")" @onclick="SortClickAsync" @onkeydown="SortKeyAsync">
            <span class="ant-table-column-title">@Title@if (Required) {<span class="m-grid-required" aria-hidden="true">*</span>}</span>
            <span class="ant-table-column-sorter ant-table-column-sorter-full">
                <span class="ant-table-column-sorter-inner">
                    <Icon Type="caret-up" Class="@($"ant-table-column-sorter-up{(sort == SortDirection.Ascending ? " active" : "")}")" />
                    <Icon Type="caret-down" Class="@($"ant-table-column-sorter-down{(sort == SortDirection.Descending ? " active" : "")}")" />
                </span>
            </span>
            @if (rank > 0)
            {
                <span class="m-th-sort-rank" aria-hidden="true">@rank</span>
            }
        </span>
    }
    else
    {
        <span class="ant-table-column-title m-th-title">@Title@if (Required) {<span class="m-grid-required" aria-hidden="true">*</span>}</span>
    }
    @if (Searchable && Host is not null && Scope?.FilterRow == true)
    {
        var current = Host.SearchOf(Key);
        var activeClass = string.IsNullOrWhiteSpace(current) ? "" : " m-th-filter-active";
        @* The table's filter row: the column search typed in place (Enter or leaving the box applies it), or picked
           from a select for option columns. *@
        if (Choices is not null)
        {
            <select class="@($"m-select m-th-filter m-th-filter-on{activeClass}")" aria-label="@($"Filter {Title}")" disabled="@Locked" title="@(Locked ? LockedText : null)"
                    @onchange="FilterChangedAsync" @onclick:stopPropagation>
                <option value="">@ColumnSearch.AnyText(Title)</option>
                @foreach (var choice in ColumnSearch.WithCurrent(Choices, current))
                {
                    <option value="@choice.Query" selected="@(choice.Query == current?.Trim())">@choice.Label</option>
                }
            </select>
        }
        else
        {
            <input class="@($"ant-input ant-input-sm m-th-filter m-th-filter-on{activeClass}")" type="text"
                   value="@current" placeholder="@ColumnSearch.FilterPlaceholder(Kind)" aria-label="@($"Filter {Title}")" title="@(Locked ? LockedText : ColumnSearch.Hint(Kind))" disabled="@Locked"
                   autocomplete="off" maxlength="@ColumnSearch.MaxLength" @onchange="FilterChangedAsync" @onclick:stopPropagation />
        }
    }
    else if (Searchable && Host is not null)
    {
        var value = Host.SearchOf(Key);
        var active = !string.IsNullOrWhiteSpace(value);
        <span class="m-th-search-host">
            <Dropdown Trigger="@(new[] { Trigger.Click })" Placement="Placement.BottomRight" Visible="_open" VisibleChanged="OpenChanged" OverlayClassName="m-col-search-drop">
                <Overlay>
                    <div class="ant-table-filter-dropdown m-col-search" role="dialog" aria-label="@($"Search {Title}")">
                        <div class="m-col-search-body">
                            <input @ref="_input" class="ant-input ant-input-sm" type="text" value="@_draft" placeholder="@($"Search {Title.ToLowerInvariant()}")"
                                   aria-label="@($"Search {Title}")" autocomplete="off" maxlength="@ColumnSearch.MaxLength"
                                   @oninput="e => _draft = e.Value?.ToString()" @onkeydown="InputKeyAsync" />
                            <div class="m-col-search-hint">@ColumnSearch.Hint(Kind)</div>
                        </div>
                        <div class="ant-table-filter-dropdown-btns">
                            <button type="button" class="ant-btn ant-btn-link ant-btn-sm" @onclick="ResetAsync"><span>Reset</span></button>
                            <button type="button" class="ant-btn ant-btn-primary ant-btn-sm" @onclick="ApplyAsync"><span>Search</span></button>
                        </div>
                    </div>
                </Overlay>
                <ChildContent>
                    <span class="@($"ant-table-filter-trigger m-th-search{(active ? " active" : "")}")" role="button" tabindex="0" title="@($"Search {Title}")"
                          aria-label="@($"Search {Title}{(active ? $": {value}" : "")}")" aria-haspopup="dialog" aria-expanded="@(_open ? "true" : "false")"
                          @onkeydown="TriggerKey">
                        <Icon Type="search" />
                    </span>
                </ChildContent>
            </Dropdown>
        </span>
    }
    @ChildContent
</span>

@code {
    /// <summary>Column key: what the table sorts and searches by.</summary>
    [Parameter, EditorRequired] public string Key { get; set; } = "";

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>How the search compares values (numbers and dates also take comparisons and ranges).</summary>
    [Parameter] public ColumnKind Kind { get; set; }

    /// <summary>A red asterisk after the title.</summary>
    [Parameter] public bool Required { get; set; }

    [Parameter] public bool Sortable { get; set; } = true;

    [Parameter] public bool Searchable { get; set; } = true;

    /// <summary>Choices of the column's box in the filter row (a select instead of a text box); see <c>GridSchema.SearchChoices</c>.</summary>
    [Parameter] public IReadOnlyList<ColumnChoice>? Choices { get; set; }

    /// <summary>More header content after the search icon (a column menu).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] public ColumnHeaderScope? Scope { get; set; }

    private IColumnHeaderHost? Host => Scope?.Host;

    private bool Locked => Scope?.Locked == true;

    private const string LockedText = "Save or discard your changes first";

    private bool _open, _focus;
    private string? _draft;
    private ElementReference _input;

    private static string State(SortDirection sort, int rank) => sort switch
    {
        SortDirection.Ascending => rank > 0 ? $" (ascending, sort {rank})" : " (ascending)",
        SortDirection.Descending => rank > 0 ? $" (descending, sort {rank})" : " (descending)",
        _ => "",
    };

    private async Task SortClickAsync(MouseEventArgs e)
    {
        if (Host is not null) await Host.SortAsync(Key, e.ShiftKey || e.CtrlKey || e.MetaKey);
    }

    private async Task SortKeyAsync(KeyboardEventArgs e)
    {
        if (Host is not null && e.Key is "Enter" or " ") await Host.SortAsync(Key, e.ShiftKey);
    }

    private void TriggerKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") OpenChanged(!_open);
    }

    private void OpenChanged(bool open)
    {
        if (open && !_open)
        {
            _draft = Host?.SearchOf(Key);
            _focus = true;
        }
        _open = open;
    }

    private async Task InputKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ApplyAsync();
        else if (e.Key == "Escape") _open = false;
    }

    private async Task ApplyAsync()
    {
        _open = false;
        if (Host is not null) await Host.SearchAsync(Key, string.IsNullOrWhiteSpace(_draft) ? null : _draft.Trim());
    }

    private async Task FilterChangedAsync(ChangeEventArgs e)
    {
        var value = e.Value?.ToString()?.Trim();
        if (Host is null || (value ?? "") == (Host.SearchOf(Key) ?? "")) return;
        await Host.SearchAsync(Key, string.IsNullOrEmpty(value) ? null : value);
    }

    private async Task ResetAsync()
    {
        _draft = null;
        await ApplyAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focus || !_open) return;
        _focus = false;
        try
        {
            // The overlay renders on the next frame; a missed focus just leaves the box unfocused.
            await Task.Delay(50);
            await _input.FocusAsync();
        }
        catch (Exception e) when (e is JSException or InvalidOperationException)
        {
        }
    }
}

@*
    Schema-driven editable grid: the columns are data (GridColumn), so they can be built at runtime, stored,
    or added by the user. Click a cell to edit it with the control for its type (Input, InputNumber, Select,
    multiple Select, DatePicker); switches and ratings change in place. Rows expand to a detail template.
    Columns can be pinned left or right (Ant Design fixed columns), hidden, reordered, resized, removed and added.
    Like the data table it has a search box, a filter row (Filterable columns), row selection with a batch bar
    (set a value, export, delete) and CSV export. Every column header sorts (ascending, descending, unsorted) and
    has a column search (ColumnHeader). Rows drag by their handle to a new place (RowDraggable).

    <EditableGrid Columns="_columns" Rows="_rows" HeaderTitle="Projects" OnSave="SaveAsync">
        <RowDetail>…@context["notes"]…</RowDetail>
    </EditableGrid>

    The MVC equivalent is <app-editable-grid> with the same model and validation (GridSchema).
*@
@using System.Globalization
@using AntDesign.TableModels
@using Modulus.Ui.Abstractions.Plugins
@implements IDisposable
@implements IColumnHeaderHost
@inject IJSRuntime JS

<Card Bordered="false" Id="@_gridId" Class="@($"m-table-card m-grid{(Resizable ? " m-resizable" : "")} {Class}")">
    @* One compact toolbar for every grid level: the title and count on the left; on the right the unsaved-changes
       count with Discard and Save, then icon buttons with tooltips (search, filter row, columns, add row, reload)
       and a "More" menu (export, add column, density). modulus-shell.js adds the keys: Ctrl+S saves, Insert adds a
       row, Ctrl+F searches, the arrow keys move between cells. *@
    <div class="m-table-toolbar">
        <div class="m-table-toolbar-title">
            @HeaderTitle
            @TitleExtra
        </div>
        <div class="m-table-toolbar-actions">
            @if (_dirty)
            {
                <span class="m-grid-dirty" role="status"><span class="ant-badge ant-badge-status ant-badge-not-a-wrapper"><span class="ant-badge-status-dot ant-badge-status-warning"></span><span class="ant-badge-status-text">@ChangesText</span></span></span>
                if (OnDiscard.HasDelegate)
                {
                    <button type="button" class="ant-btn ant-btn-text m-grid-discard" @onclick="DiscardAsync"><span>Discard</span></button>
                }
            }
            @if (OnSave.HasDelegate)
            {
                <button type="button" class="@($"ant-btn {(_dirty ? "ant-btn-primary" : "ant-btn-default")} m-grid-save{(_saving ? " ant-btn-loading" : "")}")" title="Save (Ctrl+S)"
                        data-m-grid-save disabled="@_saving" @onclick="SaveAsync"><Icon Type="@(_saving ? "loading" : "save")" Spin="_saving" /><span>Save</span></button>
            }
            @if (Searchable)
            {
                if (SearchShown)
                {
                    <Input TValue="string" Value="_keyword" ValueChanged="SearchChanged" BindOnInput AllowClear AutoFocus="_searchOpen"
                           Placeholder="@($"Search {(HeaderTitle ?? "rows").ToLowerInvariant()}…")" Class="m-table-toolbar-search m-grid-search"
                           Prefix="SearchIcon" aria-label="@($"Search {HeaderTitle ?? "rows"}")" OnBlur="SearchBlur" />
                }
                else
                {
                    <button type="button" class="ant-btn ant-btn-text ant-btn-icon-only m-table-search-toggle" aria-label="@($"Search {HeaderTitle ?? "rows"}")" title="Search (Ctrl+F)"
                            data-m-search-toggle @onclick="() => _searchOpen = true"><Icon Type="search" /></button>
                }
            }
            @ToolBar
            @if (AnyFilter)
            {
                <button type="button" class="ant-btn ant-btn-text m-table-clear" title="Clear the search and filters" @onclick="ClearFilters"><Icon Type="close-circle" /><span>Clear</span></button>
            }
            @if (ColumnSearchable)
            {
                <button type="button" class="@($"ant-btn ant-btn-text ant-btn-icon-only m-table-filter-toggle{(_filterRow ? " active" : "")}")" aria-label="Filter row"
                        title="@(_filterRow ? "Hide the filter row" : "Show the filter row")" aria-pressed="@(_filterRow ? "true" : "false")" @onclick="() => _filterRow = !_filterRow"><Icon Type="filter" /></button>
            }
            @if (AllowColumnHide || AllowColumnEdit)
            {
                <Popover Trigger="@(new[] { Trigger.Click })" Placement="Placement.BottomRight" OverlayClassName="m-grid-columns-popover">
                    <TitleTemplate>
                        <div class="m-grid-columns-head"><span>Columns</span><span class="m-muted">@Columns.Count(c => !c.Hidden) of @Columns.Count shown</span></div>
                    </TitleTemplate>
                    <ContentTemplate>
                        <ul class="m-grid-columns" role="list">
                            @for (var i = 0; i < Columns.Count; i++)
                            {
                                var column = Columns[i];
                                var first = i == 0;
                                var last = i == Columns.Count - 1;
                                <li class="m-grid-columns-item" @key="column.Key">
                                    <Checkbox Checked="!column.Hidden" CheckedChanged="v => SetHidden(column, !v)">@column.Title</Checkbox>
                                    @if (AllowColumnEdit)
                                    {
                                        <span class="m-grid-columns-tools">
                                            @ToolButton("vertical-align-top", -90, $"Pin {column.Title} to the left", column.Fixed == GridFixed.Left, false, () => Pin(column, column.Fixed == GridFixed.Left ? GridFixed.None : GridFixed.Left))
                                            @ToolButton("vertical-align-top", 90, $"Pin {column.Title} to the right", column.Fixed == GridFixed.Right, false, () => Pin(column, column.Fixed == GridFixed.Right ? GridFixed.None : GridFixed.Right))
                                            @ToolButton("arrow-up", 0, $"Move {column.Title} up", false, first, () => Move(column, -1))
                                            @ToolButton("arrow-down", 0, $"Move {column.Title} down", false, last, () => Move(column, 1))
                                        </span>
                                    }
                                </li>
                            }
                        </ul>
                    </ContentTemplate>
                    <ChildContent>
                        <button type="button" class="ant-btn ant-btn-default m-table-columns-toggle" aria-label="Columns" title="Show, hide, pin and order columns"><Icon Type="setting" /><span>Columns</span></button>
                    </ChildContent>
                </Popover>
            }
            @if (Exportable)
            {
                <button type="button" class="ant-btn ant-btn-default m-grid-export" title="Export the rows (after search and filters) to a CSV file" @onclick="() => ExportAsync(_view)"><Icon Type="download" /><span>Export CSV</span></button>
            }
            @if (AllowAddRow)
            {
                <button type="button" class="ant-btn ant-btn-text ant-btn-icon-only m-grid-add" aria-label="@AddRowText" title="@($"{AddRowText} (Insert)")"
                        data-m-grid-add @onclick="AddRow"><Icon Type="plus" /></button>
            }
            <div class="m-table-toolbar-settings">
                @if (OnReload.HasDelegate)
                {
                    <button type="button" class="ant-btn ant-btn-text ant-btn-icon-only" aria-label="Reload" title="Reload" @onclick="() => OnReload.InvokeAsync()"><Icon Type="reload" /></button>
                }
                <Dropdown Trigger="@(new[] { Trigger.Click })" Placement="Placement.BottomRight" OverlayClassName="m-table-more">
                    <Overlay>
                        <Menu Selectable="false" OnMenuItemClicked="OnMore">
                            @if (AllowColumnEdit)
                            {
                                <MenuItem Key="add-column" Icon="insert-row-right">Add column</MenuItem>
                                <MenuDivider />
                            }
                            <MenuItemGroup Title="Density">
                                @foreach (var (size, label) in Densities)
                                {
                                    <MenuItem Key="@($"density-{size}")" Class="@(_size == size ? "ant-dropdown-menu-item-selected" : null)">@label</MenuItem>
                                }
                            </MenuItemGroup>
                        </Menu>
                    </Overlay>
                    <ChildContent>
                        <button type="button" class="ant-btn ant-btn-text ant-btn-icon-only" aria-label="More actions" title="More actions"><Icon Type="more" /></button>
                    </ChildContent>
                </Dropdown>
            </div>
        </div>
    </div>

    @if (Filters is not null)
    {
        <div class="m-table-filters">@Filters</div>
    }
    else if (ClientFilters && GridSchema.FilterColumns(Columns) is { Count: > 0 } filterColumns)
    {
        <div class="m-table-filters">
            @foreach (var column in filterColumns)
            {
                var c = column;
                <Select TItemValue="string" TItem="string" Value="@_filters.GetValueOrDefault(c.Key)" ValueChanged="v => FilterChanged(c.Key, v)"
                        Placeholder="@($"Any {c.Title.ToLowerInvariant()}")" AllowClear aria-label="@c.Title">
                    <SelectOptions>
                        @foreach (var o in GridSchema.FilterOptions(c))
                        {
                            <SelectOption TItemValue="string" TItem="string" Value="@o.Value" Label="@o.Label" />
                        }
                    </SelectOptions>
                </Select>
            }
            @* The toolbar's Clear resets them. *@
        </div>
    }

    @if (Selectable && _selected.Count > 0)
    {
        var batchColumns = BatchColumns;
        <Alert Type="@AlertType.Info" Class="m-table-alert m-grid-batch" ShowIcon="false">
            <MessageTemplate>
                <span>Selected <strong>@_selected.Count</strong> @(_selected.Count == 1 ? "row" : "rows")</span>
                <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" OnClick="ClearSelection">Clear</Button>
                <span class="m-spacer"></span>
                @if (batchColumns.Count > 0)
                {
                    <select class="m-select m-grid-batch-set" aria-label="Set a value on the selected rows" @key="_batchVersion" @onchange="SetSelectedAsync">
                        <option value="">Set value…</option>
                        @foreach (var c in batchColumns)
                        {
                            <optgroup label="@c.Title">
                                @foreach (var o in GridSchema.FilterOptions(c))
                                {
                                    <option value="@($"{c.Key}={o.Value}")">@o.Label</option>
                                }
                            </optgroup>
                        }
                    </select>
                }
                @BatchActions?.Invoke(_selected.ToList())
                <button type="button" class="ant-btn ant-btn-default ant-btn-sm" @onclick="() => ExportAsync(_selected)"><Icon Type="download" /><span>Export selected</span></button>
                @if (AllowDeleteRow)
                {
                    <Popconfirm Title="@($"Delete {_selected.Count} {(_selected.Count == 1 ? "row" : "rows")}?")" OkText="Delete" OkButtonProps="@(new ButtonProps { Danger = true })" OnConfirm="DeleteSelectedAsync">
                        <button type="button" class="ant-btn ant-btn-default ant-btn-dangerous ant-btn-sm" data-m-grid-delete-selected><Icon Type="delete" /><span>Delete</span></button>
                    </Popconfirm>
                }
            </MessageTemplate>
        </Alert>
    }

    @if (_errors.Count > 0)
    {
        <Alert Type="@AlertType.Error" Class="m-table-alert" ShowIcon="true" Message="@($"{_errors.Count} {(_errors.Count == 1 ? "cell needs" : "cells need")} attention before saving.")" />
    }

    @* Rows drag by their handle (modulus-plugins.js reports the move through the hidden input; the grid reorders Rows). *@
    <div class="m-sort-rows" data-m-sort-rows="@(RowDraggable ? _gridId : null)" data-m-sort-root="@RowDraggable" data-m-sort-mode="@(RowDraggable ? "event" : null)"
         data-m-sort-disabled="@(RowDraggable && DragLocked)" data-m-sort-title="@(RowDraggable ? HeaderTitle : null)">
    @if (RowDraggable)
    {
        <input type="hidden" data-m-sort-result @onchange="RowMovedAsync" />
        @((MarkupString)SortableHtml.RowsHelp(HelpId))
    }
    <CascadingValue Value="HeaderScope">
    <Table @key="_schemaVersion"
           TItem="GridRecord"
           DataSource="_view"
           RowKey="r => r.Id"
           Size="_size"
           ScrollX="@GridSchema.ScrollWidth(Columns, (RowDetail is null ? 0 : 48) + (Selectable ? 48 : 0) + (AllowDeleteRow ? 64 : 0) + (RowDraggable ? SortableHtml.RowHandleWidth : 0)).ToString(CultureInfo.InvariantCulture)"
           HidePagination="!Paged"
           PageSize="@(Paged ? _pageSize : Math.Max(1, _view.Length))"
           PageIndex="_pageIndex"
           PageIndexChanged="i => _pageIndex = i"
           PageSizeChanged="s => _pageSize = s"
           PaginationTemplate="Pager"
           ExpandTemplate="ExpandFragment"
           RowExpandable="RowExpandableFor"
           SelectedRows="_selected"
           SelectedRowsChanged="rows => _selected = rows.ToList()"
           RowClassName="@(r => r.Data.Id == _newRowId ? "m-grid-row-new" : _changedRows.Contains(r.Data.Id) ? "m-grid-row-dirty" : "")">
        <ChildContent>
            @if (RowDraggable)
            {
                <ActionColumn Title="" Width="@SortableHtml.RowHandleWidth.ToString(CultureInfo.InvariantCulture)" Align="ColumnAlign.Center" Class="m-row-drag-cell"
                              Fixed="@(Columns.Any(c => !c.Hidden && c.Fixed == GridFixed.Left) ? ColumnFixPlacement.Left : null)">
                    @((MarkupString)SortableHtml.RowHandle(context.Id, RowLabel(context), HelpId, DragLocked))
                </ActionColumn>
            }
            @if (Selectable)
            {
                <Selection Width="48" Fixed="@(Columns.Any(c => !c.Hidden && c.Fixed == GridFixed.Left) ? ColumnFixPlacement.Left : null)" />
            }
            @foreach (var column in GridSchema.Visible(Columns))
            {
                var c = column;
                <ActionColumn Title="@c.Title" Width="@((c.Width ?? 150).ToString(CultureInfo.InvariantCulture))"
                              Fixed="@Fix(c.Fixed)" Align="@(c.AlignRight ? ColumnAlign.Right : ColumnAlign.Left)" Class="@TdClass(c)">
                    <TitleTemplate>
                        <ColumnHeader Key="@c.Key" Title="@c.Title" Kind="GridSchema.Kind(c)" Required="c.Required" Sortable="Sortable" Searchable="ColumnSearchable" Choices="GridSchema.SearchChoices(c)">
                            @if (AllowColumnEdit)
                            {
                                <Dropdown Trigger="@(new[] { Trigger.Click })" Placement="Placement.BottomRight">
                                    <Overlay>
                                        <Menu Selectable="false">
                                            @if (c.Fixed != GridFixed.Left) { <MenuItem Icon="pushpin" OnClick="() => Pin(c, GridFixed.Left)">Pin left</MenuItem> }
                                            @if (c.Fixed != GridFixed.Right) { <MenuItem Icon="pushpin" OnClick="() => Pin(c, GridFixed.Right)">Pin right</MenuItem> }
                                            @if (c.Fixed != GridFixed.None) { <MenuItem Icon="close" OnClick="() => Pin(c, GridFixed.None)">Unpin</MenuItem> }
                                            <MenuDivider />
                                            <MenuItem Icon="arrow-left" OnClick="() => Move(c, -1)">Move left</MenuItem>
                                            <MenuItem Icon="arrow-right" OnClick="() => Move(c, 1)">Move right</MenuItem>
                                            <MenuItem Icon="eye-invisible" OnClick="() => SetHidden(c, true)">Hide column</MenuItem>
                                            <MenuDivider />
                                            <MenuItem Icon="delete" Class="ant-dropdown-menu-item-danger" OnClick="() => RemoveColumn(c)">Remove column</MenuItem>
                                        </Menu>
                                    </Overlay>
                                    <ChildContent>
                                        <button type="button" class="m-grid-th-menu" aria-label="@($"{c.Title} column options")"><Icon Type="more" /></button>
                                    </ChildContent>
                                </Dropdown>
                            }
                        </ColumnHeader>
                    </TitleTemplate>
                    <ChildContent>
                        @Cell(context, c)
                    </ChildContent>
                </ActionColumn>
            }
            @if (AllowDeleteRow)
            {
                <ActionColumn Title="" Width="64" Fixed="ColumnFixPlacement.Right" Align="ColumnAlign.Center" Class="m-grid-actions">
                    <Popconfirm Title="@("Delete this row?")" OkText="Delete" OkButtonProps="@(new ButtonProps { Danger = true })" OnConfirm="() => DeleteRow(context)">
                        <button type="button" class="ant-btn ant-btn-text ant-btn-sm ant-btn-icon-only ant-btn-dangerous" aria-label="Delete row" title="Delete row"><Icon Type="delete" /></button>
                    </Popconfirm>
                </ActionColumn>
            }
        </ChildContent>
    </Table>
    </CascadingValue>
    </div>

    @if (Summary is not null)
    {
        <div class="m-grid-summary">@Summary</div>
    }
</Card>

<Modal Title="@("Add column")" Visible="_addColumnOpen" VisibleChanged="v => _addColumnOpen = v" Footer="@AddColumnFooter" Width="480" DestroyOnClose>
    <div class="ant-form ant-form-vertical">
        @* The Add button is never disabled: the Input only binds on keystrokes (not paste), so a disabled button
           could stay stuck. A blank title shows a message instead. *@
        <div class="@($"ant-form-item{(_newTitleError is null ? "" : " ant-form-item-has-error")}")">
            <div class="ant-form-item-label"><label for="m-grid-new-title" class="ant-form-item-required">Title</label></div>
            <Input Id="m-grid-new-title" @bind-Value="_newTitle" Placeholder="e.g. Region" AutoFocus BindOnInput MaxLength="60"
                   OnPressEnter="AddColumn" />
            @if (_newTitleError is not null)
            {
                <div class="ant-form-item-explain ant-form-item-explain-error" role="alert">@_newTitleError</div>
            }
        </div>
        <div class="ant-form-item">
            <div class="ant-form-item-label"><label>Type</label></div>
            <Select TItem="GridCellType" TItemValue="GridCellType" DataSource="CellTypes" @bind-Value="_newType" LabelName="" ValueName="">
                <ItemTemplate>@TypeLabel(context)</ItemTemplate>
                <LabelTemplate>@TypeLabel(context)</LabelTemplate>
            </Select>
        </div>
        @if (_newType is GridCellType.Select or GridCellType.MultiSelect or GridCellType.Tag)
        {
            <div class="ant-form-item">
                <div class="ant-form-item-label"><label for="m-grid-new-options">Options</label></div>
                <TextArea Id="m-grid-new-options" @bind-Value="_newOptions" Rows="3" Placeholder="One per line, or comma-separated" />
            </div>
        }
        <div class="ant-form-item">
            <div class="ant-form-item-label"><label>Pin</label></div>
            <RadioGroup @bind-Value="_newFixed" ButtonStyle="RadioButtonStyle.Solid">
                <Radio RadioButton Value="GridFixed.None">None</Radio>
                <Radio RadioButton Value="GridFixed.Left">Left</Radio>
                <Radio RadioButton Value="GridFixed.Right">Right</Radio>
            </RadioGroup>
        </div>
        <div class="ant-form-item" style="margin-bottom: 0">
            <Checkbox Checked="_newRequired" CheckedChanged="v => _newRequired = v">Required</Checkbox>
        </div>
    </div>
</Modal>

@code {
    /// <summary>The schema. The grid edits the list in place (pin, hide, move, add, remove).</summary>
    [Parameter, EditorRequired] public List<GridColumn> Columns { get; set; } = [];

    /// <summary>The rows. The grid edits the list in place (cells, add, delete).</summary>
    [Parameter, EditorRequired] public List<GridRecord> Rows { get; set; } = [];

    [Parameter] public string? HeaderTitle { get; set; }

    [Parameter] public RenderFragment? TitleExtra { get; set; }

    /// <summary>Buttons shown before the grid's own actions.</summary>
    [Parameter] public RenderFragment? ToolBar { get; set; }

    /// <summary>Content of an expanded row. Without it rows do not expand.</summary>
    [Parameter] public RenderFragment<GridRecord>? RowDetail { get; set; }

    /// <summary>Which rows can expand (default: all, when <see cref="RowDetail"/> is set).</summary>
    [Parameter] public Func<GridRecord, bool>? RowExpandable { get; set; }

    /// <summary>Content under the table (totals, notes). Re-rendered on every edit.</summary>
    [Parameter] public RenderFragment? Summary { get; set; }

    [Parameter] public bool AllowAddRow { get; set; } = true;

    /// <summary>Tooltip of the add-row button ("Add style", say).</summary>
    [Parameter] public string AddRowText { get; set; } = "Add row";

    /// <summary>Disables the column searches (the nested grid, while a level has unsaved edits and searches on the server).</summary>
    [Parameter] public bool FiltersLocked { get; set; }

    /// <summary>Starts with the filter row (a box or select under each column header) shown; the toolbar's filter button still toggles it.</summary>
    [Parameter] public bool FilterRowOpen { get; set; }

    [Parameter] public bool AllowDeleteRow { get; set; } = true;

    /// <summary>Column menus, the column settings popover and "Add column".</summary>
    [Parameter] public bool AllowColumnEdit { get; set; } = true;

    /// <summary>Rows per page to start with; the pager also offers <see cref="Paging.Sizes"/>.</summary>
    [Parameter] public int PageSize { get; set; } = 10;

    /// <summary>
    /// A pager under the grid ("1–10 of 42", pages, rows per page), paging the rows after search and filters. Off for
    /// a grid whose rows are one page of a server list (the nested grid's levels page on the server).
    /// </summary>
    [Parameter] public bool Paged { get; set; } = true;

    [Parameter] public TableSize Size { get; set; } = TableSize.Middle;

    /// <summary>Called by Save when every cell is valid.</summary>
    [Parameter] public EventCallback OnSave { get; set; }

    /// <summary>Called by Discard; reload <see cref="Columns"/> and <see cref="Rows"/> from the store.</summary>
    [Parameter] public EventCallback OnDiscard { get; set; }

    /// <summary>Raised after any cell, row or column change.</summary>
    [Parameter] public EventCallback OnChange { get; set; }

    [Parameter] public string? Class { get; set; }

    /// <summary>A search box that narrows the rows to those whose visible text contains the keyword.</summary>
    [Parameter] public bool Searchable { get; set; } = true;

    /// <summary>A filter row with a dropdown for each <see cref="GridColumn.Filterable"/> column (filters in the browser).</summary>
    [Parameter] public bool ClientFilters { get; set; } = true;

    /// <summary>Your own filter row (replaces the built-in one; the nested grid filters on the server this way).</summary>
    [Parameter] public RenderFragment? Filters { get; set; }

    /// <summary>A checkbox column and a batch bar for the selected rows: set a value, export, delete.</summary>
    [Parameter] public bool Selectable { get; set; } = true;

    /// <summary>More actions in the batch bar; receives the selected rows.</summary>
    [Parameter] public RenderFragment<IReadOnlyList<GridRecord>>? BatchActions { get; set; }

    /// <summary>"Export CSV" (the rows shown) in the toolbar and "Export selected" in the batch bar.</summary>
    [Parameter] public bool Exportable { get; set; } = true;

    /// <summary>File name of the CSV export (default: the title).</summary>
    [Parameter] public string? ExportFileName { get; set; }

    /// <summary>The Columns button (show and hide columns) even when <see cref="AllowColumnEdit"/> is off.</summary>
    [Parameter] public bool AllowColumnHide { get; set; } = true;

    /// <summary>Drag a header's right edge to resize the column; the width is kept in <see cref="GridColumn.Width"/>.</summary>
    [Parameter] public bool Resizable { get; set; } = true;

    /// <summary>Shows a Reload button next to the density menu.</summary>
    [Parameter] public EventCallback OnReload { get; set; }

    /// <summary>Column headers sort the rows: ascending, descending, then unsorted (in the browser, or with <see cref="OnSort"/>).</summary>
    [Parameter] public bool Sortable { get; set; } = true;

    /// <summary>
    /// A drag handle on each row: drag it (or focus it and press Up, Down, Home, End) to reorder the rows. The move
    /// changes the order of <see cref="Rows"/> and counts as an unsaved change. Locked while a column sort is on.
    /// </summary>
    [Parameter] public bool RowDraggable { get; set; } = true;

    /// <summary>Raised after a row has been dragged to a new place (Rows are already in the new order).</summary>
    [Parameter] public EventCallback<RowMove> OnRowMove { get; set; }

    /// <summary>A search icon in each column header for a search of that column (see <see cref="ColumnSearch"/>).</summary>
    [Parameter] public bool ColumnSearchable { get; set; } = true;

    /// <summary>Server sorting (the nested grid): receives the clicked column; <see cref="SortField"/> shows the result.</summary>
    [Parameter] public EventCallback<string> OnSort { get; set; }

    /// <summary>With <see cref="OnSort"/>: the column the rows are sorted by.</summary>
    [Parameter] public string? SortField { get; set; }

    [Parameter] public bool SortDescending { get; set; }

    /// <summary>Server column search: receives the column and its new search; <see cref="Searches"/> shows the result.</summary>
    [Parameter] public EventCallback<(string Key, string? Value)> OnColumnSearch { get; set; }

    /// <summary>With <see cref="OnColumnSearch"/>: the column searches applied.</summary>
    [Parameter] public IReadOnlyDictionary<string, string?>? Searches { get; set; }

    private string? _sortKey;
    private bool _sortDesc;
    private readonly Dictionary<string, string?> _searches = new(StringComparer.Ordinal);
    private ColumnHeaderScope? _headerScope;
    private string? _headerState;
    private int _headerVersion;

    // A new scope whenever the sort or a search changes re-renders the column headers (carets, search icons).
    private ColumnHeaderScope HeaderScope
    {
        get
        {
            var searches = OnColumnSearch.HasDelegate ? Searches ?? new Dictionary<string, string?>() : _searches;
            var state = $"{_filterRow}|{FiltersLocked}|{(OnSort.HasDelegate ? SortField : _sortKey)}|{(OnSort.HasDelegate ? SortDescending : _sortDesc)}|{string.Join('|', searches.Select(s => $"{s.Key}={s.Value}"))}";
            if (_headerScope is null || state != _headerState)
            {
                _headerState = state;
                _headerScope = new ColumnHeaderScope(this, ++_headerVersion, _filterRow, FiltersLocked);
            }
            return _headerScope;
        }
    }

    public Modulus.Ui.Abstractions.SortDirection SortOf(string key) =>
        (OnSort.HasDelegate ? SortField : _sortKey) != key ? Modulus.Ui.Abstractions.SortDirection.None
        : (OnSort.HasDelegate ? SortDescending : _sortDesc) ? Modulus.Ui.Abstractions.SortDirection.Descending
        : Modulus.Ui.Abstractions.SortDirection.Ascending;

    public string? SearchOf(string key) => OnColumnSearch.HasDelegate ? Searches?.GetValueOrDefault(key) : _searches.GetValueOrDefault(key);

    async Task IColumnHeaderHost.SortAsync(string key)
    {
        if (OnSort.HasDelegate)
        {
            await OnSort.InvokeAsync(key);
            return;
        }
        (_sortKey, _sortDesc) = ColumnSearch.NextSort(SortOf(key)) switch
        {
            Modulus.Ui.Abstractions.SortDirection.Ascending => (key, false),
            Modulus.Ui.Abstractions.SortDirection.Descending => (key, true),
            _ => ((string?)null, false),
        };
        FirstPage();
        await RowsChangedAsync();
    }

    async Task IColumnHeaderHost.SearchAsync(string key, string? value)
    {
        if (OnColumnSearch.HasDelegate)
        {
            await OnColumnSearch.InvokeAsync((key, value));
            return;
        }
        _searches[key] = value;
        FirstPage();
        await RowsChangedAsync();
    }

    private string? _keyword;
    private bool _searchOpen, _filterRow;
    // Rows changed since the last save (marked in the grid) and rows deleted, for the "3 unsaved changes" count.
    private readonly HashSet<string> _changedRows = new(StringComparer.Ordinal);
    private int _deletedRows;
    private readonly Dictionary<string, string?> _filters = new(StringComparer.Ordinal);
    private readonly HashSet<string> _addedIds = new(StringComparer.Ordinal);
    private List<GridRecord> _selected = [];
    private int _batchVersion;
    private DotNetObjectReference<EditableGrid>? _self;
    private static readonly RenderFragment SearchIcon = @<Icon Type="search" />;

    private bool Filtered => _filters.Values.Any(v => !string.IsNullOrEmpty(v)) || _searches.Values.Any(v => !string.IsNullOrWhiteSpace(v));

    // The toolbar's Clear: anything the grid filters by in the browser, the keyword included.
    private bool AnyFilter => Filtered || !string.IsNullOrWhiteSpace(_keyword);

    // Rows added here stay visible (and on top) whatever the search and sort, so a new row never vanishes while it is filled in.
    private GridRecord[] Shown()
    {
        IEnumerable<GridRecord> rows = string.IsNullOrWhiteSpace(_keyword) && !Filtered
            ? Rows
            : Rows.Where(r => _addedIds.Contains(r.Id) || GridSchema.Matches(Columns, r, _keyword, _filters, searches: _searches));
        if (OnSort.HasDelegate || _sortKey is null || GridSchema.Find(Columns, _sortKey) is not { Hidden: false } column) return [.. rows];
        var list = rows.ToList();
        return [.. list.Where(r => _addedIds.Contains(r.Id)), .. GridSchema.Sort(list.Where(r => !_addedIds.Contains(r.Id)), column, _sortDesc)];
    }

    private bool SearchShown => _searchOpen || !string.IsNullOrEmpty(_keyword);

    // An empty search box folds back into its icon.
    private void SearchBlur()
    {
        if (string.IsNullOrEmpty(_keyword)) _searchOpen = false;
    }

    /// <summary>Rows edited, added or deleted since the last save (not column layout: hiding, pinning or moving one).</summary>
    public bool HasRowChanges => _changedRows.Count + _deletedRows > 0;

    private string ChangesText => (_changedRows.Count + _deletedRows) switch
    {
        0 => "Unsaved changes",
        1 => "1 unsaved change",
        var n => $"{n} unsaved changes",
    };

    private static readonly (TableSize Size, string Label)[] Densities =
        [(TableSize.Default, "Comfortable"), (TableSize.Middle, "Standard"), (TableSize.Small, "Compact")];

    private void OnMore(MenuItem item)
    {
        switch (item.Key)
        {
            case "add-column":
                _newTitleError = null;
                _addColumnOpen = true;
                break;
            default:
                if (item.Key.StartsWith("density-", StringComparison.Ordinal) && Enum.TryParse<TableSize>(item.Key["density-".Length..], out var size)) _size = size;
                break;
        }
    }

    // A deleted row that was added here leaves no change behind; a stored row counts as one.
    private void Forget(string id)
    {
        if (!_addedIds.Remove(id)) _deletedRows++;
        _changedRows.Remove(id);
    }

    private async Task SearchChanged(string? keyword)
    {
        _keyword = keyword;
        FirstPage();
        await RowsChangedAsync();
    }

    private async Task FilterChanged(string key, string? value)
    {
        _filters[key] = value;
        FirstPage();
        await RowsChangedAsync();
    }

    private async Task ClearFilters()
    {
        _filters.Clear();
        _searches.Clear();
        _keyword = null;
        _searchOpen = false;
        FirstPage();
        await RowsChangedAsync();
    }

    // The batch bar's "Set value" choices: editable Select, Tag and Switch columns.
    private IReadOnlyList<GridColumn> BatchColumns =>
        [.. Columns.Where(c => c.Editable && c.Type is GridCellType.Select or GridCellType.Tag or GridCellType.Switch)];

    private void ClearSelection() => _selected = [];

    private async Task SetSelectedAsync(ChangeEventArgs e)
    {
        var choice = e.Value?.ToString() ?? "";
        var at = choice.IndexOf('=');
        _batchVersion++;
        if (at <= 0 || GridSchema.Find(Columns, choice[..at]) is not { } column) return;
        foreach (var row in _selected.ToList()) await SetValue(row, column, choice[(at + 1)..]);
    }

    private async Task DeleteSelectedAsync()
    {
        var ids = _selected.Select(r => r.Id).ToHashSet(StringComparer.Ordinal);
        Rows.RemoveAll(r => ids.Contains(r.Id));
        foreach (var id in ids) Forget(id);
        foreach (var key in _errors.Keys.Where(k => ids.Contains(k.Row)).ToList()) _errors.Remove(key);
        _selected = [];
        await ChangedAsync();
        await RowsChangedAsync();
    }

    private async Task ExportAsync(IEnumerable<GridRecord> rows)
    {
        var name = $"{ExportFileName ?? HeaderTitle ?? "grid"}.csv";
        try
        {
            await JS.InvokeVoidAsync("modulusShell.download", name, GridSchema.Csv(GridSchema.Visible(Columns), rows));
        }
        catch (JSException)
        {
            // Script not loaded (tests): nothing to save to.
        }
    }

    /// <summary>Called by modulus-shell.js when a column has been dragged to a new width.</summary>
    [JSInvokable]
    public void OnColumnResized(string key, int width)
    {
        if (GridSchema.Find(Columns, key) is not { } column) return;
        column.Width = Math.Clamp(width, 60, 600);
        StateHasChanged();
    }

    public void Dispose() => _self?.Dispose();

    private TableSize _size;
    private int _schemaVersion;
    private (string Row, string Key)? _editing;
    private bool _popupOpen;
    private readonly string _gridId = "m-grid-" + Guid.NewGuid().ToString("N")[..8];
    private bool _openPopup;
    private string? _original;
    // A fresh array whenever rows come and go: Table only notices a new DataSource, not an insert into the same list.
    private GridRecord[] _view = [];
    private List<GridRecord>? _viewOf;
    private int _viewCount;

    private int _pageIndex = 1, _pageSize = 10;

    // The data table's pager: the range, the page window with ••• jumps, and rows per page.
    private RenderFragment<(int PageSize, int PageIndex, int Total, string PaginationClass, EventCallback<PaginationEventArgs> HandlePageChange)> Pager => p =>
        @<Pagination Class="@($"{p.PaginationClass} m-grid-pager")" Total="p.Total" PageSize="p.PageSize" Current="p.PageIndex" Size="PaginationSize.Small"
                     ShowSizeChanger="true" PageSizeOptions="@Paging.SizesWith(PageSize).ToArray()" OnChange="p.HandlePageChange" ShowTotal="PagerTotal" />;

    private static readonly Func<PaginationTotalContext, string> PagerTotal = ctx =>
        $"{ctx.Range.Item1.ToString("N0", CultureInfo.CurrentCulture)}–{ctx.Range.Item2.ToString("N0", CultureInfo.CurrentCulture)} of {ctx.Total.ToString("N0", CultureInfo.CurrentCulture)}";

    // Search, filters, sorting and a new row (added on top) start again from the first page.
    private void FirstPage() => _pageIndex = 1;

    // While a row is expanded, Table shows the new DataSource only on the render after the one that hands it over.
    private async Task RowsChangedAsync()
    {
        _view = Shown();
        _pageIndex = Paging.Clamp(_pageIndex, _view.Length, _pageSize);
        _viewCount = Rows.Count;
        await Task.Yield();
        StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_viewOf, Rows) || _viewCount != Rows.Count)
        {
            if (!ReferenceEquals(_viewOf, Rows)) _selected = [];
            _view = Shown();
            _viewOf = Rows;
            _pageIndex = Paging.Clamp(_pageIndex, _view.Length, _pageSize);
        }
        _viewCount = Rows.Count;
    }
    private string? _newRowId;
    private bool _dirty;
    private bool _saving;
    private Dictionary<(string Row, string Key), string> _errors = [];

    private bool _addColumnOpen;
    private string? _newTitle;
    private string? _newTitleError;
    private RenderFragment AddColumnFooter => @<div class="m-row" style="justify-content:flex-end">
        <Button OnClick="() => _addColumnOpen = false">Cancel</Button>
        <Button Type="@ButtonType.Primary" OnClick="AddColumn">Add column</Button>
    </div>;
    private GridCellType _newType;
    private string? _newOptions;
    private GridFixed _newFixed;
    private bool _newRequired;

    private static readonly GridCellType[] CellTypes = Enum.GetValues<GridCellType>();

    protected override void OnInitialized()
    {
        _size = Size;
        _pageSize = Math.Max(1, PageSize);
        _filterRow = FilterRowOpen && ColumnSearchable;
    }

    /// <summary>Marks the grid clean (after the parent saved or reloaded) and clears errors.</summary>
    public void MarkSaved()
    {
        _dirty = false;
        _errors = [];
        _editing = null;
        _newRowId = null;
        _addedIds.Clear();
        _changedRows.Clear();
        _deletedRows = 0;
        _selected = [];
        _schemaVersion++;
        _view = Shown();
        StateHasChanged();
    }

    private RenderFragment<RowData<GridRecord>>? ExpandFragment => RowDetail is null ? null : row => RowDetail(row.Data);

    private bool RowExpandableFor(RowData<GridRecord> row) => RowDetail is not null && (RowExpandable?.Invoke(row.Data) ?? true);

    private static ColumnFixPlacement? Fix(GridFixed f) => f switch
    {
        GridFixed.Left => ColumnFixPlacement.Left,
        GridFixed.Right => ColumnFixPlacement.Right,
        _ => null,
    };

    // Yes/no columns read best centred; the sorted column keeps Ant Design's tint.
    private string TdClass(GridColumn c) =>
        "m-grid-td" + (c.Type == GridCellType.Switch ? " m-grid-td-center" : "") +
        (SortOf(c.Key) == Modulus.Ui.Abstractions.SortDirection.None ? "" : " ant-table-column-sort");

    private static string TypeLabel(GridCellType t) => t switch
    {
        GridCellType.MultiSelect => "Multi-select",
        GridCellType.Tag => "Tag (status)",
        _ => t.ToString(),
    };

    private RenderFragment ToolButton(string icon, int rotate, string label, bool active, bool disabled, Func<Task> onClick) => __builder =>
    {
        <button type="button" class="@($"m-grid-tool{(active ? " m-grid-tool-active" : "")}")" aria-label="@label" title="@label" aria-pressed="@(active ? "true" : null)"
                disabled="@disabled" @onclick="onClick">
            <Icon Type="@icon" Rotate="rotate" />
        </button>
    };

    // ---- Cells ----

    private RenderFragment Cell(GridRecord row, GridColumn c) => __builder =>
    {
        var value = row[c.Key];
        var error = _errors.GetValueOrDefault((row.Id, c.Key));
        var editing = _editing == (row.Id, c.Key);
        var direct = c.Type is GridCellType.Switch or GridCellType.Rating;
        var cls = $"m-grid-cell{(c.Editable && !direct ? " m-grid-cell-editable" : "")}{(error is not null ? " m-grid-cell-error" : "")}{(editing ? " m-grid-cell-editing" : "")}";

        if (editing && c.Editable)
        {
            <div class="@cls" @onkeydown="e => OnEditorKey(e)">@Editor(row, c)</div>
        }
        else
        {
            <div class="@cls" title="@error" tabindex="@(c.Editable && !direct ? 0 : -1)" role="@(c.Editable && !direct ? "button" : null)"
                 aria-label="@(c.Editable && !direct ? $"Edit {c.Title}: {GridSchema.Format(c, value)}" : null)"
                 @onclick="() => BeginEdit(row, c)" @onkeydown="e => OnCellKey(e, row, c)">
                @View(row, c, value)
            </div>
        }
        if (error is not null)
        {
            <div class="m-grid-cell-message" role="alert">@error</div>
        }
    };

    private RenderFragment View(GridRecord row, GridColumn c, string? value) => __builder =>
    {
        switch (c.Type)
        {
            case GridCellType.Switch:
                <Switch Size="InputSize.Small" Checked="GridSchema.Flag(value)" Disabled="!c.Editable" CheckedChanged="v => SetValue(row, c, GridSchema.FromFlag(v))" />
                break;
            case GridCellType.Rating:
                <Rate Value="(decimal)(GridSchema.Number(value) ?? 0)" Count="(int)(c.Max ?? 5)" Disabled="!c.Editable" Class="m-grid-rate"
                      ValueChanged="(decimal v) => SetValue(row, c, GridSchema.FromNumber(v))" />
                break;
            case GridCellType.Tag when GridSchema.Option(c, value) is { } tag:
                <Tag Color="@(tag.Color ?? "default")">@if (tag.Icon is not null) {<Icon Type="@tag.Icon" />}@tag.Label</Tag>
                break;
            case GridCellType.MultiSelect when GridSchema.Many(value).Count > 0:
                <span class="m-grid-tags">
                    @foreach (var v in GridSchema.Many(value))
                    {
                        var o = GridSchema.Option(c, v);
                        <Tag Color="@(o?.Color ?? "default")">@if (o?.Icon is not null) {<Icon Type="@o.Icon" />}@(o?.Label ?? v)</Tag>
                    }
                </span>
                break;
            case GridCellType.Progress when GridSchema.Number(value) is { } p:
                <Progress Percent="(double)p" Size="ProgressSize.Small" Status="@(p >= 100 ? ProgressStatus.Success : ProgressStatus.Normal)" />
                break;
            default:
                var text = GridSchema.Format(c, value);
                var icon = c.Type == GridCellType.Select ? GridSchema.Option(c, value)?.Icon : null;
                if (string.IsNullOrEmpty(text))
                {
                    <span class="m-grid-empty">@(c.Editable ? "Add" : "—")</span>
                }
                else if (c.Avatar || c.SubtitleKey is not null)
                {
                    var subtitle = c.SubtitleKey is { } sub ? row[sub] : null;
                    <span class="m-grid-entity">
                        @if (c.Avatar)
                        {
                            <span class="@($"m-avatar m-grid-avatar m-av-{GridSchema.Tint(text)}")" aria-hidden="true">@GridSchema.Initials(text)</span>
                        }
                        <span class="m-grid-entity-text">
                            <span class="m-grid-entity-title">@if (icon is not null) {<Icon Type="@icon" />}@text</span>
                            @if (!string.IsNullOrEmpty(subtitle))
                            {
                                <span class="m-grid-entity-desc">@subtitle</span>
                            }
                        </span>
                    </span>
                }
                else if (icon is not null)
                {
                    <span class="m-grid-icon-text"><Icon Type="@icon" />@text</span>
                }
                else
                {
                    <span class="@(c.AlignRight ? "m-num" : null)">@text</span>
                }
                break;
        }
    };

    private RenderFragment Editor(GridRecord row, GridColumn c) => __builder =>
    {
        var value = row[c.Key];
        switch (c.Type)
        {
            case GridCellType.Number or GridCellType.Currency or GridCellType.Percent or GridCellType.Progress:
                @* A native number input, as in the MVC grid: AntD's InputNumber drops text it cannot parse or clamp,
                   so a bad value would never reach the shared validator and its message. *@
                <div @onfocusout="EndEdit">
                    <input type="number" class="ant-input m-num" step="any" inputmode="decimal" value="@value" aria-label="@c.Title"
                           min="@c.Min?.ToString(CultureInfo.InvariantCulture)" max="@c.Max?.ToString(CultureInfo.InvariantCulture)"
                           @oninput="e => SetValue(row, c, e.Value?.ToString())" />
                </div>
                break;
            case GridCellType.Date:
                <DatePicker TValue="DateTime?" Value="GridSchema.Date(value)?.ToDateTime(TimeOnly.MinValue)" AutoFocus Style="width: 100%"
                            ValueChanged="async v => { await SetValue(row, c, GridSchema.FromDate(v)); EndEdit(); }"
                            OnOpenChange="OnPopupChange" />
                break;
            case GridCellType.Select or GridCellType.Tag:
                @* AppCreatableSelect ends its dropdown with an "Add option" row; a new option joins the column's schema. *@
                <AppCreatableSelect Options="c.Options" OptionsChanged="o => OptionsChangedAsync(c, o)" Value="@value" AllowClear="!c.Required"
                                    DefaultOpen Style="width: 100%" AriaLabel="@c.Title" AddPlaceholder="New option" CreateText="@($"Create new {c.Title.ToLowerInvariant()}")"
                                    ValueChanged="v => SetValue(row, c, v)" OpenChanged="OnCreatableOpenChange" />
                break;
            case GridCellType.MultiSelect:
                <AppCreatableSelect Options="c.Options" OptionsChanged="o => OptionsChangedAsync(c, o)" Multiple Values="GridSchema.Many(value)"
                                    DefaultOpen Style="width: 100%" AriaLabel="@c.Title" AddPlaceholder="New option" CreateText="@($"Create new {c.Title.ToLowerInvariant()}")"
                                    ValuesChanged="v => SetValue(row, c, GridSchema.FromMany(v))" OpenChanged="OnCreatableOpenChange" />
                break;
            default:
                <div @onfocusout="EndEdit">
                    <Input TValue="string" Value="value" AutoFocus BindOnInput MaxLength="500" aria-label="@c.Title"
                           ValueChanged="v => SetValue(row, c, v)" OnPressEnter="EndEdit" />
                </div>
                break;
        }
    };

    private void BeginEdit(GridRecord row, GridColumn c)
    {
        if (!c.Editable || c.Type is GridCellType.Switch or GridCellType.Rating) return;
        _editing = (row.Id, c.Key);
        _original = row[c.Key];
        // Select and DatePicker have no open API that works on first render, and InputNumber ignores AutoFocus:
        // once rendered, JS clicks the popup open or focuses the input.
        _popupOpen = false;
        _openPopup = true;
    }

    // Leaving a cell validates it, like the MVC grid, so a bad value is flagged before Save.
    private void EndEdit()
    {
        if (_editing is { } at && Rows.Find(r => r.Id == at.Row) is { } row && GridSchema.Find(Columns, at.Key) is { } column)
        {
            if (GridSchema.ValidateCell(column, row[column.Key]) is { } message) _errors[at] = message;
            else _errors.Remove(at);
        }
        _editing = null;
        _original = null;
        _popupOpen = _openPopup = false;
    }

    // Escape puts the value back.
    private async Task CancelEdit()
    {
        if (_editing is { } at && Rows.Find(r => r.Id == at.Row) is { } row && row[at.Key] != _original)
        {
            row[at.Key] = _original;
            await ChangedAsync();
        }
        _editing = null;
        _original = null;
        _popupOpen = _openPopup = false;
    }

    // Closing the popup (a pick, Escape or a click outside) ends the edit.
    private void OnPopupChange(bool open)
    {
        if (!open && _popupOpen) EndEdit();
    }

    private void OnCreatableOpenChange(bool open)
    {
        if (!open) EndEdit();
    }

    private async Task OptionsChangedAsync(GridColumn c, IReadOnlyList<GridOption> options)
    {
        c.Options = options;
        await ChangedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Resizable)
        {
            _self = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("modulusShell.watchResize", _gridId, _self);
            }
            catch (JSException)
            {
                // Script not loaded (tests, prerender): columns keep their widths.
            }
        }
        if (_openPopup && _editing is not null)
        {
            _openPopup = false;
            _popupOpen = true;
            try
            {
                await JS.InvokeVoidAsync("modulusShell.openPopup", _gridId);
            }
            catch (JSException)
            {
                // Script not loaded (tests, prerender): the control is still focused and opens on click.
            }
        }
    }

    private void OnCellKey(KeyboardEventArgs e, GridRecord row, GridColumn c)
    {
        if (e.Key is "Enter" or "F2") BeginEdit(row, c);
    }

    private async Task OnEditorKey(KeyboardEventArgs e)
    {
        if (e.Key is "Escape") await CancelEdit();
        else if (e.Key is "Enter" && _editing is { } at && GridSchema.Find(Columns, at.Key)?.Type is GridCellType.Number or GridCellType.Currency or GridCellType.Percent or GridCellType.Progress)
            EndEdit();
    }

    private async Task SetValue(GridRecord row, GridColumn c, string? value)
    {
        // Switch and Rate report their value again when re-rendered: only a real change marks the grid dirty.
        var normalized = GridSchema.Normalize(c, value);
        if (normalized == row[c.Key]) return;
        row[c.Key] = normalized;
        _changedRows.Add(row.Id);
        // Re-validate the cell once it has been flagged, so the message clears as soon as it is fixed.
        if (_errors.ContainsKey((row.Id, c.Key)))
        {
            if (GridSchema.ValidateCell(c, row[c.Key]) is { } message) _errors[(row.Id, c.Key)] = message;
            else _errors.Remove((row.Id, c.Key));
        }
        await ChangedAsync();
    }

    // ---- Rows ----

    private string HelpId => $"{_gridId}-drag-help";

    // A column sort decides the order then, so a drop would not stay where it was put.
    private bool DragLocked => OnSort.HasDelegate ? SortField is not null : _sortKey is not null;

    // Read out when a row moves: its first column.
    private string RowLabel(GridRecord row) =>
        GridSchema.Visible(Columns).FirstOrDefault() is { } first && GridSchema.Format(first, row[first.Key]) is { Length: > 0 } text ? text : "row";

    // The rows on the page shown, in their order: the drop's index counts these.
    private IEnumerable<GridRecord> PageRows() =>
        Paged ? _view.Skip(Math.Max(0, _pageIndex - 1) * _pageSize).Take(_pageSize) : _view;

    private async Task RowMovedAsync(ChangeEventArgs e)
    {
        if (DragLocked || !SortMove.TryParse(e.Value?.ToString(), out var move)) return;
        // Only the page's rows swap places: rows on other pages or filtered out keep theirs.
        var order = move.Within(PageRows().Select(r => r.Id));
        GridSchema.Reorder(Rows, order, r => r.Id);
        _changedRows.Add(move.Id);
        await ChangedAsync();
        await OnRowMove.InvokeAsync(new RowMove(move.Id, move.Index, order));
        await RowsChangedAsync();
    }

    private async Task AddRow()
    {
        var row = GridSchema.NewRow(Columns, Rows);
        Rows.Insert(0, row);
        FirstPage(); // the new row is on top
        _newRowId = row.Id;
        _addedIds.Add(row.Id);
        _changedRows.Add(row.Id);
        if (GridSchema.Visible(Columns).FirstOrDefault(c => c.Editable && c.Type is not (GridCellType.Switch or GridCellType.Rating)) is { } first)
            BeginEdit(row, first);
        await ChangedAsync();
        await RowsChangedAsync();
    }

    private async Task DeleteRow(GridRecord row)
    {
        Rows.Remove(row);
        _selected.Remove(row);
        Forget(row.Id);
        foreach (var key in _errors.Keys.Where(k => k.Row == row.Id).ToList()) _errors.Remove(key);
        await ChangedAsync();
        await RowsChangedAsync();
    }

    // ---- Columns ----

    private async Task Pin(GridColumn c, GridFixed where) { GridSchema.Pin(Columns, c.Key, where); await SchemaChangedAsync(); }

    private async Task SetHidden(GridColumn c, bool hidden) { GridSchema.SetHidden(Columns, c.Key, hidden); await SchemaChangedAsync(); }

    private async Task Move(GridColumn c, int delta) { GridSchema.Move(Columns, c.Key, delta); await SchemaChangedAsync(); }

    private async Task RemoveColumn(GridColumn c)
    {
        GridSchema.Remove(Columns, Rows, c.Key);
        foreach (var key in _errors.Keys.Where(k => k.Key == c.Key).ToList()) _errors.Remove(key);
        await SchemaChangedAsync();
    }

    private async Task AddColumn()
    {
        if (GridSchema.Add(Columns, _newTitle, _newType, _newOptions, _newFixed, _newRequired) is null)
        {
            _newTitleError = string.IsNullOrWhiteSpace(_newTitle) ? "Enter a column title." : $"A grid can have at most {GridSchema.MaxColumns} columns.";
            return;
        }
        _newTitleError = null;
        _addColumnOpen = false;
        _newTitle = _newOptions = null;
        _newType = GridCellType.Text;
        _newFixed = GridFixed.None;
        _newRequired = false;
        await SchemaChangedAsync();
    }

    private async Task SchemaChangedAsync()
    {
        _schemaVersion++;
        _editing = null;
        await ChangedAsync();
    }

    private async Task ChangedAsync()
    {
        _dirty = true;
        await OnChange.InvokeAsync();
    }

    // ---- Save ----

    private async Task SaveAsync()
    {
        _editing = null;
        _errors = GridSchema.Validate(Columns, Rows).ToDictionary(e => (e.RowId, e.Key), e => e.Message);
        if (_errors.Count > 0) return;
        _saving = true;
        try
        {
            await OnSave.InvokeAsync();
            _dirty = false;
            _newRowId = null;
            _addedIds.Clear();
            _changedRows.Clear();
            _deletedRows = 0;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DiscardAsync()
    {
        await OnDiscard.InvokeAsync();
        MarkSaved();
    }

}

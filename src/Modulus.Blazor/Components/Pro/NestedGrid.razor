@*
    Nested, expandable editable grid driven by NestedGridSettings. Each level is an EditableGrid; a row that can
    expand renders another NestedGrid for the next level, which loads its rows the first time it is shown.
    Every level has its own columns (or column set picked by a parent field), search, filters, header sorting and
    column searches (all on the server), paging, editing and Save. The number of levels in the settings is the
    nesting limit. With <c>Settings.Tree</c> the grid is a tree: one level definition at every depth, rows expand only
    when <c>ChildCountField</c> says they have children, and <c>Rollup</c> totals show under each level.

    <NestedGrid Settings="_settings" Load="LoadAsync" Save="SaveAsync" />

    Task<NestedGridPage> LoadAsync(NestedGridRequest request)   // request.Level, request.ParentId, keyword, sort, page
    Task SaveAsync(NestedGridChanges changes)                    // rows on the page as edited, and deleted ids

    The MVC equivalent is <app-nested-grid>, which renders the same levels with htmx.
*@
@using System.Globalization

<div class="@($"m-nested m-nested-level-{Level}")">
    <EditableGrid @ref="_grid" Columns="_columns" Rows="_rows" HeaderTitle="@Title" Paged="false"
                  AllowAddRow="@(LevelSettings.Editable && LevelSettings.AllowAdd)" AllowDeleteRow="@(LevelSettings.Editable && LevelSettings.AllowDelete)"
                  AllowColumnEdit="false" Size="@(Level == 0 ? TableSize.Middle : TableSize.Small)"
                  RowDetail="@(HasChildren ? ChildFragment : null)" RowExpandable="row => Settings.CanExpand(Level, row)"
                  Searchable="false" ClientFilters="false" Filters="@(FilterBarShown ? FilterRow : null)"
                  ExportFileName="@LevelSettings.Title" OnReload="ReloadAsync"
                  Sortable="LevelSettings.Sortable" OnSort="SortAsync" RowDraggable="LevelSettings.RowDraggable" SortField="@_sortField" SortDescending="_descending"
                  ColumnSearchable="LevelSettings.Searchable" OnColumnSearch="ColumnSearchAsync" Searches="_searches" FilterRowOpen="LevelSettings.Searchable"
                  FiltersLocked="_dirty"
                  OnSave="SaveAsync" OnDiscard="ReloadAsync" OnChange="() => _dirty = _grid?.HasRowChanges ?? true" Class="m-nested-grid"
                  AddRowText="@($"Add {GridSchema.Singular(LevelSettings.Title)}")">
        <TitleExtra><span class="m-badge m-badge-gray-lt">@_total</span></TitleExtra>
        <ToolBar>
            @if (LevelSettings.Searchable && (_searchOpen || !string.IsNullOrEmpty(_keyword)))
            {
                <Input TValue="string" @bind-Value="_keyword" Placeholder="@($"Search {LevelSettings.Title.ToLowerInvariant()}…")" AllowClear Size="@InputSize.Default"
                       Class="m-table-toolbar-search m-nested-search" Prefix="SearchIcon" AutoFocus="_searchOpen"
                       OnPressEnter="SearchAsync" OnClear="SearchAsync" Disabled="_dirty" aria-label="@($"Search {Title}")"
                       OnBlur="() => _searchOpen = !string.IsNullOrEmpty(_keyword)" />
            }
            else if (LevelSettings.Searchable)
            {
                @* An empty search folds into its icon, as in the grid's own toolbar. *@
                <button type="button" class="ant-btn ant-btn-text ant-btn-icon-only m-table-search-toggle" aria-label="@($"Search {Title}")" title="@(_dirty ? LockedText : "Search (Ctrl+F)")"
                        data-m-search-toggle disabled="@_dirty" @onclick="() => _searchOpen = true"><Icon Type="search" /></button>
            }
            @if (FiltersActive)
            {
                @* One click clears the level's keyword, filters and column searches. *@
                <button type="button" class="ant-btn ant-btn-text m-table-clear" title="@(_dirty ? LockedText : "Clear the search and filters")" disabled="@_dirty" @onclick="ClearFiltersAsync"><Icon Type="close-circle" /><span>Clear</span></button>
            }
        </ToolBar>
        <Summary>
            @if (_dirty)
            {
                <span class="m-grid-locked" role="status"><Icon Type="lock" /> @LockedText</span>
            }
            @if (_total > 0)
            {
                <Pagination Current="_page" Total="_total" PageSize="_pageSize" Size="PaginationSize.Small" Disabled="_dirty" ShowTotal="ShowTotal"
                            ShowSizeChanger="true" PageSizeOptions="@Paging.SizesWith(LevelPageSize).ToArray()"
                            OnChange="e => PageAsync(e.Page, e.PageSize)" Class="m-nested-pager" />
            }
            @if (_totals.Count > 0)
            {
                @((MarkupString)TableGroups.Totals(_totals, _total))
            }
        </Summary>
    </EditableGrid>
</div>

@code {
    [Parameter, EditorRequired] public NestedGridSettings Settings { get; set; } = new();

    /// <summary>Loads one page of a level (the child levels ask the first time their parent row expands).</summary>
    [Parameter, EditorRequired] public Func<NestedGridRequest, Task<NestedGridPage>> Load { get; set; } = default!;

    /// <summary>Saves a level's page. The grid reloads that page afterwards.</summary>
    [Parameter] public Func<NestedGridChanges, Task>? Save { get; set; }

    /// <summary>The level this grid shows (0 for the top; set by the parent level).</summary>
    [Parameter] public int Level { get; set; }

    /// <summary>The parent row of a child level (set by the parent level).</summary>
    [Parameter] public GridRecord? Parent { get; set; }

    /// <summary>Title of the top level (child levels use the level title and the parent's first column).</summary>
    [Parameter] public string? HeaderTitle { get; set; }

    private EditableGrid? _grid;
    private static readonly Func<PaginationTotalContext, string> ShowTotal = ctx =>
        $"{ctx.Range.Item1.ToString("N0", CultureInfo.CurrentCulture)}–{ctx.Range.Item2.ToString("N0", CultureInfo.CurrentCulture)} of {ctx.Total.ToString("N0", CultureInfo.CurrentCulture)}";

    private const string LockedText = "Save or discard your changes to search, filter, sort or change page.";
    private static readonly RenderFragment SearchIcon = @<Icon Type="search" />;
    private readonly Dictionary<string, string?> _filters = new(StringComparer.Ordinal);

    // A searchable level filters in the row under its headers (a select for option columns), so the bar above the
    // table only keeps its dropdowns for a level without column searches, and "Clear filters" while any is set.
    private IReadOnlyList<GridColumn> FilterColumns => LevelSettings.Searchable ? [] : GridSchema.FilterColumns(_columns);

    private bool FiltersActive => _filters.Values.Any(v => !string.IsNullOrEmpty(v)) || _searches is not null || !string.IsNullOrEmpty(_keyword);

    private bool FilterBarShown => FilterColumns.Count > 0;

    // The level's filters run on the server (Load gets them in the request), like its search, sort and paging.
    private RenderFragment FilterRow => __builder =>
    {
        foreach (var column in FilterColumns)
        {
            var c = column;
            <Select TItemValue="string" TItem="string" Value="@_filters.GetValueOrDefault(c.Key)" ValueChanged="v => FilterAsync(c.Key, v)"
                    Placeholder="@($"Any {c.Title.ToLowerInvariant()}")" AllowClear Disabled="_dirty" aria-label="@c.Title">
                <SelectOptions>
                    @foreach (var o in GridSchema.FilterOptions(c))
                    {
                        <SelectOption TItemValue="string" TItem="string" Value="@o.Value" Label="@o.Label" />
                    }
                </SelectOptions>
            </Select>
        }
    };

    private async Task FilterAsync(string key, string? value)
    {
        _filters[key] = value;
        _page = 1;
        await LoadPageAsync();
    }

    private async Task ClearFiltersAsync()
    {
        if (_dirty) return;
        _filters.Clear();
        _searches = null;
        _keyword = null;
        _searchOpen = false;
        _page = 1;
        await LoadPageAsync();
    }

    private List<GridColumn> _columns = [];
    private List<GridRecord> _rows = [];
    private IReadOnlyList<TableTotal> _totals = [];
    private HashSet<string> _loadedIds = [];
    private int _total, _page = 1, _pageSize;
    private string? _keyword, _sortField;
    private bool _descending, _dirty, _searchOpen;

    private NestedGridLevel LevelSettings => Settings.Level(Level) ?? new NestedGridLevel();
    private int LevelPageSize => Math.Max(1, LevelSettings.PageSize);
    private bool HasChildren => Settings.Level(Level + 1) is not null && LevelSettings.Expandable;
    private IReadOnlyDictionary<string, string?>? _searches;

    private string Title => Level == 0 && HeaderTitle is not null
        ? HeaderTitle
        : Parent is null || _columns.Count == 0 ? LevelSettings.Title : $"{LevelSettings.Title} · {ParentLabel}";

    private string ParentLabel => Settings.ColumnsFor(Level - 1, null).FirstOrDefault() is { } first
        ? GridSchema.Format(first, Parent?[first.Key], CultureInfo.CurrentCulture)
        : Parent?.Id ?? "";

    private RenderFragment<GridRecord> ChildFragment => row => __builder =>
    {
        <NestedGrid Settings="Settings" Load="Load" Save="Save" Level="Level + 1" Parent="row" @key="row.Id" />
    };

    protected override async Task OnInitializedAsync()
    {
        _columns = Settings.ColumnsFor(Level, Parent);
        _pageSize = LevelPageSize;
        if (!LevelSettings.Editable) foreach (var c in _columns) c.Editable = false;
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        var filters = _filters.Where(f => !string.IsNullOrEmpty(f.Value)).ToDictionary(f => f.Key, f => f.Value, StringComparer.Ordinal);
        var result = await Load(new NestedGridRequest(Level, Parent?.Id, _keyword, _sortField, _descending, _page, _pageSize, filters.Count == 0 ? null : filters, _searches));
        _rows = [.. result.Rows];
        _total = result.Total;
        _totals = result.Totals;
        _page = NestedGridQuery.ClampPage(new NestedGridRequest(Level, Parent?.Id, Page: _page, PageSize: _pageSize), _total);
        _loadedIds = [.. _rows.Select(r => r.Id)];
        _dirty = false;
        _grid?.MarkSaved();
    }

    private async Task ReloadAsync() => await LoadPageAsync();

    private async Task SearchAsync()
    {
        _page = 1;
        await LoadPageAsync();
    }

    // Header clicks and column searches reload the level from the server (not while it has unsaved edits).
    private async Task SortAsync(string key)
    {
        if (_dirty) return;
        var next = new NestedGridRequest(Level, Parent?.Id, SortField: _sortField, Descending: _descending).WithSort(key);
        (_sortField, _descending) = (next.SortField, next.Descending);
        _page = 1;
        await LoadPageAsync();
    }

    private async Task ColumnSearchAsync((string Key, string? Value) search)
    {
        if (_dirty) return;
        _searches = ColumnSearch.With(_searches, search.Key, search.Value);
        _page = 1;
        await LoadPageAsync();
    }

    // A new page size starts again from the first page.
    private async Task PageAsync(int page, int size)
    {
        if (_dirty) return;
        if (size > 0 && size != _pageSize)
        {
            _pageSize = Paging.Size(size, LevelPageSize);
            page = 1;
        }
        _page = page;
        await LoadPageAsync();
    }

    private async Task SaveAsync()
    {
        if (Save is not null)
        {
            var deleted = _loadedIds.Except(_rows.Select(r => r.Id)).ToList();
            await Save(new NestedGridChanges(Level, Parent?.Id, _columns, _rows, deleted) { Ordered = _sortField is null });
        }
        await LoadPageAsync();
    }
}

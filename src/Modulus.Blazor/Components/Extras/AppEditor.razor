@* WYSIWYG editor: Tiptap with an Ant Design toolbar (headings, bold, italic, underline, strike, lists, quote, code, links,
   images from a URL, clear, undo, redo). The same markup and script as the MVC <app-editor> (EditorHtml, modulus-plugins.js).
   Tiptap owns the editing area, so the starting HTML is rendered once; the script writes the HTML to the hidden input and
   raises change (debounced), which binds Value. Setting Value from outside starts a fresh editor with it. The HTML is
   cleaned with RichText.Sanitize (images allowed) on the way in and out; clean it again on the server before storing. *@
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@using Modulus.Ui.Abstractions.Forms
@using Modulus.Ui.Abstractions.Plugins
@implements IDisposable

<div class="m-editor-wrap@(Invalid ? " m-editor-invalid" : "")" style="display: contents">
    <div @key="_version" class="m-editor@(string.IsNullOrEmpty(CssClass) ? "" : " " + CssClass)" data-m-editor data-m-debounce
         data-placeholder="@Placeholder" data-label="@Label" data-labelledby="@LabelledBy" data-readonly="@ReadOnly"
         style="--m-editor-min-height: @(MinHeight)px">
        @((MarkupString)EditorHtml.Toolbar(ReadOnly))
        @((MarkupString)EditorHtml.Bar)
        <div class="m-editor-host">@((MarkupString)_initial)</div>
        @((MarkupString)EditorHtml.Footer)
        <input type="hidden" name="@Name" id="@Id" value="@_initial" data-m-editor-value @onchange="Changed" />
    </div>
</div>

@code {
    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>With an EditForm: the bound field, so edits notify validation and its messages mark the editor.</summary>
    [Parameter] public Expression<Func<string?>>? ValueExpression { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Accessible name of the editing area.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Id of the element that labels the editing area (a form label).</summary>
    [Parameter] public string? LabelledBy { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Least height of the editing area in pixels.</summary>
    [Parameter] public int MinHeight { get; set; } = 220;

    /// <summary>Form field name of the hidden input (for a plain form post).</summary>
    [Parameter] public string? Name { get; set; }

    [Parameter] public string? Id { get; set; }

    /// <summary>Shows the error border (set automatically inside an EditForm).</summary>
    [Parameter] public bool Error { get; set; }

    [Parameter] public string? CssClass { get; set; }

    [CascadingParameter] private EditContext? EditContext { get; set; }

    private string _initial = "";
    private string? _last;
    private bool _readOnly;
    private int _version;
    private FieldIdentifier? _field;
    private EditContext? _subscribed;

    private bool Invalid => Error || (_field is { } f && EditContext is not null && EditContext.GetValidationMessages(f).Any());

    protected override void OnParametersSet()
    {
        if (ValueExpression is not null && _field is null) _field = FieldIdentifier.Create(ValueExpression);
        if (!ReferenceEquals(_subscribed, EditContext))
        {
            if (_subscribed is not null) _subscribed.OnValidationStateChanged -= ValidationChanged;
            _subscribed = EditContext;
            if (_subscribed is not null) _subscribed.OnValidationStateChanged += ValidationChanged;
        }
        var value = Value ?? "";
        // A value the editor did not produce (first render, a reset, a loaded record) or a read-only switch: start again.
        if (_version == 0 || value != (_last ?? "") || ReadOnly != _readOnly)
        {
            _initial = RichText.Sanitize(value, images: true);
            _last = value;
            _readOnly = ReadOnly;
            _version++;
        }
    }

    private async Task Changed(ChangeEventArgs e)
    {
        var html = RichText.Sanitize(e.Value?.ToString(), images: true);
        if (html == (_last ?? "")) return;
        _last = html;
        await ValueChanged.InvokeAsync(html);
        if (_field is { } f) EditContext?.NotifyFieldChanged(f);
    }

    private void ValidationChanged(object? sender, ValidationStateChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (_subscribed is not null) _subscribed.OnValidationStateChanged -= ValidationChanged;
    }
}

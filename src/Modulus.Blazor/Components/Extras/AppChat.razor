@* A conversation and its composer: the turns as a log (the same markup as the MVC <app-chat>, from ChatHtml), and a question
   field that calls OnAsk with the question when it is sent. The page owns the turns and answers the question. *@
@using Modulus.Ui.Abstractions.Chat

<section class="m-chat">
    @((MarkupString)ChatHtml.Log(Turns ?? [], EmptyText))
    <form class="m-chat-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
        <div class="m-chat-composer">
            <label class="m-chat-label" for="@_id">@Label</label>
            <textarea id="@_id" class="ant-input m-chat-input" rows="2" maxlength="@ChatTranscript.MaxTextLength" placeholder="@Placeholder" disabled="@Busy" @bind="_question" @bind:event="oninput"></textarea>
            <button type="submit" class="ant-btn ant-btn-primary" disabled="@(Busy || string.IsNullOrWhiteSpace(_question))">@Button</button>
        </div>
    </form>
</section>

@code {
    private readonly string _id = "chat-" + Guid.NewGuid().ToString("N")[..8];
    private string _question = "";

    /// <summary>The conversation so far.</summary>
    [Parameter] public IReadOnlyList<ChatTurn>? Turns { get; set; }

    /// <summary>Called with the question when it is sent.</summary>
    [Parameter] public EventCallback<string> OnAsk { get; set; }

    [Parameter] public string Label { get; set; } = "Your question";

    [Parameter] public string Placeholder { get; set; } = "";

    [Parameter] public string Button { get; set; } = "Ask";

    [Parameter] public string EmptyText { get; set; } = "Ask a question to start.";

    /// <summary>True while the page answers a question: the field and the button are off.</summary>
    [Parameter] public bool Busy { get; set; }

    private async Task SubmitAsync()
    {
        if (Busy || string.IsNullOrWhiteSpace(_question)) return;
        var question = _question.Trim();
        _question = "";
        await OnAsk.InvokeAsync(question);
    }
}

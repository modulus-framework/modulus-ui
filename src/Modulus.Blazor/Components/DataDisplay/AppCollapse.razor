@inherits ComponentBase

<div @attributes="AdditionalAttributes">
    @if (Items != null)
    {
        @foreach (var (item, index) in Items.Select((x, i) => (x, i)))
        {
            <div style="border: 1px solid #d9d9d9; border-radius: 4px; margin-bottom: 8px; overflow: hidden;">
                <div @onclick="() => TogglePanel(index)"
                     style="padding: 12px; background: #fafafa; cursor: pointer; display: flex; justify-content: space-between; align-items: center; user-select: none;">
                    <span style="font-weight: bold;">@item</span>
                    <span style="transition: transform 0.3s;">@(ExpandedPanels.Contains(index) ? "▼" : "▶")</span>
                </div>
                
                @if (ExpandedPanels.Contains(index))
                {
                    <div style="padding: 16px; border-top: 1px solid #d9d9d9;">
                        Content for @item panel
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public List<string>? Items { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> AdditionalAttributes { get; set; } = [];

    private HashSet<int> ExpandedPanels { get; set; } = new();

    private void TogglePanel(int index)
    {
        if (ExpandedPanels.Contains(index))
            ExpandedPanels.Remove(index);
        else
            ExpandedPanels.Add(index);
    }
}

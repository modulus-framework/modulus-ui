@inherits ComponentBase

<div @attributes="AdditionalAttributes" style="position: relative;">
    <input type="text" 
           class="ant-input" 
           placeholder="@Placeholder"
           style="width: 100%; padding-right: 32px;"
           @onclick="ToggleDropdown"
           readonly />
    <span style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); color: rgba(0,0,0,0.45);">▼</span>
    
    @if (ShowDropdown)
    {
        <div style="position: absolute; top: 100%; left: 0; right: 0; background: white; border: 1px solid #d9d9d9; border-top: none; max-height: 256px; overflow-y: auto; z-index: 1000; padding: 8px;">
            <div style="padding: 8px 12px; cursor: pointer;">
                @if (TreeData != null)
                {
                    @foreach (var node in TreeData)
                    {
                        <div style="padding: 4px 0;">
                            🗂️ @node
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string? Placeholder { get; set; } = "Select hierarchy";

    [Parameter]
    public IEnumerable<string>? TreeData { get; set; }

    [Parameter]
    public bool ShowDropdown { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> AdditionalAttributes { get; set; } = [];

    private void ToggleDropdown()
    {
        ShowDropdown = !ShowDropdown;
    }
}

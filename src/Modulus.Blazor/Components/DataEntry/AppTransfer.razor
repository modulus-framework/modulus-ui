@typeparam TItem
@inherits ComponentBase

<div @attributes="AdditionalAttributes" 
     style="display: flex; gap: 16px; align-items: flex-start;">
    
    <!-- Source List -->
    <div style="flex: 1; border: 1px solid #d9d9d9; border-radius: 4px; overflow: hidden;">
        <div style="padding: 8px; background: #fafafa; border-bottom: 1px solid #d9d9d9; font-weight: bold;">
            Available (@(SourceList?.Count() ?? 0))
        </div>
        <div style="max-height: 300px; overflow-y: auto;">
            @if (SourceList != null)
            {
                @foreach (var item in SourceList)
                {
                    <label style="display: block; padding: 8px; border-bottom: 1px solid #f0f0f0; cursor: pointer;">
                        <input type="checkbox" style="margin-right: 8px;" />
                        @item
                    </label>
                }
            }
        </div>
    </div>
    
    <!-- Transfer Buttons -->
    <div style="display: flex; flex-direction: column; gap: 8px; justify-content: center;">
        <button class="ant-btn" style="padding: 4px;">→</button>
        <button class="ant-btn" style="padding: 4px;">←</button>
    </div>
    
    <!-- Target List -->
    <div style="flex: 1; border: 1px solid #d9d9d9; border-radius: 4px; overflow: hidden;">
        <div style="padding: 8px; background: #fafafa; border-bottom: 1px solid #d9d9d9; font-weight: bold;">
            Selected (@(TargetList?.Count() ?? 0))
        </div>
        <div style="max-height: 300px; overflow-y: auto;">
            @if (TargetList != null)
            {
                @foreach (var item in TargetList)
                {
                    <label style="display: block; padding: 8px; border-bottom: 1px solid #f0f0f0; cursor: pointer;">
                        <input type="checkbox" style="margin-right: 8px;" />
                        @item
                    </label>
                }
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public IEnumerable<TItem> SourceList { get; set; } = new List<TItem>();

    [Parameter]
    public IEnumerable<TItem> TargetList { get; set; } = new List<TItem>();

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> AdditionalAttributes { get; set; } = [];
}

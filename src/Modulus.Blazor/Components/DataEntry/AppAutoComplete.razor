@typeparam TItem
@typeparam TItemValue
@inherits ComponentBase

<div @attributes="AdditionalAttributes" style="position: relative;">
    <input type="text" 
           class="ant-input" 
           placeholder="@Placeholder"
           style="width: 100%;"
           @onchange="@HandleSearch" />
    
    @if (ShowDropdown && FilteredOptions != null)
    {
        <div style="position: absolute; top: 100%; left: 0; right: 0; background: white; border: 1px solid #d9d9d9; border-top: none; max-height: 256px; overflow-y: auto; z-index: 1000;">
            @foreach (var option in FilteredOptions)
            {
                <div style="padding: 8px 12px; cursor: pointer; hover:background-color: #f5f5f5;">
                    @option
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public IEnumerable<TItem>? Options { get; set; }

    [Parameter]
    public IEnumerable<TItem>? FilteredOptions { get; set; }

    [Parameter]
    public EventCallback<string> OnSearch { get; set; }

    [Parameter]
    public bool ShowDropdown { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> AdditionalAttributes { get; set; } = [];

    private async Task HandleSearch(ChangeEventArgs e)
    {
        ShowDropdown = true;
        if (OnSearch.HasDelegate)
            await OnSearch.InvokeAsync(e.Value?.ToString());
    }
}

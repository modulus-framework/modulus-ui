@inherits ComponentBase

<div @attributes="AdditionalAttributes" style="display: flex; gap: 8px;">
    <select class="ant-input" style="flex: 1;" @onchange="@HandleLevel1Change">
        <option selected>@Level1Placeholder</option>
        @if (Level1Options != null)
        {
            @foreach (var opt in Level1Options)
            {
                <option value="@opt">@opt</option>
            }
        }
    </select>
    
    @if (ShowLevel2)
    {
        <select class="ant-input" style="flex: 1;" @onchange="@HandleLevel2Change">
            <option selected>@Level2Placeholder</option>
            @if (Level2Options != null)
            {
                @foreach (var opt in Level2Options)
                {
                    <option value="@opt">@opt</option>
                }
            }
        </select>
    }
    
    @if (ShowLevel3)
    {
        <select class="ant-input" style="flex: 1;">
            <option selected>@Level3Placeholder</option>
            @if (Level3Options != null)
            {
                @foreach (var opt in Level3Options)
                {
                    <option value="@opt">@opt</option>
                }
            }
        </select>
    }
</div>

@code {
    [Parameter]
    public string Level1Placeholder { get; set; } = "Province";
    [Parameter]
    public string Level2Placeholder { get; set; } = "City";
    [Parameter]
    public string Level3Placeholder { get; set; } = "District";

    [Parameter]
    public IEnumerable<string>? Level1Options { get; set; }
    [Parameter]
    public IEnumerable<string>? Level2Options { get; set; }
    [Parameter]
    public IEnumerable<string>? Level3Options { get; set; }

    [Parameter]
    public EventCallback<string> OnLevel1Change { get; set; }
    [Parameter]
    public EventCallback<string> OnLevel2Change { get; set; }

    public bool ShowLevel2 { get; set; }
    public bool ShowLevel3 { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> AdditionalAttributes { get; set; } = [];

    private async Task HandleLevel1Change(ChangeEventArgs e)
    {
        ShowLevel2 = true;
        if (OnLevel1Change.HasDelegate)
            await OnLevel1Change.InvokeAsync(e.Value?.ToString());
    }

    private async Task HandleLevel2Change(ChangeEventArgs e)
    {
        ShowLevel3 = true;
        if (OnLevel2Change.HasDelegate)
            await OnLevel2Change.InvokeAsync(e.Value?.ToString());
    }
}

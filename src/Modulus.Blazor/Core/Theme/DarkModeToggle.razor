@inject IJSRuntime JS

<Button Type="ButtonType.Primary" Shape="ButtonShape.Circle" Icon="@(isDark ? "sun" : "moon")" OnClick="OnToggle" Title="@(isDark ? "Light mode" : "Dark mode")" />

@code {
    [CascadingParameter]
    public ThemeProvider? Parent { get; set; }

    private bool isDark = false;

    protected override async Task OnInitializedAsync()
    {
        var themeValue = await JS.InvokeAsync<string?>("localStorage.getItem", "modulus-theme-dark");
        isDark = themeValue == "true";
    }

    private async Task OnToggle()
    {
        isDark = !isDark;
        if (Parent is not null)
        {
            await Parent.ToggleDarkMode(isDark);
        }
    }
}

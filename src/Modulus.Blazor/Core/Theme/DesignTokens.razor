@code {
    [Parameter]
    public ModulusDesignTokens? Value { get; set; }
}

@if (Value is not null)
{
    <style>
        :root {
            @if (!Value.IsDark)
            {
                <text>
                --ant-color-primary: #1890ff;
                --ant-color-primary-bg: #e6f7ff;
                --ant-color-primary-border: #91d5ff;
                --ant-color-error: #ff4d4f;
                --ant-color-warning: #faad14;
                --ant-color-success: #52c41a;
                --ant-color-info: #1890ff;
                --ant-color-text: rgba(0, 0, 0, 0.85);
                --ant-color-text-secondary: rgba(0, 0, 0, 0.65);
                --ant-color-text-tertiary: rgba(0, 0, 0, 0.45);
                --ant-color-text-quaternary: rgba(0, 0, 0, 0.25);
                --ant-color-bg: #ffffff;
                --ant-color-border: #d9d9d9;
                --ant-border-radius-lg: 8px;
                --ant-border-radius: 6px;
                --ant-border-radius-sm: 4px;
                --ant-font-size: 14px;
                --ant-line-height: 1.5714285714;
                --ant-control-height: 32px;
                --modulus-bg-light: #f5f5f5;
                --modulus-bg-lighter: #fafafa;
                </text>
            }
            @if (Value.IsDark)
            {
                <text>
                --ant-color-primary: #177ddc;
                --ant-color-primary-bg: #111d2c;
                --ant-color-primary-border: #15395b;
                --ant-color-error: #ff4d4f;
                --ant-color-warning: #faad14;
                --ant-color-success: #52c41a;
                --ant-color-info: #177ddc;
                --ant-color-text: rgba(255, 255, 255, 0.85);
                --ant-color-text-secondary: rgba(255, 255, 255, 0.65);
                --ant-color-text-tertiary: rgba(255, 255, 255, 0.45);
                --ant-color-text-quaternary: rgba(255, 255, 255, 0.25);
                --ant-color-bg: #141414;
                --ant-color-border: #434343;
                --ant-border-radius-lg: 8px;
                --ant-border-radius: 6px;
                --ant-border-radius-sm: 4px;
                --ant-font-size: 14px;
                --ant-line-height: 1.5714285714;
                --ant-control-height: 32px;
                --modulus-bg-light: #262626;
                --modulus-bg-lighter: #1f1f1f;
                </text>
            }
        }
    </style>
}

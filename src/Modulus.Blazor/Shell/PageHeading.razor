@*
    Tabler page header: small uppercase pretitle, title, optional subtitle and actions on the right. Crumbs (the page's own
    breadcrumb trail, the same as AppCrumbs) sit above the pretitle.

        <PageHeading Pretitle="Overview" Title="Dashboard" Crumbs="_trail">
            <Actions><Button Type="@ButtonType.Primary">New report</Button></Actions>
        </PageHeading>
*@
@using Modulus.Ui.Abstractions.Navigation
<div class="m-page-header">
    <div class="m-page-header-text">
        @if (Crumbs is { Count: > 0 })
        {
            <div class="m-page-crumbs">@((MarkupString)CrumbHtml.Trail(Crumbs))</div>
        }
        @if (Pretitle is not null)
        {
            <div class="m-pretitle">@Pretitle</div>
        }
        <h1 class="m-page-title">@Title @TitleExtra</h1>
        @if (Subtitle is not null)
        {
            <p class="m-page-subtitle">@Subtitle</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="m-page-actions">@Actions</div>
    }
</div>

@code {
    [Parameter] public string? Pretitle { get; set; }

    [Parameter] public string Title { get; set; } = "";

    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Content after the title text, e.g. a status badge.</summary>
    [Parameter] public RenderFragment? TitleExtra { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>The page's breadcrumb trail, from the app down to this page (the last level is the current page).</summary>
    [Parameter] public IReadOnlyList<Crumb>? Crumbs { get; set; }
}

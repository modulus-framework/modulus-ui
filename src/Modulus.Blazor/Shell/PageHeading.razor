@*
    Tabler page header: small uppercase pretitle, title, optional subtitle and actions on the right.

        <PageHeading Pretitle="Overview" Title="Dashboard">
            <Actions><Button Type="@ButtonType.Primary">New report</Button></Actions>
        </PageHeading>
*@
<div class="m-page-header">
    <div class="m-page-header-text">
        @if (Pretitle is not null)
        {
            <div class="m-pretitle">@Pretitle</div>
        }
        <h1 class="m-page-title">@Title @TitleExtra</h1>
        @if (Subtitle is not null)
        {
            <p class="m-page-subtitle">@Subtitle</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="m-page-actions">@Actions</div>
    }
</div>

@code {
    [Parameter] public string? Pretitle { get; set; }

    [Parameter] public string Title { get; set; } = "";

    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Content after the title text, e.g. a status badge.</summary>
    [Parameter] public RenderFragment? TitleExtra { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }
}

@* Named icon, drawn as an Ant Design icon inline: <Ti Name="home" /> *@
@((MarkupString)ShellRenderer.Icon(Name, Class))

@code {
    /// <summary>Ant Design outline icon name, e.g. "home", "team", "bar-chart", or a Remix Icon fallback such as "ri:fingerprint".</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    [Parameter] public string? Class { get; set; }
}

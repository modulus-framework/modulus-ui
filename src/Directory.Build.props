<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    NuGet packages: dotnet pack Modulus.slnx -c Release -o artifacts/packages
    One version for every library. CI stamps prereleases with -p:VersionSuffix=ci.<run>; a release tag vX.Y.Z packs X.Y.Z.
  -->
  <PropertyGroup>
    <VersionPrefix>0.9.1</VersionPrefix>
    <IsPackable>true</IsPackable>
    <!-- Same ID pattern as the Modulus framework packages (build/Modulus.Packaging.props there): Synvro.<project name>. -->
    <PackageId>Synvro.$(MSBuildProjectName)</PackageId>
    <Authors>synvro</Authors>
    <Company>synvro</Company>
    <Copyright>Copyright © $([System.DateTime]::UtcNow.Year) synvro. All rights reserved.</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/modulus-framework/modulus-ui</PackageProjectUrl>
    <RepositoryUrl>https://github.com/modulus-framework/modulus-ui.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ant-design;antd;blazor;aspnetcore;mvc;razor-pages;admin;dashboard;ui</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public members without XML docs are allowed; the docs that exist ship in the package. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>

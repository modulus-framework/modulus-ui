@*
    Modulus application shell for MVC and Razor Pages (Tabler layout). The sidebar, header, navbar,
    footer and theme settings panel come from ShellRenderer, which Blazor's AppShell also uses, so
    every flavor renders the same DOM.

    Sections:  Head (optional), Scripts (optional)
    Content:   register an IShellContentProvider for the user menu, notifications and footer links.
    Page:      ViewData["Title"] sets the document title.
    SPA:       with ModulusThemeOptions.SpaNavigation, links and forms load through htmx (hx-boost). A boosted request gets
               only the title, the navigation (out of band) and <main>, with the page's Head and Scripts sections inside it,
               and modulus-spa.js swaps them in. The .m-page element is htmx's history element: back and forward reload
               it from the server, never the scripts after it.
*@
@using Microsoft.AspNetCore.Authorization
@using Modulus.AspNetCore.Mvc.Htmx
@using Modulus.Ui.Abstractions.Shell
@inject IOptions<ModulusThemeOptions> ThemeOptions
@inject IMenuProvider MenuProvider
@inject IShellContentProvider ShellContentProvider
@inject IAuthorizationService Authorization
@{
    var cookies = Context.Request.Cookies;
    var theme = ThemeCss.ResolveOptions(ThemeOptions.Value, name => cookies[name]);
    var menu = await MenuFilter.FilterAsync(await MenuProvider.GetMainMenuAsync(),
        async policy => (await Authorization.AuthorizeAsync(User, policy)).Succeeded);
    var shell = new ShellView(theme, menu, Context.Request.Path.Value?.Trim('/') ?? "",
        await ShellContentProvider.GetContentAsync(User, Context.RequestAborted),
        ThemeCss.ResolveMode(cookies[ThemeCss.ModeCookie], ThemeMode.System), cookies[ShellRenderer.TenantCookie], cookies[ShellRenderer.TenantsCookie]);
    var title = ViewData["Title"] as string;
    var documentTitle = title is null ? theme.Title : $"{title} · {theme.Title}";
    var spa = theme.SpaNavigation;
    var app = ShellRenderer.CurrentApp(shell)?.MenuKey ?? "";
    if (spa) SpaNavigation.AddVary(Context.Response);
    // Back and forward reload .m-page from a full page; the page's own assets go inside it, where htmx runs them.
    var restore = spa && Context.Request.Headers["HX-History-Restore-Request"] == "true";
}
@if (spa && Context.Request.IsBoosted())
{
    SpaNavigation.PrepareFragment(Context.Response);
    // The navigation shows where the page sits (active items, the app's menu and breadcrumb), so it comes along; the
    // app launcher only when the app changes, as it marks the current app.
    <title>@documentTitle</title>
    @Html.Raw(SpaNavigation.Oob(ShellRenderer.Sidebar(shell), "m-sidebar"))
    @Html.Raw(SpaNavigation.Oob(ShellRenderer.Header(shell), "m-header"))
    if (SpaNavigation.AppChanged(Context.Request, app))
    {
        @Html.Raw(SpaNavigation.Oob(ShellRenderer.AppLauncher(shell), "m-launcher"))
    }
    <main class="m-page-body" id="main" x-data tabindex="-1" data-m-app="@app">
        <div class="m-container">
            @RenderBody()
        </div>
        @* The page's own assets run once they're in the page; modulus-spa.js skips files the page already has. *@
        <div hidden data-m-page-assets>
            @await RenderSectionAsync("Head", required: false)
            @await RenderSectionAsync("Scripts", required: false)
        </div>
    </main>
    return;
}
<!DOCTYPE html>
<html lang="@(string.IsNullOrEmpty(System.Globalization.CultureInfo.CurrentUICulture.Name) ? "en" : System.Globalization.CultureInfo.CurrentUICulture.Name)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@documentTitle</title>
    <modulus-head />
    @if (!restore)
    {
        @await RenderSectionAsync("Head", required: false)
    }
</head>
<body modulus-antiforgery hx-boost="@(spa ? "true" : null)" data-m-spa="@(spa ? "" : null)" data-m-prefetch="@(spa && theme.SpaPrefetch ? "" : null)">
    <div class="m-page" hx-history-elt="@(spa ? "" : null)">
        @Html.Raw(ShellRenderer.Sidebar(shell))
        @Html.Raw(ShellRenderer.Header(shell))
        <div class="m-page-wrapper">
            @* x-data: every page can use Alpine directives (@click="$store.drawer.load(…)") without its own scope. *@
            <main class="m-page-body" id="main" x-data tabindex="-1" data-m-app="@app">
                <div class="m-container">
                    @RenderBody()
                </div>
                @if (restore)
                {
                    <div hidden data-m-page-assets>
                        @await RenderSectionAsync("Head", required: false)
                        @await RenderSectionAsync("Scripts", required: false)
                    </div>
                }
            </main>
            @Html.Raw(ShellRenderer.Footer(shell))
        </div>
    </div>
    @Html.Raw(ShellRenderer.Customizer(shell))
    @Html.Raw(ShellRenderer.AppLauncher(shell))

    @* Shared drawer. Open with Alpine.store('drawer').show(title) and load its body via hx-target="#modulus-drawer-body". *@
    <div x-data class="ant-drawer ant-drawer-right ant-drawer-open m-drawer" x-show="$store.drawer.open" :data-open="$store.drawer.open" x-cloak
         @@keydown.escape.window="$store.drawer.hide()" role="dialog" aria-modal="true" :aria-label="$store.drawer.title">
        <div class="ant-drawer-mask" @@click="$store.drawer.hide()" x-show="$store.drawer.open" x-transition.opacity></div>
        <div class="ant-drawer-content-wrapper" :style="`width: ${$store.drawer.width}px; max-width: 100vw`"
             x-show="$store.drawer.open"
             x-transition:enter="m-drawer-enter" x-transition:enter-start="m-drawer-hidden"
             x-transition:leave="m-drawer-enter" x-transition:leave-end="m-drawer-hidden">
            <div class="ant-drawer-content">
                <div class="ant-drawer-wrapper-body">
                    @* Same header as AntDesign Blazor's Drawer: title, then the close button on the right (Tabler offcanvas). *@
                    <div class="ant-drawer-header">
                        <div class="ant-drawer-title" x-text="$store.drawer.title"></div>
                        <button type="button" class="ant-drawer-close" aria-label="Close" @@click="$store.drawer.hide()"><app-icon type="close" /></button>
                    </div>
                    <div class="ant-drawer-body" id="modulus-drawer-body"></div>
                </div>
            </div>
        </div>
    </div>

    @* Ant Design confirm dialog used for every hx-confirm. *@
    <div x-data class="m-confirm" x-show="$store.confirm.open" x-cloak @@keydown.escape.window="$store.confirm.answer(false)">
        <div class="ant-modal-mask"></div>
        <div class="ant-modal-wrap" role="alertdialog" aria-modal="true" :aria-label="$store.confirm.title">
            <div class="ant-modal ant-modal-confirm ant-modal-confirm-confirm" style="width: 416px;">
                <div class="ant-modal-content">
                    <div class="ant-modal-body">
                        <div class="ant-modal-confirm-body-wrapper">
                            <div class="ant-modal-confirm-body">
                                <app-icon type="exclamation-circle" theme="Fill" />
                                <span class="ant-modal-confirm-title" x-text="$store.confirm.title"></span>
                                <div class="ant-modal-confirm-content">This action can't be undone.</div>
                            </div>
                            <div class="ant-modal-confirm-btns">
                                <button type="button" class="ant-btn ant-btn-default" @@click="$store.confirm.answer(false)"><span>Cancel</span></button>
                                <button type="button" class="ant-btn ant-btn-primary" :class="$store.confirm.danger && 'ant-btn-dangerous'" @@click="$store.confirm.answer(true)" x-ref="ok"><span x-text="$store.confirm.okText"></span></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="ant-message" id="modulus-messages" aria-live="polite"></div>
    <div class="ant-notification ant-notification-topRight m-notifications" id="modulus-notifications" aria-live="polite"></div>
    <template id="modulus-icon-check-circle"><app-icon type="check-circle" theme="Fill" /></template>
    <template id="modulus-icon-info-circle"><app-icon type="info-circle" theme="Fill" /></template>
    <template id="modulus-icon-exclamation-circle"><app-icon type="exclamation-circle" theme="Fill" /></template>
    <template id="modulus-icon-close-circle"><app-icon type="close-circle" theme="Fill" /></template>
    <template id="modulus-icon-o-check-circle"><app-icon type="check-circle" /></template>
    <template id="modulus-icon-o-info-circle"><app-icon type="info-circle" /></template>
    <template id="modulus-icon-o-exclamation-circle"><app-icon type="exclamation-circle" /></template>
    <template id="modulus-icon-o-close-circle"><app-icon type="close-circle" /></template>
    <template id="modulus-icon-close"><app-icon type="close" /></template>

    <modulus-scripts />
    @if (!restore)
    {
        @await RenderSectionAsync("Scripts", required: false)
    }
</body>
</html>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Scriban page and component templates and the ui-kit.json manifest that the Modulus CLI renders to scaffold admin UI for MVC, Razor Pages, Blazor and Fluid.</Description>
    <!-- Content-only package: no assembly, the CLI unpacks templates/ and ui-kit.json from the .nupkg. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <!--
    Template content package: no code, only manifests and embedded Scriban templates.
    The CLI renders templates from here at scaffold time, so every template version matches the kit version exactly.
  -->

  <ItemGroup>
    <!-- Embed the manifest and all .sbn templates -->
    <EmbeddedResource Include="ui-kit.json" />
    <EmbeddedResource Include="templates/**/*.sbn" />
  </ItemGroup>

  <ItemGroup>
    <None Include="ui-kit.json" Pack="true" PackagePath="/" />
    <None Include="templates/**/*.sbn;templates/**/*.json" Pack="true" PackagePath="templates/" />
  </ItemGroup>

</Project>

{% comment %} Badge for Fluid: status (active, inactive, pending, error, or any other value), label. The markup is the one <app-badge> draws. {% endcomment %}
{% assign status = status | default: 'default' | downcase %}
{% assign kind = 'processing' %}
{% if status == 'active' %}{% assign kind = 'success' %}{% elsif status == 'inactive' %}{% assign kind = 'default' %}{% elsif status == 'pending' %}{% assign kind = 'warning' %}{% elsif status == 'error' %}{% assign kind = 'error' %}{% endif %}
{% assign text = label | default: status %}

<span class="ant-badge ant-badge-status ant-badge-not-a-wrapper" role="status"><span class="ant-badge-status-dot ant-badge-status-{{ kind }}"></span><span class="ant-badge-status-text">{{ text }}</span></span>

{% if model.id %}
<h1>Edit {{ entity_name }}</h1>
{% else %}
<h1>Create {{ entity_name }}</h1>
{% endif %}

<div class="page-wrapper">
    <div class="container-xl">
        <div class="page-header d-mb-4">
            <div class="row align-items-center">
                <div class="col">
                    <h2 class="page-title">{{ entity_name_plural }}</h2>
                    {% if model.id %}
                    <nav aria-label="breadcrumb" class="ms-2">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/{{ entity_name_plural | downcase }}">{{ entity_name_plural }}</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Edit</li>
                        </ol>
                    </nav>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    <div class="page-body">
        <div class="container-xl">
            <div class="row">
                <div class="col-md-8 col-lg-6">
                    <div class="card">
                        <div class="card-body">
                            <form method="post" class="form-horizontal">
                                {% if model.id %}
                                <input type="hidden" name="id" value="{{ model.id }}" />
                                {% endif %}

                                <div class="mb-3">
                                    <label class="form-label">Name <span class="badge badge-pill badge-danger">Required</span></label>
                                    <input type="text" name="name" class="form-control" value="{{ model.name }}" placeholder="Enter name" required />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Description</label>
                                    <textarea class="form-control" name="description" rows="4" placeholder="Enter description">{{ model.description }}</textarea>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Status</label>
                                    <select name="status" class="form-select">
                                        <option value="">Choose status</option>
                                        <option value="active" {% if model.status == 'active' %}selected{% endif %}>Active</option>
                                        <option value="inactive" {% if model.status == 'inactive' %}selected{% endif %}>Inactive</option>
                                    </select>
                                </div>

                                <div class="form-footer">
                                    <button type="submit" class="btn btn-primary">
                                        {% if model.id %}
                                        Update
                                        {% else %}
                                        Create
                                        {% endif %}
                                    </button>
                                    <a href="/{{ entity_name_plural | downcase }}" class="btn btn-link">Cancel</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

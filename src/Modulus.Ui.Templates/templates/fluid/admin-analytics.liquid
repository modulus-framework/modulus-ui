{% comment %} Analytics for Fluid: sample figures, a traffic bar per day and the top pages. A plain progress bar per point; swap in a chart for a real one. {% endcomment %}

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Reports</div><h1 class="m-page-title">Analytics &amp; insights</h1></div>
</div>

<div class="ant-alert ant-alert-info ant-alert-with-description m-mb-16" role="alert">
    <div class="ant-alert-content">
        <div class="ant-alert-message">Sample data</div>
        <div class="ant-alert-description">This page shows built-in sample figures. Connect your analytics data to replace them.</div>
    </div>
</div>

<div class="m-row-cards">
    <div class="m-grid m-cols-4">
        <div class="m-card m-stat-card"><div class="m-card-body"><div class="m-stat-card-head"><span>Visits</span></div><div class="m-stat-card-value">12,480</div></div></div>
        <div class="m-card m-stat-card"><div class="m-card-body"><div class="m-stat-card-head"><span>Unique users</span></div><div class="m-stat-card-value">3,912</div></div></div>
        <div class="m-card m-stat-card"><div class="m-card-body"><div class="m-stat-card-head"><span>Bounce rate</span></div><div class="m-stat-card-value">34%</div></div></div>
        <div class="m-card m-stat-card"><div class="m-card-body"><div class="m-stat-card-head"><span>Avg. session</span></div><div class="m-stat-card-value">4m 12s</div></div></div>
    </div>

    <div class="m-grid m-cols-main">
        <div class="m-card">
            <div class="m-card-header"><h2 class="m-card-title">Traffic over time</h2></div>
            <div class="m-card-body">
                <div class="m-bars">
                    <label class="m-bar-row"><span>Mon</span><progress max="1800" value="1520"></progress><span>1,520</span></label>
                    <label class="m-bar-row"><span>Tue</span><progress max="1800" value="1740"></progress><span>1,740</span></label>
                    <label class="m-bar-row"><span>Wed</span><progress max="1800" value="1310"></progress><span>1,310</span></label>
                    <label class="m-bar-row"><span>Thu</span><progress max="1800" value="1680"></progress><span>1,680</span></label>
                    <label class="m-bar-row"><span>Fri</span><progress max="1800" value="1800"></progress><span>1,800</span></label>
                </div>
            </div>
        </div>
        <div class="m-card">
            <div class="m-card-header"><h2 class="m-card-title">Top pages</h2></div>
            <div class="m-card-body m-card-body-flush">
                <div class="ant-table-wrapper m-table-flush">
                    <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                        <table style="table-layout:auto">
                            <thead class="ant-table-thead"><tr><th class="ant-table-cell">Page</th><th class="ant-table-cell">Views</th></tr></thead>
                            <tbody class="ant-table-tbody">
                                <tr class="ant-table-row"><td class="ant-table-cell">/dashboard</td><td class="ant-table-cell">4,210</td></tr>
                                <tr class="ant-table-row"><td class="ant-table-cell">/apps/invoice/list</td><td class="ant-table-cell">2,087</td></tr>
                                <tr class="ant-table-row"><td class="ant-table-cell">/admin/users</td><td class="ant-table-cell">905</td></tr>
                            </tbody>
                        </table>
                    </div></div></div>
                </div>
            </div>
        </div>
    </div>
</div>

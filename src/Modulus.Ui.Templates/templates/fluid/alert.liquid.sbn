{# Alert component for Fluid: type (success, info, warning, danger), title, message, dismissible #}
{% assign type = type | default: 'info' | downcase %}
{% assign kind = 'info' %}
{% if type == 'success' %}{% assign kind = 'success' %}{% elsif type == 'warning' %}{% assign kind = 'warning' %}{% elsif type == 'danger' or type == 'error' %}{% assign kind = 'error' %}{% endif %}

<div class="ant-alert ant-alert-{{ kind }} ant-alert-with-description" role="alert">
    <div class="ant-alert-content">
        {% if title %}
        <div class="ant-alert-message">{{ title }}</div>
        {% endif %}
        {% if message %}
        <div class="{% if title %}ant-alert-description{% else %}ant-alert-message{% endif %}">{{ message }}</div>
        {% endif %}
    </div>
    {% if dismissible %}
    <button type="button" class="ant-alert-close-icon" aria-label="Close">&times;</button>
    {% endif %}
</div>

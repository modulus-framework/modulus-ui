{# Alert component for Fluid #}
{% assign type = type | default: 'info' | downcase %}
{% assign alert_class = 'alert' %}

{% if type == 'success' %}
  {% assign alert_class = alert_class | append: ' alert-success' %}
{% elsif type == 'warning' %}
  {% assign alert_class = alert_class | append: ' alert-warning' %}
{% elsif type == 'danger' %}
  {% assign alert_class = alert_class | append: ' alert-danger' %}
{% else %}
  {% assign alert_class = alert_class | append: ' alert-info' %}
{% endif %}

{% if dismissible %}
  {% assign alert_class = alert_class | append: ' alert-dismissible' %}
{% endif %}

<div class="{{ alert_class }}" role="alert">
    <div class="d-flex">
        <div>
            {% if title %}
            <h4 class="alert-title">{{ title }}</h4>
            {% endif %}
            {% if message %}
            <div class="text-secondary">
                {{ message }}
            </div>
            {% endif %}
        </div>
        {% if dismissible %}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        {% endif %}
    </div>
</div>

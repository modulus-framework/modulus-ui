{% comment %} Steps for Fluid: items (each with title and optional description), current (0-based), vertical {% endcomment %}
{% assign current = current | default: 0 %}
{% assign direction = 'horizontal' %}
{% if vertical %}{% assign direction = 'vertical' %}{% endif %}

<div class="ant-steps ant-steps-{{ direction }} ant-steps-label-horizontal" role="list">
    {% for item in items %}
    {% assign state = 'wait' %}
    {% if forloop.index0 < current %}{% assign state = 'finish' %}{% elsif forloop.index0 == current %}{% assign state = 'process' %}{% endif %}
    <div class="ant-steps-item ant-steps-item-{{ state }}" role="listitem"{% if forloop.index0 == current %} aria-current="step"{% endif %}>
        <div class="ant-steps-item-container">
            <div class="ant-steps-item-icon"><span class="ant-steps-icon">{{ forloop.index }}</span></div>
            <div class="ant-steps-item-content">
                <div class="ant-steps-item-title">{{ item.title }}</div>
                {% if item.description %}<div class="ant-steps-item-description">{{ item.description }}</div>{% endif %}
            </div>
        </div>
    </div>
    {% endfor %}
</div>

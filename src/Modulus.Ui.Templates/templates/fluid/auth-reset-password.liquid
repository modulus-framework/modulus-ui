{% comment %} Reset password for Fluid: token, error, antiforgery_token. Posts to /auth/reset-password. The sample checks the form and does not change the password. {% endcomment %}

<div class="m-page-header">
    <div class="m-page-header-text"><h1 class="m-page-title">Reset password</h1></div>
</div>

{% if error and error != blank %}
<div class="ant-alert ant-alert-error ant-alert-with-description m-mb-16" role="alert">
    <div class="ant-alert-content"><div class="ant-alert-message">{{ error }}</div></div>
</div>
{% endif %}

<div class="m-card">
    <div class="m-card-body">
        <form method="post" action="/auth/reset-password" class="ant-form ant-form-vertical" novalidate>
            <input type="hidden" name="__RequestVerificationToken" value="{{ antiforgery_token }}" />
            <input type="hidden" name="token" value="{{ token }}" />
            <div class="ant-form-item">
                <div class="ant-form-item-label"><label for="reset-password">New password</label></div>
                <div class="ant-form-item-control"><input id="reset-password" type="password" name="password" autocomplete="new-password" minlength="8" class="ant-input" required /></div>
            </div>
            <div class="ant-form-item">
                <div class="ant-form-item-label"><label for="reset-confirm">Confirm password</label></div>
                <div class="ant-form-item-control"><input id="reset-confirm" type="password" name="confirm" autocomplete="new-password" minlength="8" class="ant-input" required /></div>
            </div>
            <div class="m-form-actions m-mt-16">
                <button type="submit" class="ant-btn ant-btn-primary"><span>Reset password</span></button>
            </div>
        </form>
    </div>
</div>

{# Module home page for Fluid #}

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Modules</div><h1 class="m-page-title">{{ module_name }} module</h1></div>
</div>

<div class="m-row-cards">
    <div class="m-grid m-cols-3">
        <div class="m-card m-stat-card">
            <div class="m-card-body">
                <div class="m-stat-card-head"><span>Entities</span></div>
                <div class="m-stat-card-value">{{ entity_count | default: 0 }}</div>
                    <div class="m-stat-sub">Domain models in this module</div>
            </div>
        </div>
        <div class="m-card m-stat-card">
            <div class="m-card-body">
                <div class="m-stat-card-head"><span>APIs</span></div>
                <div class="m-stat-card-value">{{ api_count | default: 0 }}</div>
                    <div class="m-stat-sub">REST endpoints exposed</div>
            </div>
        </div>
        <div class="m-card m-stat-card">
            <div class="m-card-body">
                <div class="m-stat-card-head"><span>Permissions</span></div>
                <div class="m-stat-card-value">{{ permission_count | default: 0 }}</div>
                    <div class="m-stat-sub">Access control policies</div>
            </div>
        </div>
    </div>

    <div class="m-card">
        <div class="m-card-header"><h2 class="m-card-title">Module overview</h2></div>
        <div class="m-card-body">
            <p class="m-mb-0">{{ module_description }}</p>
        </div>
    </div>
</div>

{% comment %} Theme toggle for Fluid: label (default 'Theme'). The button is wired by the Modulus scripts (data-theme-toggle). {% endcomment %}
<button type="button" class="ant-btn ant-btn-default m-theme-toggle" data-theme-toggle aria-label="{{ label | default: 'Switch colour theme' }}"><span>{{ label | default: 'Theme' }}</span></button>

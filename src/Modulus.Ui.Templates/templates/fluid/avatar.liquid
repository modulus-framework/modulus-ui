{% comment %} Avatar for Fluid: name, src (image), size (sm, md, lg). Without an image it shows the initial of the name. The markup is the one <app-avatar> draws. {% endcomment %}
{% assign size_class = '' %}
{% if size == 'sm' %}{% assign size_class = ' ant-avatar-sm' %}{% elsif size == 'lg' %}{% assign size_class = ' ant-avatar-lg' %}{% endif %}
{% assign initial = name | slice: 0 | upcase %}

{% if src and src != blank %}
<span class="ant-avatar ant-avatar-circle ant-avatar-image{{ size_class }}" title="{{ name }}"><img src="{{ src }}" alt="{{ name }}" /></span>
{% else %}
<span class="ant-avatar ant-avatar-circle{{ size_class }}" title="{{ name }}"><span class="ant-avatar-string">{{ initial }}</span></span>
{% endif %}

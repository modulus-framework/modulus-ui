{# Admin Dashboard for Fluid #}
{% assign total_users = total_users | default: 0 %}
{% assign active_sessions = active_sessions | default: 0 %}
{% assign total_modules = total_modules | default: 0 %}

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Overview</div><h1 class="m-page-title">Dashboard</h1></div>
</div>

<div class="m-row-cards">
    <div class="m-grid m-cols-4">
        <div class="m-card m-stat-card">
            <div class="m-card-body">
                <div class="m-stat-card-head"><span>Total users</span></div>
                <div class="m-stat-card-value">{{ total_users }}</div>
            </div>
        </div>
        <div class="m-card m-stat-card">
            <div class="m-card-body">
                <div class="m-stat-card-head"><span>Active sessions</span></div>
                <div class="m-stat-card-value">{{ active_sessions }}</div>
            </div>
        </div>
        <div class="m-card m-stat-card">
            <div class="m-card-body">
                <div class="m-stat-card-head"><span>Modules</span></div>
                <div class="m-stat-card-value">{{ total_modules }}</div>
            </div>
        </div>
        <div class="m-card m-stat-card">
            <div class="m-card-body">
                <div class="m-stat-card-head"><span>System health</span></div>
                <div class="m-stat-card-value"><span class="m-text-success">100%</span></div>
            </div>
        </div>
    </div>

    <div class="m-grid m-cols-2">
        <div class="m-card">
            <div class="m-card-header"><h2 class="m-card-title">Recent users</h2></div>
            <div class="m-card-body m-card-body-flush">
                <div class="ant-table-wrapper m-table-flush">
                    <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                        <table style="table-layout:auto">
                            <thead class="ant-table-thead"><tr><th class="ant-table-cell">Name</th><th class="ant-table-cell">Email</th><th class="ant-table-cell">Status</th></tr></thead>
                            <tbody class="ant-table-tbody">
                                <tr class="ant-table-row"><td class="ant-table-cell"><strong>Sample User</strong></td><td class="ant-table-cell m-muted">user@example.com</td><td class="ant-table-cell"><span class="m-badge m-badge-success-lt">Active</span></td></tr>
                            </tbody>
                        </table>
                    </div></div></div>
                </div>
            </div>
        </div>
        <div class="m-card">
            <div class="m-card-header"><h2 class="m-card-title">System status</h2></div>
            <div class="m-card-body">
                <ul class="m-list m-list-plain">
                    <li class="m-flex m-between m-mb-12"><span>API gateway</span><span class="m-badge m-badge-success-lt">Running</span></li>
                    <li class="m-flex m-between m-mb-12"><span>Database</span><span class="m-badge m-badge-success-lt">Connected</span></li>
                    <li class="m-flex m-between"><span>Cache</span><span class="m-badge m-badge-success-lt">Active</span></li>
                </ul>
            </div>
        </div>
    </div>
</div>

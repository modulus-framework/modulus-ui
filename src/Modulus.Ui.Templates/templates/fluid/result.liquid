{% comment %} Result for Fluid: status (success, info, warning, error, 404, 403, 500), title, sub_title, action_text and action_url (one link button). The classes and the icon are the ones <app-result> draws; the status code is the class, as in MVC. {% endcomment %}
{% assign status = status | default: 'success' | downcase %}

<div class="ant-result ant-result-{{ status }}" role="status">
    <div class="ant-result-icon">
        {% if status == 'success' %}{% icon "check-circle" %}{% elsif status == 'warning' %}{% icon "warning" %}{% elsif status == 'error' %}{% icon "close-circle" %}{% else %}{% icon "exclamation-circle" %}{% endif %}
    </div>
    {% if title %}<div class="ant-result-title">{{ title }}</div>{% endif %}
    {% if sub_title %}<div class="ant-result-subtitle">{{ sub_title }}</div>{% endif %}
    {% if action_text %}<div class="ant-result-extra"><a class="ant-btn ant-btn-primary" href="{{ action_url | default: '#' }}">{{ action_text }}</a></div>{% endif %}
</div>

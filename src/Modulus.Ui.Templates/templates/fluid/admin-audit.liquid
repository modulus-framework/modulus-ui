{% comment %} Audit logs for Fluid: a static activity table with sample rows. Connect a real audit store by replacing the rows. {% endcomment %}

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Security</div><h1 class="m-page-title">Audit logs</h1></div>
</div>

<div class="ant-alert ant-alert-info ant-alert-with-description m-mb-16" role="alert">
    <div class="ant-alert-content">
        <div class="ant-alert-message">Sample data</div>
        <div class="ant-alert-description">This page shows built-in sample data. Connect your audit store to replace it.</div>
    </div>
</div>

<div class="m-card">
    <div class="m-card-header">
        <h2 class="m-card-title">Activity timeline</h2>
        <form method="get" class="m-card-actions">
            <input class="ant-input" type="search" name="q" placeholder="Search logs..." aria-label="Search logs" />
        </form>
    </div>
    <div class="m-card-body m-card-body-flush">
        <div class="ant-table-wrapper m-table-flush">
            <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                <table style="table-layout:auto">
                    <thead class="ant-table-thead"><tr><th class="ant-table-cell">When (UTC)</th><th class="ant-table-cell">Who</th><th class="ant-table-cell">What</th><th class="ant-table-cell">Target</th><th class="ant-table-cell">Details</th></tr></thead>
                    <tbody class="ant-table-tbody">
                        <tr class="ant-table-row"><td class="ant-table-cell">2026-11-16 09:12</td><td class="ant-table-cell">admin@example.com</td><td class="ant-table-cell"><strong>user.created</strong></td><td class="ant-table-cell">asha@example.com</td><td class="ant-table-cell">Role: Viewer</td></tr>
                        <tr class="ant-table-row"><td class="ant-table-cell">2026-11-16 08:47</td><td class="ant-table-cell">admin@example.com</td><td class="ant-table-cell"><strong>role.updated</strong></td><td class="ant-table-cell">Manager</td><td class="ant-table-cell">Added permission: orders.approve</td></tr>
                        <tr class="ant-table-row"><td class="ant-table-cell">2026-11-15 17:03</td><td class="ant-table-cell">rafi@example.com</td><td class="ant-table-cell"><strong>auth.signed-in</strong></td><td class="ant-table-cell">rafi@example.com</td><td class="ant-table-cell">Two-factor: passed</td></tr>
                        <tr class="ant-table-row"><td class="ant-table-cell">2026-11-15 11:30</td><td class="ant-table-cell">admin@example.com</td><td class="ant-table-cell"><strong>settings.saved</strong></td><td class="ant-table-cell">System</td><td class="ant-table-cell">Time zone changed</td></tr>
                    </tbody>
                </table>
            </div></div></div>
        </div>
    </div>
</div>

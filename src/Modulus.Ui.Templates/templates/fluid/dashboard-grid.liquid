{% comment %} Dashboard grid for Fluid: items (each with content (rendered HTML) and span (columns, default 1)), columns (default 3). {% endcomment %}
{% assign cols = columns | default: 3 %}
<div class="m-dashboard-grid" style="display: grid; grid-template-columns: repeat({{ cols }}, minmax(0, 1fr)); gap: 16px;">
    {% for item in items %}
    <div class="m-dashboard-cell" style="grid-column: span {{ item.span | default: 1 }};">{{ item.content }}</div>
    {% endfor %}
</div>

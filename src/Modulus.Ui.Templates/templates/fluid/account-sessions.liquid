{% comment %} Sessions for Fluid: sessions (each with id, type, client, created and expires: the signed-in user's active tokens, newest first), error (a message when the list could not be read), antiforgery_token. Each row ends its session by posting to /auth/sessions/end. {% endcomment %}

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Account</div><h1 class="m-page-title">Sessions</h1></div>
</div>

{% if error and error != blank %}
<div class="ant-alert ant-alert-error ant-alert-with-description m-mb-16" role="alert">
    <div class="ant-alert-content"><div class="ant-alert-message">{{ error }}</div></div>
</div>
{% endif %}

<div class="m-card">
    <div class="m-card-header"><h2 class="m-card-title">Active sessions</h2></div>
    <div class="m-card-body m-card-body-flush">
        <div class="ant-table-wrapper m-table-flush">
            <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                <table style="table-layout:auto">
                    <thead class="ant-table-thead"><tr><th class="ant-table-cell">Type</th><th class="ant-table-cell">Client</th><th class="ant-table-cell m-hide-sm">Issued</th><th class="ant-table-cell m-hide-sm">Expires</th><th class="ant-table-cell"></th></tr></thead>
                    <tbody class="ant-table-tbody">
                        {% for session in sessions %}
                        <tr class="ant-table-row">
                            <td class="ant-table-cell">{{ session.type }}</td>
                            <td class="ant-table-cell">{{ session.client }}</td>
                            <td class="ant-table-cell m-hide-sm">{{ session.created }}</td>
                            <td class="ant-table-cell m-hide-sm">{{ session.expires }}</td>
                            <td class="ant-table-cell">
                                <form method="post" action="/auth/sessions/end">
                                    <input type="hidden" name="__RequestVerificationToken" value="{{ antiforgery_token }}" />
                                    <input type="hidden" name="id" value="{{ session.id }}" />
                                    <button type="submit" class="ant-btn ant-btn-text ant-btn-sm ant-btn-dangerous"><span>End session</span></button>
                                </form>
                            </td>
                        </tr>
                        {% else %}
                        <tr class="ant-table-row"><td class="ant-table-cell" colspan="5"><div class="m-empty">No active sessions.</div></td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div></div></div>
        </div>
    </div>
</div>

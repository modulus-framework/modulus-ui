    <div class="m-card-body m-card-body-flush">
        <div class="ant-table-wrapper m-table-flush">
            <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                <table style="table-layout:auto">
                    <thead class="ant-table-thead"><tr><th class="ant-table-cell">When</th><th class="ant-table-cell">Result</th><th class="ant-table-cell">Device</th></tr></thead>
                    <tbody class="ant-table-tbody">
                        <tr class="ant-table-row"><td class="ant-table-cell">2026-11-16 09:02</td><td class="ant-table-cell"><span class="m-badge m-badge-success-lt">Signed in</span></td><td class="ant-table-cell">Chrome on Windows</td></tr>
                        <tr class="ant-table-row"><td class="ant-table-cell">2026-11-15 21:40</td><td class="ant-table-cell"><span class="m-badge m-badge-success-lt">Signed in</span></td><td class="ant-table-cell">Safari on iPhone</td></tr>
                        <tr class="ant-table-row"><td class="ant-table-cell">2026-11-14 08:11</td><td class="ant-table-cell"><span class="m-badge m-badge-danger-lt">Wrong password</span></td><td class="ant-table-cell">Unknown</td></tr>
                    </tbody>
                </table>
            </div></div></div>

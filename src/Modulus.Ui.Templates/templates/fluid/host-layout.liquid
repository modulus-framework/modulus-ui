{% comment %} The page frame of a Liquid web host: the Modulus styles and scripts, then the page as `content`. Values are escaped by Fluid. {% endcomment %}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }} · {{ app_name }}</title>
    {% modulus_head %}
</head>
<body>
        <div class="m-page">
        <main class="m-page-body" id="main">
            <div class="m-container">
                {{ content }}
            </div>
        </main>
    </div>
</body>
</html>

{% comment %} Two-factor sign-in for Fluid: pending (the protected sign-in from the password step), error, antiforgery_token. Posts to /auth/two-factor, which checks the code at the BFF. Accepts an authenticator code or a recovery code. {% endcomment %}

<div class="m-page-header">
    <div class="m-page-header-text"><h1 class="m-page-title">Two-factor authentication</h1></div>
</div>

{% if error and error != blank %}
<div class="ant-alert ant-alert-error ant-alert-with-description m-mb-16" role="alert">
    <div class="ant-alert-content"><div class="ant-alert-message">{{ error }}</div></div>
</div>
{% endif %}

<div class="m-card">
    <div class="m-card-body">
        <p class="m-muted">Enter the 6-digit code from your authenticator app, or one of your recovery codes.</p>
        <form method="post" action="/auth/two-factor" class="ant-form ant-form-vertical" novalidate>
            <input type="hidden" name="__RequestVerificationToken" value="{{ antiforgery_token }}" />
            <input type="hidden" name="pending" value="{{ pending }}" />
            <div class="ant-form-item">
                <div class="ant-form-item-label"><label for="two-factor-code">Code</label></div>
                <div class="ant-form-item-control"><input id="two-factor-code" name="code" inputmode="text" autocomplete="one-time-code" autocapitalize="off" spellcheck="false" class="ant-input" required /></div>
            </div>
            <div class="m-form-actions m-mt-16">
                <button type="submit" class="ant-btn ant-btn-primary"><span>Verify</span></button>
            </div>
        </form>
    </div>
</div>

{# Card component for Fluid: title, header_action, content, footer #}
<div class="m-card {{ css_class }}">
    {% if title %}
    <div class="m-card-header">
        <h3 class="m-card-title">{{ title }}</h3>
        {% if header_action %}
        <div class="m-card-actions">{{ header_action }}</div>
        {% endif %}
    </div>
    {% endif %}
    <div class="m-card-body">
        {{ content }}
    </div>
    {% if footer %}
    <div class="m-card-footer">{{ footer }}</div>
    {% endif %}
</div>

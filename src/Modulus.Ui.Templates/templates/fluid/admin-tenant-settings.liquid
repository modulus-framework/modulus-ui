{% comment %} Tenant settings for Fluid: a static form with sample values for the tenant in the route (id). Connect a tenant directory to save. {% endcomment %}

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Administration</div><h1 class="m-page-title">Tenant settings</h1></div>
    <div class="m-page-actions"><a class="ant-btn" href="/admin/tenants"><span>Back to tenants</span></a></div>
</div>

<div class="ant-alert ant-alert-info ant-alert-with-description m-mb-16" role="alert">
    <div class="ant-alert-content">
        <div class="ant-alert-message">Sample data</div>
        <div class="ant-alert-description">This page shows built-in sample values for tenant {{ id }}. Connect your tenant directory to save them.</div>
    </div>
</div>

<div class="m-card">
    <div class="m-card-header"><h2 class="m-card-title">General settings</h2></div>
    <div class="m-card-body">
        <form method="post" class="ant-form ant-form-vertical" novalidate>
            <div class="m-form-grid">
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="tenant-name">Tenant name</label></div>
                    <div class="ant-form-item-control"><input id="tenant-name" name="name" placeholder="Company name" value="Tenant {{ id }}" class="ant-input" required /></div>
                </div>
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="tenant-domain">Domain</label></div>
                    <div class="ant-form-item-control"><input id="tenant-domain" value="tenant-{{ id }}.example.com" class="ant-input" disabled /></div>
                </div>
                <div class="ant-form-item m-span-2">
                    <div class="ant-form-item-label"><label for="tenant-description">Description</label></div>
                    <div class="ant-form-item-control"><textarea id="tenant-description" name="description" placeholder="Describe the company" class="ant-input" rows="4"></textarea></div>
                </div>
            </div>
            <div class="m-form-actions">
                <button type="submit" class="ant-btn ant-btn-primary"><span>Save changes</span></button>
            </div>
        </form>
    </div>
</div>

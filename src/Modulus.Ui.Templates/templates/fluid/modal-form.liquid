{% comment %} Modal form for Fluid: open (drawn only when true), title, action (the form's post URL), fields (rendered HTML), submit_label, cancel_url. {% endcomment %}
{% if open %}
<div class="ant-modal-root">
    <div class="ant-modal-mask"></div>
    <div class="ant-modal-wrap" role="dialog" aria-modal="true" aria-labelledby="modal-form-title">
        <div class="ant-modal">
            <form class="ant-form ant-form-vertical" method="post" action="{{ action }}">
                <div class="ant-modal-content">
                    <div class="ant-modal-header"><div class="ant-modal-title" id="modal-form-title">{{ title }}</div></div>
                    <div class="ant-modal-body">{{ fields }}</div>
                    <div class="ant-modal-footer">
                        {% if cancel_url and cancel_url != blank %}<a class="ant-btn ant-btn-default" href="{{ cancel_url }}"><span>Cancel</span></a>{% endif %}
                        <button type="submit" class="ant-btn ant-btn-primary"><span>{{ submit_label | default: 'Save' }}</span></button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
{% endif %}

<!DOCTYPE html>
<html>
<head>
    <title>{{ entity_name_plural }}</title>
    {% modulus_head %}
</head>
<body>
    <div class="page-wrapper">
        <div class="container-xl">
            <div class="page-header d-mb-4">
                <div class="row align-items-center">
                    <div class="col">
                        <h2 class="page-title">{{ entity_name_plural }}</h2>
                    </div>
                    <div class="col-auto">
                        <a href="/{{ route_prefix }}/create" class="btn btn-primary">
                            {% icon 'plus' %} New {{ entity_name }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="page-body">
            <div class="container-xl">
                <div class="row row-deck row-cards">
                    <div class="col-12">
                        <div class="card">
                            <div class="table-responsive">
                                <table class="table table-vcenter">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Name</th>
                                            <th>Status</th>
                                            <th class="w-1">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for item in rows %}
                                        <tr>
                                            <td class="text-muted">{{ item.id }}</td>
                                            <td>{{ item.name }}</td>
                                            <td>
                                                {% if item.status == "active" %}
                                                    <span class="status-badge status-success">Active</span>
                                                {% else %}
                                                    <span class="status-badge status-default">Inactive</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <a href="/{{ route_prefix }}/edit/{{ item.id }}" class="btn btn-sm btn-ghost-primary">Edit</a>
                                            </td>
                                        </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

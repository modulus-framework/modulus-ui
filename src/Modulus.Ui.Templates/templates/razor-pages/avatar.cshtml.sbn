@* Avatar: ViewBag.Name, Src (image) and Size (sm, md, lg). Without an image it shows the initials. *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@{
    string name = ViewBag.Name ?? "";
    string? src = ViewBag.Src;
    string size = ((string?)ViewBag.Size ?? "md") switch { "sm" => "small", "lg" => "large", _ => "default" };
}

<app-avatar name="@name" src="@src" size="@size" />

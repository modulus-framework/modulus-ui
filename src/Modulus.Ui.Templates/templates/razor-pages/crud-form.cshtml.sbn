@page "/{{ entity_name_plural | downcase }}/Create"
@page "/{{ entity_name_plural | downcase }}/Edit/{id}"
@using Modulus.Samples.Shared
@model {{ entity_name }}Dto
@{
    ViewData["Title"] = string.IsNullOrEmpty(Model?.Id.ToString()) ? "Create {{ entity_name }}" : "Edit {{ entity_name }}";
}

<div class="page-wrapper">
    <div class="container-xl">
        <div class="page-header d-mb-4">
            <div class="row align-items-center">
                <div class="col">
                    <h2 class="page-title">{{ entity_name_plural }}</h2>
                    <nav aria-label="breadcrumb" class="ms-2">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/{{ entity_name_plural | downcase }}">{{ entity_name_plural }}</a></li>
                            <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>
    <div class="page-body">
        <div class="container-xl">
            <div class="row">
                <div class="col-md-8 col-lg-6">
                    <div class="card">
                        <div class="card-body">
                            <form method="post" class="form-horizontal">
                                @if (Model?.Id != Guid.Empty)
                                {
                                    <input type="hidden" asp-for="Id" />
                                }

                                <div class="mb-3">
                                    <label class="form-label">Name <span class="badge badge-pill badge-danger">Required</span></label>
                                    <input type="text" asp-for="Name" class="form-control" placeholder="Enter name" required />
                                    <span asp-validation-for="Name" class="form-text text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Description</label>
                                    <textarea class="form-control" rows="4" placeholder="Enter description"></textarea>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Status</label>
                                    <select class="form-select">
                                        <option selected>Choose status</option>
                                        <option value="active">Active</option>
                                        <option value="inactive">Inactive</option>
                                    </select>
                                </div>

                                <div class="form-footer">
                                    <button type="submit" class="btn btn-primary">
                                        @if (Model?.Id != Guid.Empty)
                                        {
                                            <span>Update</span>
                                        }
                                        else
                                        {
                                            <span>Create</span>
                                        }
                                    </button>
                                    <a href="/{{ entity_name_plural | downcase }}" class="btn btn-link">Cancel</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Heatmap: sample data below, replace it with your own (a query, an API call). *@
@page "/charts/heatmap"
@addTagHelper *, Modulus.AspNetCore.Mvc
@using Modulus.Ui.Abstractions.Charts
@{
    ViewData["Title"] = "Heatmap";
    var days = new[] { "Mon", "Tue", "Wed", "Thu", "Fri" };
    var hours = new[] { "9", "11", "13", "15", "17" };
    var values = new double[][]
    {
        new double[] { 4, 8, 6, 9, 3 },
        new double[] { 5, 9, 7, 8, 4 },
        new double[] { 3, 7, 9, 6, 5 },
        new double[] { 6, 8, 8, 7, 2 },
        new double[] { 2, 5, 6, 4, 1 },
    };
}

<app-page-header pretitle="Charts" title="Heatmap"></app-page-header>

<div class="m-card">
    <div class="m-card-header"><h2 class="m-card-title">Heatmap</h2></div>
    <div class="m-card-body">
        <app-heatmap rows="days" columns="hours" values="values" />
    </div>
</div>

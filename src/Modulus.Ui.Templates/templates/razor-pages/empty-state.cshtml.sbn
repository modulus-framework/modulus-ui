@* Empty state: shown when a list or search has no results. ViewBag.Title, Message, ActionText, ActionUrl *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@{
    string title = ViewBag.Title ?? "Nothing here yet";
    string? message = ViewBag.Message;
    string? actionText = ViewBag.ActionText;
    string actionUrl = ViewBag.ActionUrl ?? "#";
}

<div class="m-empty">
    <h3 class="m-empty-title">@title</h3>
    @if (!string.IsNullOrEmpty(message))
    {
        <p class="m-empty-subtitle">@message</p>
    }
    @if (!string.IsNullOrEmpty(actionText))
    {
        <app-button type="primary" href="@actionUrl">@actionText</app-button>
    }
</div>

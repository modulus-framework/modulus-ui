@* Checkbox: ViewBag.Name, Label, Value, Checked, Help *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@{
    string name = ViewBag.Name ?? "";
    string label = ViewBag.Label ?? name;
    string? help = ViewBag.Help;
    string value = ViewBag.Value?.ToString() ?? "true";
    bool isChecked = ViewBag.Checked == true;
}

<app-form-item label="@label" help="@help">
    <app-checkbox name="@name" value="@value" checked="isChecked">@label</app-checkbox>
</app-form-item>

@* Tag input: ViewBag.Name, Label, Max, Placeholder, Help *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@{
    string name = ViewBag.Name ?? "";
    string label = ViewBag.Label ?? name;
    string? help = ViewBag.Help;
    int max = ViewBag.Max ?? 0;
    string? placeholder = ViewBag.Placeholder ?? "Type and press Enter";
}

<app-form-item label="@label" help="@help">
    <app-tag-input name="@name" max="max" placeholder="@placeholder" aria-label="@label" />
</app-form-item>

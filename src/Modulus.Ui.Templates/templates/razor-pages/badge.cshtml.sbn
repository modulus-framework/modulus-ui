@* Badge: ViewBag.Status (active, inactive, pending, error, anything else) and an optional Label *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@{
    string status = ((string?)ViewBag.Status ?? "default").ToLowerInvariant();
    string kind = status switch
    {
        "active" => "success",
        "inactive" => "default",
        "pending" => "warning",
        "error" => "error",
        _ => "processing"
    };
}

<app-badge status="@kind" text="@((string?)ViewBag.Label ?? status)" />

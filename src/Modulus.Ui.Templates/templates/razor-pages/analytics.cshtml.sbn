@page "/analytics"
{{ if use_auth }}@attribute [Microsoft.AspNetCore.Authorization.Authorize]
{{ end }}
@* Scaffold generated by `modulus ui`. This file is yours: edit the markup and the handlers freely. *@
@* The figures comes from IMetricsSource (Modulus.Ui.Abstractions.Admin). Until you register your own implementation the built-in *@
@* sample data answers and the page says so. To connect real data, implement IMetricsSource and register it after AddModulusMvc, *@
@* or replace the calls in @functions below with your own services. *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Mvc
@using Modulus.Ui.Abstractions.Admin
@inject IMetricsSource Metrics
@functions {
    public AnalyticsData Data { get; private set; } = new([], [], []);

    public async Task OnGetAsync() => Data = await Metrics.AnalyticsAsync();
}
@{
    ViewData["Title"] = "Analytics";
    var peak = Data.Traffic.Count == 0 ? 1 : Data.Traffic.Max(p => p.Value);
}

<app-page-header pretitle="Reports" title="Analytics &amp; insights"></app-page-header>

@if (Metrics.IsSample)
{
    <app-alert type="info" message="Sample data" description="This page shows built-in sample data. Register your own IMetricsSource to connect it to your analytics data." show-icon="true" />
}

<div class="m-row-cards">
    <div class="m-grid m-cols-4">
        @foreach (var s in Data.Stats)
        {
            <div class="m-card m-stat-card">
                <div class="m-card-body">
                    <div class="m-stat-card-head"><span>@s.Label</span></div>
                    <div class="m-stat-card-value">@s.Value</div>
                </div>
            </div>
        }
    </div>

    <div class="m-grid m-cols-main">
        <div class="m-card">
            <div class="m-card-header"><h2 class="m-card-title">Traffic over time</h2></div>
            <div class="m-card-body">
                @if (Data.Traffic.Count == 0)
                {
                    <div class="m-empty"><h3 class="m-empty-title">No traffic data</h3></div>
                }
                else
                {
                    @* A plain progress bar per point. Swap in the kit's chart tag helpers for a real chart. *@
                    <div class="m-bars">
                        @foreach (var p in Data.Traffic)
                        {
                            <label class="m-bar-row"><span>@p.Label</span><progress max="@peak" value="@p.Value"></progress><span>@p.Value</span></label>
                        }
                    </div>
                }
            </div>
        </div>
        <div class="m-card">
            <div class="m-card-header"><h2 class="m-card-title">Top pages</h2></div>
    <div class="m-card-body m-card-body-flush">
        @if (Data.TopPages.Count == 0)
        {
            <div class="m-empty">
                <h3 class="m-empty-title">No page data</h3>
            </div>
        }
        else
        {
            <div class="ant-table-wrapper m-table-flush">
                <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                    <table style="table-layout:auto">
                        <thead class="ant-table-thead"><tr><th class="ant-table-cell">Page</th><th class="ant-table-cell">Views</th></tr></thead>
                        <tbody class="ant-table-tbody">
                            @foreach (var p in Data.TopPages)
                            {
                                <tr class="ant-table-row">
                                    <td class="ant-table-cell">@p.Path</td>
                                    <td class="ant-table-cell">@p.Views</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div></div></div>
            </div>
        }
    </div>
        </div>
    </div>
</div>

<style>
    .m-bars { display: flex; flex-direction: column; gap: 8px; }
    .m-bar-row { display: grid; grid-template-columns: 48px 1fr 56px; gap: 12px; align-items: center; }
    .m-bar-row progress { width: 100%; }
</style>

@page "/audit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@* Scaffold generated by `modulus ui`. This file is yours: edit the markup and the handlers freely. *@
@* The audit events comes from IAuditTrail (Modulus.Ui.Abstractions.Admin). Until you register your own implementation the built-in *@
@* sample data answers and the page says so. To connect real data, implement IAuditTrail and register it after AddModulusMvc, *@
@* or replace the calls in @functions below with your own services. *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Mvc
@using Modulus.Ui.Abstractions.Admin
@inject IAuditTrail Audit
@functions {
    [BindProperty(SupportsGet = true)] public string? Q { get; set; }
    public IReadOnlyList<AuditEntry> Items { get; private set; } = [];

    public async Task OnGetAsync() => Items = await Audit.SearchAsync(Q);
}
@{
    ViewData["Title"] = "Audit logs";
}

<app-page-header pretitle="Security" title="Audit logs"></app-page-header>

@if (Audit.IsSample)
{
    <app-alert type="info" message="Sample data" description="This page shows built-in sample data. Register your own IAuditTrail to connect it to your audit store." show-icon="true" />
}

<div class="m-card">
    <div class="m-card-header">
        <h2 class="m-card-title">Activity timeline</h2>
        <form method="get" class="m-card-actions">
            <input class="ant-input" type="search" name="q" value="@Q" placeholder="Search logs..." aria-label="Search logs" />
        </form>
    </div>
    <div class="m-card-body m-card-body-flush">
        @if (Items.Count == 0)
        {
            <div class="m-empty">
                <h3 class="m-empty-title">No events found</h3>
                <p class="m-empty-subtitle">Events appear here as things happen.</p>
            </div>
        }
        else
        {
            <div class="ant-table-wrapper m-table-flush">
                <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                    <table style="table-layout:auto">
                        <thead class="ant-table-thead"><tr><th class="ant-table-cell">When (UTC)</th><th class="ant-table-cell">Who</th><th class="ant-table-cell">What</th><th class="ant-table-cell">Target</th><th class="ant-table-cell">Details</th></tr></thead>
                        <tbody class="ant-table-tbody">
                            @foreach (var e in Items)
                            {
                                <tr class="ant-table-row">
                                    <td class="ant-table-cell">@e.At.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="ant-table-cell">@e.Actor</td>
                                    <td class="ant-table-cell"><strong>@e.Action</strong></td>
                                    <td class="ant-table-cell">@e.Target</td>
                                    <td class="ant-table-cell">@e.Detail</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div></div></div>
            </div>
        }
    </div>
</div>

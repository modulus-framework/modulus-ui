@* Sankey chart: sample data below, replace it with your own (a query, an API call). *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@using Modulus.Ui.Abstractions.Charts
@{
    ViewData["Title"] = "Sankey chart";
    var flows = new[]
    {
        new SankeyLink("Supplier A", "Plant", 60), new SankeyLink("Supplier B", "Plant", 40),
        new SankeyLink("Plant", "Customers", 85), new SankeyLink("Plant", "Scrap", 15),
    };
}

<app-page-header pretitle="Charts" title="Sankey chart"></app-page-header>

<div class="m-card">
    <div class="m-card-header"><h2 class="m-card-title">Sankey chart</h2></div>
    <div class="m-card-body">
        <app-sankey-chart flows="flows" title="Material flow" height="300" />
    </div>
</div>

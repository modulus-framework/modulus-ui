@* Permission matrix for {{ entity_name }}: roles down, permissions across. Reads and changes grants through the Modulus.Authorization.Management endpoints ({{ api_prefix }}/grants). *@
@page "/permissions/{{ entity_route }}"
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@addTagHelper *, Modulus.AspNetCore.Mvc
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@{
    ViewData["Title"] = "{{ entity_name }} permissions";
    var csrf = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}

<app-page-header pretitle="Security" title="{{ entity_name }} permissions"></app-page-header>

<input type="hidden" id="csrf" value="@csrf" />

<div id="result" class="ant-alert m-mb-16" role="alert" hidden><div class="ant-alert-content"><div id="result-text" class="ant-alert-message"></div></div></div>

<div class="m-card">
    <div class="m-card-header"><h2 class="m-card-title">Roles and permissions</h2></div>
    <div class="m-card-body">
        <p class="m-muted">Tick a box to grant the permission to the role; clear it to revoke. A role that is denied a permission shows a locked box.</p>
    </div>
    <div class="ant-table-wrapper m-table-flush">
        <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
            <table style="table-layout:auto">
                <thead class="ant-table-thead">
                    <tr>
                        <th class="ant-table-cell" scope="col">Role</th>
{{~ for p in permissions ~}}
                        <th class="ant-table-cell" scope="col" title="{{ p.key }}">{{ p.label }}</th>
{{~ end ~}}
                    </tr>
                </thead>
                <tbody class="ant-table-tbody">
{{~ for r in roles ~}}
                    <tr class="ant-table-row">
                        <td class="ant-table-cell" role="rowheader"><strong>{{ r }}</strong></td>
{{~ for p in permissions ~}}
                        <td class="ant-table-cell"><input type="checkbox" data-role="{{ r }}" data-permission="{{ p.key }}" aria-label="{{ r }}: {{ p.label }}" disabled /></td>
{{~ end ~}}
                    </tr>
{{~ end ~}}
                </tbody>
            </table>
        </div></div></div>
    </div>
</div>
<script nonce="@Modulus.AspNetCore.Hosting.CspNonce.Of(Context)">
    (function () {
        const csrf = document.getElementById('csrf').value;
        const api = '{{ api_prefix }}';
        const roles = [{{ for r in roles }}'{{ r }}'{{ if !for.last }}, {{ end }}{{ end }}];

        function show(message, ok) {
            const el = document.getElementById('result');
            document.getElementById('result-text').textContent = message;
            el.className = 'ant-alert m-mb-16 ant-alert-' + (ok ? 'success' : 'error');
            el.hidden = false;
        }
        function box(role, permission) {
            return document.querySelector('input[data-role="' + role + '"][data-permission="' + permission + '"]');
        }
        async function load() {
            for (const role of roles) {
                const res = await fetch(api + '/grants/Role/' + encodeURIComponent(role), { credentials: 'same-origin', headers: { 'Accept': 'application/json' } });
                if (!res.ok) { show('Could not read the grants (' + res.status + '). You need the authorization management permission.', false); return; }
                for (const g of await res.json()) {
                    const b = box(role, g.permission);
                    if (!b) continue;
                    if (g.type === 'Allow') b.checked = true;
                    if (g.type === 'Deny') { b.checked = false; b.title = 'Denied'; b.dataset.denied = 'true'; }
                }
            }
            document.querySelectorAll('input[data-role]').forEach(function (b) { b.disabled = b.dataset.denied === 'true'; });
        }
        document.addEventListener('change', async function (e) {
            const b = e.target;
            if (!b.matches || !b.matches('input[data-role]')) return;
            const role = b.dataset.role, permission = b.dataset.permission;
            b.disabled = true;
            const res = b.checked
                ? await fetch(api + '/grants', {
                    method: 'POST', credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrf },
                    body: JSON.stringify({ holderType: 'Role', holder: role, permissions: [permission], type: 'Allow' })
                })
                : await fetch(api + '/grants/Role/' + encodeURIComponent(role) + '/' + encodeURIComponent(permission), {
                    method: 'DELETE', credentials: 'same-origin', headers: { 'RequestVerificationToken': csrf }
                });
            if (!res.ok) { b.checked = !b.checked; show('The change was refused (' + res.status + ').', false); }
            else { show(role + ': ' + permission + (b.checked ? ' granted.' : ' revoked.'), true); }
            b.disabled = false;
        });
        load();
    })();
</script>

@page "/account/profile"
{{ if use_auth }}@attribute [Microsoft.AspNetCore.Authorization.Authorize]
{{ end }}
@* Scaffold generated by `modulus ui`. This file is yours: edit the markup and the handlers freely. *@
@* The signed-in user's profile comes from IUserDirectory (Modulus.Ui.Abstractions.Admin). Until you register your own implementation the built-in *@
@* sample data answers and the page says so. To connect real data, implement IUserDirectory and register it after AddModulusMvc, *@
@* or replace the calls in @functions below with your own services. *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Mvc
@using Modulus.Ui.Abstractions.Admin
@inject IUserDirectory Users
@functions {
    [BindProperty] public ProfileInfo Profile { get; set; } = new();

    public async Task OnGetAsync() => Profile = await Users.GetProfileAsync(User.Identity?.Name);

    public async Task<IActionResult> OnPostAsync()
    {
        if (string.IsNullOrWhiteSpace(Profile.FirstName) || string.IsNullOrWhiteSpace(Profile.Email))
        {
            TempData["Error"] = "First name and email are required.";
            return RedirectToPage();
        }
        await Users.SaveProfileAsync(User.Identity?.Name, Profile);
        TempData["Message"] = "Profile saved.";
        return RedirectToPage();
    }

    private static string Initials(ProfileInfo p) =>
        string.Concat(new[] { p.FirstName, p.LastName }.Where(n => !string.IsNullOrEmpty(n)).Select(n => char.ToUpperInvariant(n[0])));
}
@{
    ViewData["Title"] = "User profile";
}

<app-page-header pretitle="Account" title="Profile"></app-page-header>

@if (Users.IsSample)
{
    <app-alert type="info" message="Sample data" description="This page shows built-in sample data. Register your own IUserDirectory to connect it to your user store." show-icon="true" />
}
@if (TempData["Message"] is string flash)
{
    <app-alert type="success" message="@flash" show-icon="true" closable="true" />
}
@if (TempData["Error"] is string problem)
{
    <app-alert type="error" message="@problem" show-icon="true" closable="true" />
}

<div class="m-grid m-profile-grid">
    <div class="m-card">
        <div class="m-card-header"><h2 class="m-card-title">Profile information</h2></div>
        <div class="m-card-body">
            <form method="post" asp-antiforgery="true" class="ant-form ant-form-vertical" novalidate>
                <div class="m-profile-avatar">
                    <div class="m-avatar m-avatar-lg" aria-hidden="true">@Initials(Profile)</div>
                    <p class="m-profile-name">@Profile.FirstName @Profile.LastName</p>
                </div>

                <div class="m-divider"></div>

                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="first-name">First name</label></div>
                    <div class="ant-form-item-control"><input id="first-name" placeholder="First name" name="Profile.FirstName" value="@Profile.FirstName" class="ant-input" required /></div>
                </div>
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="last-name">Last name</label></div>
                    <div class="ant-form-item-control"><input id="last-name" placeholder="Last name" name="Profile.LastName" value="@Profile.LastName" class="ant-input" /></div>
                </div>
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="email">Email</label></div>
                    <div class="ant-form-item-control"><input id="email" placeholder="name@example.com" name="Profile.Email" value="@Profile.Email" type="email" class="ant-input" required /></div>
                </div>
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="phone">Phone</label></div>
                    <div class="ant-form-item-control"><input id="phone" placeholder="e.g. +1 555 010 0100" name="Profile.Phone" value="@Profile.Phone" type="tel" class="ant-input" /></div>
                </div>
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="job-title">Job title</label></div>
                    <div class="ant-form-item-control"><input id="job-title" placeholder="e.g. Operations manager" name="Profile.JobTitle" value="@Profile.JobTitle" class="ant-input" /></div>
                </div>
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="bio">Bio</label></div>
                    <div class="ant-form-item-control"><textarea id="bio" placeholder="Tell us about yourself" name="Profile.Bio" class="ant-input" rows="4">@Profile.Bio</textarea></div>
                </div>

                <div class="m-form-actions">
                    <app-button type="primary" html-type="submit">Save profile</app-button>
                </div>
            </form>
        </div>
    </div>

    <div class="m-card">
        <div class="m-card-header"><h2 class="m-card-title">Account information</h2></div>
        <div class="m-card-body">
            <div class="m-info-group">
                <div class="m-info-item"><p class="m-info-label">Member since</p><p class="m-info-value">@(Profile.MemberSince?.ToString("yyyy-MM-dd") ?? "—")</p></div>
                <div class="m-info-item"><p class="m-info-label">Account type</p><p class="m-info-value">@(Profile.AccountType ?? "—")</p></div>
                <div class="m-info-item"><p class="m-info-label">Last login</p><p class="m-info-value">@(Profile.LastLogin?.ToString("yyyy-MM-dd HH:mm") ?? "—")</p></div>
                <div class="m-info-item"><p class="m-info-label">Account status</p><p class="m-info-value">@(Profile.Status ?? "—")</p></div>
            </div>
            @* Add your own actions here, for example password change (/auth/...), two-factor, or account deletion. *@
        </div>
    </div>
</div>

<style>
    .m-profile-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 24px; }
    @@media (max-width: 768px) { .m-profile-grid { grid-template-columns: 1fr; } }

    .m-profile-avatar { display: flex; align-items: center; gap: 16px; margin-bottom: 16px; }
    .m-avatar { display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #1677ff; color: white; font-weight: 600; }
    .m-avatar-lg { width: 80px; height: 80px; font-size: 24px; }

    .m-profile-name { margin: 0; font-weight: 600; }
    .m-divider { border: none; border-top: 1px solid rgba(0, 0, 0, 0.06); margin: 16px 0; }

    .m-info-group { display: flex; flex-direction: column; gap: 12px; }
    .m-info-item { display: flex; justify-content: space-between; }
    .m-info-label { margin: 0; font-size: 12px; color: rgba(0, 0, 0, 0.45); }
    .m-info-value { margin: 0; font-weight: 500; }
</style>

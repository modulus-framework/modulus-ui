@* Org chart: sample data below, replace it with your own (a query, an API call). A node whose parent is null is a root. *@
@page "/charts/org"
{{ if use_auth }}@attribute [Microsoft.AspNetCore.Authorization.Authorize]
{{ end }}
@addTagHelper *, Modulus.AspNetCore.Mvc
@using Modulus.Ui.Abstractions.Charts
@{
    ViewData["Title"] = "Org chart";
    var people = new[]
    {
        new OrgNode("1", null, "Ada Lovelace", "CEO"),
        new OrgNode("2", "1", "Grace Hopper", "Finance"),
        new OrgNode("3", "1", "Alan Turing", "Technology"),
        new OrgNode("4", "3", "Linus T.", "Platform"),
    };
}

<app-page-header pretitle="Charts" title="Org chart"></app-page-header>

<div class="m-card">
    <div class="m-card-header"><h2 class="m-card-title">Org chart</h2></div>
    <div class="m-card-body">
        <app-org-chart nodes="people" title="Company structure" />
    </div>
</div>

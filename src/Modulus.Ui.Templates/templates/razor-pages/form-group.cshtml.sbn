@* Form group: ViewBag.Label, Required, Help, Error, and the control as ViewBag.Content (markup) *@
<div class="ant-form-item">
    @if (!string.IsNullOrEmpty((string?)ViewBag.Label))
    {
        <div class="ant-form-item-label">
            <label class="@(ViewBag.Required == true ? "ant-form-item-required" : "")">@ViewBag.Label</label>
        </div>
    }
    <div class="ant-form-item-control">
        @ViewBag.Content
        @if (!string.IsNullOrEmpty((string?)ViewBag.Help))
        {
            <div class="m-muted m-mt-4">@ViewBag.Help</div>
        }
        @if (!string.IsNullOrEmpty((string?)ViewBag.Error))
        {
            <div class="ant-form-item-explain-error">@ViewBag.Error</div>
        }
    </div>
</div>

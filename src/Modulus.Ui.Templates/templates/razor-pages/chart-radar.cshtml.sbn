@* Radar chart: sample data below, replace it with your own (a query, an API call). *@
@page "/charts/radar"
{{ if use_auth }}@attribute [Microsoft.AspNetCore.Authorization.Authorize]
{{ end }}
@addTagHelper *, Modulus.AspNetCore.Mvc
@using Modulus.Ui.Abstractions.Charts
@{
    ViewData["Title"] = "Radar chart";
    var axes = new[] { "Quality", "Delivery", "Price", "Service", "Compliance" };
    var series = new[]
    {
        new ChartSeries("Supplier A", new double[] { 4.5, 4.0, 3.2, 4.1, 4.7 }),
        new ChartSeries("Supplier B", new double[] { 3.6, 4.6, 4.4, 3.5, 3.9 }),
    };
}

<app-page-header pretitle="Charts" title="Radar chart"></app-page-header>

<div class="m-card">
    <div class="m-card-header"><h2 class="m-card-title">Radar chart</h2></div>
    <div class="m-card-body">
        <app-radar-chart axes="axes" series="series" max="5" title="Supplier scorecard" height="320" />
    </div>
</div>

@* Breadcrumb navigation component *@
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        @{
            var breadcrumbs = ViewBag.Items as System.Collections.Generic.List<dynamic> ?? new System.Collections.Generic.List<dynamic>();
            if (breadcrumbs.Count == 0)
            {
                breadcrumbs = new System.Collections.Generic.List<dynamic>
                {
                    new { label = "Home", url = "/" }
                };
            }
        }
        @foreach (var (item, index) in breadcrumbs.Select((x, i) => (x, i)))
        {
            @if (index == breadcrumbs.Count - 1)
            {
                <li class="breadcrumb-item active" aria-current="page">@item.label</li>
            }
            else
            {
                <li class="breadcrumb-item">
                    <a href="@item.url">@item.label</a>
                </li>
            }
        }
    </ol>
</nav>

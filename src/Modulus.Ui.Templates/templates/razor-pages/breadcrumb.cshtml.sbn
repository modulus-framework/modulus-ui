@* Breadcrumb: ViewBag.Items is a list of (label, url); the last one is the current page *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@{
    var items = ViewBag.Items as System.Collections.Generic.List<dynamic> ?? new System.Collections.Generic.List<dynamic>();
    if (items.Count == 0)
    {
        items.Add(new { label = "Home", url = "/" });
    }
}

<app-breadcrumb>
    @for (var i = 0; i < items.Count; i++)
    {
        if (i == items.Count - 1)
        {
            <app-crumb>@items[i].label</app-crumb>
        }
        else
        {
            <app-crumb href="@items[i].url">@items[i].label</app-crumb>
        }
    }
</app-breadcrumb>

@page "/reports"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@* Scaffold generated by `modulus ui`. This file is yours: edit the markup and the handlers freely. *@
@* The reports comes from IMetricsSource (Modulus.Ui.Abstractions.Admin). Until you register your own implementation the built-in *@
@* sample data answers and the page says so. To connect real data, implement IMetricsSource and register it after AddModulusMvc, *@
@* or replace the calls in @functions below with your own services. *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Mvc
@using Modulus.Ui.Abstractions.Admin
@inject IMetricsSource Metrics
@functions {
    public ReportsData Data { get; private set; } = new([], []);

    public async Task OnGetAsync() => Data = await Metrics.ReportsAsync();
}
@{
    ViewData["Title"] = "Reports & analytics";
}

<app-page-header pretitle="Reports" title="Reports &amp; analytics"></app-page-header>

@if (Metrics.IsSample)
{
    <app-alert type="info" message="Sample data" description="This page shows built-in sample data. Register your own IMetricsSource to connect it to your report store." show-icon="true" />
}

<div class="m-row-cards">
    <div class="m-grid m-cols-4">
        @foreach (var s in Data.Stats)
        {
            <div class="m-card m-stat-card">
                <div class="m-card-body">
                    <div class="m-stat-card-head"><span>@s.Label</span></div>
                    <div class="m-stat-card-value">@s.Value</div>
                </div>
            </div>
        }
    </div>

    <div class="m-card">
        <div class="m-card-header"><h2 class="m-card-title">Available reports</h2></div>
    <div class="m-card-body m-card-body-flush">
        @if (Data.Reports.Count == 0)
        {
            <div class="m-empty">
                <h3 class="m-empty-title">No reports yet</h3>
                <p class="m-empty-subtitle">Add report links or download buttons in the last column when you connect real reports.</p>
            </div>
        }
        else
        {
            <div class="ant-table-wrapper m-table-flush">
                <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                    <table style="table-layout:auto">
                        <thead class="ant-table-thead"><tr><th class="ant-table-cell">Report</th><th class="ant-table-cell">Schedule</th><th class="ant-table-cell">Last run</th></tr></thead>
                        <tbody class="ant-table-tbody">
                            @foreach (var r in Data.Reports)
                            {
                                <tr class="ant-table-row">
                                    <td class="ant-table-cell"><strong>@r.Name</strong></td>
                                    <td class="ant-table-cell">@r.Schedule</td>
                                    <td class="ant-table-cell">@(r.LastRun?.ToString("yyyy-MM-dd") ?? "Never")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div></div></div>
            </div>
        }
    </div>
    </div>
</div>

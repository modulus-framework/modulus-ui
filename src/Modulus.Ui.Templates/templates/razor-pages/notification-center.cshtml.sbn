@page "/notifications"
@addTagHelper *, Modulus.AspNetCore.Mvc
@* Notification center - list all notifications with filtering and actions *@
@{
    ViewData["Title"] = "Notifications";
}

<app-page-header pretitle="Account" title="Notifications"></app-page-header>

<div class="m-card">
    <div class="m-card-header">
        <h2 class="m-card-title">Notification center</h2>
        <div class="m-card-actions">
            <app-button type="default" href="#">Mark all as read</app-button>
            <app-input type="search" name="q" placeholder="Search notifications..." aria-label="Search notifications" prefix-icon="search" />
        </div>
    </div>
    <div class="m-card-body m-card-body-flush">
        <div class="m-notification-list">
            <div class="m-notification-item m-notification-unread">
                <div class="m-notification-icon m-notification-info">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                </div>
                <div class="m-notification-content">
                    <h4 class="m-notification-title">System update completed</h4>
                    <p class="m-notification-message m-muted">Version 2.1.0 has been deployed successfully</p>
                    <span class="m-notification-time m-muted">2 hours ago</span>
                </div>
                <div class="m-notification-actions">
                    <button type="button" class="ant-btn ant-btn-text ant-btn-sm">Dismiss</button>
                </div>
            </div>
            <div class="m-notification-item m-notification-unread">
                <div class="m-notification-icon m-notification-success">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </div>
                <div class="m-notification-content">
                    <h4 class="m-notification-title">Report generated</h4>
                    <p class="m-notification-message m-muted">Your monthly sales report is ready to view</p>
                    <span class="m-notification-time m-muted">5 hours ago</span>
                </div>
                <div class="m-notification-actions">
                    <button type="button" class="ant-btn ant-btn-text ant-btn-sm">View</button>
                </div>
            </div>
            <div class="m-notification-item">
                <div class="m-notification-icon m-notification-warning">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3.05h16.94a2 2 0 0 0 1.71-3.05L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                </div>
                <div class="m-notification-content">
                    <h4 class="m-notification-title">Subscription expiring soon</h4>
                    <p class="m-notification-message m-muted">Your license will expire in 15 days. Renew now to avoid service interruption</p>
                    <span class="m-notification-time m-muted">1 day ago</span>
                </div>
                <div class="m-notification-actions">
                    <button type="button" class="ant-btn ant-btn-text ant-btn-sm">Renew</button>
                </div>
            </div>
            <div class="m-notification-item">
                <div class="m-notification-icon m-notification-error">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                </div>
                <div class="m-notification-content">
                    <h4 class="m-notification-title">Failed backup</h4>
                    <p class="m-notification-message m-muted">Automated backup failed. Check logs and retry manually</p>
                    <span class="m-notification-time m-muted">2 days ago</span>
                </div>
                <div class="m-notification-actions">
                    <button type="button" class="ant-btn ant-btn-text ant-btn-sm">Details</button>
                </div>
            </div>
        </div>
    </div>
    <div class="m-card-footer">
        <app-pagination total="40" current="1" page-size="10" url="/notifications" />
    </div>
</div>

<style>
    .m-notification-list { max-width: 100%; }
    .m-notification-item {
        display: flex;
        gap: 16px;
        padding: 16px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
        align-items: flex-start;
        transition: background-color 0.2s;
    }
    .m-notification-item:hover { background-color: rgba(0, 0, 0, 0.02); }
    .m-notification-item.m-notification-unread {
        background-color: rgba(22, 119, 255, 0.06);
        font-weight: 500;
    }
    .m-notification-icon {
        display: flex;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .m-notification-icon.m-notification-info { background-color: rgba(22, 119, 255, 0.1); color: #1677ff; }
    .m-notification-icon.m-notification-success { background-color: rgba(52, 211, 153, 0.1); color: #34d399; }
    .m-notification-icon.m-notification-warning { background-color: rgba(251, 146, 60, 0.1); color: #fb923c; }
    .m-notification-icon.m-notification-error { background-color: rgba(239, 68, 68, 0.1); color: #ef4444; }
    .m-notification-content { flex: 1; }
    .m-notification-title { margin: 0; font-size: 14px; }
    .m-notification-message { margin: 4px 0; font-size: 13px; }
    .m-notification-time { font-size: 12px; }
    .m-notification-actions { display: flex; gap: 8px; }
</style>

@page "/notifications"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@* Scaffold generated by `modulus ui`. This file is yours: edit the markup and the handlers freely. *@
@* The notifications comes from INotificationCenter (Modulus.Ui.Abstractions.Admin). Until you register your own implementation the built-in *@
@* sample data answers and the page says so. To connect real data, implement INotificationCenter and register it after AddModulusMvc, *@
@* or replace the calls in @functions below with your own services. *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Mvc
@using Modulus.Ui.Abstractions.Admin
@inject INotificationCenter Notifications
@functions {
    [BindProperty(SupportsGet = true)] public string? Q { get; set; }
    public IReadOnlyList<UserNotification> Items { get; private set; } = [];

    public async Task OnGetAsync() => Items = await Notifications.ListAsync(User.Identity?.Name, Q);

    public async Task<IActionResult> OnPostReadAsync(string? id)
    {
        await Notifications.MarkReadAsync(User.Identity?.Name, id);
        return RedirectToPage();
    }
}
@{
    ViewData["Title"] = "Notifications";
}

<app-page-header pretitle="Account" title="Notifications">
    <form method="post" asp-page-handler="Read" asp-antiforgery="true">
        <app-button type="default" html-type="submit">Mark all as read</app-button>
    </form>
</app-page-header>

@if (Notifications.IsSample)
{
    <app-alert type="info" message="Sample data" description="This page shows built-in sample data. Register your own INotificationCenter to connect it to your notification source." show-icon="true" />
}

<div class="m-card">
    <div class="m-card-header">
        <h2 class="m-card-title">Notification center</h2>
        <form method="get" class="m-card-actions">
            <input class="ant-input" type="search" name="q" value="@Q" placeholder="Search notifications..." aria-label="Search notifications" />
        </form>
    </div>
    <div class="m-card-body m-card-body-flush">
        @if (Items.Count == 0)
        {
            <div class="m-empty">
                <h3 class="m-empty-title">No notifications</h3>
                <p class="m-empty-subtitle">New notifications will appear here.</p>
            </div>
        }
        else
        {
            <div class="ant-table-wrapper m-table-flush">
                <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                    <table style="table-layout:auto">
                        <thead class="ant-table-thead"><tr><th class="ant-table-cell"></th><th class="ant-table-cell">Notification</th><th class="ant-table-cell">When</th><th class="ant-table-cell"></th></tr></thead>
                        <tbody class="ant-table-tbody">
                            @foreach (var n in Items)
                            {
                                <tr class="ant-table-row">
                                    <td class="ant-table-cell">@(n.Read ? "" : "●")</td>
                                    <td class="ant-table-cell">
                                        @if (n.Read) { <span>@n.Title</span> } else { <strong>@n.Title</strong> }
                                        <div class="m-muted">@n.Message</div>
                                    </td>
                                    <td class="ant-table-cell">@n.At.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="ant-table-cell">
                                        @if (!n.Read)
                                        {
                                            <form method="post" asp-page-handler="Read" asp-route-id="@n.Id" asp-antiforgery="true">
                                                <button type="submit" class="ant-btn ant-btn-text ant-btn-sm"><span>Mark read</span></button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div></div></div>
            </div>
        }
    </div>
</div>

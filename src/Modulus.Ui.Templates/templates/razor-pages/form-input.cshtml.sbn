@* Form input: label, control, hint and validation message for one field. ViewBag.Name, Label, Type, Value, Placeholder, Help, Error, Required *@
@{
    string name = ViewBag.Name ?? "";
    string label = ViewBag.Label ?? name;
    string type = ViewBag.Type ?? "text";
    string? value = ViewBag.Value?.ToString();
    string? placeholder = ViewBag.Placeholder;
    string? help = ViewBag.Help;
    string? error = ViewBag.Error;
    bool required = ViewBag.Required == true;
}

<div class="ant-form-item">
    <div class="ant-form-item-label">
        <label for="@name" class="@(required ? "ant-form-item-required" : "")">@label</label>
    </div>
    <div class="ant-form-item-control">
        <input id="@name" name="@name" type="@type" value="@value" placeholder="@placeholder" required="@required"
               class="ant-input@(string.IsNullOrEmpty(error) ? "" : " ant-input-status-error")" />
        @if (!string.IsNullOrEmpty(help))
        {
            <div class="m-muted m-mt-4">@help</div>
        }
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="ant-form-item-explain-error">@error</div>
        }
    </div>
</div>

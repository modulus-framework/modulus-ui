@* Modal: opened with $dispatch('modulus:modal-open', '<ModalId>') or modulusModal.open('<ModalId>'). *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@{
    string name = ViewBag.ModalId ?? "modal";
    int width = ViewBag.Size == "lg" ? 800 : ViewBag.Size == "sm" ? 400 : 520;
}

<app-modal name="@name" title="@((string?)ViewBag.Title)" width="width">
    @RenderBody()
</app-modal>

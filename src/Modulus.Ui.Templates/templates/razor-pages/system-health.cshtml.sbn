@page "/system/health"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@* Scaffold generated by `modulus ui`. This file is yours: edit the markup and the handlers freely. *@
@* The health figures comes from IMetricsSource (Modulus.Ui.Abstractions.Admin). Until you register your own implementation the built-in *@
@* sample data answers and the page says so. To connect real data, implement IMetricsSource and register it after AddModulusMvc, *@
@* or replace the calls in @functions below with your own services. *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Mvc
@using Modulus.Ui.Abstractions.Admin
@inject IMetricsSource Metrics
@functions {
    public HealthData Data { get; private set; } = new([], [], []);

    public async Task OnGetAsync() => Data = await Metrics.HealthAsync();
}
@{
    ViewData["Title"] = "System health";
}

<app-page-header pretitle="System" title="System health"></app-page-header>

@if (Metrics.IsSample)
{
    <app-alert type="info" message="Sample data" description="This page shows built-in sample data. Register your own IMetricsSource to connect it to your health checks and metrics." show-icon="true" />
}

<div class="m-row-cards">
    <div class="m-grid m-cols-4">
        @foreach (var s in Data.Stats)
        {
            <div class="m-card m-stat-card">
                <div class="m-card-body">
                    <div class="m-stat-card-head"><span>@s.Label</span></div>
                    <div class="m-stat-card-value">@s.Value</div>
                </div>
            </div>
        }
    </div>

    <div class="m-grid m-cols-main">
        <div class="m-card">
            <div class="m-card-header"><h2 class="m-card-title">Services</h2></div>
    <div class="m-card-body m-card-body-flush">
        @if (Data.Services.Count == 0)
        {
            <div class="m-empty">
                <h3 class="m-empty-title">No services reported</h3>
            </div>
        }
        else
        {
            <div class="ant-table-wrapper m-table-flush">
                <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                    <table style="table-layout:auto">
                        <thead class="ant-table-thead"><tr><th class="ant-table-cell">Service</th><th class="ant-table-cell">Status</th><th class="ant-table-cell">Details</th></tr></thead>
                        <tbody class="ant-table-tbody">
                            @foreach (var s in Data.Services)
                            {
                                <tr class="ant-table-row">
                                    <td class="ant-table-cell"><strong>@s.Name</strong></td>
                                    <td class="ant-table-cell">@s.Status</td>
                                    <td class="ant-table-cell">@s.Detail</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div></div></div>
            </div>
        }
    </div>
        </div>
        <div class="m-card">
            <div class="m-card-header"><h2 class="m-card-title">Resource usage</h2></div>
            <div class="m-card-body">
                @if (Data.Usage.Count == 0)
                {
                    <div class="m-empty"><h3 class="m-empty-title">No usage data</h3></div>
                }
                else
                {
                    <div class="m-bars">
                        @foreach (var g in Data.Usage)
                        {
                            <label class="m-bar-row"><span>@g.Label</span><progress max="100" value="@g.Percent"></progress><span>@g.Percent%</span></label>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .m-bars { display: flex; flex-direction: column; gap: 8px; }
    .m-bar-row { display: grid; grid-template-columns: 64px 1fr 48px; gap: 12px; align-items: center; }
    .m-bar-row progress { width: 100%; }
</style>

@page "/admin/settings"
{{ if use_auth }}@attribute [Microsoft.AspNetCore.Authorization.Authorize]
{{ end }}
@* Scaffold generated by `modulus ui`. This file is yours: edit the markup and the handlers freely. *@
@* The settings comes from IAdminSettingsStore (Modulus.Ui.Abstractions.Admin). Until you register your own implementation the built-in *@
@* sample data answers and the page says so. To connect real data, implement IAdminSettingsStore and register it after AddModulusMvc, *@
@* or replace the calls in @functions below with your own services. *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Mvc
@using Modulus.Ui.Abstractions.Admin
@inject IAdminSettingsStore Store
@functions {
    [BindProperty] public SystemSettings Settings { get; set; } = new();

    public async Task OnGetAsync() => Settings = await Store.GetAsync();

    public async Task<IActionResult> OnPostAsync()
    {
        if (string.IsNullOrWhiteSpace(Settings.AppName))
            TempData["Error"] = "The application needs a name.";
        else
        {
            await Store.SaveAsync(Settings);
            TempData["Message"] = "Settings saved.";
        }
        return RedirectToPage();
    }
}
@{
    ViewData["Title"] = "System settings";
}

<app-page-header pretitle="Administration" title="System settings"></app-page-header>

@if (Store.IsSample)
{
    <app-alert type="info" message="Sample data" description="This page shows built-in sample data. Register your own IAdminSettingsStore to connect it to your settings store." show-icon="true" />
}
@if (TempData["Message"] is string flash)
{
    <app-alert type="success" message="@flash" show-icon="true" closable="true" />
}
@if (TempData["Error"] is string problem)
{
    <app-alert type="error" message="@problem" show-icon="true" closable="true" />
}

<div class="m-card">
    <div class="m-card-header"><h2 class="m-card-title">General settings</h2></div>
    <div class="m-card-body">
        <form method="post" asp-antiforgery="true" class="ant-form ant-form-vertical" novalidate>
            <div class="m-form-grid">
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="app-name">Application name</label></div>
                    <div class="ant-form-item-control"><input id="app-name" placeholder="Application name" name="Settings.AppName" value="@Settings.AppName" class="ant-input" required /></div>
                </div>
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="support-email">Support email</label></div>
                    <div class="ant-form-item-control"><input id="support-email" placeholder="name@example.com" name="Settings.SupportEmail" value="@Settings.SupportEmail" type="email" class="ant-input" /></div>
                </div>
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="time-zone">Time zone</label></div>
                    <div class="ant-form-item-control">
                        <select id="time-zone" name="Settings.TimeZone" class="ant-input">
                            @foreach (var zone in SystemSettings.TimeZones)
                            {
                                <option value="@zone" selected="@(zone == Settings.TimeZone)">@zone</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="m-form-actions">
                <app-button type="primary" html-type="submit">Save changes</app-button>
            </div>
        </form>
    </div>
</div>

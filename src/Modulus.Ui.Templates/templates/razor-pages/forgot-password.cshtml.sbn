@page "/auth/forgot-password"
@addTagHelper *, Modulus.AspNetCore.Mvc
@* Forgot password page: talks to the Modulus.Identity account endpoints on this host (/account/...) *@
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot password";
}

<div class="m-auth-card">
    <div class="m-auth-card-body">
        <h1 class="m-auth-title">Forgot password</h1>
        <p class="m-auth-hint">Enter your email address and we will send you a link to reset it.</p>
        <div id="result" class="ant-alert m-mb-16" role="alert" hidden><div class="ant-alert-content"><div id="result-text" class="ant-alert-message"></div></div></div>
        <form id="form" class="ant-form ant-form-vertical ant-form-hide-required-mark" novalidate>
            <div class="ant-form-item">
                <div class="ant-form-item-label"><label for="email">Email address</label></div>
                <div class="ant-form-item-control"><input id="email" class="ant-input" type="email" placeholder="you@example.com" required autocomplete="email" /></div>
            </div>
            <div class="m-auth-actions">
                <app-button type="primary" html-type="submit" block>Send reset link</app-button>
            </div>
        </form>
        <p class="m-auth-hint m-mt-16"><a href="/Account/Login">Back to sign in</a></p>
    </div>
</div>

<script>
    async function post(url, body) {
        const res = await fetch(url, {
            method: 'POST',
            credentials: 'same-origin',
            headers: body === undefined ? {} : { 'Content-Type': 'application/json' },
            body: body === undefined ? undefined : JSON.stringify(body)
        });
        let data = null;
        try { data = await res.json(); } catch (e) { }
        return { ok: res.ok, data: data };
    }
    function show(id, message, ok) {
        const el = document.getElementById(id);
        document.getElementById(id + '-text').textContent = message;
        el.className = 'ant-alert m-mb-16 ant-alert-' + (ok ? 'success' : 'error');
        el.hidden = false;
    }
    document.getElementById('form').addEventListener('submit', async function (e) {
        e.preventDefault();
        const email = document.getElementById('email').value;
        const r = await post('/account/forgot-password?email=' + encodeURIComponent(email));
        show('result', r.ok ? (r.data && r.data.message) || 'If the address is registered, a reset link is on its way.' : (r.data && r.data.error) || 'Something went wrong. Try again.', r.ok);
    });
</script>

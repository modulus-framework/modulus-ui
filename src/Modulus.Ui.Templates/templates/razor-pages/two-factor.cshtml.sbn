@page "/auth/two-factor"
{{ if use_auth }}@attribute [Microsoft.AspNetCore.Authorization.Authorize]
{{ end }}
@* Two-factor authentication page: talks to the Modulus.Identity account endpoints on this host (/account/2fa/...). *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Two-factor authentication";
    var csrf = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
}

<input type="hidden" id="csrf" value="@csrf" />

<app-page-header pretitle="Account" title="Two-factor authentication"></app-page-header>

<div class="m-grid m-cols-main">
    <div class="m-card">
        <div class="m-card-body">
            <div id="result" class="ant-alert m-mb-16" role="alert" hidden><div class="ant-alert-content"><div id="result-text" class="ant-alert-message"></div></div></div>
            <div id="step-start">
                <p class="m-muted">Protect your account with an authenticator app (Microsoft Authenticator, Google Authenticator, 1Password ...).</p>
                <app-button type="primary" id="start">Set up two-factor authentication</app-button>
            </div>
            <div id="step-confirm" hidden>
                <p>Add this key to your authenticator app, or open the link on your phone:</p>
                <p><code id="key"></code></p>
                <p><a id="uri" href="#">Open in authenticator app</a></p>
                <form id="enable-form" class="ant-form ant-form-vertical" novalidate>
                    <div class="ant-form-item">
                        <div class="ant-form-item-label"><label for="code">Code from the app</label></div>
                        <div class="ant-form-item-control"><input id="code" placeholder="Enter the 6-digit code" class="ant-input" inputmode="numeric" autocomplete="one-time-code" /></div>
                    </div>
                    <app-button type="primary" html-type="submit" id="enable">Turn on</app-button>
                </form>
            </div>
            <div id="step-codes" hidden>
                <p class="m-text-success"><strong>Two-factor authentication is on.</strong></p>
                <p>Save these recovery codes. Each works once, and they are not shown again:</p>
                <pre id="codes" class="m-font-mono"></pre>
            </div>
            <app-divider></app-divider>
            <div id="step-disable">
                <form id="disable-form" class="ant-form ant-form-vertical" novalidate>
                    <div class="ant-form-item">
                        <div class="ant-form-item-label"><label for="password">Password (to turn it off)</label></div>
                        <div class="ant-form-item-control"><input id="password" placeholder="Enter your password" class="ant-input" type="password" autocomplete="current-password" /></div>
                    </div>
                    <app-button id="disable" html-type="submit" danger="true">Turn off two-factor authentication</app-button>
                </form>
            </div>
        </div>
    </div>
</div>

<script nonce="@Modulus.AspNetCore.Hosting.CspNonce.Of(HttpContext)">
    (function () {
        const csrf = document.getElementById('csrf').value;

        async function post(url, body) {
            const headers = { 'RequestVerificationToken': csrf };
            if (body !== undefined) headers['Content-Type'] = 'application/json';
            const res = await fetch(url, {
                method: 'POST',
                credentials: 'same-origin',
                headers: headers,
                body: body === undefined ? undefined : JSON.stringify(body)
            });
            let data = null;
            try { data = await res.json(); } catch (e) { }
            return { ok: res.ok, data: data };
        }
        function show(id, message, ok) {
            const el = document.getElementById(id);
            document.getElementById(id + '-text').textContent = message;
            el.className = 'ant-alert m-mb-16 ant-alert-' + (ok ? 'success' : 'error');
            el.hidden = false;
        }
        function reveal(id) { document.getElementById(id).hidden = false; }

        // Keep the forms from navigating; the handlers below do the work.
        ['enable-form', 'disable-form'].forEach(function (id) {
            document.getElementById(id).addEventListener('submit', function (e) { e.preventDefault(); });
        });

        document.getElementById('start').addEventListener('click', async function () {
            const r = await post('/account/2fa/setup');
            if (!r.ok) { show('result', 'Sign in first, then set up two-factor authentication.', false); return; }
            document.getElementById('key').textContent = r.data.sharedKey;
            document.getElementById('uri').href = r.data.authenticatorUri;
            document.getElementById('step-start').hidden = true;
            reveal('step-confirm');
        });
        document.getElementById('enable').addEventListener('click', async function () {
            const r = await post('/account/2fa/enable', { code: document.getElementById('code').value });
            if (!r.ok) { show('result', (r.data && r.data.error) || 'The code is not valid.', false); return; }
            document.getElementById('codes').textContent = r.data.recoveryCodes.join('\n');
            document.getElementById('step-confirm').hidden = true;
            reveal('step-codes');
        });
        document.getElementById('disable').addEventListener('click', async function () {
            const r = await post('/account/2fa/disable', { password: document.getElementById('password').value });
            show('result', r.ok ? 'Two-factor authentication is off.' : (r.data && r.data.error) || 'Could not turn it off.', r.ok);
        });
    })();
</script>

@page "/auth/reset-password"
@* Reset password page: talks to the Modulus.Identity account endpoints on this host (/account/...) *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset password";
    var csrf = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
}

<input type="hidden" id="csrf" value="@csrf" />

<div class="m-auth-card">
    <div class="m-auth-card-body">
        <h1 class="m-auth-title">Reset password</h1>
        <p class="m-auth-hint">Choose a new password for your account.</p>
        <div id="result" class="ant-alert m-mb-16" role="alert" hidden><div class="ant-alert-content"><div id="result-text" class="ant-alert-message"></div></div></div>
        <form id="form" class="ant-form ant-form-vertical ant-form-hide-required-mark" novalidate>
            <div class="ant-form-item">
                <div class="ant-form-item-label"><label for="password">New password</label></div>
                <div class="ant-form-item-control"><input id="password" class="ant-input" type="password" required autocomplete="new-password" /></div>
            </div>
            <div class="ant-form-item">
                <div class="ant-form-item-label"><label for="confirm">Confirm password</label></div>
                <div class="ant-form-item-control"><input id="confirm" class="ant-input" type="password" required autocomplete="new-password" /></div>
            </div>
            <div class="m-auth-actions">
                <app-button type="primary" html-type="submit" block>Reset password</app-button>
            </div>
        </form>
        <p class="m-auth-hint m-mt-16"><a href="/Account/Login">Back to sign in</a></p>
    </div>
</div>

<script nonce="@Modulus.AspNetCore.Hosting.CspNonce.Of(HttpContext)">
    (function () {
        const csrf = document.getElementById('csrf').value;
        const query = new URLSearchParams(window.location.search);

        function show(id, message, ok) {
            const el = document.getElementById(id);
            document.getElementById(id + '-text').textContent = message;
            el.className = 'ant-alert m-mb-16 ant-alert-' + (ok ? 'success' : 'error');
            el.hidden = false;
        }
        document.getElementById('form').addEventListener('submit', async function (e) {
            e.preventDefault();
            const password = document.getElementById('password').value;
            if (password !== document.getElementById('confirm').value) { show('result', 'The passwords do not match.', false); return; }
            const res = await fetch('/account/reset-password', {
                method: 'POST', credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrf },
                body: JSON.stringify({ email: query.get('email'), token: query.get('token'), newPassword: password })
            });
            let data = null;
            try { data = await res.json(); } catch (err) { }
            show('result', res.ok ? 'Your password has been reset. You can sign in now.' : (data && data.error) || 'The link is not valid or has expired.', res.ok);
        });
    })();
</script>

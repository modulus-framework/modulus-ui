@page "/{{ entity_name_plural | downcase }}"
@using Modulus.Ui.Abstractions.Grids
@model Modulus.Samples.Shared.PageRequest
@{
    ViewData["Title"] = "{{ entity_name_plural }}";
}

<div class="page-wrapper">
    <div class="container-xl">
        <div class="page-header d-mb-4">
            <div class="row align-items-center">
                <div class="col">
                    <h2 class="page-title">{{ entity_name_plural }}</h2>
                </div>
                <div class="col-auto">
                    <a href="./Create" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon">
                            <path d="M12 5v14m-7-7h14"></path>
                        </svg>
                        New {{ entity_name }}
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-deck row-cards">
                <div class="col-12">
                    <div class="card">
                        <div class="table-responsive">
                            <table class="table table-vcenter card-table">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Name</th>
                                        <th>Status</th>
                                        <th class="w-1">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (false)
                                    {
                                        <tr>
                                            <td><span class="text-secondary">Sample ID</span></td>
                                            <td>Sample Name</td>
                                            <td><span class="badge badge-success">Active</span></td>
                                            <td>
                                                <a href="./Details?id=1" class="btn btn-sm btn-ghost-primary">View</a>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-4">
                                                No {{ entity_name_plural | downcase }} found. <a href="./Create">Create one</a>.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* List page for {{ entity_name_plural }}: reads the {{ module_name }} API through {{ entity_name }}ApiClient. Page model: Index.cshtml.cs. The rows are in _List.cshtml. *@
@page "/{{ route }}"
{{ if use_auth }}@attribute [Microsoft.AspNetCore.Authorization.Authorize]
{{ end }}
@addTagHelper *, Modulus.AspNetCore.Mvc
@model {{ ui_namespace }}.Pages.{{ module_name }}.{{ entity_name_plural }}.IndexModel
@{
    ViewData["Title"] = "{{ entity_name_plural }}";
}

<app-page-header pretitle="{{ module_name }}" title="{{ entity_name_plural }}">
    <app-button type="primary" href="/{{ route }}/new">New {{ entity_name }}</app-button>
</app-page-header>

@if (Model.Message is not null)
{
    <app-alert type="@(Model.Failed ? "error" : "success")" message="@Model.Message" show-icon="true" closable="true" />
}

<div class="m-card">
    <div class="m-card-body m-card-body-flush">
        <partial name="_List" model="Model" />
    </div>
    @if (Model.PageNumber > 1 || Model.HasNext)
    {
        <div class="m-card-footer m-flex m-between">
            <span class="m-muted">Page @Model.PageNumber</span>
            <span class="m-flex">
                @if (Model.PageNumber > 1)
                {
                    <a class="ant-btn ant-btn-default ant-btn-sm" href="/{{ route }}?p=@(Model.PageNumber - 1)"><span>Previous</span></a>
                }
                @if (Model.HasNext)
                {
                    <a class="ant-btn ant-btn-default ant-btn-sm" href="/{{ route }}?p=@(Model.PageNumber + 1)"><span>Next</span></a>
                }
            </span>
        </div>
    }
</div>

<script nonce="@Modulus.AspNetCore.Hosting.CspNonce.Of(HttpContext)">
    // Asks before any form marked data-confirm is submitted. Inline onclick handlers are blocked by the Content-Security-Policy.
    document.addEventListener('submit', function (e) {
        var message = e.target.getAttribute('data-confirm');
        if (message && !window.confirm(message)) e.preventDefault();
    });
</script>

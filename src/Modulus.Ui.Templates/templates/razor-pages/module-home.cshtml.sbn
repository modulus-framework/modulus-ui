@page "/{{ module_name | string.downcase }}"
@addTagHelper *, Modulus.AspNetCore.Mvc
@* {{ module_name }} module (static sample data and ViewBag values: replace them with your own). *@
@{
    ViewData["Title"] = "{{ module_name }} module";
}

<app-page-header pretitle="Modules" title="{{ module_name }} module"></app-page-header>

<div class="m-row-cards">
    <div class="m-grid m-cols-3">
        <div class="m-card m-stat-card">
          <div class="m-card-body">
            <div class="m-stat-card-head"><span>Entities</span></div>
            <div class="m-stat-card-value">@(ViewBag.EntityCount ?? 0)</div>
          </div>
        </div>
        <div class="m-card m-stat-card">
          <div class="m-card-body">
            <div class="m-stat-card-head"><span>APIs</span></div>
            <div class="m-stat-card-value">@(ViewBag.ApiCount ?? 0)</div>
          </div>
        </div>
        <div class="m-card m-stat-card">
          <div class="m-card-body">
            <div class="m-stat-card-head"><span>Permissions</span></div>
            <div class="m-stat-card-value">@(ViewBag.PermissionCount ?? 0)</div>
          </div>
        </div>
    </div>

    <div class="m-card">
      <div class="m-card-header"><h2 class="m-card-title">Module overview</h2></div>
      <div class="m-card-body">
    <p class="m-mb-0">{{ module_description }}</p>
      </div>
    </div>
</div>

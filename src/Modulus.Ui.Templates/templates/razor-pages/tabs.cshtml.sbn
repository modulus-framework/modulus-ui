@* Tabs: ViewBag.Tabs is a list of (id, label, content), the first one is open. content is encoded as text when it is a string; pass an IHtmlContent to insert markup. *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@{
    var tabs = ViewBag.Tabs as System.Collections.Generic.List<dynamic> ?? new System.Collections.Generic.List<dynamic>();
    string? first = tabs.Count > 0 ? (string?)tabs[0].id : null;
}

<app-tabs active="@first">
    @foreach (var tab in tabs)
    {
        <app-tab key="@tab.id" title="@tab.label">@tab.content</app-tab>
    }
</app-tabs>

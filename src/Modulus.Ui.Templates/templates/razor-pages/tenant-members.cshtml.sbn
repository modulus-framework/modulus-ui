@page "/admin/tenants/{id}/members"
{{ if use_auth }}@attribute [Microsoft.AspNetCore.Authorization.Authorize]
{{ end }}
@* Scaffold generated by `modulus ui`. This file is yours: edit the markup and the handlers freely. *@
@* The tenant's members and invitations comes from ITenantDirectory (Modulus.Ui.Abstractions.Admin). Until you register your own implementation the built-in *@
@* sample data answers and the page says so. To connect real data, implement ITenantDirectory and register it after AddModulusMvc, *@
@* or replace the calls in @functions below with your own services. *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Mvc
@using Modulus.Ui.Abstractions.Admin
@inject ITenantDirectory Tenants
@functions {
    [BindProperty(SupportsGet = true)] public string? Q { get; set; }
    public string TenantId { get; private set; } = "";
    public IReadOnlyList<TenantMember> Items { get; private set; } = [];
    public IReadOnlyList<TenantInvitation> Invitations { get; private set; } = [];

    public async Task<IActionResult> OnGetAsync(string id)
    {
        if (await Tenants.GetAsync(id) is null) return NotFound();
        TenantId = id;
        Items = await Tenants.MembersAsync(id, Q);
        Invitations = await Tenants.InvitationsAsync(id);
        return Page();
    }

    public async Task<IActionResult> OnPostInviteAsync(string id, string? email, string? role)
    {
        if (string.IsNullOrWhiteSpace(email))
            TempData["Error"] = "Enter an email address.";
        else
        {
            await Tenants.InviteMemberAsync(id, email.Trim(), string.IsNullOrWhiteSpace(role) ? "Member" : role);
            TempData["Message"] = $"Invitation sent to {email.Trim()}.";
        }
        return RedirectToPage(new { id });
    }

    public async Task<IActionResult> OnPostRemoveAsync(string id, string userId)
    {
        await Tenants.RemoveMemberAsync(id, userId);
        TempData["Message"] = "Member removed.";
        return RedirectToPage(new { id });
    }
}
@{
    ViewData["Title"] = "Tenant members";
}

<app-page-header pretitle="Administration" title="Tenant members">
    <app-button type="default" href="/admin/tenants">Back to tenants</app-button>
</app-page-header>

@if (Tenants.IsSample)
{
    <app-alert type="info" message="Sample data" description="This page shows built-in sample data. Register your own ITenantDirectory to connect it to your tenant store." show-icon="true" />
}
@if (TempData["Message"] is string flash)
{
    <app-alert type="success" message="@flash" show-icon="true" closable="true" />
}
@if (TempData["Error"] is string problem)
{
    <app-alert type="error" message="@problem" show-icon="true" closable="true" />
}

<div class="m-card">
    <div class="m-card-header"><h2 class="m-card-title">Invite a member</h2></div>
    <div class="m-card-body">
        <form method="post" asp-page-handler="Invite" asp-route-id="@TenantId" asp-antiforgery="true" class="m-flex m-flex-wrap">
            <input class="ant-input" type="email" name="email" placeholder="name@example.com" aria-label="Email address" required />
            <select class="ant-input" name="role" aria-label="Role"><option>Member</option><option>Admin</option><option>Owner</option></select>
            <app-button type="primary" html-type="submit">Invite</app-button>
        </form>
    </div>
</div>

<div class="m-card m-mt-24">
    <div class="m-card-header">
        <h2 class="m-card-title">Members</h2>
        <form method="get" class="m-card-actions">
            <input class="ant-input" type="search" name="q" value="@Q" placeholder="Search members..." aria-label="Search members" />
        </form>
    </div>
    <div class="m-card-body m-card-body-flush">
        @if (Items.Count == 0)
        {
            <div class="m-empty">
                <h3 class="m-empty-title">No members found</h3>
            </div>
        }
        else
        {
            <div class="ant-table-wrapper m-table-flush">
                <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                    <table style="table-layout:auto">
                        <thead class="ant-table-thead"><tr><th class="ant-table-cell">Name</th><th class="ant-table-cell">Email</th><th class="ant-table-cell">Role</th><th class="ant-table-cell"></th></tr></thead>
                        <tbody class="ant-table-tbody">
                            @foreach (var m in Items)
                            {
                                <tr class="ant-table-row">
                                    <td class="ant-table-cell"><strong>@m.Name</strong></td>
                                    <td class="ant-table-cell">@m.Email</td>
                                    <td class="ant-table-cell">@m.Role</td>
                                    <td class="ant-table-cell">
                                        <form method="post" asp-page-handler="Remove" asp-route-id="@TenantId" asp-route-userId="@m.UserId" asp-antiforgery="true" data-confirm="Remove @m.Name from this tenant?">
                                            <button type="submit" class="ant-btn ant-btn-text ant-btn-sm ant-btn-dangerous"><span>Remove</span></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div></div></div>
            </div>
        }
    </div>
</div>

<div class="m-card m-mt-24">
    <div class="m-card-header"><h2 class="m-card-title">Pending invitations</h2></div>
    <div class="m-card-body m-card-body-flush">
        @if (Invitations.Count == 0)
        {
            <div class="m-empty">
                <h3 class="m-empty-title">No pending invitations</h3>
            </div>
        }
        else
        {
            <div class="ant-table-wrapper m-table-flush">
                <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                    <table style="table-layout:auto">
                        <thead class="ant-table-thead"><tr><th class="ant-table-cell">Email</th><th class="ant-table-cell">Role</th><th class="ant-table-cell">Sent</th></tr></thead>
                        <tbody class="ant-table-tbody">
                            @foreach (var i in Invitations)
                            {
                                <tr class="ant-table-row">
                                    <td class="ant-table-cell">@i.Email</td>
                                    <td class="ant-table-cell">@i.Role</td>
                                    <td class="ant-table-cell">@i.SentAt.ToString("yyyy-MM-dd")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div></div></div>
            </div>
        }
    </div>
</div>

<style>
    .m-mt-24 { margin-top: 24px; }
</style>

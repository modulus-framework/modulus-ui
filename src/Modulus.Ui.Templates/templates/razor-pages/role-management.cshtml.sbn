@page "/admin/roles"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@* Scaffold generated by `modulus ui`. This file is yours: edit the markup and the handlers freely. *@
@* The role list comes from IRoleDirectory (Modulus.Ui.Abstractions.Admin). Until you register your own implementation the built-in *@
@* sample data answers and the page says so. To connect real data, implement IRoleDirectory and register it after AddModulusMvc, *@
@* or replace the calls in @functions below with your own services. *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Mvc
@using Modulus.Ui.Abstractions.Admin
@inject IRoleDirectory Roles
@functions {
    [BindProperty(SupportsGet = true)] public string? Q { get; set; }
    public IReadOnlyList<AdminRole> Items { get; private set; } = [];

    public async Task OnGetAsync() => Items = await Roles.SearchAsync(Q);

    public async Task<IActionResult> OnPostCreateAsync(string? name, string? description)
    {
        if (string.IsNullOrWhiteSpace(name))
            TempData["Error"] = "Enter a role name.";
        else
        {
            await Roles.CreateAsync(name.Trim(), description?.Trim() ?? "");
            TempData["Message"] = $"Role {name.Trim()} created.";
        }
        return RedirectToPage();
    }

    public async Task<IActionResult> OnPostDeleteAsync(string name)
    {
        await Roles.DeleteAsync(name);
        TempData["Message"] = $"Role {name} deleted.";
        return RedirectToPage();
    }
}
@{
    ViewData["Title"] = "Role management";
}

<app-page-header pretitle="Administration" title="Role management"></app-page-header>

@if (Roles.IsSample)
{
    <app-alert type="info" message="Sample data" description="This page shows built-in sample data. Register your own IRoleDirectory to connect it to your role store." show-icon="true" />
}
@if (TempData["Message"] is string flash)
{
    <app-alert type="success" message="@flash" show-icon="true" closable="true" />
}
@if (TempData["Error"] is string problem)
{
    <app-alert type="error" message="@problem" show-icon="true" closable="true" />
}

<div class="m-card">
    <div class="m-card-header"><h2 class="m-card-title">Create a role</h2></div>
    <div class="m-card-body">
        <form method="post" asp-antiforgery="true" asp-page-handler="Create" class="m-flex m-flex-wrap">
            <input class="ant-input" name="name" placeholder="Role name" aria-label="Role name" required />
            <input class="ant-input" name="description" placeholder="Description" aria-label="Description" />
            <app-button type="primary" html-type="submit">Create role</app-button>
        </form>
    </div>
</div>

<div class="m-card m-mt-24">
    <div class="m-card-header">
        <h2 class="m-card-title">Roles</h2>
        <form method="get" class="m-card-actions">
            <input class="ant-input" type="search" name="q" value="@Q" placeholder="Search roles..." aria-label="Search roles" />
        </form>
    </div>
    <div class="m-card-body m-card-body-flush">
        @if (Items.Count == 0)
        {
            <div class="m-empty">
                <h3 class="m-empty-title">No roles found</h3>
            </div>
        }
        else
        {
            <div class="ant-table-wrapper m-table-flush">
                <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                    <table style="table-layout:auto">
                        <thead class="ant-table-thead"><tr><th class="ant-table-cell">Role</th><th class="ant-table-cell">Description</th><th class="ant-table-cell">Members</th><th class="ant-table-cell"></th></tr></thead>
                        <tbody class="ant-table-tbody">
                            @foreach (var r in Items)
                            {
                                <tr class="ant-table-row">
                                    <td class="ant-table-cell"><strong>@r.Name</strong></td>
                                    <td class="ant-table-cell">@r.Description</td>
                                    <td class="ant-table-cell">@r.Members</td>
                                    <td class="ant-table-cell">
                                        <form method="post" asp-page-handler="Delete" asp-route-name="@r.Name" asp-antiforgery="true" data-confirm="Delete the role @r.Name?">
                                            <button type="submit" class="ant-btn ant-btn-text ant-btn-sm ant-btn-dangerous"><span>Delete</span></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div></div></div>
            </div>
        }
    </div>
</div>

<style>
    .m-mt-24 { margin-top: 24px; }
</style>

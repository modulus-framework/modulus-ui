@page "/account/profile"
{{ if use_auth }}@attribute [Microsoft.AspNetCore.Authorization.Authorize]
{{ end }}
@* Scaffold generated by `modulus ui`. This file is yours: edit the markup and the code block freely. *@
@* The signed-in user's profile comes from IUserDirectory (Modulus.Ui.Abstractions.Admin). Until you register your own implementation the built-in *@
@* sample data answers and the page says so. To connect real data, implement IUserDirectory and register it after AddModulusBlazor, *@
@* or replace the calls in @code below with your own services. *@
@using Modulus.Ui.Abstractions.Admin
@using Microsoft.AspNetCore.Components.Authorization
@inject IUserDirectory UserDirectory
@inject AuthenticationStateProvider Auth

<PageTitle>Profile</PageTitle>

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Account</div><h1 class="m-page-title">Profile</h1></div>
</div>

@if (UserDirectory.IsSample)
{
    <div class="ant-alert ant-alert-info ant-alert-with-description m-mb-16" role="status">
        <div class="ant-alert-content">
            <div class="ant-alert-message">Sample data</div>
            <div class="ant-alert-description">This page shows built-in sample data. Register your own IUserDirectory to connect it to your user store.</div>
        </div>
    </div>
}
@if (_message is not null)
{
    <div class="ant-alert m-mb-16 ant-alert-@(_ok ? "success" : "error")" role="alert"><div class="ant-alert-content"><div class="ant-alert-message">@_message</div></div></div>
}

<div class="m-grid m-profile-grid">
    <div class="m-card">
        <div class="m-card-header"><h2 class="m-card-title">Profile information</h2></div>
        <div class="m-card-body">
            <form class="ant-form ant-form-vertical" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <div class="m-profile-avatar">
                    <div class="m-avatar m-avatar-lg" aria-hidden="true">@Initials()</div>
                    <p class="m-profile-name">@_profile.FirstName @_profile.LastName</p>
                </div>

                <div class="m-divider"></div>

                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="first-name">First name</label></div>
                    <div class="ant-form-item-control"><input id="first-name" class="ant-input" @bind="_profile.FirstName" /></div>
                </div>
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="last-name">Last name</label></div>
                    <div class="ant-form-item-control"><input id="last-name" class="ant-input" @bind="_profile.LastName" /></div>
                </div>
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="email">Email</label></div>
                    <div class="ant-form-item-control"><input id="email" type="email" class="ant-input" @bind="_profile.Email" /></div>
                </div>
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="phone">Phone</label></div>
                    <div class="ant-form-item-control"><input id="phone" type="tel" class="ant-input" @bind="_profile.Phone" /></div>
                </div>
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="job-title">Job title</label></div>
                    <div class="ant-form-item-control"><input id="job-title" class="ant-input" @bind="_profile.JobTitle" /></div>
                </div>
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="bio">Bio</label></div>
                    <div class="ant-form-item-control"><textarea id="bio" class="ant-input" rows="4" @bind="_profile.Bio"></textarea></div>
                </div>

                <div class="m-form-actions">
                    <button type="submit" class="ant-btn ant-btn-primary"><span>Save profile</span></button>
                </div>
            </form>
        </div>
    </div>

    <div class="m-card">
        <div class="m-card-header"><h2 class="m-card-title">Account information</h2></div>
        <div class="m-card-body">
            <div class="m-info-group">
                <div class="m-info-item"><p class="m-info-label">Member since</p><p class="m-info-value">@(_profile.MemberSince?.ToString("yyyy-MM-dd") ?? "—")</p></div>
                <div class="m-info-item"><p class="m-info-label">Account type</p><p class="m-info-value">@(_profile.AccountType ?? "—")</p></div>
                <div class="m-info-item"><p class="m-info-label">Last login</p><p class="m-info-value">@(_profile.LastLogin?.ToString("yyyy-MM-dd HH:mm") ?? "—")</p></div>
                <div class="m-info-item"><p class="m-info-label">Account status</p><p class="m-info-value">@(_profile.Status ?? "—")</p></div>
            </div>
            @* Add your own actions here, for example password change, two-factor, or account deletion. *@
        </div>
    </div>
</div>

<style>
    .m-profile-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 24px; }
    @@media (max-width: 768px) { .m-profile-grid { grid-template-columns: 1fr; } }

    .m-profile-avatar { display: flex; align-items: center; gap: 16px; margin-bottom: 16px; }
    .m-avatar { display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #1677ff; color: white; font-weight: 600; }
    .m-avatar-lg { width: 80px; height: 80px; font-size: 24px; }

    .m-profile-name { margin: 0; font-weight: 600; }
    .m-divider { border: none; border-top: 1px solid rgba(0, 0, 0, 0.06); margin: 16px 0; }

    .m-info-group { display: flex; flex-direction: column; gap: 12px; }
    .m-info-item { display: flex; justify-content: space-between; }
    .m-info-label { margin: 0; font-size: 12px; color: rgba(0, 0, 0, 0.45); }
    .m-info-value { margin: 0; font-weight: 500; }
</style>

@code {
    private ProfileInfo _profile = new();
    private string? _userName;
    private string? _message;
    private bool _ok;

    private void Say(string message, bool ok = true)
    {
        _message = message;
        _ok = ok;
    }

    protected override async Task OnInitializedAsync()
    {
        _userName = (await Auth.GetAuthenticationStateAsync()).User.Identity?.Name;
        _profile = await UserDirectory.GetProfileAsync(_userName);
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_profile.FirstName) || string.IsNullOrWhiteSpace(_profile.Email))
        {
            Say("First name and email are required.", false);
            return;
        }
        await UserDirectory.SaveProfileAsync(_userName, _profile);
        _profile = await UserDirectory.GetProfileAsync(_userName);
        Say("Profile saved.");
    }

    private string Initials() =>
        string.Concat(new[] { _profile.FirstName, _profile.LastName }.Where(n => !string.IsNullOrEmpty(n)).Select(n => char.ToUpperInvariant(n[0])));
}

@* Upload: Label, Action (the upload URL), Accept, Multiple and MaxCount *@

<div class="ant-form-item m-field">
    @if (!string.IsNullOrEmpty(Label))
    {
        <div class="ant-form-item-label">
            <label class="@(Required ? "ant-form-item-required" : "")">@Label</label>
        </div>
    }
    <div class="ant-form-item-control">
        <AntDesign.Upload Action="@Action" Name="@Name" Accept="@Accept" Multiple="Multiple" MaxCount="MaxCount" Disabled="Disabled">
            <Button Icon="upload">@ButtonText</Button>
        </AntDesign.Upload>
        @if (!string.IsNullOrEmpty(Help))
        {
            <div class="m-muted m-mt-4">@Help</div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Help { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Action { get; set; }
    [Parameter] public string Name { get; set; } = "file";
    [Parameter] public string? Accept { get; set; }
    [Parameter] public bool Multiple { get; set; }
    [Parameter] public int MaxCount { get; set; } = 0;
    [Parameter] public string ButtonText { get; set; } = "Select file";

}

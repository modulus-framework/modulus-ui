@* Permission matrix for {{ entity_name }}: roles down, permissions across. Reads and changes grants through the Modulus.Authorization.Management endpoints ({{ api_prefix }}/grants). *@
@page "/permissions/{{ entity_route }}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject Modulus.Blazor.ModulusHttp Http

<PageTitle>{{ entity_name }} permissions</PageTitle>

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Security</div><h1 class="m-page-title">{{ entity_name }} permissions</h1></div>
</div>

@if (_message is not null)
{
    <div class="ant-alert m-mb-16 ant-alert-@(_ok ? "success" : "error")" role="alert"><div class="ant-alert-content"><div class="ant-alert-message">@_message</div></div></div>
}

<div class="m-card">
    <div class="m-card-header"><h2 class="m-card-title">Roles and permissions</h2></div>
    <div class="m-card-body">
        <p class="m-muted">Tick a box to grant the permission to the role; clear it to revoke. A role that is denied a permission shows a locked box.</p>
    </div>
    <div class="ant-table-wrapper m-table-flush">
        <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
            <table style="table-layout:auto">
                <thead class="ant-table-thead">
                    <tr>
                        <th class="ant-table-cell" scope="col">Role</th>
                        @foreach (var p in Permissions)
                        {
                            <th class="ant-table-cell" scope="col" title="@p.Key">@p.Label</th>
                        }
                    </tr>
                </thead>
                <tbody class="ant-table-tbody">
                    @foreach (var role in Roles)
                    {
                        <tr class="ant-table-row">
                            <td class="ant-table-cell" role="rowheader"><strong>@role</strong></td>
                            @foreach (var p in Permissions)
                            {
                                var cell = (role, p.Key);
                                <td class="ant-table-cell">
                                    <input type="checkbox" aria-label="@role: @p.Label"
                                           checked="@_allowed.Contains(cell)" disabled="@(_denied.Contains(cell) || _busy)"
                                           title="@(_denied.Contains(cell) ? "Denied" : null)"
                                           @onchange="e => ToggleAsync(role, p.Key, (bool)(e.Value ?? false))" />
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div></div></div>
    </div>
</div>

@code {
    private const string Api = "{{ api_prefix }}";

    private sealed record Permission(string Key, string Label);
    private sealed record Grant(string Permission, string Type);

    private static readonly string[] Roles = [{{ for r in roles }}"{{ r }}"{{ if !for.last }}, {{ end }}{{ end }}];
    private static readonly Permission[] Permissions =
    [
{{~ for p in permissions ~}}
        new("{{ p.key }}", "{{ p.label }}"),
{{~ end ~}}
    ];

    private readonly HashSet<(string Role, string Permission)> _allowed = [];
    private readonly HashSet<(string Role, string Permission)> _denied = [];
    private string? _message;
    private bool _ok;
    private bool _busy;

    // The requests run in the browser (cookies + antiforgery), which needs JS interop: load after the first render.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        foreach (var role in Roles)
        {
            var response = await Http.GetAsync($"{Api}/grants/Role/{Uri.EscapeDataString(role)}");
            if (!response.Ok)
            {
                Report($"Could not read the grants ({response.Status}). You need the authorization management permission.", false);
                return;
            }
            foreach (var g in response.Read<List<Grant>>() ?? [])
            {
                if (g.Type == "Allow") _allowed.Add((role, g.Permission));
                if (g.Type == "Deny") _denied.Add((role, g.Permission));
            }
        }
    }

    private async Task ToggleAsync(string role, string permission, bool grant)
    {
        _busy = true;
        var response = grant
            ? await Http.PostAsync($"{Api}/grants", new { holderType = "Role", holder = role, permissions = new[] { permission }, type = "Allow" })
            : await Http.DeleteAsync($"{Api}/grants/Role/{Uri.EscapeDataString(role)}/{Uri.EscapeDataString(permission)}");
        if (response.Ok)
        {
            if (grant) _allowed.Add((role, permission)); else _allowed.Remove((role, permission));
            Report($"{role}: {permission} {(grant ? "granted" : "revoked")}.", true);
        }
        else
        {
            Report($"The change was refused ({response.Status}).", false);
        }
        _busy = false;
    }

    private void Report(string message, bool ok)
    {
        _ok = ok;
        _message = message;
    }
}

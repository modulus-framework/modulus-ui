@* Barcode: a wrapper around Components.Extras.AppBarcode. Pass its parameters through; defaults match the framework. *@
@using Modulus.Ui.Abstractions.Barcode
@using Microsoft.AspNetCore.Components

<Modulus.Blazor.Components.Extras.AppBarcode
    Value="@Value"
    Kind="@Kind"
    Height="@Height"
    ShowText="@ShowText"
    AriaLabel="@AriaLabel" />

@code {
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public BarcodeKind Kind { get; set; } = BarcodeKind.Code128;
    [Parameter] public int Height { get; set; } = 80;
    [Parameter] public bool ShowText { get; set; } = true;
    [Parameter] public string? AriaLabel { get; set; }
}

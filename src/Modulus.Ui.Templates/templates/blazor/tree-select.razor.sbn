@* Tree select: Label, Options (a TreeOption tree), Value and Placeholder *@

<div class="ant-form-item m-field">
    @if (!string.IsNullOrEmpty(Label))
    {
        <div class="ant-form-item-label">
            <label class="@(Required ? "ant-form-item-required" : "")">@Label</label>
        </div>
    }
    <div class="ant-form-item-control">
        <AntDesign.TreeSelect TItem="TreeOption" TItemValue="string" DataSource="@Options" Value="@Value" ValueChanged="SetValue" Placeholder="@Placeholder" EnableSearch AllowClear TreeDefaultExpandAll Disabled="Disabled"
                    TitleExpression="x => x.DataItem.Title" KeyExpression="x => x.DataItem.Value" ChildrenExpression="x => x.DataItem.Children" IsLeafExpression="x => x.DataItem.IsLeaf" />
        @if (!string.IsNullOrEmpty(Help))
        {
            <div class="m-muted m-mt-4">@Help</div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Help { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<TreeOption> Options { get; set; } = [];
    [Parameter] public string? Placeholder { get; set; }
    private async Task SetValue(string? v)
    {
        Value = v;
        await ValueChanged.InvokeAsync(v);
    }
}

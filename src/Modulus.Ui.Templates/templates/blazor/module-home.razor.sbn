@page "/modules/{moduleName}"

<PageTitle>@ModuleName Module</PageTitle>

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Modules</div><h1 class="m-page-title">@ModuleName module</h1></div>
</div>

@if (Stats != null)
{
    <div class="m-row-cards">
        <div class="m-grid m-cols-3">
            <div class="m-card m-stat-card"><div class="m-card-body"><div class="m-stat-card-head"><span>Entities</span></div><div class="m-stat-card-value">@(Stats.EntityCount ?? 0)</div></div></div>
            <div class="m-card m-stat-card"><div class="m-card-body"><div class="m-stat-card-head"><span>APIs</span></div><div class="m-stat-card-value">@(Stats.ApiCount ?? 0)</div></div></div>
            <div class="m-card m-stat-card"><div class="m-card-body"><div class="m-stat-card-head"><span>Permissions</span></div><div class="m-stat-card-value">@(Stats.PermissionCount ?? 0)</div></div></div>
        </div>
        <div class="m-card">
            <div class="m-card-header"><h2 class="m-card-title">Module overview</h2></div>
            <div class="m-card-body"><p class="m-mb-0">Everything the @ModuleName module offers lives here.</p></div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string ModuleName { get; set; } = "";

    private ModuleStats? Stats;

    protected override async Task OnInitializedAsync()
    {
        Stats = new ModuleStats
        {
            EntityCount = 0,
            ApiCount = 0,
            PermissionCount = 0
        };
    }

    public class ModuleStats
    {
        public int? EntityCount { get; set; }
        public int? ApiCount { get; set; }
        public int? PermissionCount { get; set; }
    }
}

@page "/admin/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@* Scaffold generated by `modulus ui`. This file is yours: edit the markup and the code block freely. *@
@* The settings comes from IAdminSettingsStore (Modulus.Ui.Abstractions.Admin). Until you register your own implementation the built-in *@
@* sample data answers and the page says so. To connect real data, implement IAdminSettingsStore and register it after AddModulusBlazor, *@
@* or replace the calls in @code below with your own services. *@
@using Modulus.Ui.Abstractions.Admin
@inject IAdminSettingsStore Store

<PageTitle>System settings</PageTitle>

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Administration</div><h1 class="m-page-title">System settings</h1></div>
</div>

@if (Store.IsSample)
{
    <div class="ant-alert ant-alert-info ant-alert-with-description m-mb-16" role="status">
        <div class="ant-alert-content">
            <div class="ant-alert-message">Sample data</div>
            <div class="ant-alert-description">This page shows built-in sample data. Register your own IAdminSettingsStore to connect it to your settings store.</div>
        </div>
    </div>
}
@if (_message is not null)
{
    <div class="ant-alert m-mb-16 ant-alert-@(_ok ? "success" : "error")" role="alert"><div class="ant-alert-content"><div class="ant-alert-message">@_message</div></div></div>
}

<div class="m-card">
    <div class="m-card-header"><h2 class="m-card-title">General settings</h2></div>
    <div class="m-card-body">
        <form class="ant-form ant-form-vertical" @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <div class="m-form-grid">
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="app-name">Application name</label></div>
                    <div class="ant-form-item-control"><input id="app-name" class="ant-input" @bind="_settings.AppName" /></div>
                </div>
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="support-email">Support email</label></div>
                    <div class="ant-form-item-control"><input id="support-email" type="email" class="ant-input" @bind="_settings.SupportEmail" /></div>
                </div>
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="time-zone">Time zone</label></div>
                    <div class="ant-form-item-control">
                        <select id="time-zone" class="ant-input" @bind="_settings.TimeZone">
                            @foreach (var zone in SystemSettings.TimeZones)
                            {
                                <option value="@zone">@zone</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="m-form-actions">
                <button type="submit" class="ant-btn ant-btn-primary"><span>Save changes</span></button>
            </div>
        </form>
    </div>
</div>

@code {
    private SystemSettings _settings = new();
    private string? _message;
    private bool _ok;

    private void Say(string message, bool ok = true)
    {
        _message = message;
        _ok = ok;
    }

    protected override async Task OnInitializedAsync() => _settings = await Store.GetAsync();

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_settings.AppName))
        {
            Say("The application needs a name.", false);
            return;
        }
        await Store.SaveAsync(_settings);
        Say("Settings saved.");
    }
}

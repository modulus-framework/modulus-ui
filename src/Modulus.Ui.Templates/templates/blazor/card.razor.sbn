@* Card: Title, HeaderAction, the body as child content, and Footer *@

<div class="m-card @CssClass">
    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="m-card-header">
            <h3 class="m-card-title">@Title</h3>
            @if (HeaderAction != null)
            {
                <div class="m-card-actions">@HeaderAction</div>
            }
        </div>
    }
    <div class="m-card-body">
        @ChildContent
    </div>
    @if (Footer != null)
    {
        <div class="m-card-footer">@Footer</div>
    }
</div>

@code {
    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public RenderFragment? HeaderAction { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Footer { get; set; }
}

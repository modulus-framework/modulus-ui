@* Avatar: an image, or initials when there is no image. Size is sm, md, lg or xl. *@

@if (!string.IsNullOrEmpty(Src))
{
    <span class="m-avatar @SizeClass" title="@Name" role="img" aria-label="@Name"><img src="@Src" alt="@Name" /></span>
}
else
{
    <span class="m-avatar @SizeClass" title="@Name" role="img" aria-label="@Name">@Initials</span>
}

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string? Src { get; set; }
    /// <summary>sm, md, lg or xl.</summary>
    [Parameter] public string Size { get; set; } = "md";

    private string SizeClass => Size switch { "sm" => "m-avatar-sm", "lg" => "m-avatar-lg", "xl" => "m-avatar-xl", _ => "m-avatar-md" };

    private string Initials =>
        string.Concat(Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
}

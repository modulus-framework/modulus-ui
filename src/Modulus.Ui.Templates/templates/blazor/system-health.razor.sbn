@page "/system/health"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@* Scaffold generated by `modulus ui`. This file is yours: edit the markup and the code block freely. *@
@* The figures comes from IMetricsSource (Modulus.Ui.Abstractions.Admin). Until you register your own implementation the built-in *@
@* sample data answers and the page says so. To connect real data, implement IMetricsSource and register it after AddModulusBlazor, *@
@* or replace the calls in @code below with your own services. *@
@using Modulus.Ui.Abstractions.Admin
@inject IMetricsSource Metrics

<PageTitle>System health</PageTitle>

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">System</div><h1 class="m-page-title">System health</h1></div>
</div>

@if (Metrics.IsSample)
{
    <div class="ant-alert ant-alert-info ant-alert-with-description m-mb-16" role="status">
        <div class="ant-alert-content">
            <div class="ant-alert-message">Sample data</div>
            <div class="ant-alert-description">This page shows built-in sample data. Register your own IMetricsSource to connect it to your data.</div>
        </div>
    </div>
}

<div class="m-row-cards">
    <div class="m-grid m-cols-4">
        @foreach (var s in _data.Stats)
        {
            <div class="m-card m-stat-card">
                <div class="m-card-body">
                    <div class="m-stat-card-head"><span>@s.Label</span></div>
                    <div class="m-stat-card-value">@s.Value</div>
                </div>
            </div>
        }
    </div>

    <div class="m-grid m-cols-main">
        <div class="m-card">
            <div class="m-card-header"><h2 class="m-card-title">Services</h2></div>
    <div class="m-card-body m-card-body-flush">
        @if (_data.Services.Count == 0)
        {
            <div class="m-empty">
                <h3 class="m-empty-title">No services reported</h3>
            </div>
        }
        else
        {
            <div class="ant-table-wrapper m-table-flush">
                <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                    <table style="table-layout:auto">
                        <thead class="ant-table-thead"><tr><th class="ant-table-cell">Service</th><th class="ant-table-cell">Status</th><th class="ant-table-cell">Details</th></tr></thead>
                        <tbody class="ant-table-tbody">
                            @foreach (var s in _data.Services)
                            {
                                <tr class="ant-table-row">
                                    <td class="ant-table-cell"><strong>@s.Name</strong></td>
                                    <td class="ant-table-cell">@s.Status</td>
                                    <td class="ant-table-cell">@s.Detail</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div></div></div>
            </div>
        }
    </div>
        </div>
        <div class="m-card">
            <div class="m-card-header"><h2 class="m-card-title">Resource usage</h2></div>
            <div class="m-card-body">
                @if (_data.Usage.Count == 0)
                {
                    <div class="m-empty"><h3 class="m-empty-title">No usage data</h3></div>
                }
                else
                {
                    <div class="m-bars">
                        @foreach (var g in _data.Usage)
                        {
                            <label class="m-bar-row"><span>@g.Label</span><progress max="100" value="@g.Percent"></progress><span>@g.Percent%</span></label>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .m-bars { display: flex; flex-direction: column; gap: 8px; }
    .m-bar-row { display: grid; grid-template-columns: 64px 1fr 56px; gap: 12px; align-items: center; }
    .m-bar-row progress { width: 100%; }
</style>

@code {
    private HealthData _data = new([], [], []);

    protected override async Task OnInitializedAsync() => _data = await Metrics.HealthAsync();
}

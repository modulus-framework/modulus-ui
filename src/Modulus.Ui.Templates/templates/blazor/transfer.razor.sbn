@* Transfer: Label, Options (a TreeOption list), the chosen TargetKeys and TargetKeysChanged *@

<div class="ant-form-item m-field">
    @if (!string.IsNullOrEmpty(Label))
    {
        <div class="ant-form-item-label">
            <label class="@(Required ? "ant-form-item-required" : "")">@Label</label>
        </div>
    }
    <div class="ant-form-item-control">
        <AntDesign.Transfer DataSource="_items" TargetKeys="@TargetKeys.ToList()" Titles="@(new[] { "Available", "Selected" })" ShowSearch OnChange="Changed" />
        @if (!string.IsNullOrEmpty(Help))
        {
            <div class="m-muted m-mt-4">@Help</div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Help { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public IReadOnlyList<TreeOption> Options { get; set; } = [];
    [Parameter] public IEnumerable<string> TargetKeys { get; set; } = [];
    [Parameter] public EventCallback<IEnumerable<string>> TargetKeysChanged { get; set; }
    private List<TransferItem> _items = [];

    protected override void OnParametersSet()
        => _items = Options.Select(o => new TransferItem { Key = o.Value, Title = o.Title, Disabled = o.Disabled }).ToList();

    private async Task Changed(TransferChangeArgs args)
    {
        TargetKeys = args.TargetKeys;
        await TargetKeysChanged.InvokeAsync(TargetKeys);
    }
}

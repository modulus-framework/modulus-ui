@* Badge component for status display *@

<span class="m-badge m-badge-@StatusClass">@(ChildContent ?? (RenderFragment)(b => b.AddContent(0, Label ?? Status)))</span>

@code {
    /// <summary>active, inactive, pending or error; anything else is neutral.</summary>
    [Parameter] public string Status { get; set; } = "default";
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string StatusClass => Status.ToLowerInvariant() switch
    {
        "active" => "success-lt",
        "inactive" => "gray-lt",
        "pending" => "warning-lt",
        "error" => "danger-lt",
        _ => "primary-lt"
    };
}

@page "/admin/tenants/{id}/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject HttpClient Http

<PageTitle>Tenant Settings</PageTitle>

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Administration</div><h1 class="m-page-title">Tenant settings</h1></div>
    <a href="/admin/tenants" class="ant-btn ant-btn-default">Back to tenants</a>
</div>

<div class="m-tabs" style="margin-bottom: 24px;">
    <div class="ant-tabs" role="tablist">
        <div class="ant-tabs-nav" role="tablist">
            <div class="ant-tabs-nav-wrap">
                <button class="ant-tabs-tab ant-tabs-tab-active" role="tab">General</button>
                <button class="ant-tabs-tab" role="tab">Billing</button>
                <button class="ant-tabs-tab" role="tab">Features</button>
                <button class="ant-tabs-tab" role="tab">Security</button>
            </div>
        </div>
    </div>
</div>

<div class="m-card m-mt-24">
    <div class="m-card-header"><h2 class="m-card-title">General settings</h2></div>
    <div class="m-card-body">
        @if (tenant != null)
        {
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="tenant-name">Tenant name</label></div>
                    <div class="ant-form-item-control"><input id="tenant-name" @bind="tenant.Name" class="ant-input" /></div>
                </div>
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="tenant-domain">Domain</label></div>
                    <div class="ant-form-item-control"><input id="tenant-domain" @bind="tenant.Domain" class="ant-input" disabled /></div>
                </div>
            </div>
            <div class="ant-form-item">
                <div class="ant-form-item-label"><label for="tenant-description">Description</label></div>
                <div class="ant-form-item-control"><textarea id="tenant-description" @bind="tenant.Description" class="ant-input" rows="4"></textarea></div>
            </div>
            <div style="margin-top: 16px;">
                <button class="ant-btn ant-btn-primary" @onclick="SaveTenant">Save changes</button>
            </div>
        }
        else
        {
            <p class="m-muted">Loading...</p>
        }
    </div>
</div>

<div class="m-card m-mt-24">
    <div class="m-card-header"><h2 class="m-card-title">Tenant logo and branding</h2></div>
    <div class="m-card-body">
        <div class="m-upload-area">
            <p>Upload your tenant logo (PNG, JPG, SVG, max 2MB)</p>
            <input type="file" accept="image/*" />
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Id { get; set; } = "";

    private TenantSettings? tenant;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            tenant = await Http.GetFromJsonAsync<TenantSettings>($"/api/admin/tenants/{Id}");
        }
        catch
        {
            tenant = null;
        }
    }

    private async Task SaveTenant()
    {
        if (tenant != null)
        {
            try
            {
                await Http.PutAsJsonAsync($"/api/admin/tenants/{Id}", tenant);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error saving tenant: {ex.Message}");
            }
        }
    }

    public class TenantSettings
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Domain { get; set; } = "";
        public string Description { get; set; } = "";
    }
}

<style>
    .m-tabs { margin-bottom: 24px; }
    .ant-tabs-nav { border-bottom: 1px solid rgba(0, 0, 0, 0.06); }
    .ant-tabs-tab { padding: 12px 16px; border: none; cursor: pointer; background: none; }
    .ant-tabs-tab-active { color: #1677ff; border-bottom: 2px solid #1677ff; }
    .m-mt-24 { margin-top: 24px; }
    .m-upload-area { border: 2px dashed rgba(0, 0, 0, 0.15); border-radius: 4px; padding: 24px; text-align: center; }
</style>

@page "/admin/tenants/{Id}/settings"
{{ if use_auth }}@attribute [Microsoft.AspNetCore.Authorization.Authorize]
{{ end }}
@* Scaffold generated by `modulus ui`. This file is yours: edit the markup and the code block freely. *@
@* The tenant's settings comes from ITenantDirectory (Modulus.Ui.Abstractions.Admin). Until you register your own implementation the built-in *@
@* sample data answers and the page says so. To connect real data, implement ITenantDirectory and register it after AddModulusBlazor, *@
@* or replace the calls in @code below with your own services. *@
@using Modulus.Ui.Abstractions.Admin
@inject ITenantDirectory TenantDirectory

<PageTitle>Tenant settings</PageTitle>

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Administration</div><h1 class="m-page-title">Tenant settings</h1></div>
    <a class="ant-btn ant-btn-default" href="/admin/tenants"><span>Back to tenants</span></a>
</div>

@if (TenantDirectory.IsSample)
{
    <div class="ant-alert ant-alert-info ant-alert-with-description m-mb-16" role="status">
        <div class="ant-alert-content">
            <div class="ant-alert-message">Sample data</div>
            <div class="ant-alert-description">This page shows built-in sample data. Register your own ITenantDirectory to connect it to your tenant store.</div>
        </div>
    </div>
}
@if (_message is not null)
{
    <div class="ant-alert m-mb-16 ant-alert-@(_ok ? "success" : "error")" role="alert"><div class="ant-alert-content"><div class="ant-alert-message">@_message</div></div></div>
}

@if (_details is null)
{
    <div class="m-empty"><h3 class="m-empty-title">Tenant not found</h3></div>
}
else
{
    <div class="m-card">
        <div class="m-card-header"><h2 class="m-card-title">General settings</h2></div>
        <div class="m-card-body">
            <form class="ant-form ant-form-vertical" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <div class="m-form-grid">
                    <div class="ant-form-item">
                        <div class="ant-form-item-label"><label for="tenant-name">Tenant name</label></div>
                        <div class="ant-form-item-control"><input id="tenant-name" placeholder="Company name" class="ant-input" @bind="_details.Name" /></div>
                    </div>
                    <div class="ant-form-item">
                        <div class="ant-form-item-label"><label for="tenant-domain">Domain</label></div>
                        <div class="ant-form-item-control"><input id="tenant-domain" class="ant-input" value="@_details.Domain" disabled /></div>
                    </div>
                    <div class="ant-form-item m-span-2">
                        <div class="ant-form-item-label"><label for="tenant-description">Description</label></div>
                        <div class="ant-form-item-control"><textarea id="tenant-description" placeholder="Describe the company" class="ant-input" rows="4" @bind="_details.Description"></textarea></div>
                    </div>
                </div>
                <div class="m-form-actions">
                    <button type="submit" class="ant-btn ant-btn-primary"><span>Save changes</span></button>
                </div>
            </form>
        </div>
    </div>
    @* Add more sections (billing, features, branding) as cards here. *@
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private TenantDetails? _details;
    private string? _message;
    private bool _ok;

    private void Say(string message, bool ok = true)
    {
        _message = message;
        _ok = ok;
    }

    protected override async Task OnParametersSetAsync() => _details = await TenantDirectory.GetAsync(Id);

    private async Task SaveAsync()
    {
        if (_details is null) return;
        if (string.IsNullOrWhiteSpace(_details.Name))
        {
            Say("The tenant needs a name.", false);
            return;
        }
        await TenantDirectory.SaveAsync(Id, _details);
        Say("Tenant settings saved.");
    }
}

@* Form input: label, control, hint and validation message, bound with @bind-Value *@
@using System.Linq.Expressions

<div class="ant-form-item">
    <div class="ant-form-item-label">
        <label class="@(Required ? "ant-form-item-required" : "")">@Label</label>
    </div>
    <div class="ant-form-item-control">
        <InputText Value="Value" ValueChanged="ValueChanged" ValueExpression="ValueExpression"
                   class="ant-input" placeholder="@Placeholder" type="@Type" />
        @if (!string.IsNullOrEmpty(HelpText))
        {
            <div class="m-muted m-mt-4">@HelpText</div>
        }
        @if (ValueExpression is not null)
        {
            <ValidationMessage For="ValueExpression" class="ant-form-item-explain-error" />
        }
    </div>
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string?>>? ValueExpression { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? HelpText { get; set; }
}

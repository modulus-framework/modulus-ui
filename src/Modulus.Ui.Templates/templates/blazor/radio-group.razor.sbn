@* Radio group: Label, Options (value and label), Value and Buttons *@

<div class="ant-form-item m-field">
    @if (!string.IsNullOrEmpty(Label))
    {
        <div class="ant-form-item-label">
            <label class="@(Required ? "ant-form-item-required" : "")">@Label</label>
        </div>
    }
    <div class="ant-form-item-control">
        <AntDesign.RadioGroup TValue="string" Value="@Value" ValueChanged="SetValue" ButtonStyle="@(Buttons ? RadioButtonStyle.Outline : RadioButtonStyle.Default)">
            @foreach (var option in Options)
            {
                if (Buttons)
                {
                    <Radio RadioButton TValue="string" Value="@option.Value" Disabled="Disabled">@option.Label</Radio>
                }
                else
                {
                    <Radio TValue="string" Value="@option.Value" Disabled="Disabled">@option.Label</Radio>
                }
            }
        </AntDesign.RadioGroup>
        @if (!string.IsNullOrEmpty(Help))
        {
            <div class="m-muted m-mt-4">@Help</div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Help { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public bool Buttons { get; set; }
    [Parameter] public IEnumerable<Option> Options { get; set; } = [];
    public sealed record Option(string Value, string Label);
    private async Task SetValue(string v)
    {
        Value = v;
        await ValueChanged.InvokeAsync(v);
    }
}

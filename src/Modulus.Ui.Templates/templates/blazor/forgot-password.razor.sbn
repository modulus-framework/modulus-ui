@* Forgot password page: talks to the Modulus.Identity account endpoints on this host (/account/...) *@
@page "/auth/forgot-password"
@inject HttpClient Http

<PageTitle>Forgot password</PageTitle>

<div class="page page-center">
    <div class="container container-tight py-4">
        <div class="card card-md">
            <div class="card-body">
                <h2 class="h2 text-center mb-4">Forgot password</h2>
                @if (_message is not null)
                {
                    <div class="alert @(_ok ? "alert-success" : "alert-danger")" role="alert">@_message</div>
                }
                <EditForm Model="this" OnSubmit="SendAsync">
                    <div class="mb-3">
                        <label class="form-label">Email address</label>
                        <InputText @bind-Value="Email" type="email" class="form-control" autocomplete="email" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100" disabled="@_busy">Send reset link</button>
                </EditForm>
                <div class="text-center text-secondary mt-3"><a href="/Account/Login">Back to sign in</a></div>
            </div>
        </div>
    </div>
</div>

@code {
    private string Email { get; set; } = "";
    private string? _message;
    private bool _ok;
    private bool _busy;

    private async Task SendAsync()
    {
        _busy = true;
        try
        {
            var response = await Http.PostAsync($"/account/forgot-password?email={Uri.EscapeDataString(Email)}", null);
            _ok = response.IsSuccessStatusCode;
            _message = _ok ? "If the address is registered, a reset link is on its way." : "Something went wrong. Try again.";
        }
        finally { _busy = false; }
    }
}

@* Forgot password page: talks to the Modulus.Identity account endpoints on this host (/account/...) *@
@page "/auth/forgot-password"
@inject Modulus.Blazor.ModulusHttp Http

<PageTitle>Forgot password</PageTitle>

<div class="m-auth-card">
    <div class="m-auth-card-body">
        <h1 class="m-auth-title">Forgot password</h1>
        <p class="m-auth-hint">Enter your email address and we will send you a link to reset it.</p>
        @if (_message is not null)
        {
            <div class="ant-alert m-mb-16 ant-alert-@(_ok ? "success" : "error")" role="alert"><div class="ant-alert-content"><div class="ant-alert-message">@_message</div></div></div>
        }
        <EditForm Model="this" OnSubmit="SendAsync" class="ant-form ant-form-vertical ant-form-hide-required-mark">
            <div class="ant-form-item">
                <div class="ant-form-item-label"><label>Email address</label></div>
                <div class="ant-form-item-control"><InputText @bind-Value="Email" type="email" class="ant-input" autocomplete="email" placeholder="you@example.com" /></div>
            </div>
            <div class="m-auth-actions">
                <button type="submit" class="ant-btn ant-btn-primary ant-btn-block" disabled="@_busy"><span>Send reset link</span></button>
            </div>
        </EditForm>
        <p class="m-auth-hint m-mt-16"><a href="/Account/Login">Back to sign in</a></p>
    </div>
</div>

@code {
    private string Email { get; set; } = "";
    private string? _message;
    private bool _ok;
    private bool _busy;

    private async Task SendAsync()
    {
        _busy = true;
        try
        {
            var response = await Http.PostAsync($"/account/forgot-password?email={Uri.EscapeDataString(Email)}");
            _ok = response.Ok;
            _message = _ok ? "If the address is registered, a reset link is on its way." : "Something went wrong. Try again.";
        }
        finally { _busy = false; }
    }
}

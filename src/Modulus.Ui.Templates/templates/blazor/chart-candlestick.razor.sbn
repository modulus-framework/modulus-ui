@* Candlestick chart: sample data below, replace it with your own (a query, an API call). *@
@page "/charts/candlestick"
{{ if use_auth }}@attribute [Microsoft.AspNetCore.Authorization.Authorize]
{{ end }}
@using Modulus.Blazor.Components.Charts
@using Modulus.Ui.Abstractions.Charts

<PageTitle>Candlestick chart</PageTitle>

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Charts</div><h1 class="m-page-title">Candlestick chart</h1></div>
</div>

<div class="m-card">
    <div class="m-card-header"><h2 class="m-card-title">Candlestick chart</h2></div>
    <div class="m-card-body">
        <CandlestickChart Candles="_prices" Prefix="$" ValueFormat="N2" Title="Price" />
    </div>
</div>

@code {
    private readonly Candle[] _prices =
    [
        new("Mon", 80, 83, 79, 82, 9000), new("Tue", 82, 84, 80, 81, 11000),
        new("Wed", 81, 82, 77, 78, 15000), new("Thu", 78, 81, 77, 80.5, 8000),
        new("Fri", 80.5, 85, 80, 84, 12000),
    ];
}

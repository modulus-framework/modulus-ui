@* Donut chart: sample data below, replace it with your own (a query, an API call). *@
@page "/charts/donut"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Modulus.Blazor.Components.Charts
@using Modulus.Ui.Abstractions.Charts

<PageTitle>Donut chart</PageTitle>

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Charts</div><h1 class="m-page-title">Donut chart</h1></div>
</div>

<div class="m-card">
    <div class="m-card-header"><h2 class="m-card-title">Donut chart</h2></div>
    <div class="m-card-body">
        <DonutChart Slices="_channels" CenterLabel="Visits" />
    </div>
</div>

@code {
    private readonly ChartSlice[] _channels =
    [
        new("Search", 540),
        new("Direct", 320),
        new("Referral", 180),
        new("Social", 110),
    ];
}

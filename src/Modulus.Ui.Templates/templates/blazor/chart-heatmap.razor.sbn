@* Heatmap: sample data below, replace it with your own (a query, an API call). *@
@page "/charts/heatmap"
{{ if use_auth }}@attribute [Microsoft.AspNetCore.Authorization.Authorize]
{{ end }}
@using Modulus.Blazor.Components.Charts
@using Modulus.Ui.Abstractions.Charts

<PageTitle>Heatmap</PageTitle>

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Charts</div><h1 class="m-page-title">Heatmap</h1></div>
</div>

<div class="m-card">
    <div class="m-card-header"><h2 class="m-card-title">Heatmap</h2></div>
    <div class="m-card-body">
        <HeatmapChart Rows="_days" Columns="_hours" Values="_values" />
    </div>
</div>

@code {
    private readonly string[] _days = ["Mon", "Tue", "Wed", "Thu", "Fri"];
    private readonly string[] _hours = ["9", "11", "13", "15", "17"];
    private readonly double[][] _values =
    [
        [4, 8, 6, 9, 3],
        [5, 9, 7, 8, 4],
        [3, 7, 9, 6, 5],
        [6, 8, 8, 7, 2],
        [2, 5, 6, 4, 1],
    ];
}

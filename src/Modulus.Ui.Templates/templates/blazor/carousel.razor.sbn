@* Carousel: Slides (a render fragment each), Autoplay and Dots *@

<AntDesign.Carousel Autoplay="@(Autoplay ? TimeSpan.FromSeconds(3) : TimeSpan.Zero)" Dots="Dots" DotPosition="CarouselDotPosition.Bottom">
    @foreach (var slide in Slides)
    {
        <div>@slide</div>
    }
</AntDesign.Carousel>

@code {
    [Parameter] public IEnumerable<RenderFragment> Slides { get; set; } = [];
    [Parameter] public bool Autoplay { get; set; }
    [Parameter] public bool Dots { get; set; } = true;
}

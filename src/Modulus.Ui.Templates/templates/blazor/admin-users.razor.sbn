@page "/admin/users"
{{ if use_auth }}@attribute [Microsoft.AspNetCore.Authorization.Authorize]
{{ end }}
@* Scaffold generated by `modulus ui`. This file is yours: edit the markup and the code block freely. *@
@* The user list comes from IUserDirectory (Modulus.Ui.Abstractions.Admin). Until you register your own implementation the built-in *@
@* sample data answers and the page says so. To connect real data, implement IUserDirectory and register it after AddModulusBlazor, *@
@* or replace the calls in @code below with your own services. *@
@using Modulus.Ui.Abstractions.Admin
@inject IUserDirectory UserDirectory
@inject IRoleDirectory RoleDirectory

<PageTitle>User management</PageTitle>

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Administration</div><h1 class="m-page-title">User management</h1></div>
</div>

@if (UserDirectory.IsSample)
{
    <div class="ant-alert ant-alert-info ant-alert-with-description m-mb-16" role="status">
        <div class="ant-alert-content">
            <div class="ant-alert-message">Sample data</div>
            <div class="ant-alert-description">This page shows built-in sample data. Register your own IUserDirectory to connect it to your user store.</div>
        </div>
    </div>
}
@if (_message is not null)
{
    <div class="ant-alert m-mb-16 ant-alert-@(_ok ? "success" : "error")" role="alert"><div class="ant-alert-content"><div class="ant-alert-message">@_message</div></div></div>
}

<div class="m-card">
    <div class="m-card-header"><h2 class="m-card-title">Invite a user</h2></div>
    <div class="m-card-body">
        <form class="m-flex m-flex-wrap" @onsubmit="InviteAsync" @onsubmit:preventDefault>
            <input class="ant-input" type="email" placeholder="name@example.com" aria-label="Email address" @bind="_email" />
            <select class="ant-input" aria-label="Role" @bind="_role">
                @foreach (var role in _roles)
                {
                    <option value="@role.Name">@role.Name</option>
                }
            </select>
            <button type="submit" class="ant-btn ant-btn-primary"><span>Invite</span></button>
        </form>
    </div>
</div>

<div class="m-card m-mt-24">
    <div class="m-card-header">
        <h2 class="m-card-title">Users</h2>
        <div class="m-card-actions">
            <input type="search" class="ant-input" placeholder="Search users..." aria-label="Search users" @bind="_q" @bind:event="oninput" @bind:after="LoadAsync" />
        </div>
    </div>
    <div class="m-card-body m-card-body-flush">
        @if (_items.Count == 0)
        {
            <div class="m-empty">
                <h3 class="m-empty-title">No users found</h3>
            </div>
        }
        else
        {
            <div class="ant-table-wrapper m-table-flush">
                <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                    <table style="table-layout:auto">
                        <thead class="ant-table-thead"><tr><th class="ant-table-cell">Name</th><th class="ant-table-cell">Email</th><th class="ant-table-cell">Role</th><th class="ant-table-cell">Status</th><th class="ant-table-cell">Last active</th><th class="ant-table-cell"></th></tr></thead>
                        <tbody class="ant-table-tbody">
                            @foreach (var u in _items)
                            {
                                <tr class="ant-table-row">
                                    <td class="ant-table-cell"><strong>@u.Name</strong></td>
                                    <td class="ant-table-cell">@u.Email</td>
                                    <td class="ant-table-cell">@u.Role</td>
                                    <td class="ant-table-cell">@u.Status</td>
                                    <td class="ant-table-cell">@(u.LastActive?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                    <td class="ant-table-cell">
                                        @if (_confirm == u.Id)
                                        {
                                            <button type="button" class="ant-btn ant-btn-text ant-btn-sm ant-btn-dangerous" @onclick="() => RemoveAsync(u.Id)"><span>Confirm</span></button>
                                            <button type="button" class="ant-btn ant-btn-text ant-btn-sm" @onclick="() => _confirm = null"><span>Cancel</span></button>
                                        }
                                        else
                                        {
                                            <button type="button" class="ant-btn ant-btn-text ant-btn-sm ant-btn-dangerous" @onclick="() => _confirm = u.Id"><span>Remove</span></button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div></div></div>
            </div>
        }
    </div>
</div>

<style>
    .m-mt-24 { margin-top: 24px; }
</style>

@code {
    private IReadOnlyList<AdminUser> _items = [];
    private IReadOnlyList<AdminRole> _roles = [];
    private string? _q;
    private string _email = "";
    private string _role = "User";
    private string? _confirm;
    private string? _message;
    private bool _ok;

    private void Say(string message, bool ok = true)
    {
        _message = message;
        _ok = ok;
    }

    protected override async Task OnInitializedAsync()
    {
        _roles = await RoleDirectory.SearchAsync(null);
        await LoadAsync();
    }

    private async Task LoadAsync() => _items = await UserDirectory.SearchAsync(_q);

    private async Task InviteAsync()
    {
        if (string.IsNullOrWhiteSpace(_email))
        {
            Say("Enter an email address.", false);
            return;
        }
        await UserDirectory.InviteAsync(_email.Trim(), _role);
        Say($"Invitation sent to {_email.Trim()}.");
        _email = "";
        await LoadAsync();
    }

    private async Task RemoveAsync(string id)
    {
        await UserDirectory.RemoveAsync(id);
        _confirm = null;
        Say("User removed.");
        await LoadAsync();
    }
}

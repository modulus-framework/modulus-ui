@* Data table: Columns (title, property or a template), Items, an optional RowTemplate (actions column) and EmptyMessage *@
@typeparam TItem

<div class="ant-table-wrapper">
    <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
        <table style="table-layout:auto">
            <thead class="ant-table-thead">
                <tr>
                    @foreach (var column in Columns ?? [])
                    {
                        <th class="ant-table-cell" style="@GetColumnStyle(column)">@column.Title</th>
                    }
                    @if (RowTemplate != null)
                    {
                        <th class="ant-table-cell">Actions</th>
                    }
                </tr>
            </thead>
            <tbody class="ant-table-tbody">
                @if (Items?.Any() == true)
                {
                    @foreach (var item in Items)
                    {
                        <tr class="ant-table-row">
                            @foreach (var column in Columns ?? [])
                            {
                                <td class="ant-table-cell">
                                    @if (column.Template != null)
                                    {
                                        @column.Template(item)
                                    }
                                    else
                                    {
                                        @GetPropertyValue(item, column.PropertyName)
                                    }
                                </td>
                            }
                            @if (RowTemplate != null)
                            {
                                <td class="ant-table-cell">@RowTemplate(item)</td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr class="ant-table-placeholder">
                        <td colspan="@((Columns?.Count ?? 0) + (RowTemplate != null ? 1 : 0))" class="ant-table-cell m-muted">@EmptyMessage</td>
                    </tr>
                }
            </tbody>
        </table>
    </div></div></div>
</div>

@code {
    [Parameter]
    public IEnumerable<TItem>? Items { get; set; }

    [Parameter]
    public List<DataColumn<TItem>>? Columns { get; set; }

    [Parameter]
    public RenderFragment<TItem>? RowTemplate { get; set; }

    [Parameter]
    public string EmptyMessage { get; set; } = "No records found.";

    private string GetColumnStyle(DataColumn<TItem> column)
    {
        var style = "";
        if (column.Width.HasValue)
            style += $"width: {column.Width}px;";
        if (!string.IsNullOrEmpty(column.Align))
            style += $"text-align: {column.Align};";
        return style;
    }

    private object? GetPropertyValue(TItem item, string propertyName)
    {
        var property = typeof(TItem).GetProperty(propertyName);
        return property?.GetValue(item);
    }

    public class DataColumn<T>
    {
        public string Title { get; set; } = "";
        public string PropertyName { get; set; } = "";
        public int? Width { get; set; }
        public string? Align { get; set; }
        public RenderFragment<T>? Template { get; set; }
    }
}

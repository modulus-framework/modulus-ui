@* Progress bar: Percentage (0-100), Color (primary, success, danger, warning) and ShowLabel *@

<div class="m-progress" role="progressbar" aria-valuenow="@Percentage" aria-valuemin="0" aria-valuemax="100">
    <div class="@GetProgressClass()" style="width: @Percentage%"></div>
</div>
@if (ShowLabel)
{
    <div class="m-progress-legend">@Percentage%</div>
}

@code {
    [Parameter]
    public int Percentage { get; set; } = 0;

    [Parameter]
    public string Color { get; set; } = "primary";

    [Parameter]
    public bool ShowLabel { get; set; } = false;

    private string GetProgressClass() => Color switch { "success" => "m-progress-bar m-bg-success", "danger" => "m-progress-bar m-bg-danger", "warning" => "m-progress-bar m-bg-warning", _ => "m-progress-bar" };
}

@* Pagination component for Blazor *@

<nav aria-label="Page navigation">
    <ul class="pagination">
        @if (CurrentPage > 1)
        {
            <li class="page-item">
                <a class="page-link" href="#" @onclick:preventDefault @onclick="@((EventArgs) => GoToPage(1))">First</a>
            </li>
            <li class="page-item">
                <a class="page-link" href="#" @onclick:preventDefault @onclick="@((EventArgs) => GoToPage(CurrentPage - 1))">Previous</a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link">First</span>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Previous</span>
            </li>
        }

        @for (var i = Math.Max(1, CurrentPage - 2); i <= Math.Min(TotalPages, CurrentPage + 2); i++)
        {
            var pageNum = i;
            @if (i == CurrentPage)
            {
                <li class="page-item active">
                    <span class="page-link">@i</span>
                </li>
            }
            else
            {
                <li class="page-item">
                    <a class="page-link" href="#" @onclick:preventDefault @onclick="@((EventArgs) => GoToPage(pageNum))">@i</a>
                </li>
            }
        }

        @if (CurrentPage < TotalPages)
        {
            <li class="page-item">
                <a class="page-link" href="#" @onclick:preventDefault @onclick="@((EventArgs) => GoToPage(CurrentPage + 1))">Next</a>
            </li>
            <li class="page-item">
                <a class="page-link" href="#" @onclick:preventDefault @onclick="@((EventArgs) => GoToPage(TotalPages))">Last</a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link">Next</span>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Last</span>
            </li>
        }
    </ul>
</nav>

@code {
    [Parameter]
    public int CurrentPage { get; set; } = 1;

    [Parameter]
    public int TotalPages { get; set; } = 1;

    [Parameter]
    public EventCallback<int> OnPageChanged { get; set; }

    private async Task GoToPage(int pageNum)
    {
        if (pageNum != CurrentPage)
        {
            CurrentPage = pageNum;
            await OnPageChanged.InvokeAsync(pageNum);
        }
    }
}

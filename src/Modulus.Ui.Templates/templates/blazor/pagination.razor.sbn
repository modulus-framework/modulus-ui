@* Pagination: CurrentPage, TotalPages and OnPageChanged *@

<ul class="ant-pagination" aria-label="Page navigation">
    <li class="ant-pagination-prev @(CurrentPage <= 1 ? "ant-pagination-disabled" : "")">
        <a class="ant-pagination-item-link" href="#" aria-label="Previous page" @onclick:preventDefault @onclick="@(() => GoToPage(CurrentPage - 1))">&lsaquo;</a>
    </li>
    @for (var i = Math.Max(1, CurrentPage - 2); i <= Math.Min(TotalPages, CurrentPage + 2); i++)
    {
        var pageNum = i;
        <li class="ant-pagination-item @(i == CurrentPage ? "ant-pagination-item-active" : "")" aria-current="@(i == CurrentPage ? "page" : null)">
            <a href="#" @onclick:preventDefault @onclick="@(() => GoToPage(pageNum))">@i</a>
        </li>
    }
    <li class="ant-pagination-next @(CurrentPage >= TotalPages ? "ant-pagination-disabled" : "")">
        <a class="ant-pagination-item-link" href="#" aria-label="Next page" @onclick:preventDefault @onclick="@(() => GoToPage(CurrentPage + 1))">&rsaquo;</a>
    </li>
</ul>

@code {
    [Parameter]
    public int CurrentPage { get; set; } = 1;

    [Parameter]
    public int TotalPages { get; set; } = 1;

    [Parameter]
    public EventCallback<int> OnPageChanged { get; set; }

    private async Task GoToPage(int pageNum)
    {
        if (pageNum >= 1 && pageNum <= TotalPages && pageNum != CurrentPage)
        {
            CurrentPage = pageNum;
            await OnPageChanged.InvokeAsync(pageNum);
        }
    }
}

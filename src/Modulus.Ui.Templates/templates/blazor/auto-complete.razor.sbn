@* Auto-complete: Label, Value, Options (text suggestions) and Placeholder *@

<div class="ant-form-item m-field">
    @if (!string.IsNullOrEmpty(Label))
    {
        <div class="ant-form-item-label">
            <label class="@(Required ? "ant-form-item-required" : "")">@Label</label>
        </div>
    }
    <div class="ant-form-item-control">
        <AntDesign.AutoComplete TOption="string" Value="@Value" ValueChanged="SetValue" Options="@Options.Select(o => new AutoCompleteOption(o, o)).ToList()" Placeholder="@Placeholder" Disabled="Disabled" />
        @if (!string.IsNullOrEmpty(Help))
        {
            <div class="m-muted m-mt-4">@Help</div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Help { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public IEnumerable<string> Options { get; set; } = [];
    [Parameter] public string? Placeholder { get; set; }
    private async Task SetValue(string? v)
    {
        Value = v;
        await ValueChanged.InvokeAsync(v);
    }
}

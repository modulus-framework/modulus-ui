@page "/account/notification-preferences"
{{ if use_auth }}@attribute [Microsoft.AspNetCore.Authorization.Authorize]
{{ end }}
@* Scaffold generated by `modulus ui`. This file is yours: edit the markup and the code block freely. *@
@* The notification preferences comes from INotificationCenter (Modulus.Ui.Abstractions.Admin). Until you register your own implementation the built-in *@
@* sample data answers and the page says so. To connect real data, implement INotificationCenter and register it after AddModulusBlazor, *@
@* or replace the calls in @code below with your own services. *@
@using Modulus.Ui.Abstractions.Admin
@using Microsoft.AspNetCore.Components.Authorization
@inject INotificationCenter NotificationCenter
@inject AuthenticationStateProvider Auth

<PageTitle>Notification preferences</PageTitle>

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Account</div><h1 class="m-page-title">Notification preferences</h1></div>
</div>

@if (NotificationCenter.IsSample)
{
    <div class="ant-alert ant-alert-info ant-alert-with-description m-mb-16" role="status">
        <div class="ant-alert-content">
            <div class="ant-alert-message">Sample data</div>
            <div class="ant-alert-description">This page shows built-in sample data. Register your own INotificationCenter to connect it to your preference store.</div>
        </div>
    </div>
}
@if (_message is not null)
{
    <div class="ant-alert m-mb-16 ant-alert-@(_ok ? "success" : "error")" role="alert"><div class="ant-alert-content"><div class="ant-alert-message">@_message</div></div></div>
}

<form class="ant-form ant-form-vertical" @onsubmit="SaveAsync" @onsubmit:preventDefault>
    <div class="m-card">
        <div class="m-card-header"><h2 class="m-card-title">Email notifications</h2></div>
        <div class="m-card-body">
            <div class="m-checkbox-group">
                <label class="ant-checkbox-wrapper">
                    <input type="checkbox" class="ant-checkbox-input" @bind="_prefs.EmailActivitySummary" />
                    <span>Weekly activity summary</span>
                </label>
                <label class="ant-checkbox-wrapper">
                    <input type="checkbox" class="ant-checkbox-input" @bind="_prefs.EmailSecurityAlerts" />
                    <span>Security alerts and login attempts</span>
                </label>
                <label class="ant-checkbox-wrapper">
                    <input type="checkbox" class="ant-checkbox-input" @bind="_prefs.EmailProductUpdates" />
                    <span>Product updates and announcements</span>
                </label>
                <label class="ant-checkbox-wrapper">
                    <input type="checkbox" class="ant-checkbox-input" @bind="_prefs.EmailMarketing" />
                    <span>Marketing emails and promotions</span>
                </label>
            </div>
        </div>
    </div>

    <div class="m-card m-mt-24">
        <div class="m-card-header"><h2 class="m-card-title">In-app notifications</h2></div>
        <div class="m-card-body">
            <div class="m-checkbox-group">
                <label class="ant-checkbox-wrapper">
                    <input type="checkbox" class="ant-checkbox-input" @bind="_prefs.NotifySystemUpdates" />
                    <span>System updates and maintenance</span>
                </label>
                <label class="ant-checkbox-wrapper">
                    <input type="checkbox" class="ant-checkbox-input" @bind="_prefs.NotifyReports" />
                    <span>Report generation and completion</span>
                </label>
                <label class="ant-checkbox-wrapper">
                    <input type="checkbox" class="ant-checkbox-input" @bind="_prefs.NotifyCollaboration" />
                    <span>Collaboration and mentions</span>
                </label>
                <label class="ant-checkbox-wrapper">
                    <input type="checkbox" class="ant-checkbox-input" @bind="_prefs.NotifyScheduled" />
                    <span>Scheduled task reminders</span>
                </label>
            </div>
        </div>
    </div>

    <div class="m-card m-mt-24">
        <div class="m-card-header"><h2 class="m-card-title">Notification delivery</h2></div>
        <div class="m-card-body">
            <div class="m-form-grid">
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="digest-frequency">Digest frequency</label></div>
                    <div class="ant-form-item-control">
                        <select id="digest-frequency" class="ant-input" @bind="_prefs.DigestFrequency">
                            @foreach (var option in NotificationSettings.DigestFrequencies)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="quiet-hours">Quiet hours start</label></div>
                    <div class="ant-form-item-control"><input id="quiet-hours" class="ant-input" type="time" value="@_prefs.QuietHours" @onchange="e => _prefs.QuietHours = e.Value?.ToString()" /></div>
                </div>
            </div>
        </div>
    </div>

    <div class="m-form-actions m-mt-24">
        <button type="submit" class="ant-btn ant-btn-primary"><span>Save preferences</span></button>
    </div>
</form>

<style>
    .m-checkbox-group { display: flex; flex-direction: column; gap: 12px; }
    .ant-checkbox-wrapper { display: flex; align-items: center; margin: 0; }
    .m-mt-24 { margin-top: 24px; }
</style>

@code {
    private NotificationSettings _prefs = new();
    private string? _userName;
    private string? _message;
    private bool _ok;

    private void Say(string message, bool ok = true)
    {
        _message = message;
        _ok = ok;
    }

    protected override async Task OnInitializedAsync()
    {
        _userName = (await Auth.GetAuthenticationStateAsync()).User.Identity?.Name;
        _prefs = await NotificationCenter.GetPreferencesAsync(_userName);
    }

    private async Task SaveAsync()
    {
        await NotificationCenter.SavePreferencesAsync(_userName, _prefs);
        Say("Preferences saved.");
    }
}

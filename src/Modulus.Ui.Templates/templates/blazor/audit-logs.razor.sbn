@page "/audit"
{{ if use_auth }}@attribute [Microsoft.AspNetCore.Authorization.Authorize]
{{ end }}
@* Scaffold generated by `modulus ui`. This file is yours: edit the markup and the code block freely. *@
@* The audit events comes from IAuditTrail (Modulus.Ui.Abstractions.Admin). Until you register your own implementation the built-in *@
@* sample data answers and the page says so. To connect real data, implement IAuditTrail and register it after AddModulusBlazor, *@
@* or replace the calls in @code below with your own services. *@
@using Modulus.Ui.Abstractions.Admin
@inject IAuditTrail AuditTrail

<PageTitle>Audit logs</PageTitle>

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Security</div><h1 class="m-page-title">Audit logs</h1></div>
</div>

@if (AuditTrail.IsSample)
{
    <div class="ant-alert ant-alert-info ant-alert-with-description m-mb-16" role="status">
        <div class="ant-alert-content">
            <div class="ant-alert-message">Sample data</div>
            <div class="ant-alert-description">This page shows built-in sample data. Register your own IAuditTrail to connect it to your audit store.</div>
        </div>
    </div>
}

<div class="m-card">
    <div class="m-card-header">
        <h2 class="m-card-title">Activity timeline</h2>
        <div class="m-card-actions">
            <input type="search" class="ant-input" placeholder="Search logs..." aria-label="Search logs" @bind="_q" @bind:event="oninput" @bind:after="LoadAsync" />
        </div>
    </div>
    <div class="m-card-body m-card-body-flush">
        @if (_items.Count == 0)
        {
            <div class="m-empty">
                <h3 class="m-empty-title">No events found</h3>
                <p class="m-empty-subtitle">Events appear here as things happen.</p>
            </div>
        }
        else
        {
            <div class="ant-table-wrapper m-table-flush">
                <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                    <table style="table-layout:auto">
                        <thead class="ant-table-thead"><tr><th class="ant-table-cell">When (UTC)</th><th class="ant-table-cell">Who</th><th class="ant-table-cell">What</th><th class="ant-table-cell">Target</th><th class="ant-table-cell">Details</th></tr></thead>
                        <tbody class="ant-table-tbody">
                            @foreach (var e in _items)
                            {
                                <tr class="ant-table-row">
                                    <td class="ant-table-cell">@e.At.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="ant-table-cell">@e.Actor</td>
                                    <td class="ant-table-cell"><strong>@e.Action</strong></td>
                                    <td class="ant-table-cell">@e.Target</td>
                                    <td class="ant-table-cell">@e.Detail</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div></div></div>
            </div>
        }
    </div>
</div>

@code {
    private IReadOnlyList<AuditEntry> _items = [];
    private string? _q;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() => _items = await AuditTrail.SearchAsync(_q);
}

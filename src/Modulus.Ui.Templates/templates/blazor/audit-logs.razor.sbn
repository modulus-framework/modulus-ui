@page "/audit-logs"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject HttpClient Http

<PageTitle>Audit Logs</PageTitle>

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Security</div><h1 class="m-page-title">Audit logs</h1></div>
</div>

@if (Logs == null)
{
    <p class="m-muted">Loading audit logs...</p>
}
else
{
    <div class="m-card">
        <div class="m-card-header">
            <h2 class="m-card-title">Activity timeline</h2>
            <div class="m-card-actions">
                <input type="search" class="ant-input" placeholder="Search logs..." aria-label="Search logs" @oninput="OnSearch" />
            </div>
        </div>
        <div class="m-card-body m-card-body-flush">
            <div class="ant-table-wrapper m-table-flush"><div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                <table style="table-layout:auto">
                    <thead class="ant-table-thead"><tr><th class="ant-table-cell">Timestamp</th><th class="ant-table-cell">User</th><th class="ant-table-cell">Action</th><th class="ant-table-cell">Resource</th><th class="ant-table-cell">Status</th></tr></thead>
                    <tbody class="ant-table-tbody">
                        @foreach (var log in Logs.Where(l => string.IsNullOrEmpty(SearchTerm) || l.User.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) || l.Resource.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)))
                        {
                            <tr class="ant-table-row">
                                <td class="ant-table-cell m-muted">@log.Timestamp</td>
                                <td class="ant-table-cell"><span class="m-flex"><span class="m-avatar m-avatar-sm">@Initials(log.User)</span>@log.User</span></td>
                                <td class="ant-table-cell"><span class="m-badge @GetActionBadgeClass(log.Action)">@log.Action</span></td>
                                <td class="ant-table-cell m-muted">@log.Resource</td>
                                <td class="ant-table-cell"><span class="m-badge m-badge-success-lt">@log.Status</span></td>
                            </tr>
                        }
                        @if (Logs.Count == 0)
                        {
                            <tr class="ant-table-placeholder"><td colspan="5" class="ant-table-cell m-muted">No audit events yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div></div></div></div>
        </div>
    </div>
}

@code {
    private List<AuditLog>? Logs;
    private string SearchTerm = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Logs = await Http.GetFromJsonAsync<List<AuditLog>>("/api/admin/audit-logs");
            Logs ??= new List<AuditLog>();
        }
        catch
        {
            Logs = new List<AuditLog>();
        }
    }

    private async Task OnSearch(ChangeEventArgs args)
    {
        SearchTerm = args.Value?.ToString() ?? "";
        // Implement search logic
    }

    private string GetActionBadgeClass(string action) => action?.ToUpper() switch
    {
        "CREATE" => "m-badge-success-lt",
        "UPDATE" => "m-badge-info-lt",
        "DELETE" => "m-badge-danger-lt",
        _ => "m-badge-gray-lt"
    };

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));

    public class AuditLog
    {
        public string Timestamp { get; set; } = "";
        public string User { get; set; } = "";
        public string Action { get; set; } = "";
        public string Resource { get; set; } = "";
        public string Status { get; set; } = "Success";
    }
}

@* Empty state: shown when a list or search has no results *@

<div class="m-empty">
    <h3 class="m-empty-title">@Title</h3>
    @if (!string.IsNullOrEmpty(Message))
    {
        <p class="m-empty-subtitle">@Message</p>
    }
    @if (!string.IsNullOrEmpty(ActionText))
    {
        <a href="@ActionUrl" class="ant-btn ant-btn-primary"><span>@ActionText</span></a>
    }
    @ChildContent
</div>

@code {
    [Parameter] public string Title { get; set; } = "Nothing here yet";
    [Parameter] public string? Message { get; set; }
    [Parameter] public string? ActionText { get; set; }
    [Parameter] public string ActionUrl { get; set; } = "#";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

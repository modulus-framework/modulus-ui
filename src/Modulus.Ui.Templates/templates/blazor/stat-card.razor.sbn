@* Stat card: one headline number with a label and an optional change ("+12%" / "-3%") *@

<div class="m-card m-stat-card">
    <div class="m-card-body">
        <div class="m-stat-card-head"><span>@Label</span></div>
        <div class="m-stat-card-value">@Value</div>
        @if (!string.IsNullOrEmpty(Change))
        {
            <div class="m-stat-sub"><span class="m-text-@(Change.StartsWith('-') ? "danger" : "success")">@Change</span></div>
        }
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "0";
    [Parameter] public string? Change { get; set; }
}

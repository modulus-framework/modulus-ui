@* Session manager: lists the caller's sessions and sign-in history from the Modulus.Identity account endpoints (/account/sessions, /account/login-history) *@
@page "/auth/sessions"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Sessions</PageTitle>

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Account</div><h1 class="m-page-title">Sessions</h1></div>
    <div class="m-page-actions"><button type="button" class="ant-btn ant-btn-default ant-btn-dangerous" @onclick="RevokeAllAsync"><span>Sign out everywhere</span></button></div>
</div>

@if (_message is not null)
{
    <div class="ant-alert m-mb-16 ant-alert-@(_ok ? "success" : "error")" role="alert"><div class="ant-alert-content"><div class="ant-alert-message">@_message</div></div></div>
}

<div class="m-row-cards">
    <div class="m-card">
        <div class="m-card-header"><h2 class="m-card-title">Active sessions</h2></div>
        <div class="ant-table-wrapper m-table-flush">
            <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                <table style="table-layout:auto">
                    <thead class="ant-table-thead"><tr><th class="ant-table-cell">Type</th><th class="ant-table-cell">Application</th><th class="ant-table-cell">Started</th><th class="ant-table-cell">Expires</th><th class="ant-table-cell"></th></tr></thead>
                    <tbody class="ant-table-tbody">
                        @foreach (var s in _sessions)
                        {
                            <tr class="ant-table-row">
                                <td class="ant-table-cell">@s.Type</td>
                                <td class="ant-table-cell">@s.ClientId</td>
                                <td class="ant-table-cell">@s.CreatedAt?.ToLocalTime().ToString("g")</td>
                                <td class="ant-table-cell">@s.ExpiresAt?.ToLocalTime().ToString("g")</td>
                                <td class="ant-table-cell"><button type="button" class="ant-btn ant-btn-default ant-btn-sm ant-btn-dangerous" @onclick="() => RevokeAsync(s.Id)"><span>Revoke</span></button></td>
                            </tr>
                        }
                        @if (_sessions.Count == 0)
                        {
                            <tr class="ant-table-placeholder"><td colspan="5" class="ant-table-cell m-muted">No active sessions.</td></tr>
                        }
                    </tbody>
                </table>
            </div></div></div>
        </div>
    </div>
    <div class="m-card">
        <div class="m-card-header"><h2 class="m-card-title">Recent sign-ins</h2></div>
        <div class="ant-table-wrapper m-table-flush">
            <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                <table style="table-layout:auto">
                    <thead class="ant-table-thead"><tr><th class="ant-table-cell">When</th><th class="ant-table-cell">Event</th><th class="ant-table-cell">Result</th><th class="ant-table-cell">Application</th></tr></thead>
                    <tbody class="ant-table-tbody">
                        @foreach (var e in _history)
                        {
                            <tr class="ant-table-row">
                                <td class="ant-table-cell">@e.OccurredAt.ToLocalTime().ToString("g")</td>
                                <td class="ant-table-cell">@e.Action</td>
                                <td class="ant-table-cell">@(e.Succeeded ? "OK" : "Refused" + (e.Reason is null ? "" : $" ({e.Reason})"))</td>
                                <td class="ant-table-cell">@e.ClientId</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div></div></div>
        </div>
    </div>
</div>

@code {
    private sealed record SessionRow(string Id, string Type, string? ClientId, DateTimeOffset? CreatedAt, DateTimeOffset? ExpiresAt);
    private sealed record LoginRow(DateTimeOffset OccurredAt, string Action, bool Succeeded, string? Reason, string? ClientId);

    private List<SessionRow> _sessions = [];
    private List<LoginRow> _history = [];
    private string? _message;
    private bool _ok;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var sessions = await Http.GetAsync("/account/sessions");
        if (!sessions.IsSuccessStatusCode)
        {
            Fail("Sign in to see your sessions.");
            return;
        }
        _sessions = await sessions.Content.ReadFromJsonAsync<List<SessionRow>>() ?? [];
        _history = await Http.GetFromJsonAsync<List<LoginRow>>("/account/login-history?take=25") ?? [];
    }

    private async Task RevokeAsync(string id)
    {
        var response = await Http.DeleteAsync($"/account/sessions/{Uri.EscapeDataString(id)}");
        _ok = response.IsSuccessStatusCode;
        _message = _ok ? "Session ended." : "Could not end the session.";
        await LoadAsync();
    }

    private async Task RevokeAllAsync()
    {
        var response = await Http.PostAsync("/account/sessions/revoke-all", null);
        if (response.IsSuccessStatusCode)
            Navigation.NavigateTo("/", forceLoad: true);
        else
            Fail("Could not sign out everywhere.");
    }

    private void Fail(string message)
    {
        _ok = false;
        _message = message;
    }
}

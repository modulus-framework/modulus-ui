@* Status badge: the text as child content and Tone (default, success, warning, danger, info) *@
@using Modulus.Blazor.Components.Pro

<Modulus.Blazor.Components.Pro.StatusBadge Tone="@Tone">@ChildContent</Modulus.Blazor.Components.Pro.StatusBadge>

@code {
    [Parameter] public string Tone { get; set; } = "default";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

@* Reset password page: talks to the Modulus.Identity account endpoints on this host (/account/...) *@
@page "/auth/reset-password"
@inject HttpClient Http

<PageTitle>Reset password</PageTitle>

<div class="page page-center">
    <div class="container container-tight py-4">
        <div class="card card-md">
            <div class="card-body">
                <h2 class="h2 text-center mb-4">Reset password</h2>
                @if (_message is not null)
                {
                    <div class="alert @(_ok ? "alert-success" : "alert-danger")" role="alert">@_message</div>
                }
                <EditForm Model="this" OnSubmit="ResetAsync">
                    <div class="mb-3">
                        <label class="form-label">New password</label>
                        <InputText @bind-Value="Password" type="password" class="form-control" autocomplete="new-password" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Confirm password</label>
                        <InputText @bind-Value="Confirm" type="password" class="form-control" autocomplete="new-password" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100" disabled="@_busy">Reset password</button>
                </EditForm>
                <div class="text-center text-secondary mt-3"><a href="/Account/Login">Back to sign in</a></div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private string Password { get; set; } = "";
    private string Confirm { get; set; } = "";
    private string? _message;
    private bool _ok;
    private bool _busy;

    private sealed record ErrorBody(string? Error);

    private async Task ResetAsync()
    {
        if (Password != Confirm)
        {
            _ok = false;
            _message = "The passwords do not match.";
            return;
        }

        _busy = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/account/reset-password", new { email = Email, token = Token, newPassword = Password });
            _ok = response.IsSuccessStatusCode;
            _message = _ok
                ? "Your password has been reset. You can sign in now."
                : (await response.Content.ReadFromJsonAsync<ErrorBody>())?.Error ?? "The link is not valid or has expired.";
        }
        finally { _busy = false; }
    }
}

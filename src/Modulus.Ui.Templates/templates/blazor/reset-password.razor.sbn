@* Reset password page: talks to the Modulus.Identity account endpoints on this host (/account/...) *@
@page "/auth/reset-password"
@inject Modulus.Blazor.ModulusHttp Http

<PageTitle>Reset password</PageTitle>

<div class="m-auth-card">
    <div class="m-auth-card-body">
        <h1 class="m-auth-title">Reset password</h1>
        <p class="m-auth-hint">Choose a new password for your account.</p>
        @if (_message is not null)
        {
            <div class="ant-alert m-mb-16 ant-alert-@(_ok ? "success" : "error")" role="alert"><div class="ant-alert-content"><div class="ant-alert-message">@_message</div></div></div>
        }
        <EditForm Model="this" OnSubmit="ResetAsync" class="ant-form ant-form-vertical ant-form-hide-required-mark">
            <div class="ant-form-item">
                <div class="ant-form-item-label"><label>New password</label></div>
                <div class="ant-form-item-control"><InputText @bind-Value="Password" type="password" class="ant-input" autocomplete="new-password" /></div>
            </div>
            <div class="ant-form-item">
                <div class="ant-form-item-label"><label>Confirm password</label></div>
                <div class="ant-form-item-control"><InputText @bind-Value="Confirm" type="password" class="ant-input" autocomplete="new-password" /></div>
            </div>
            <div class="m-auth-actions">
                <button type="submit" class="ant-btn ant-btn-primary ant-btn-block" disabled="@_busy"><span>Reset password</span></button>
            </div>
        </EditForm>
        <p class="m-auth-hint m-mt-16"><a href="/Account/Login">Back to sign in</a></p>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private string Password { get; set; } = "";
    private string Confirm { get; set; } = "";
    private string? _message;
    private bool _ok;
    private bool _busy;

    private async Task ResetAsync()
    {
        if (Password != Confirm)
        {
            _ok = false;
            _message = "The passwords do not match.";
            return;
        }

        _busy = true;
        try
        {
            var response = await Http.PostAsync("/account/reset-password", new { email = Email, token = Token, newPassword = Password });
            _ok = response.Ok;
            _message = _ok
                ? "Your password has been reset. You can sign in now."
                : response.Error ?? "The link is not valid or has expired.";
        }
        finally { _busy = false; }
    }
}

@* Date picker: Label, Value, Picker (date, week, month, quarter, year) and ShowTime *@

<div class="ant-form-item m-field">
    @if (!string.IsNullOrEmpty(Label))
    {
        <div class="ant-form-item-label">
            <label class="@(Required ? "ant-form-item-required" : "")">@Label</label>
        </div>
    }
    <div class="ant-form-item-control">
        <AntDesign.DatePicker TValue="DateTime?" Value="@Value" ValueChanged="SetValue" Picker="@Picker" ShowTime="ShowTime" Placeholder="@Placeholder" Disabled="Disabled" Style="width:100%" />
        @if (!string.IsNullOrEmpty(Help))
        {
            <div class="m-muted m-mt-4">@Help</div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Help { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    [Parameter] public string Picker { get; set; } = "date";
    [Parameter] public bool ShowTime { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    private async Task SetValue(DateTime? v)
    {
        Value = v;
        await ValueChanged.InvokeAsync(v);
    }
}

@* Trend: a wrapper around Components.Pro.Trend. Pass its parameters through; defaults match the framework. *@
@using Modulus.Blazor.Components.Pro
@using Microsoft.AspNetCore.Components

<Modulus.Blazor.Components.Pro.Trend
    Direction="@Direction"
    Inverse="@Inverse"
    ChildContent="@ChildContent" />

@code {
    [Parameter] public TrendDirection Direction { get; set; } = TrendDirection.Up;
    [Parameter] public bool Inverse { get; set; } = false;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

@* Rich text editor: Value (HTML), ValueChanged, Label, Placeholder, MinHeight and ReadOnly *@
@using Modulus.Blazor.Components.Extras

<AppEditor Value="@Value" ValueChanged="ValueChanged" Label="@Label" Placeholder="@Placeholder" MinHeight="MinHeight" ReadOnly="ReadOnly" />

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public int MinHeight { get; set; } = 220;
    [Parameter] public bool ReadOnly { get; set; }
}

@* Cascader: Label, Options (a TreeOption tree), Value (the chosen path) and Placeholder *@

<div class="ant-form-item m-field">
    @if (!string.IsNullOrEmpty(Label))
    {
        <div class="ant-form-item-label">
            <label class="@(Required ? "ant-form-item-required" : "")">@Label</label>
        </div>
    }
    <div class="ant-form-item-control">
        <AntDesign.Cascader Options="_nodes" Value="@Value" ValueChanged="SetValue" Placeholder="@Placeholder" Disabled="Disabled" Style="width:100%" />
        @if (!string.IsNullOrEmpty(Help))
        {
            <div class="m-muted m-mt-4">@Help</div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Help { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<TreeOption> Options { get; set; } = [];
    [Parameter] public string? Placeholder { get; set; }
    private List<CascaderNode> _nodes = [];

    protected override void OnParametersSet() => _nodes = Options.Select(ToNode).ToList();

    private static CascaderNode ToNode(TreeOption o) => new()
    {
        Value = o.Value,
        Label = o.Title,
        Disabled = o.Disabled,
        Children = o.Children?.Select(ToNode)
    };

    private async Task SetValue(string? v)
    {
        Value = v;
        await ValueChanged.InvokeAsync(v);
    }
}

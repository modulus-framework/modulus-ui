@* Result: Status (success, info, warning, error, 404, 403, 500), Title, SubTitle and the actions as child content *@

<AntDesign.Result Status="@Status" Title="@Title" SubTitle="@SubTitle">
    <Extra>@ChildContent</Extra>
</AntDesign.Result>

@code {
    [Parameter] public string Status { get; set; } = "success";
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? SubTitle { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

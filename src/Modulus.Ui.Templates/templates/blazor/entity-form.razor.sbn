@page "/{{ entity_name_plural | string.downcase }}/edit/{Id:guid?}"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>@(Item?.Id == Guid.Empty ? "Create" : "Edit") {{ entity_name }}</PageTitle>

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">{{ entity_name_plural }}</div><h1 class="m-page-title">@(Item?.Id == Guid.Empty ? "Create" : "Edit") {{ entity_name }}</h1></div>
</div>

<div class="m-grid m-cols-main">
    <div class="m-card">
        <div class="m-card-body">
            @if (Item == null)
            {
                <p class="m-muted">Loading...</p>
            }
            else
            {
                <EditForm Model="Item" OnValidSubmit="HandleSubmit" class="ant-form ant-form-vertical">
                    <DataAnnotationsValidator />
{{ for f in fields ~}}
                    <div class="ant-form-item">
{{ if f.kind == "checkbox" ~}}
                        <div class="ant-form-item-control">
                            <label><InputCheckbox @bind-Value="Item.{{ f.name }}" /> {{ f.label }}</label>
                        </div>
{{ else ~}}
                        <div class="ant-form-item-label"><label class="{{ if f.required }}ant-form-item-required{{ end }}">{{ f.label }}</label></div>
                        <div class="ant-form-item-control">
{{ if f.kind == "textarea" ~}}
                            <InputTextArea @bind-Value="Item.{{ f.name }}" class="ant-input" rows="4" />
{{ else if f.kind == "number" ~}}
                            <InputNumber @bind-Value="Item.{{ f.name }}" class="ant-input" />
{{ else if f.kind == "date" || f.kind == "datetime" ~}}
                            <InputDate @bind-Value="Item.{{ f.name }}" class="ant-input" />
{{ else ~}}
                            <InputText @bind-Value="Item.{{ f.name }}" class="ant-input" />
{{ end ~}}
                            <ValidationMessage For="() => Item.{{ f.name }}" class="ant-form-item-explain-error" />
                        </div>
{{ end ~}}
                    </div>
{{ end ~}}
                    <div class="m-form-actions">
                        <button type="submit" class="ant-btn ant-btn-primary"><span>@(Item.Id == Guid.Empty ? "Create" : "Update")</span></button>
                        <a href="/{{ entity_name_plural | string.downcase }}" class="ant-btn ant-btn-default"><span>Cancel</span></a>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private {{ entity_name }}Dto? Item { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Item = Id.HasValue && Id.Value != Guid.Empty
            ? await Http.GetFromJsonAsync<{{ entity_name }}Dto>($"/api/{{ entity_name_plural | string.downcase }}/{Id}")
            : new {{ entity_name }}Dto();
    }

    private async Task HandleSubmit()
    {
        // TODO: save through the API
        Navigation.NavigateTo("/{{ entity_name_plural | string.downcase }}");
        await Task.CompletedTask;
    }
}

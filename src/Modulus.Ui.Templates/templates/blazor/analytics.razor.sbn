@page "/analytics"
@inject HttpClient Http

<PageTitle>Analytics</PageTitle>

<div class="page-wrapper">
    <div class="container-xl">
        <div class="page-header d-mb-4">
            <div class="row align-items-center">
                <div class="col">
                    <h2 class="page-title">Analytics & Insights</h2>
                </div>
                <div class="col-auto">
                    <select class="form-select" style="width: 150px;">
                        <option selected>Last 30 days</option>
                        <option>Last 7 days</option>
                        <option>Last 90 days</option>
                        <option>This year</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="page-body">
        <div class="container-xl">
            @if (Analytics == null)
            {
                <p><em>Loading analytics...</em></p>
            }
            else
            {
                <div class="row row-deck row-cards mb-4">
                    <div class="col-sm-6 col-lg-3">
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex align-items-baseline">
                                    <div class="h2 mb-0">@(Analytics.PageViews ?? "0")</div>
                                    <div class="ms-auto"><span class="badge badge-success">+12%</span></div>
                                </div>
                                <div class="text-secondary">Page Views</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex align-items-baseline">
                                    <div class="h2 mb-0">@(Analytics.UniqueUsers ?? "0")</div>
                                    <div class="ms-auto"><span class="badge badge-success">+8%</span></div>
                                </div>
                                <div class="text-secondary">Unique Users</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex align-items-baseline">
                                    <div class="h2 mb-0">@(Analytics.AvgSessionDuration ?? "0s")</div>
                                    <div class="ms-auto"><span class="badge badge-danger">-2%</span></div>
                                </div>
                                <div class="text-secondary">Avg. Session Duration</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex align-items-baseline">
                                    <div class="h2 mb-0">@(Analytics.ConversionRate ?? "0%")</div>
                                    <div class="ms-auto"><span class="badge badge-success">+5%</span></div>
                                </div>
                                <div class="text-secondary">Conversion Rate</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row row-deck row-cards">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h3 class="card-title">Traffic Over Time</h3>
                            </div>
                            <div class="card-body" style="height: 300px;">
                                <p class="text-muted">Chart placeholder - integrate Chart.js</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h3 class="card-title">Top Pages</h3>
                            </div>
                            <div class="card-body">
                                <ul class="list-unstyled divide-y">
                                    @foreach (var page in Analytics.TopPages ?? new List<PageStat>())
                                    {
                                        <li class="py-3">
                                            <div class="d-flex justify-content-between">
                                                <span>@page.Path</span>
                                                <span class="text-muted">@page.Views views</span>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private AnalyticsData? Analytics;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Analytics = await Http.GetFromJsonAsync<AnalyticsData>("/api/admin/analytics");
            Analytics ??= new AnalyticsData
            {
                PageViews = "1,234",
                UniqueUsers = "456",
                AvgSessionDuration = "5m 30s",
                ConversionRate = "3.2%",
                TopPages = new List<PageStat>()
            };
        }
        catch
        {
            Analytics = new AnalyticsData();
        }
    }

    public class AnalyticsData
    {
        public string? PageViews { get; set; }
        public string? UniqueUsers { get; set; }
        public string? AvgSessionDuration { get; set; }
        public string? ConversionRate { get; set; }
        public List<PageStat>? TopPages { get; set; }
    }

    public class PageStat
    {
        public string Path { get; set; } = "";
        public string Views { get; set; } = "";
    }
}

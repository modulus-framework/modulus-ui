@page "/analytics"
@using Modulus.Blazor.Components.Charts
@using Modulus.Ui.Abstractions.Charts
@inject HttpClient Http

<PageTitle>Analytics</PageTitle>

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Reports</div><h1 class="m-page-title">Analytics &amp; insights</h1></div>
</div>

@if (Data == null)
{
    <p class="m-muted">Loading analytics...</p>
}
else
{
    <div class="m-row-cards">
        <div class="m-grid m-cols-4">
            <div class="m-card m-stat-card">
                <div class="m-card-body">
                    <div class="m-stat-card-head"><span>Page views</span></div>
                    <div class="m-stat-card-value">@(Data.PageViews ?? "0")</div>
                        <div class="m-stat-sub"><span class="m-text-success">+12%</span></div>
                </div>
            </div>
            <div class="m-card m-stat-card">
                <div class="m-card-body">
                    <div class="m-stat-card-head"><span>Unique users</span></div>
                    <div class="m-stat-card-value">@(Data.UniqueUsers ?? "0")</div>
                        <div class="m-stat-sub"><span class="m-text-success">+8%</span></div>
                </div>
            </div>
            <div class="m-card m-stat-card">
                <div class="m-card-body">
                    <div class="m-stat-card-head"><span>Avg. session duration</span></div>
                    <div class="m-stat-card-value">@(Data.AvgSessionDuration ?? "0s")</div>
                        <div class="m-stat-sub"><span class="m-text-danger">-2%</span></div>
                </div>
            </div>
            <div class="m-card m-stat-card">
                <div class="m-card-body">
                    <div class="m-stat-card-head"><span>Conversion rate</span></div>
                    <div class="m-stat-card-value">@(Data.ConversionRate ?? "0%")</div>
                        <div class="m-stat-sub"><span class="m-text-success">+5%</span></div>
                </div>
            </div>
        </div>

        <div class="m-grid m-cols-main">
            <div class="m-card">
                <div class="m-card-header"><h2 class="m-card-title">Traffic over time</h2></div>
                <div class="m-card-body">
                    <LineChart Labels="_days" Series="_traffic" Area />
                </div>
            </div>
            <div class="m-card">
                <div class="m-card-header"><h2 class="m-card-title">Top pages</h2></div>
                <div class="m-card-body">
                    <ul class="m-list m-list-plain">
                        @foreach (var entry in Data.TopPages ?? new List<PageStat>())
                        {
                            <li class="m-flex m-between m-mb-12"><span>@entry.Path</span><span class="m-muted">@entry.Views views</span></li>
                        }
                    </ul>
                    @if (Data.TopPages is null || Data.TopPages.Count == 0)
                    {
                        <p class="m-muted m-mb-0">No page views recorded yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly string[] _days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    private readonly ChartSeries[] _traffic =
    [
        new("Page views", [820, 932, 901, 934, 1290, 1330, 1320]),
        new("Unique users", [320, 402, 391, 434, 590, 630, 610]),
    ];

    private AnalyticsData? Data;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Data = await Http.GetFromJsonAsync<AnalyticsData>("/api/admin/analytics");
            Data ??= new AnalyticsData
            {
                PageViews = "1,234",
                UniqueUsers = "456",
                AvgSessionDuration = "5m 30s",
                ConversionRate = "3.2%",
                TopPages = new List<PageStat>()
            };
        }
        catch
        {
            Data = new AnalyticsData();
        }
    }

    public class AnalyticsData
    {
        public string? PageViews { get; set; }
        public string? UniqueUsers { get; set; }
        public string? AvgSessionDuration { get; set; }
        public string? ConversionRate { get; set; }
        public List<PageStat>? TopPages { get; set; }
    }

    public class PageStat
    {
        public string Path { get; set; } = "";
        public string Views { get; set; } = "";
    }
}

@* Modal: IsOpen, Title, Size (sm, md, lg, xl), the body as child content, an optional Footer and OnClose *@

@if (IsOpen)
{
    <div class="m-modal">
        <div class="ant-modal-mask"></div>
        <div class="ant-modal-wrap" role="dialog" aria-modal="true" @onclick="OnClose">
            <div class="ant-modal" style="width: @(GetWidth())px" @onclick:stopPropagation>
                <div class="ant-modal-content">
                    <button type="button" class="ant-modal-close" aria-label="Close" @onclick="OnClose"><span class="ant-modal-close-x">&times;</span></button>
                    @if (!string.IsNullOrEmpty(Title))
                    {
                        <div class="ant-modal-header"><div class="ant-modal-title">@Title</div></div>
                    }
                    <div class="ant-modal-body">@ChildContent</div>
                    <div class="ant-modal-footer">
                        <button type="button" class="ant-btn ant-btn-default" @onclick="OnClose"><span>Close</span></button>
                        @Footer
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; } = false;

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string Size { get; set; } = "md";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Footer { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private int GetWidth() => Size switch
    {
        "sm" => 400,
        "lg" => 800,
        "xl" => 1100,
        _ => 520
    };
}

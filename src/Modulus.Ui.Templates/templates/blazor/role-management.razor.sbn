@page "/admin/roles"
{{ if use_auth }}@attribute [Microsoft.AspNetCore.Authorization.Authorize]
{{ end }}
@* Scaffold generated by `modulus ui`. This file is yours: edit the markup and the code block freely. *@
@* The role list comes from IRoleDirectory (Modulus.Ui.Abstractions.Admin). Until you register your own implementation the built-in *@
@* sample data answers and the page says so. To connect real data, implement IRoleDirectory and register it after AddModulusBlazor, *@
@* or replace the calls in @code below with your own services. *@
@using Modulus.Ui.Abstractions.Admin
@inject IRoleDirectory RoleDirectory

<PageTitle>Role management</PageTitle>

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Administration</div><h1 class="m-page-title">Role management</h1></div>
</div>

@if (RoleDirectory.IsSample)
{
    <div class="ant-alert ant-alert-info ant-alert-with-description m-mb-16" role="status">
        <div class="ant-alert-content">
            <div class="ant-alert-message">Sample data</div>
            <div class="ant-alert-description">This page shows built-in sample data. Register your own IRoleDirectory to connect it to your role store.</div>
        </div>
    </div>
}
@if (_message is not null)
{
    <div class="ant-alert m-mb-16 ant-alert-@(_ok ? "success" : "error")" role="alert"><div class="ant-alert-content"><div class="ant-alert-message">@_message</div></div></div>
}

<div class="m-card">
    <div class="m-card-header"><h2 class="m-card-title">Create a role</h2></div>
    <div class="m-card-body">
        <form class="m-flex m-flex-wrap" @onsubmit="CreateAsync" @onsubmit:preventDefault>
            <input class="ant-input" placeholder="Role name" aria-label="Role name" @bind="_name" />
            <input class="ant-input" placeholder="Description" aria-label="Description" @bind="_description" />
            <button type="submit" class="ant-btn ant-btn-primary"><span>Create role</span></button>
        </form>
    </div>
</div>

<div class="m-card m-mt-24">
    <div class="m-card-header">
        <h2 class="m-card-title">Roles</h2>
        <div class="m-card-actions">
            <input type="search" class="ant-input" placeholder="Search roles..." aria-label="Search roles" @bind="_q" @bind:event="oninput" @bind:after="LoadAsync" />
        </div>
    </div>
    <div class="m-card-body m-card-body-flush">
        @if (_items.Count == 0)
        {
            <div class="m-empty">
                <h3 class="m-empty-title">No roles found</h3>
            </div>
        }
        else
        {
            <div class="ant-table-wrapper m-table-flush">
                <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                    <table style="table-layout:auto">
                        <thead class="ant-table-thead"><tr><th class="ant-table-cell">Role</th><th class="ant-table-cell">Description</th><th class="ant-table-cell">Members</th><th class="ant-table-cell"></th></tr></thead>
                        <tbody class="ant-table-tbody">
                            @foreach (var r in _items)
                            {
                                <tr class="ant-table-row">
                                    <td class="ant-table-cell"><strong>@r.Name</strong></td>
                                    <td class="ant-table-cell">@r.Description</td>
                                    <td class="ant-table-cell">@r.Members</td>
                                    <td class="ant-table-cell">
                                        @if (_confirm == r.Name)
                                        {
                                            <button type="button" class="ant-btn ant-btn-text ant-btn-sm ant-btn-dangerous" @onclick="() => DeleteAsync(r.Name)"><span>Confirm</span></button>
                                            <button type="button" class="ant-btn ant-btn-text ant-btn-sm" @onclick="() => _confirm = null"><span>Cancel</span></button>
                                        }
                                        else
                                        {
                                            <button type="button" class="ant-btn ant-btn-text ant-btn-sm ant-btn-dangerous" @onclick="() => _confirm = r.Name"><span>Delete</span></button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div></div></div>
            </div>
        }
    </div>
</div>

<style>
    .m-mt-24 { margin-top: 24px; }
</style>

@code {
    private IReadOnlyList<AdminRole> _items = [];
    private string? _q;
    private string _name = "";
    private string _description = "";
    private string? _confirm;
    private string? _message;
    private bool _ok;

    private void Say(string message, bool ok = true)
    {
        _message = message;
        _ok = ok;
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() => _items = await RoleDirectory.SearchAsync(_q);

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            Say("Enter a role name.", false);
            return;
        }
        await RoleDirectory.CreateAsync(_name.Trim(), _description.Trim());
        Say($"Role {_name.Trim()} created.");
        _name = _description = "";
        await LoadAsync();
    }

    private async Task DeleteAsync(string name)
    {
        await RoleDirectory.DeleteAsync(name);
        _confirm = null;
        Say($"Role {name} deleted.");
        await LoadAsync();
    }
}

@* Two-factor authentication page: talks to the Modulus.Identity account endpoints on this host (/account/2fa/...) *@
@page "/auth/two-factor"
{{ if use_auth }}@attribute [Microsoft.AspNetCore.Authorization.Authorize]
{{ end }}
@inject Modulus.Blazor.ModulusHttp Http

<PageTitle>Two-factor authentication</PageTitle>

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Account</div><h1 class="m-page-title">Two-factor authentication</h1></div>
</div>

<div class="m-grid m-cols-main">
    <div class="m-card">
        <div class="m-card-body">
            @if (_message is not null)
            {
                <div class="ant-alert m-mb-16 ant-alert-@(_ok ? "success" : "error")" role="alert"><div class="ant-alert-content"><div class="ant-alert-message">@_message</div></div></div>
            }

            @if (_recoveryCodes is not null)
            {
                <p class="m-text-success"><strong>Two-factor authentication is on.</strong></p>
                <p>Save these recovery codes. Each works once, and they are not shown again:</p>
                <pre class="m-font-mono">@string.Join("\n", _recoveryCodes)</pre>
            }
            else if (_setup is not null)
            {
                <p>Add this key to your authenticator app, or open the link on your phone:</p>
                <p><code>@_setup.SharedKey</code></p>
                <p><a href="@_setup.AuthenticatorUri">Open in authenticator app</a></p>
                <div class="ant-form ant-form-vertical">
                    <div class="ant-form-item">
                        <div class="ant-form-item-label"><label for="code">Code from the app</label></div>
                        <div class="ant-form-item-control"><input id="code" @bind="_code" class="ant-input" inputmode="numeric" autocomplete="one-time-code" /></div>
                    </div>
                </div>
                <button type="button" class="ant-btn ant-btn-primary" @onclick="EnableAsync"><span>Turn on</span></button>
            }
            else
            {
                <p class="m-muted">Protect your account with an authenticator app (Microsoft Authenticator, Google Authenticator, 1Password ...).</p>
                <button type="button" class="ant-btn ant-btn-primary" @onclick="StartAsync"><span>Set up two-factor authentication</span></button>
            }

            <div class="ant-divider ant-divider-horizontal" role="separator"></div>
            <div class="ant-form ant-form-vertical">
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="password">Password (to turn it off)</label></div>
                    <div class="ant-form-item-control"><input id="password" @bind="_password" type="password" class="ant-input" autocomplete="current-password" /></div>
                </div>
            </div>
            <button type="button" class="ant-btn ant-btn-default ant-btn-dangerous" @onclick="DisableAsync"><span>Turn off two-factor authentication</span></button>
        </div>
    </div>
</div>

@code {
    private sealed record Setup(string SharedKey, string AuthenticatorUri);
    private sealed record Codes(string[] RecoveryCodes);

    private Setup? _setup;
    private string[]? _recoveryCodes;
    private string _code = "";
    private string _password = "";
    private string? _message;
    private bool _ok;

    private async Task StartAsync()
    {
        var response = await Http.PostAsync("/account/2fa/setup");
        if (!response.Ok) { Fail("Sign in first, then set up two-factor authentication."); return; }
        _setup = response.Read<Setup>();
        _message = null;
    }

    private async Task EnableAsync()
    {
        var response = await Http.PostAsync("/account/2fa/enable", new { code = _code });
        if (!response.Ok)
        {
            Fail(response.Error ?? "The code is not valid.");
            return;
        }
        _recoveryCodes = response.Read<Codes>()?.RecoveryCodes ?? [];
        _message = null;
    }

    private async Task DisableAsync()
    {
        var response = await Http.PostAsync("/account/2fa/disable", new { password = _password });
        if (response.Ok)
        {
            _ok = true;
            _message = "Two-factor authentication is off.";
            _setup = null;
            _recoveryCodes = null;
        }
        else
        {
            Fail(response.Error ?? "Could not turn it off.");
        }
    }

    private void Fail(string message)
    {
        _ok = false;
        _message = message;
    }
}

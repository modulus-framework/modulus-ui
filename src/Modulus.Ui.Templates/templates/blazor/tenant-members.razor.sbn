@page "/admin/tenants/{Id}/members"
{{ if use_auth }}@attribute [Microsoft.AspNetCore.Authorization.Authorize]
{{ end }}
@* Scaffold generated by `modulus ui`. This file is yours: edit the markup and the code block freely. *@
@* The tenant's members and invitations comes from ITenantDirectory (Modulus.Ui.Abstractions.Admin). Until you register your own implementation the built-in *@
@* sample data answers and the page says so. To connect real data, implement ITenantDirectory and register it after AddModulusBlazor, *@
@* or replace the calls in @code below with your own services. *@
@using Modulus.Ui.Abstractions.Admin
@inject ITenantDirectory TenantDirectory

<PageTitle>Tenant members</PageTitle>

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Administration</div><h1 class="m-page-title">Tenant members</h1></div>
    <a class="ant-btn ant-btn-default" href="/admin/tenants"><span>Back to tenants</span></a>
</div>

@if (TenantDirectory.IsSample)
{
    <div class="ant-alert ant-alert-info ant-alert-with-description m-mb-16" role="status">
        <div class="ant-alert-content">
            <div class="ant-alert-message">Sample data</div>
            <div class="ant-alert-description">This page shows built-in sample data. Register your own ITenantDirectory to connect it to your tenant store.</div>
        </div>
    </div>
}
@if (_message is not null)
{
    <div class="ant-alert m-mb-16 ant-alert-@(_ok ? "success" : "error")" role="alert"><div class="ant-alert-content"><div class="ant-alert-message">@_message</div></div></div>
}

@if (!_found)
{
    <div class="m-empty"><h3 class="m-empty-title">Tenant not found</h3></div>
}
else
{
    <div class="m-card">
        <div class="m-card-header"><h2 class="m-card-title">Invite a member</h2></div>
        <div class="m-card-body">
            <form class="m-flex m-flex-wrap" @onsubmit="InviteAsync" @onsubmit:preventDefault>
                <input class="ant-input" type="email" placeholder="name@example.com" aria-label="Email address" @bind="_email" />
                <select class="ant-input" aria-label="Role" @bind="_role"><option>Member</option><option>Admin</option><option>Owner</option></select>
                <button type="submit" class="ant-btn ant-btn-primary"><span>Invite</span></button>
            </form>
        </div>
    </div>

    <div class="m-card m-mt-24">
        <div class="m-card-header">
            <h2 class="m-card-title">Members</h2>
        <div class="m-card-actions">
            <input type="search" class="ant-input" placeholder="Search members..." aria-label="Search members" @bind="_q" @bind:event="oninput" @bind:after="LoadAsync" />
        </div>
        </div>
    <div class="m-card-body m-card-body-flush">
        @if (_items.Count == 0)
        {
            <div class="m-empty">
                <h3 class="m-empty-title">No members found</h3>
            </div>
        }
        else
        {
            <div class="ant-table-wrapper m-table-flush">
                <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                    <table style="table-layout:auto">
                        <thead class="ant-table-thead"><tr><th class="ant-table-cell">Name</th><th class="ant-table-cell">Email</th><th class="ant-table-cell">Role</th><th class="ant-table-cell"></th></tr></thead>
                        <tbody class="ant-table-tbody">
                            @foreach (var m in _items)
                            {
                                <tr class="ant-table-row">
                                    <td class="ant-table-cell"><strong>@m.Name</strong></td>
                                    <td class="ant-table-cell">@m.Email</td>
                                    <td class="ant-table-cell">@m.Role</td>
                                    <td class="ant-table-cell">
                                        @if (_confirm == m.UserId)
                                        {
                                            <button type="button" class="ant-btn ant-btn-text ant-btn-sm ant-btn-dangerous" @onclick="() => RemoveAsync(m.UserId)"><span>Confirm</span></button>
                                            <button type="button" class="ant-btn ant-btn-text ant-btn-sm" @onclick="() => _confirm = null"><span>Cancel</span></button>
                                        }
                                        else
                                        {
                                            <button type="button" class="ant-btn ant-btn-text ant-btn-sm ant-btn-dangerous" @onclick="() => _confirm = m.UserId"><span>Remove</span></button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div></div></div>
            </div>
        }
    </div>
    </div>

    <div class="m-card m-mt-24">
        <div class="m-card-header"><h2 class="m-card-title">Pending invitations</h2></div>
    <div class="m-card-body m-card-body-flush">
        @if (_invitations.Count == 0)
        {
            <div class="m-empty">
                <h3 class="m-empty-title">No pending invitations</h3>
            </div>
        }
        else
        {
            <div class="ant-table-wrapper m-table-flush">
                <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                    <table style="table-layout:auto">
                        <thead class="ant-table-thead"><tr><th class="ant-table-cell">Email</th><th class="ant-table-cell">Role</th><th class="ant-table-cell">Sent</th></tr></thead>
                        <tbody class="ant-table-tbody">
                            @foreach (var i in _invitations)
                            {
                                <tr class="ant-table-row">
                                    <td class="ant-table-cell">@i.Email</td>
                                    <td class="ant-table-cell">@i.Role</td>
                                    <td class="ant-table-cell">@i.SentAt.ToString("yyyy-MM-dd")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div></div></div>
            </div>
        }
    </div>
    </div>
}

<style>
    .m-mt-24 { margin-top: 24px; }
</style>

@code {
    [Parameter] public string Id { get; set; } = "";

    private bool _found;
    private IReadOnlyList<TenantMember> _items = [];
    private IReadOnlyList<TenantInvitation> _invitations = [];
    private string? _q;
    private string _email = "";
    private string _role = "Member";
    private string? _confirm;
    private string? _message;
    private bool _ok;

    private void Say(string message, bool ok = true)
    {
        _message = message;
        _ok = ok;
    }

    protected override async Task OnParametersSetAsync()
    {
        _found = await TenantDirectory.GetAsync(Id) is not null;
        if (_found) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _items = await TenantDirectory.MembersAsync(Id, _q);
        _invitations = await TenantDirectory.InvitationsAsync(Id);
    }

    private async Task InviteAsync()
    {
        if (string.IsNullOrWhiteSpace(_email))
        {
            Say("Enter an email address.", false);
            return;
        }
        await TenantDirectory.InviteMemberAsync(Id, _email.Trim(), _role);
        Say($"Invitation sent to {_email.Trim()}.");
        _email = "";
        await LoadAsync();
    }

    private async Task RemoveAsync(string userId)
    {
        await TenantDirectory.RemoveMemberAsync(Id, userId);
        _confirm = null;
        Say("Member removed.");
        await LoadAsync();
    }
}

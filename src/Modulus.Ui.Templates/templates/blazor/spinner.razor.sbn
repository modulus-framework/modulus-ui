@* Spinner: Size (sm, lg) and Label *@

<div class="ant-spin ant-spin-spinning @(Size == "sm" ? "ant-spin-sm" : Size == "lg" ? "ant-spin-lg" : "")" role="status" aria-live="polite">
    <span class="ant-spin-dot ant-spin-dot-spin"><i class="ant-spin-dot-item"></i><i class="ant-spin-dot-item"></i><i class="ant-spin-dot-item"></i><i class="ant-spin-dot-item"></i></span>
    @if (!string.IsNullOrEmpty(Label))
    {
        <div class="ant-spin-text">@Label</div>
    }
</div>

@code {
    [Parameter] public string? Size { get; set; }
    [Parameter] public string? Label { get; set; } = "Loading...";
}

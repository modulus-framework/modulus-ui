@* Select: Label, Options (value and label), Value, Placeholder and AllowClear *@

<div class="ant-form-item m-field">
    @if (!string.IsNullOrEmpty(Label))
    {
        <div class="ant-form-item-label">
            <label class="@(Required ? "ant-form-item-required" : "")">@Label</label>
        </div>
    }
    <div class="ant-form-item-control">
        <AntDesign.Select TItemValue="string" TItem="string" Value="@Value" ValueChanged="SetValue" Placeholder="@Placeholder" AllowClear="AllowClear" Disabled="Disabled" Style="width:100%">
            <SelectOptions>
                @foreach (var option in Options)
                {
                    <SelectOption TItemValue="string" TItem="string" Value="@option.Value" Label="@option.Label" />
                }
            </SelectOptions>
        </AntDesign.Select>
        @if (!string.IsNullOrEmpty(Help))
        {
            <div class="m-muted m-mt-4">@Help</div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Help { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool AllowClear { get; set; } = true;
    [Parameter] public IEnumerable<Option> Options { get; set; } = [];
    public sealed record Option(string Value, string Label);
    private async Task SetValue(string v)
    {
        Value = v;
        await ValueChanged.InvokeAsync(v);
    }
}

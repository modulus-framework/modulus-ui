@page "/admin/tenants"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@* Scaffold generated by `modulus ui`. This file is yours: edit the markup and the code block freely. *@
@* The tenant list comes from ITenantDirectory (Modulus.Ui.Abstractions.Admin). Until you register your own implementation the built-in *@
@* sample data answers and the page says so. To connect real data, implement ITenantDirectory and register it after AddModulusBlazor, *@
@* or replace the calls in @code below with your own services. *@
@using Modulus.Ui.Abstractions.Admin
@inject ITenantDirectory Tenants

<PageTitle>Tenant management</PageTitle>

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Administration</div><h1 class="m-page-title">Tenant management</h1></div>
</div>

@if (Tenants.IsSample)
{
    <div class="ant-alert ant-alert-info ant-alert-with-description m-mb-16" role="status">
        <div class="ant-alert-content">
            <div class="ant-alert-message">Sample data</div>
            <div class="ant-alert-description">This page shows built-in sample data. Register your own ITenantDirectory to connect it to your tenant store.</div>
        </div>
    </div>
}
@if (_message is not null)
{
    <div class="ant-alert m-mb-16 ant-alert-@(_ok ? "success" : "error")" role="alert"><div class="ant-alert-content"><div class="ant-alert-message">@_message</div></div></div>
}

<div class="m-card">
    <div class="m-card-header"><h2 class="m-card-title">Create a tenant</h2></div>
    <div class="m-card-body">
        <form class="m-flex m-flex-wrap" @onsubmit="CreateAsync" @onsubmit:preventDefault>
            <input class="ant-input" placeholder="Tenant name" aria-label="Tenant name" @bind="_name" />
            <input class="ant-input" placeholder="tenant.example.com" aria-label="Domain" @bind="_domain" />
            <button type="submit" class="ant-btn ant-btn-primary"><span>Create tenant</span></button>
        </form>
    </div>
</div>

<div class="m-card m-mt-24">
    <div class="m-card-header">
        <h2 class="m-card-title">Tenants</h2>
        <div class="m-card-actions">
            <input type="search" class="ant-input" placeholder="Search tenants..." aria-label="Search tenants" @bind="_q" @bind:event="oninput" @bind:after="LoadAsync" />
        </div>
    </div>
    <div class="m-card-body m-card-body-flush">
        @if (_items.Count == 0)
        {
            <div class="m-empty">
                <h3 class="m-empty-title">No tenants found</h3>
            </div>
        }
        else
        {
            <div class="ant-table-wrapper m-table-flush">
                <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                    <table style="table-layout:auto">
                        <thead class="ant-table-thead"><tr><th class="ant-table-cell">Name</th><th class="ant-table-cell">Domain</th><th class="ant-table-cell">Plan</th><th class="ant-table-cell">Status</th><th class="ant-table-cell">Members</th><th class="ant-table-cell"></th></tr></thead>
                        <tbody class="ant-table-tbody">
                            @foreach (var t in _items)
                            {
                                <tr class="ant-table-row">
                                    <td class="ant-table-cell"><strong>@t.Name</strong></td>
                                    <td class="ant-table-cell">@t.Domain</td>
                                    <td class="ant-table-cell">@t.Plan</td>
                                    <td class="ant-table-cell">@t.Status</td>
                                    <td class="ant-table-cell">@t.Members</td>
                                    <td class="ant-table-cell">
                                        <a class="ant-btn ant-btn-text ant-btn-sm" href="/admin/tenants/@t.Id/settings"><span>Settings</span></a>
                                        <a class="ant-btn ant-btn-text ant-btn-sm" href="/admin/tenants/@t.Id/members"><span>Members</span></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div></div></div>
            </div>
        }
    </div>
</div>

<style>
    .m-mt-24 { margin-top: 24px; }
</style>

@code {
    private IReadOnlyList<AdminTenant> _items = [];
    private string? _q;
    private string _name = "";
    private string _domain = "";
    private string? _message;
    private bool _ok;

    private void Say(string message, bool ok = true)
    {
        _message = message;
        _ok = ok;
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() => _items = await Tenants.SearchAsync(_q);

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_domain))
        {
            Say("Enter a name and a domain.", false);
            return;
        }
        await Tenants.CreateAsync(_name.Trim(), _domain.Trim());
        Say($"Tenant {_name.Trim()} created.");
        _name = _domain = "";
        await LoadAsync();
    }
}

@* Form group: Label, Required, Help, Error and the control as child content *@

<div class="ant-form-item">
    @if (!string.IsNullOrEmpty(Label))
    {
        <div class="ant-form-item-label">
            <label class="@(Required ? "ant-form-item-required" : "")">@Label</label>
        </div>
    }
    <div class="ant-form-item-control">
        @ChildContent
        @if (!string.IsNullOrEmpty(Help))
        {
            <div class="m-muted m-mt-4">@Help</div>
        }
        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="ant-form-item-explain-error">@Error</div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? Help { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

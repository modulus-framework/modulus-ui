@page "/notifications"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject HttpClient Http

<PageTitle>Notifications</PageTitle>

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Account</div><h1 class="m-page-title">Notifications</h1></div>
</div>

<div class="m-card">
    <div class="m-card-header">
        <h2 class="m-card-title">Notification center</h2>
        <div class="m-card-actions">
            <button class="ant-btn ant-btn-default" @onclick="MarkAllRead">Mark all as read</button>
            <input type="search" class="ant-input" placeholder="Search notifications..." @oninput="OnSearch" />
        </div>
    </div>
    <div class="m-card-body m-card-body-flush">
        @if (Notifications == null)
        {
            <p class="m-muted">Loading notifications...</p>
        }
        else if (Notifications.Count == 0)
        {
            <div class="m-empty-state">
                <p>No notifications</p>
            </div>
        }
        else
        {
            <div class="m-notification-list">
                @foreach (var notif in FilteredNotifications)
                {
                    <div class="m-notification-item @(notif.IsRead ? "" : "m-notification-unread")">
                        <div class="m-notification-icon m-notification-@notif.Type.ToLower()">
                            @GetIcon(notif.Type)
                        </div>
                        <div class="m-notification-content">
                            <h4 class="m-notification-title">@notif.Title</h4>
                            <p class="m-notification-message m-muted">@notif.Message</p>
                            <span class="m-notification-time m-muted">@GetTimeAgo(notif.CreatedAt)</span>
                        </div>
                        <div class="m-notification-actions">
                            @if (!string.IsNullOrEmpty(notif.ActionUrl))
                            {
                                <a class="ant-btn ant-btn-text ant-btn-sm" href="@notif.ActionUrl">@notif.ActionLabel</a>
                            }
                            <button class="ant-btn ant-btn-text ant-btn-sm" @onclick="@(() => DismissNotification(notif.Id))">Dismiss</button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<NotificationItem>? Notifications;
    private string SearchTerm = "";

    private List<NotificationItem> FilteredNotifications =>
        Notifications?.Where(n => string.IsNullOrEmpty(SearchTerm) ||
                                  n.Title.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                                  n.Message.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)).ToList() ?? new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Notifications = await Http.GetFromJsonAsync<List<NotificationItem>>("/api/notifications");
            Notifications ??= new List<NotificationItem>();
        }
        catch
        {
            Notifications = new List<NotificationItem>();
        }
    }

    private void OnSearch(ChangeEventArgs args)
    {
        SearchTerm = args.Value?.ToString() ?? "";
    }

    private async Task MarkAllRead()
    {
        if (Notifications != null)
        {
            foreach (var notif in Notifications.Where(n => !n.IsRead))
            {
                notif.IsRead = true;
            }
            await Http.PostAsJsonAsync("/api/notifications/mark-all-read", new { });
        }
    }

    private async Task DismissNotification(string id)
    {
        if (Notifications != null)
        {
            Notifications.RemoveAll(n => n.Id == id);
            await Http.DeleteAsync($"/api/notifications/{id}");
        }
    }

    private string GetTimeAgo(DateTime createdAt)
    {
        var timeSpan = DateTime.UtcNow - createdAt;
        return timeSpan.TotalHours < 1 ? $"{(int)timeSpan.TotalMinutes} minutes ago" :
               timeSpan.TotalHours < 24 ? $"{(int)timeSpan.TotalHours} hours ago" :
               timeSpan.TotalDays < 30 ? $"{(int)timeSpan.TotalDays} days ago" : "Long ago";
    }

    private RenderFragment GetIcon(string type) => type?.ToUpper() switch
    {
        "INFO" => @<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>,
        "SUCCESS" => @<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>,
        "WARNING" => @<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3.05h16.94a2 2 0 0 0 1.71-3.05L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>,
        "ERROR" => @<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>,
        _ => null
    };

    public class NotificationItem
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string Message { get; set; } = "";
        public string Type { get; set; } = "Info";
        public bool IsRead { get; set; } = false;
        public DateTime CreatedAt { get; set; } = DateTime.UtcNow;
        public string? ActionUrl { get; set; }
        public string? ActionLabel { get; set; }
    }
}

<style>
    .m-notification-list { max-width: 100%; }
    .m-notification-item {
        display: flex;
        gap: 16px;
        padding: 16px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
        align-items: flex-start;
        transition: background-color 0.2s;
    }
    .m-notification-item:hover { background-color: rgba(0, 0, 0, 0.02); }
    .m-notification-item.m-notification-unread {
        background-color: rgba(22, 119, 255, 0.06);
        font-weight: 500;
    }
    .m-notification-icon {
        display: flex;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .m-notification-icon.m-notification-info { background-color: rgba(22, 119, 255, 0.1); color: #1677ff; }
    .m-notification-icon.m-notification-success { background-color: rgba(52, 211, 153, 0.1); color: #34d399; }
    .m-notification-icon.m-notification-warning { background-color: rgba(251, 146, 60, 0.1); color: #fb923c; }
    .m-notification-icon.m-notification-error { background-color: rgba(239, 68, 68, 0.1); color: #ef4444; }
    .m-notification-content { flex: 1; }
    .m-notification-title { margin: 0; font-size: 14px; }
    .m-notification-message { margin: 4px 0; font-size: 13px; }
    .m-notification-time { font-size: 12px; }
    .m-notification-actions { display: flex; gap: 8px; }
</style>

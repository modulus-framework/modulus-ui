@page "/notifications"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@* Scaffold generated by `modulus ui`. This file is yours: edit the markup and the code block freely. *@
@* The notifications comes from INotificationCenter (Modulus.Ui.Abstractions.Admin). Until you register your own implementation the built-in *@
@* sample data answers and the page says so. To connect real data, implement INotificationCenter and register it after AddModulusBlazor, *@
@* or replace the calls in @code below with your own services. *@
@using Modulus.Ui.Abstractions.Admin
@using Microsoft.AspNetCore.Components.Authorization
@inject INotificationCenter Notifications
@inject AuthenticationStateProvider Auth

<PageTitle>Notifications</PageTitle>

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">Account</div><h1 class="m-page-title">Notifications</h1></div>
    <button type="button" class="ant-btn ant-btn-default" @onclick="() => MarkReadAsync(null)"><span>Mark all as read</span></button>
</div>

@if (Notifications.IsSample)
{
    <div class="ant-alert ant-alert-info ant-alert-with-description m-mb-16" role="status">
        <div class="ant-alert-content">
            <div class="ant-alert-message">Sample data</div>
            <div class="ant-alert-description">This page shows built-in sample data. Register your own INotificationCenter to connect it to your notification source.</div>
        </div>
    </div>
}

<div class="m-card">
    <div class="m-card-header">
        <h2 class="m-card-title">Notification center</h2>
        <div class="m-card-actions">
            <input type="search" class="ant-input" placeholder="Search notifications..." aria-label="Search notifications" @bind="_q" @bind:event="oninput" @bind:after="LoadAsync" />
        </div>
    </div>
    <div class="m-card-body m-card-body-flush">
        @if (_items.Count == 0)
        {
            <div class="m-empty">
                <h3 class="m-empty-title">No notifications</h3>
                <p class="m-empty-subtitle">New notifications will appear here.</p>
            </div>
        }
        else
        {
            <div class="ant-table-wrapper m-table-flush">
                <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                    <table style="table-layout:auto">
                        <thead class="ant-table-thead"><tr><th class="ant-table-cell"></th><th class="ant-table-cell">Notification</th><th class="ant-table-cell">When</th><th class="ant-table-cell"></th></tr></thead>
                        <tbody class="ant-table-tbody">
                            @foreach (var n in _items)
                            {
                                <tr class="ant-table-row">
                                    <td class="ant-table-cell" aria-label="@(n.Read ? "Read" : "Unread")">@(n.Read ? "" : "●")</td>
                                    <td class="ant-table-cell">
                                        @if (n.Read) { <span>@n.Title</span> } else { <strong>@n.Title</strong> }
                                        <div class="m-muted">@n.Message</div>
                                    </td>
                                    <td class="ant-table-cell">@n.At.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="ant-table-cell">
                                        @if (!n.Read)
                                        {
                                            <button type="button" class="ant-btn ant-btn-text ant-btn-sm" @onclick="() => MarkReadAsync(n.Id)"><span>Mark read</span></button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div></div></div>
            </div>
        }
    </div>
</div>

@code {
    private IReadOnlyList<UserNotification> _items = [];
    private string? _q;
    private string? _userName;

    protected override async Task OnInitializedAsync()
    {
        _userName = (await Auth.GetAuthenticationStateAsync()).User.Identity?.Name;
        await LoadAsync();
    }

    private async Task LoadAsync() => _items = await Notifications.ListAsync(_userName, _q);

    private async Task MarkReadAsync(string? id)
    {
        await Notifications.MarkReadAsync(_userName, id);
        await LoadAsync();
    }
}

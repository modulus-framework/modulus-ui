@* Edit page for {{ entity_name }}: loads and saves the {{ entity_name | string.downcase }} through {{ entity_name }}ApiClient *@
@page "/{{ route }}/edit"
{{ if use_auth }}@attribute [Microsoft.AspNetCore.Authorization.Authorize]
{{ end }}
@using {{ module_namespace }}.Application.Dtos
@using {{ ui_namespace }}.Services.ApiClients
@inject {{ entity_name }}ApiClient Api
@inject NavigationManager Navigation

<PageTitle>Edit {{ entity_name | string.downcase }}</PageTitle>

<div class="m-page-header">
    <div class="m-page-header-text"><div class="m-pretitle">{{ entity_name_plural }}</div><h1 class="m-page-title">Edit {{ entity_name | string.downcase }}</h1></div>
</div>

<div class="m-grid m-cols-main">
    <div class="m-card">
        <div class="m-card-body">
            @if (_input is null)
            {
                <p class="m-muted">Loading...</p>
            }
            else
            {
                @if (_error is not null)
                {
                    <div class="ant-alert m-mb-16 ant-alert-error" role="alert"><div class="ant-alert-content"><div class="ant-alert-message">@_error</div></div></div>
                }
                <{{ entity_name }}Editor Input="_input" IsNew="false" Busy="_busy" OnSave="SaveAsync" />
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public Guid? Id { get; set; }

    private {{ entity_name }}Editor.FormInput? _input;
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        if (Id is null || Id == Guid.Empty)
        {
            Navigation.NavigateTo("/{{ route }}/new", replace: true);
            return;
        }

        var existing = await Api.GetByIdAsync(Id.Value);
        if (existing is null)
        {
            Navigation.NavigateTo("/{{ route }}");
            return;
        }

        _input = new {{ entity_name }}Editor.FormInput { Name = existing.Name };
    }

    private async Task SaveAsync({{ entity_name }}Editor.FormInput input)
    {
        _busy = true;
        _error = null;
        try
        {
            var updated = await Api.UpdateAsync(Id!.Value, new Update{{ entity_name }}Dto { Name = input.Name });
            if (updated) Navigation.NavigateTo("/{{ route }}");
            else _error = "The API refused the change.";
        }
        catch (HttpRequestException)
        {
            _error = "The API could not be reached.";
        }
        finally { _busy = false; }
    }
}

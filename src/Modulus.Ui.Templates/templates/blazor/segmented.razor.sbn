@* Segmented control: Label, Options (value and label) and Value *@

<div class="ant-form-item m-field">
    @if (!string.IsNullOrEmpty(Label))
    {
        <div class="ant-form-item-label">
            <label class="@(Required ? "ant-form-item-required" : "")">@Label</label>
        </div>
    }
    <div class="ant-form-item-control">
        <AntDesign.Segmented TValue="string" Options="@Options.Select(o => o.Value).ToArray()" Value="@Value" ValueChanged="SetValue" />
        @if (!string.IsNullOrEmpty(Help))
        {
            <div class="m-muted m-mt-4">@Help</div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Help { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public IEnumerable<Option> Options { get; set; } = [];
    public sealed record Option(string Value, string Label);
    private async Task SetValue(string v)
    {
        Value = v;
        await ValueChanged.InvokeAsync(v);
    }
}

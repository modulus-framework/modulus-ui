@* Alert: Type (success, info, warning, danger), Title, Message and Dismissible *@

@if (!_closed)
{
    <div class="ant-alert ant-alert-@AlertKind ant-alert-with-description" role="alert">
        <div class="ant-alert-content">
            @if (!string.IsNullOrEmpty(Title))
            {
                <div class="ant-alert-message">@Title</div>
            }
            @if (!string.IsNullOrEmpty(Message))
            {
                <div class="@(string.IsNullOrEmpty(Title) ? "ant-alert-message" : "ant-alert-description")">@Message</div>
            }
            @ChildContent
        </div>
        @if (Dismissible)
        {
            <button type="button" class="ant-alert-close-icon" aria-label="Close" @onclick="CloseAsync">&times;</button>
        }
    </div>
}

@code {
    [Parameter] public string? Type { get; set; } = "info";
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public bool Dismissible { get; set; } = false;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }

    private bool _closed;

    private string AlertKind => Type?.ToLowerInvariant() switch
    {
        "success" => "success",
        "warning" => "warning",
        "danger" or "error" => "error",
        _ => "info"
    };

    private async Task CloseAsync()
    {
        _closed = true;
        await OnDismiss.InvokeAsync();
    }
}

@* Tabs component for Blazor *}

<ul class="nav nav-tabs" role="tablist">
    @foreach (var (tab, index) in Tabs.Select((t, i) => (t, i)))
    {
        <li class="nav-item" role="presentation">
            <button
                class="nav-link @(ActiveTab == index ? "active" : "")"
                @onclick="@((EventArgs) => SelectTab(index))"
                type="button"
                role="tab">
                @tab.Label
            </button>
        </li>
    }
</ul>
<div class="tab-content">
    @foreach (var (tab, index) in Tabs.Select((t, i) => (t, i)))
    {
        <div
            class="tab-pane @(ActiveTab == index ? "show active" : "")"
            role="tabpanel">
            @tab.Content
        </div>
    }
</div>

@code {
    [Parameter]
    public List<TabItem>? Tabs { get; set; }

    [Parameter]
    public int ActiveTab { get; set; } = 0;

    [Parameter]
    public EventCallback<int> OnTabChanged { get; set; }

    public class TabItem
    {
        public string Label { get; set; } = "";
        public RenderFragment? Content { get; set; }
    }

    private async Task SelectTab(int index)
    {
        if (ActiveTab != index)
        {
            ActiveTab = index;
            await OnTabChanged.InvokeAsync(index);
        }
    }
}

@* Tabs: Items (label and content), ActiveTab and OnTabChanged *@

<div class="ant-tabs ant-tabs-top">
    <div class="ant-tabs-nav" role="tablist">
        <div class="ant-tabs-nav-wrap">
            <div class="ant-tabs-nav-list">
                @foreach (var (tab, index) in (Items ?? []).Select((t, i) => (t, i)))
                {
                    var current = index;
                    <div class="ant-tabs-tab @(ActiveTab == index ? "ant-tabs-tab-active" : "")">
                        <div role="tab" aria-selected="@(ActiveTab == index ? "true" : "false")" tabindex="@(ActiveTab == index ? 0 : -1)" class="ant-tabs-tab-btn"
                             @onclick="@(() => SelectTab(current))">@tab.Label</div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="ant-tabs-content-holder">
        <div class="ant-tabs-content ant-tabs-content-top">
            @foreach (var (tab, index) in (Items ?? []).Select((t, i) => (t, i)))
            {
                @if (ActiveTab == index)
                {
                    <div role="tabpanel" class="ant-tabs-tabpane ant-tabs-tabpane-active">@tab.Content</div>
                }
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public List<TabItem>? Items { get; set; }

    [Parameter]
    public int ActiveTab { get; set; } = 0;

    [Parameter]
    public EventCallback<int> OnTabChanged { get; set; }

    public class TabItem
    {
        public string Label { get; set; } = "";
        public RenderFragment? Content { get; set; }
    }

    private async Task SelectTab(int index)
    {
        if (ActiveTab != index)
        {
            ActiveTab = index;
            await OnTabChanged.InvokeAsync(index);
        }
    }
}

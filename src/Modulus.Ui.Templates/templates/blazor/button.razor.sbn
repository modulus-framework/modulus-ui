@* Button: Variant (primary, default, dashed, text, link, danger), Size (sm, lg), Href, Type (button, submit) *@

@if (IsLink)
{
    <a href="@Href" class="@GetButtonClass()"><span>@ChildContent</span></a>
}
else
{
    <button type="@Type" class="@GetButtonClass()" disabled="@IsDisabled" @onclick="OnClick"><span>@ChildContent</span></button>
}

@code {
    [Parameter]
    public string Variant { get; set; } = "primary";

    [Parameter]
    public string Size { get; set; } = "md";

    [Parameter]
    public string Type { get; set; } = "button";

    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public bool IsDisabled { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool IsLink => !string.IsNullOrEmpty(Href);

    private string GetButtonClass()
    {
        var classes = "ant-btn";

        classes += Variant switch
        {
            "primary" => " ant-btn-primary",
            "danger" => " ant-btn-default ant-btn-dangerous",
            "dashed" => " ant-btn-dashed",
            "text" or "ghost" => " ant-btn-text",
            "link" => " ant-btn-link",
            _ => " ant-btn-default"
        };

        classes += Size switch
        {
            "sm" => " ant-btn-sm",
            "lg" => " ant-btn-lg",
            _ => ""
        };

        return classes;
    }
}

@* Slider: Label, Value, Min, Max and Step *@

<div class="ant-form-item m-field">
    @if (!string.IsNullOrEmpty(Label))
    {
        <div class="ant-form-item-label">
            <label class="@(Required ? "ant-form-item-required" : "")">@Label</label>
        </div>
    }
    <div class="ant-form-item-control">
        <AntDesign.Slider TValue="double" Value="@Value" ValueChanged="SetValue" Min="Min" Max="Max" Step="Step" Disabled="Disabled" />
        @if (!string.IsNullOrEmpty(Help))
        {
            <div class="m-muted m-mt-4">@Help</div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Help { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public double Value { get; set; }
    [Parameter] public EventCallback<double> ValueChanged { get; set; }
    [Parameter] public double Min { get; set; } = 0;
    [Parameter] public double Max { get; set; } = 100;
    [Parameter] public double Step { get; set; } = 1;
    private async Task SetValue(double v)
    {
        Value = v;
        await ValueChanged.InvokeAsync(v);
    }
}

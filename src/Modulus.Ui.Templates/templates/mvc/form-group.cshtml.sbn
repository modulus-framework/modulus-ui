@* Form group wrapper for consistent styling *}
@{
    var size = ViewBag.Size ?? "md";
    var gridClass = size switch
    {
        "lg" => "col-lg-8",
        "md" => "col-md-6",
        "sm" => "col-md-4",
        _ => "col-md-6"
    };
}

<div class="@gridClass">
    <div class="mb-3">
        @if (!string.IsNullOrEmpty(ViewBag.Label))
        {
            <label class="form-label">
                @ViewBag.Label
                @if (ViewBag.Required == true)
                {
                    <span class="text-danger">*</span>
                }
            </label>
        }

        @RenderBody()

        @if (!string.IsNullOrEmpty(ViewBag.Help))
        {
            <small class="form-hint d-block mt-2">@ViewBag.Help</small>
        }

        @if (!string.IsNullOrEmpty(ViewBag.Error))
        {
            <div class="text-danger small mt-2">@ViewBag.Error</div>
        }
    </div>
</div>

@addTagHelper *, Modulus.AspNetCore.Mvc
@using {{ module_namespace }}.Application.Dtos
@model {{ entity_name }}Dto
@{
    ViewData["Title"] = Model?.Id == Guid.Empty ? "Create {{ entity_name }}" : "Edit {{ entity_name }}";
}

<app-page-header pretitle="{{ entity_name_plural }}" title="@ViewData["Title"]"></app-page-header>

<div class="m-grid m-cols-main">
    <div class="m-card">
        <div class="m-card-body">
            <form method="post" asp-antiforgery="true" class="ant-form ant-form-vertical" novalidate>
                <input type="hidden" asp-for="Id" />
{{ for f in fields ~}}
{{ if f.kind == "checkbox" ~}}
                <app-form-item asp-for="{{ f.name }}">
                    <app-checkbox asp-for="{{ f.name }}">{{ f.label }}</app-checkbox>
                </app-form-item>
{{ else if f.kind == "textarea" ~}}
                <app-form-item asp-for="{{ f.name }}" label="{{ f.label }}">
                    <app-textarea asp-for="{{ f.name }}" rows="4" />
                </app-form-item>
{{ else ~}}
                <app-form-item asp-for="{{ f.name }}" label="{{ f.label }}">
                    <app-input asp-for="{{ f.name }}" type="{{ f.input_type }}" />
                </app-form-item>
{{ end ~}}
{{ end ~}}
                <div class="m-form-actions">
                    <app-button type="primary" html-type="submit">@(Model?.Id == Guid.Empty ? "Create" : "Update")</app-button>
                    <app-button href="/{{ entity_name_plural | string.downcase }}">Cancel</app-button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Stat card: one headline number with a label and an optional change. ViewBag.Label, Value, Change ("+12%" / "-3%") *@
@{
    string label = ViewBag.Label ?? "";
    string value = ViewBag.Value?.ToString() ?? "0";
    string? change = ViewBag.Change;
    var negative = change?.StartsWith('-') == true;
}

<div class="m-card m-stat-card">
    <div class="m-card-body">
        <div class="m-stat-card-head"><span>@label</span></div>
        <div class="m-stat-card-value">@value</div>
        @if (!string.IsNullOrEmpty(change))
        {
            <div class="m-stat-sub"><span class="m-text-@(negative ? "danger" : "success")">@change</span></div>
        }
    </div>
</div>

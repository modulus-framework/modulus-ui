@* Progress bar: ViewBag.Percentage (0-100), Color (success, exception, active) and ShowLabel *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@{
    double percentage = ViewBag.Percentage ?? 0;
    string? status = ViewBag.Color switch { "danger" => "exception", "success" => "success", _ => null };
    bool showLabel = ViewBag.ShowLabel == true;
}

<app-progress percent="percentage" status="@status" show-info="showLabel" />

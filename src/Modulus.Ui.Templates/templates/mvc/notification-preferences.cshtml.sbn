@model NotificationSettings
@* Scaffold generated by `modulus ui`. This file is yours: edit the markup and the handlers freely. *@
@* The notification preferences comes from INotificationCenter (Modulus.Ui.Abstractions.Admin). Until you register your own implementation the built-in *@
@* sample data answers and the page says so. To connect real data, implement INotificationCenter and register it after AddModulusMvc, *@
@* or change the controller action that feeds this view. *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Modulus.Ui.Abstractions.Admin
@inject INotificationCenter Notifications

@{
    ViewData["Title"] = "Notification preferences";
}

<app-page-header pretitle="Account" title="Notification preferences"></app-page-header>

@if (Notifications.IsSample)
{
    <app-alert type="info" message="Sample data" description="This page shows built-in sample data. Register your own INotificationCenter to connect it to your preference store." show-icon="true" />
}
@if (TempData["Message"] is string flash)
{
    <app-alert type="success" message="@flash" show-icon="true" closable="true" />
}
@if (TempData["Error"] is string problem)
{
    <app-alert type="error" message="@problem" show-icon="true" closable="true" />
}

<form method="post" asp-antiforgery="true" class="ant-form ant-form-vertical" novalidate>
    <div class="m-card">
        <div class="m-card-header"><h2 class="m-card-title">Email notifications</h2></div>
        <div class="m-card-body">
            <div class="m-checkbox-group">
                        <label class="ant-checkbox-wrapper">
                            <input type="checkbox" class="ant-checkbox-input" name="Prefs.EmailActivitySummary" value="true" checked="@Model.EmailActivitySummary" />
                            <input type="hidden" name="Prefs.EmailActivitySummary" value="false" />
                            <span>Weekly activity summary</span>
                        </label>
                        <label class="ant-checkbox-wrapper">
                            <input type="checkbox" class="ant-checkbox-input" name="Prefs.EmailSecurityAlerts" value="true" checked="@Model.EmailSecurityAlerts" />
                            <input type="hidden" name="Prefs.EmailSecurityAlerts" value="false" />
                            <span>Security alerts and login attempts</span>
                        </label>
                        <label class="ant-checkbox-wrapper">
                            <input type="checkbox" class="ant-checkbox-input" name="Prefs.EmailProductUpdates" value="true" checked="@Model.EmailProductUpdates" />
                            <input type="hidden" name="Prefs.EmailProductUpdates" value="false" />
                            <span>Product updates and announcements</span>
                        </label>
                        <label class="ant-checkbox-wrapper">
                            <input type="checkbox" class="ant-checkbox-input" name="Prefs.EmailMarketing" value="true" checked="@Model.EmailMarketing" />
                            <input type="hidden" name="Prefs.EmailMarketing" value="false" />
                            <span>Marketing emails and promotions</span>
                        </label>
            </div>
        </div>
    </div>

    <div class="m-card m-mt-24">
        <div class="m-card-header"><h2 class="m-card-title">In-app notifications</h2></div>
        <div class="m-card-body">
            <div class="m-checkbox-group">
                        <label class="ant-checkbox-wrapper">
                            <input type="checkbox" class="ant-checkbox-input" name="Prefs.NotifySystemUpdates" value="true" checked="@Model.NotifySystemUpdates" />
                            <input type="hidden" name="Prefs.NotifySystemUpdates" value="false" />
                            <span>System updates and maintenance</span>
                        </label>
                        <label class="ant-checkbox-wrapper">
                            <input type="checkbox" class="ant-checkbox-input" name="Prefs.NotifyReports" value="true" checked="@Model.NotifyReports" />
                            <input type="hidden" name="Prefs.NotifyReports" value="false" />
                            <span>Report generation and completion</span>
                        </label>
                        <label class="ant-checkbox-wrapper">
                            <input type="checkbox" class="ant-checkbox-input" name="Prefs.NotifyCollaboration" value="true" checked="@Model.NotifyCollaboration" />
                            <input type="hidden" name="Prefs.NotifyCollaboration" value="false" />
                            <span>Collaboration and mentions</span>
                        </label>
                        <label class="ant-checkbox-wrapper">
                            <input type="checkbox" class="ant-checkbox-input" name="Prefs.NotifyScheduled" value="true" checked="@Model.NotifyScheduled" />
                            <input type="hidden" name="Prefs.NotifyScheduled" value="false" />
                            <span>Scheduled task reminders</span>
                        </label>
            </div>
        </div>
    </div>

    <div class="m-card m-mt-24">
        <div class="m-card-header"><h2 class="m-card-title">Notification delivery</h2></div>
        <div class="m-card-body">
            <div class="m-form-grid">
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="digest-frequency">Digest frequency</label></div>
                    <div class="ant-form-item-control">
                        <select id="digest-frequency" name="Prefs.DigestFrequency" class="ant-input">
                            @foreach (var option in NotificationSettings.DigestFrequencies)
                            {
                                <option value="@option" selected="@(option == Model.DigestFrequency)">@option</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="quiet-hours">Quiet hours start</label></div>
                    <div class="ant-form-item-control"><input id="quiet-hours" name="Prefs.QuietHours" value="@Model.QuietHours" class="ant-input" type="time" /></div>
                </div>
            </div>
        </div>
    </div>

    <div class="m-form-actions m-mt-24">
        <app-button type="primary" html-type="submit">Save preferences</app-button>
    </div>
</form>

<style>
    .m-checkbox-group { display: flex; flex-direction: column; gap: 12px; }
    .ant-checkbox-wrapper { display: flex; align-items: center; margin: 0; }
    .m-mt-24 { margin-top: 24px; }
</style>

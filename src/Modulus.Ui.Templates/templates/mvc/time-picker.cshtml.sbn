@* Time picker: ViewBag.Name, Label, Format (HH:mm:ss or HH:mm), Help *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@{
    string name = ViewBag.Name ?? "";
    string label = ViewBag.Label ?? name;
    string? help = ViewBag.Help;
    string format = ViewBag.Format ?? "HH:mm";
}

<app-form-item label="@label" help="@help">
    <app-time-picker name="@name" format="@format" aria-label="@label" />
</app-form-item>

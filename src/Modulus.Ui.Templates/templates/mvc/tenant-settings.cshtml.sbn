@* Tenant settings - configure tenant-level settings *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@{
    ViewData["Title"] = "Tenant settings";
}

<app-page-header pretitle="Administration" title="Tenant settings">
    <app-button type="default" href="#">Back to tenants</app-button>
</app-page-header>

<div class="m-tabs">
    <div class="ant-tabs" role="tablist">
        <div class="ant-tabs-nav" role="tablist">
            <div class="ant-tabs-nav-wrap">
                <button class="ant-tabs-tab ant-tabs-tab-active" role="tab">General</button>
                <button class="ant-tabs-tab" role="tab">Billing</button>
                <button class="ant-tabs-tab" role="tab">Features</button>
                <button class="ant-tabs-tab" role="tab">Security</button>
            </div>
        </div>
    </div>
</div>

<div class="m-card m-mt-24">
    <div class="m-card-header"><h2 class="m-card-title">General settings</h2></div>
    <div class="m-card-body">
        <form method="post" asp-antiforgery="true" class="ant-form ant-form-vertical" novalidate>
            <div class="m-form-grid">
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="tenant-name">Tenant name</label></div>
                    <div class="ant-form-item-control"><input id="tenant-name" name="TenantName" class="ant-input" value="Acme Corporation" /></div>
                </div>
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="tenant-domain">Domain</label></div>
                    <div class="ant-form-item-control"><input id="tenant-domain" name="TenantDomain" class="ant-input" value="acme-corp" disabled /></div>
                </div>
            </div>
            <div class="ant-form-item">
                <div class="ant-form-item-label"><label for="tenant-description">Description</label></div>
                <div class="ant-form-item-control"><textarea id="tenant-description" name="TenantDescription" class="ant-input" rows="4">Enterprise resource planning solution</textarea></div>
            </div>
            <div class="m-form-actions">
                <app-button type="primary" html-type="submit">Save changes</app-button>
            </div>
        </form>
    </div>
</div>

<div class="m-card m-mt-24">
    <div class="m-card-header"><h2 class="m-card-title">Tenant logo and branding</h2></div>
    <div class="m-card-body">
        <div class="m-upload-area">
            <p>Upload your tenant logo (PNG, JPG, SVG, max 2MB)</p>
            <input type="file" accept="image/*" />
        </div>
    </div>
</div>

<style>
    .m-tabs { margin-bottom: 24px; }
    .ant-tabs-nav { border-bottom: 1px solid rgba(0, 0, 0, 0.06); }
    .ant-tabs-tab { padding: 12px 16px; border: none; cursor: pointer; background: none; }
    .ant-tabs-tab-active { color: #1677ff; border-bottom: 2px solid #1677ff; }
    .m-mt-24 { margin-top: 24px; }
    .m-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .m-upload-area { border: 2px dashed rgba(0, 0, 0, 0.15); border-radius: 4px; padding: 24px; text-align: center; }
</style>

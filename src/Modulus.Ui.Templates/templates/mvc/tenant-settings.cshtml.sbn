@model TenantDetails
@* Scaffold generated by `modulus ui`. This file is yours: edit the markup and the handlers freely. *@
@* The tenant's settings comes from ITenantDirectory (Modulus.Ui.Abstractions.Admin). Until you register your own implementation the built-in *@
@* sample data answers and the page says so. To connect real data, implement ITenantDirectory and register it after AddModulusMvc, *@
@* or change the controller action that feeds this view. *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Modulus.Ui.Abstractions.Admin
@inject ITenantDirectory Tenants

@{
    ViewData["Title"] = "Tenant settings";
}

<app-page-header pretitle="Administration" title="Tenant settings">
    <app-button type="default" href="/admin/tenants">Back to tenants</app-button>
</app-page-header>

@if (Tenants.IsSample)
{
    <app-alert type="info" message="Sample data" description="This page shows built-in sample data. Register your own ITenantDirectory to connect it to your tenant store." show-icon="true" />
}
@if (TempData["Message"] is string flash)
{
    <app-alert type="success" message="@flash" show-icon="true" closable="true" />
}
@if (TempData["Error"] is string problem)
{
    <app-alert type="error" message="@problem" show-icon="true" closable="true" />
}

<div class="m-card">
    <div class="m-card-header"><h2 class="m-card-title">General settings</h2></div>
    <div class="m-card-body">
        <form method="post" asp-antiforgery="true" class="ant-form ant-form-vertical" novalidate>
            <div class="m-form-grid">
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="tenant-name">Tenant name</label></div>
                    <div class="ant-form-item-control"><input id="tenant-name" placeholder="Company name" name="Details.Name" value="@Model.Name" class="ant-input" required /></div>
                </div>
                <div class="ant-form-item">
                    <div class="ant-form-item-label"><label for="tenant-domain">Domain</label></div>
                    <div class="ant-form-item-control"><input id="tenant-domain" value="@Model.Domain" class="ant-input" disabled /></div>
                </div>
                <div class="ant-form-item m-span-2">
                    <div class="ant-form-item-label"><label for="tenant-description">Description</label></div>
                    <div class="ant-form-item-control"><textarea id="tenant-description" placeholder="Describe the company" name="Details.Description" class="ant-input" rows="4">@Model.Description</textarea></div>
                </div>
            </div>
            <div class="m-form-actions">
                <app-button type="primary" html-type="submit">Save changes</app-button>
            </div>
        </form>
    </div>
</div>
@* Add more sections (billing, features, branding) as cards here. *@

@* Button: ViewBag.Label, Variant (primary, default, dashed, text, link), Size (sm, lg), Href, Type (button, submit) and Danger *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@{
    string variant = (string?)ViewBag.Variant ?? "primary";
    string size = ((string?)ViewBag.Size) switch { "sm" => "small", "lg" => "large", _ => "middle" };
    string? href = ViewBag.Href;
    string htmlType = (string?)ViewBag.Type ?? "button";
    bool danger = ViewBag.Danger == true;
}

<app-button type="@variant" size="@size" href="@href" html-type="@htmlType" danger="danger">@ViewBag.Label</app-button>

@* Dropdown: ViewBag.Label and Items, a list of (label, url, icon) or (divider = true) *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@{
    var items = ViewBag.Items as System.Collections.Generic.List<dynamic> ?? new System.Collections.Generic.List<dynamic>();
}

<app-dropdown>
    <app-button type="primary">@((string?)ViewBag.Label ?? "Actions")</app-button>
    <dropdown-menu>
        @foreach (var item in items)
        {
            if (item.divider == true)
            {
                <app-dropdown-divider />
            }
            else
            {
                <app-dropdown-item href="@item.url">@item.label</app-dropdown-item>
            }
        }
    </dropdown-menu>
</app-dropdown>

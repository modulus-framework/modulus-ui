@* Dropdown menu component *@
<div class="dropdown">
    <button
        class="btn @(ViewBag.Variant ?? "btn-primary") dropdown-toggle"
        type="button"
        data-bs-toggle="dropdown">
        @(ViewBag.Label ?? "Actions")
    </button>
    <ul class="dropdown-menu">
        @{
            var items = ViewBag.Items as System.Collections.Generic.List<dynamic> ?? new System.Collections.Generic.List<dynamic>();
        }
        @foreach (var item in items)
        {
            @if (item.divider == true)
            {
                <li><hr class="dropdown-divider"></li>
            }
            else
            {
                <li>
                    <a class="dropdown-item" href="@item.url">
                        @if (!string.IsNullOrEmpty(item.icon))
                        {
                            <span class="@item.icon me-2"></span>
                        }
                        @item.label
                    </a>
                </li>
            }
        }
    </ul>
</div>

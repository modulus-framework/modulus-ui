@* System Health Monitoring page for MVC *@
@{
    ViewData["Title"] = "System Health";
}

<div class="page-wrapper">
    <div class="container-xl">
        <div class="page-header d-mb-4">
            <div class="row align-items-center">
                <div class="col">
                    <h2 class="page-title">System Health</h2>
                </div>
                <div class="col-auto">
                    <span class="badge badge-success">All Systems Operational</span>
                </div>
            </div>
        </div>
    </div>
    <div class="page-body">
        <div class="container-xl">
            <!-- Overall Status -->
            <div class="row row-deck row-cards mb-4">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-auto">
                                    <div class="text-secondary">System Status</div>
                                    <div class="display-6">99.9%</div>
                                </div>
                                <div class="col-auto ms-auto">
                                    <div class="progress" style="width: 200px; height: 10px;">
                                        <div class="progress-bar bg-success" style="width: 99.9%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Components Health -->
            <div class="row row-deck row-cards">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Services</h3>
                        </div>
                        <table class="table table-vcenter card-table">
                            <thead>
                                <tr>
                                    <th>Service</th>
                                    <th>Status</th>
                                    <th>Response Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>API Gateway</strong></td>
                                    <td><span class="badge badge-success">UP</span></td>
                                    <td>45ms</td>
                                </tr>
                                <tr>
                                    <td><strong>Database</strong></td>
                                    <td><span class="badge badge-success">UP</span></td>
                                    <td>120ms</td>
                                </tr>
                                <tr>
                                    <td><strong>Cache Service</strong></td>
                                    <td><span class="badge badge-success">UP</span></td>
                                    <td>5ms</td>
                                </tr>
                                <tr>
                                    <td><strong>Email Service</strong></td>
                                    <td><span class="badge badge-success">UP</span></td>
                                    <td>200ms</td>
                                </tr>
                                <tr>
                                    <td><strong>File Storage</strong></td>
                                    <td><span class="badge badge-success">UP</span></td>
                                    <td>150ms</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Resource Usage</h3>
                        </div>
                        <div class="card-body space-y">
                            <div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>CPU Usage</span>
                                    <span>35%</span>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar" style="width: 35%"></div>
                                </div>
                            </div>
                            <div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Memory Usage</span>
                                    <span>62%</span>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-info" style="width: 62%"></div>
                                </div>
                            </div>
                            <div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Disk Usage</span>
                                    <span>48%</span>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-warning" style="width: 48%"></div>
                                </div>
                            </div>
                            <div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Database Size</span>
                                    <span>2.4 GB</span>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-success" style="width: 24%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Card: ViewBag.Title, ViewBag.CssClass, ViewBag.HeaderAction and ViewBag.Footer, and the body is the partial's content. *@
@* HeaderAction and Footer are encoded as text when they are strings; pass an IHtmlContent (for example a rendered partial) to insert markup. *@
@{
    string? title = ViewBag.Title;
}

<div class="m-card @ViewBag.CssClass">
    @if (!string.IsNullOrEmpty(title))
    {
        <div class="m-card-header">
            <h3 class="m-card-title">@title</h3>
            @if (ViewBag.HeaderAction is not null)
            {
                <div class="m-card-actions">@ViewBag.HeaderAction</div>
            }
        </div>
    }
    <div class="m-card-body">
        @RenderBody()
    </div>
    @if (ViewBag.Footer is not null)
    {
        <div class="m-card-footer">@ViewBag.Footer</div>
    }
</div>

@* Card: ViewBag.Title, HeaderAction (markup), Footer (markup); the body is the partial's content *@
@{
    string? title = ViewBag.Title;
}

<div class="m-card @ViewBag.CssClass">
    @if (!string.IsNullOrEmpty(title))
    {
        <div class="m-card-header">
            <h3 class="m-card-title">@title</h3>
            @if (!string.IsNullOrEmpty((string?)ViewBag.HeaderAction))
            {
                <div class="m-card-actions">@Html.Raw(ViewBag.HeaderAction)</div>
            }
        </div>
    }
    <div class="m-card-body">
        @RenderBody()
    </div>
    @if (!string.IsNullOrEmpty((string?)ViewBag.Footer))
    {
        <div class="m-card-footer">@Html.Raw(ViewBag.Footer)</div>
    }
</div>

@model UsersPage
@* Scaffold generated by `modulus ui`. This file is yours: edit the markup and the handlers freely. *@
@* The user list comes from IUserDirectory (Modulus.Ui.Abstractions.Admin). Until you register your own implementation the built-in *@
@* sample data answers and the page says so. To connect real data, implement IUserDirectory and register it after AddModulusMvc, *@
@* or change the controller action that feeds this view. *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Modulus.Ui.Abstractions.Admin
@inject IUserDirectory Users

@{
    ViewData["Title"] = "User management";
}

<app-page-header pretitle="Administration" title="User management"></app-page-header>

@if (Users.IsSample)
{
    <app-alert type="info" message="Sample data" description="This page shows built-in sample data. Register your own IUserDirectory to connect it to your user store." show-icon="true" />
}
@if (TempData["Message"] is string flash)
{
    <app-alert type="success" message="@flash" show-icon="true" closable="true" />
}
@if (TempData["Error"] is string problem)
{
    <app-alert type="error" message="@problem" show-icon="true" closable="true" />
}

<div class="m-card">
    <div class="m-card-header"><h2 class="m-card-title">Invite a user</h2></div>
    <div class="m-card-body">
        <form method="post" asp-antiforgery="true" action="/admin/users/invite" class="m-flex m-flex-wrap">
            <input class="ant-input" type="email" name="email" placeholder="name@example.com" aria-label="Email address" required />
            <select class="ant-input" name="role" aria-label="Role">
                @foreach (var role in Model.Roles)
                {
                    <option value="@role.Name">@role.Name</option>
                }
            </select>
            <app-button type="primary" html-type="submit">Invite</app-button>
        </form>
    </div>
</div>

<div class="m-card m-mt-24">
    <div class="m-card-header">
        <h2 class="m-card-title">Users</h2>
        <form method="get" class="m-card-actions">
            <input class="ant-input" type="search" name="q" value="@Context.Request.Query["q"].ToString()" placeholder="Search users..." aria-label="Search users" />
        </form>
    </div>
    <div class="m-card-body m-card-body-flush">
        @if (Model.Users.Count == 0)
        {
            <div class="m-empty">
                <h3 class="m-empty-title">No users found</h3>
            </div>
        }
        else
        {
            <div class="ant-table-wrapper m-table-flush">
                <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                    <table style="table-layout:auto">
                        <thead class="ant-table-thead"><tr><th class="ant-table-cell">Name</th><th class="ant-table-cell">Email</th><th class="ant-table-cell">Role</th><th class="ant-table-cell">Status</th><th class="ant-table-cell">Last active</th><th class="ant-table-cell"></th></tr></thead>
                        <tbody class="ant-table-tbody">
                            @foreach (var u in Model.Users)
                            {
                                <tr class="ant-table-row">
                                    <td class="ant-table-cell"><strong>@u.Name</strong></td>
                                    <td class="ant-table-cell">@u.Email</td>
                                    <td class="ant-table-cell">@u.Role</td>
                                    <td class="ant-table-cell">@u.Status</td>
                                    <td class="ant-table-cell">@(u.LastActive?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                    <td class="ant-table-cell">
                                        <form method="post" action="/admin/users/remove" asp-antiforgery="true" data-confirm="Remove @u.Name?">
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <button type="submit" class="ant-btn ant-btn-text ant-btn-sm ant-btn-dangerous"><span>Remove</span></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div></div></div>
            </div>
        }
    </div>
</div>

<style>
    .m-mt-24 { margin-top: 24px; }
</style>

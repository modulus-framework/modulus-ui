@* Pagination: ViewBag.CurrentPage, TotalPages, PageSize (default 10) and BaseUrl; links are BaseUrl?page=N *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@{
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    string baseUrl = ViewBag.BaseUrl ?? "";
}

<app-pagination total="totalPages * pageSize" current="currentPage" page-size="pageSize" url="@baseUrl" />

@* Alert: ViewBag.Type (success, info, warning, error), Title, Message, Dismissible *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@{
    string type = ((string?)ViewBag.Type ?? "info").ToLowerInvariant();
    if (type == "danger") { type = "error"; }
    string? title = ViewBag.Title;
    string? message = ViewBag.Message;
    bool dismissible = ViewBag.Dismissible == true;
}

<app-alert type="@type" message="@(title ?? message)" description="@(title is null ? null : message)" closable="dismissible" show-icon="true" />

@* Saved views: ViewBag.Page (the page key the views belong to), Id. Needs AddModulusMvc() in Program.cs, which registers SavedViews. *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@{
    string? pageKey = ViewBag.Page;
    string id = ViewBag.Id ?? "views";
}

<app-saved-views page="@pageKey" id="@id" />

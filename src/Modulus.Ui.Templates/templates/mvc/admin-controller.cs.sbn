using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Modulus.Ui.Abstractions.Admin;

namespace {{ namespace }};

/// <summary>
/// Scaffold generated by `modulus ui`. This file is yours: edit the actions freely.
/// Serves the admin pages in Views/{{ if module_name }}{{ module_name }}{{ else }}Admin{{ end }} (users, roles, tenants, notifications, audit, settings, dashboards). Each action
/// reads or writes through a service from Modulus.Ui.Abstractions.Admin; until you register your own implementation the
/// built-in sample data answers and the view says so. Antiforgery is validated on every POST by AddModulusMvc.
/// </summary>
[Authorize]
public sealed class AdminController(
    IUserDirectory users,
    IRoleDirectory roles,
    ITenantDirectory tenants,
    INotificationCenter notifications,
    IAuditTrail audit,
    IAdminSettingsStore settings,
    IMetricsSource metrics) : Controller
{
    private const string Folder = "~/Views/{{ if module_name }}{{ module_name }}{{ else }}Admin{{ end }}/";

    private string? UserName => User.Identity?.Name;

    private IActionResult Done(string url, string message)
    {
        TempData["Message"] = message;
        return LocalRedirect(url);
    }

    private IActionResult Fail(string url, string message)
    {
        TempData["Error"] = message;
        return LocalRedirect(url);
    }

    // Users

    [HttpGet("/admin/users")]
    public async Task<IActionResult> Users(string? q) =>
        View(Folder + "Users.cshtml", new UsersPage(await users.SearchAsync(q), await roles.SearchAsync(null)));

    [HttpPost("/admin/users/invite")]
    public async Task<IActionResult> InviteUser(string? email, string? role)
    {
        if (string.IsNullOrWhiteSpace(email)) return Fail("/admin/users", "Enter an email address.");
        await users.InviteAsync(email.Trim(), string.IsNullOrWhiteSpace(role) ? "User" : role);
        return Done("/admin/users", $"Invitation sent to {email.Trim()}.");
    }

    [HttpPost("/admin/users/remove")]
    public async Task<IActionResult> RemoveUser(string id)
    {
        await users.RemoveAsync(id);
        return Done("/admin/users", "User removed.");
    }

    [HttpGet("/account/profile")]
    public async Task<IActionResult> Profile() =>
        View(Folder + "Profile.cshtml", await users.GetProfileAsync(UserName));

    [HttpPost("/account/profile")]
    public async Task<IActionResult> Profile([Bind(Prefix = "Profile")] ProfileInfo profile)
    {
        if (string.IsNullOrWhiteSpace(profile.FirstName) || string.IsNullOrWhiteSpace(profile.Email))
            return Fail("/account/profile", "First name and email are required.");
        await users.SaveProfileAsync(UserName, profile);
        return Done("/account/profile", "Profile saved.");
    }

    // Roles

    [HttpGet("/admin/roles")]
    public async Task<IActionResult> Roles(string? q) =>
        View(Folder + "Roles.cshtml", await roles.SearchAsync(q));

    [HttpPost("/admin/roles/create")]
    public async Task<IActionResult> CreateRole(string? name, string? description)
    {
        if (string.IsNullOrWhiteSpace(name)) return Fail("/admin/roles", "Enter a role name.");
        await roles.CreateAsync(name.Trim(), description?.Trim() ?? "");
        return Done("/admin/roles", $"Role {name.Trim()} created.");
    }

    [HttpPost("/admin/roles/delete")]
    public async Task<IActionResult> DeleteRole(string name)
    {
        await roles.DeleteAsync(name);
        return Done("/admin/roles", $"Role {name} deleted.");
    }

    // Tenants

    [HttpGet("/admin/tenants")]
    public async Task<IActionResult> Tenants(string? q) =>
        View(Folder + "Tenants.cshtml", await tenants.SearchAsync(q));

    [HttpPost("/admin/tenants/create")]
    public async Task<IActionResult> CreateTenant(string? name, string? domain)
    {
        if (string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(domain))
            return Fail("/admin/tenants", "Enter a name and a domain.");
        await tenants.CreateAsync(name.Trim(), domain.Trim());
        return Done("/admin/tenants", $"Tenant {name.Trim()} created.");
    }

    [HttpGet("/admin/tenants/{id}/settings")]
    public async Task<IActionResult> TenantSettings(string id) =>
        await tenants.GetAsync(id) is { } details ? View(Folder + "TenantSettings.cshtml", details) : NotFound();

    [HttpPost("/admin/tenants/{id}/settings")]
    public async Task<IActionResult> TenantSettings(string id, [Bind(Prefix = "Details")] TenantDetails details)
    {
        if (await tenants.GetAsync(id) is not { } current) return NotFound();
        var back = $"/admin/tenants/{Uri.EscapeDataString(id)}/settings";
        if (string.IsNullOrWhiteSpace(details.Name)) return Fail(back, "The tenant needs a name.");
        details.Domain = current.Domain; // the domain is read-only here
        await tenants.SaveAsync(id, details);
        return Done(back, "Tenant settings saved.");
    }

    [HttpGet("/admin/tenants/{id}/members")]
    public async Task<IActionResult> TenantMembers(string id, string? q) =>
        await tenants.GetAsync(id) is null
            ? NotFound()
            : View(Folder + "TenantMembers.cshtml", new TenantMembersPage(id, await tenants.MembersAsync(id, q), await tenants.InvitationsAsync(id)));

    [HttpPost("/admin/tenants/{id}/members/invite")]
    public async Task<IActionResult> InviteMember(string id, string? email, string? role)
    {
        var back = $"/admin/tenants/{Uri.EscapeDataString(id)}/members";
        if (string.IsNullOrWhiteSpace(email)) return Fail(back, "Enter an email address.");
        await tenants.InviteMemberAsync(id, email.Trim(), string.IsNullOrWhiteSpace(role) ? "Member" : role);
        return Done(back, $"Invitation sent to {email.Trim()}.");
    }

    [HttpPost("/admin/tenants/{id}/members/remove")]
    public async Task<IActionResult> RemoveMember(string id, string userId)
    {
        await tenants.RemoveMemberAsync(id, userId);
        return Done($"/admin/tenants/{Uri.EscapeDataString(id)}/members", "Member removed.");
    }

    // Notifications

    [HttpGet("/notifications")]
    public async Task<IActionResult> Notifications(string? q) =>
        View(Folder + "Notifications.cshtml", await notifications.ListAsync(UserName, q));

    [HttpPost("/notifications/read")]
    public async Task<IActionResult> MarkRead(string? id)
    {
        await notifications.MarkReadAsync(UserName, id);
        return LocalRedirect("/notifications");
    }

    [HttpGet("/account/notification-preferences")]
    public async Task<IActionResult> NotificationPreferences() =>
        View(Folder + "NotificationPreferences.cshtml", await notifications.GetPreferencesAsync(UserName));

    [HttpPost("/account/notification-preferences")]
    public async Task<IActionResult> NotificationPreferences([Bind(Prefix = "Prefs")] NotificationSettings prefs)
    {
        await notifications.SavePreferencesAsync(UserName, prefs);
        return Done("/account/notification-preferences", "Preferences saved.");
    }

    // Audit, settings and dashboards

    [HttpGet("/audit")]
    public async Task<IActionResult> Audit(string? q) =>
        View(Folder + "Audit.cshtml", await audit.SearchAsync(q));

    [HttpGet("/admin/settings")]
    public async Task<IActionResult> Settings() =>
        View(Folder + "Settings.cshtml", await settings.GetAsync());

    [HttpPost("/admin/settings")]
    public async Task<IActionResult> Settings([Bind(Prefix = "Settings")] SystemSettings values)
    {
        if (string.IsNullOrWhiteSpace(values.AppName)) return Fail("/admin/settings", "The application needs a name.");
        await settings.SaveAsync(values);
        return Done("/admin/settings", "Settings saved.");
    }

    [HttpGet("/dashboard")]
    public async Task<IActionResult> Dashboard() => View(Folder + "Dashboard.cshtml", await metrics.DashboardAsync());

    [HttpGet("/analytics")]
    public async Task<IActionResult> Analytics() => View(Folder + "Analytics.cshtml", await metrics.AnalyticsAsync());

    [HttpGet("/reports")]
    public async Task<IActionResult> Reports() => View(Folder + "Reports.cshtml", await metrics.ReportsAsync());

    [HttpGet("/system/health")]
    public async Task<IActionResult> Health() => View(Folder + "Health.cshtml", await metrics.HealthAsync());
}

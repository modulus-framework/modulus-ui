@* Module home page template for MVC *@
@{
    ViewData["Title"] = "{{ module_name }} Module";
}

<div class="page-wrapper">
    <div class="container-xl">
        <div class="page-header d-mb-4">
            <div class="row align-items-center">
                <div class="col">
                    <h2 class="page-title">{{ module_name }} Module</h2>
                    <nav aria-label="breadcrumb" class="ms-2">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">{{ module_name }}</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>
    <div class="page-body">
        <div class="container-xl">
            <div class="row">
                <div class="col-md-3">
                    <div class="list-group">
                        <a href="/" class="list-group-item list-group-item-action">
                            <span class="icon me-3">📊</span> Overview
                        </a>
                        <a href="?tab=entities" class="list-group-item list-group-item-action">
                            <span class="icon me-3">📋</span> Entities
                        </a>
                        <a href="?tab=settings" class="list-group-item list-group-item-action">
                            <span class="icon me-3">⚙️</span> Settings
                        </a>
                        <a href="?tab=permissions" class="list-group-item list-group-item-action">
                            <span class="icon me-3">🔐</span> Permissions
                        </a>
                    </div>
                </div>
                <div class="col-md-9">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Module Overview</h3>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="stat-item">
                                        <h4>Entities</h4>
                                        <div class="display-5">@(ViewBag.EntityCount ?? 0)</div>
                                        <p class="text-secondary">Domain models in this module</p>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="stat-item">
                                        <h4>APIs</h4>
                                        <div class="display-5">@(ViewBag.ApiCount ?? 0)</div>
                                        <p class="text-secondary">REST endpoints exposed</p>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="stat-item">
                                        <h4>Permissions</h4>
                                        <div class="display-5">@(ViewBag.PermissionCount ?? 0)</div>
                                        <p class="text-secondary">Access control policies</p>
                                    </div>
                                </div>
                            </div>
                            <hr />
                            <p>{{ module_description }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

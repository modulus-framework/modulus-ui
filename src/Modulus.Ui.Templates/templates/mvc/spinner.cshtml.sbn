@* Spinner/Loading indicator component *@
@{
    var spinnerClass = "spinner-border";
    if (!string.IsNullOrEmpty(ViewBag.Size))
    {
        spinnerClass += ViewBag.Size == "sm" ? " spinner-border-sm" : "";
    }
    if (!string.IsNullOrEmpty(ViewBag.Color))
    {
        spinnerClass += $" text-{ViewBag.Color}";
    }
}

<div class="@spinnerClass" role="status">
    @if (!string.IsNullOrEmpty(ViewBag.Label))
    {
        <span class="visually-hidden">@ViewBag.Label</span>
    }
</div>

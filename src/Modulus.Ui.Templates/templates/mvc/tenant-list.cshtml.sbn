@model IReadOnlyList<AdminTenant>
@* Scaffold generated by `modulus ui`. This file is yours: edit the markup and the handlers freely. *@
@* The tenant list comes from ITenantDirectory (Modulus.Ui.Abstractions.Admin). Until you register your own implementation the built-in *@
@* sample data answers and the page says so. To connect real data, implement ITenantDirectory and register it after AddModulusMvc, *@
@* or change the controller action that feeds this view. *@
@addTagHelper *, Modulus.AspNetCore.Mvc
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Modulus.Ui.Abstractions.Admin
@inject ITenantDirectory Tenants

@{
    ViewData["Title"] = "Tenant management";
}

<app-page-header pretitle="Administration" title="Tenant management"></app-page-header>

@if (Tenants.IsSample)
{
    <app-alert type="info" message="Sample data" description="This page shows built-in sample data. Register your own ITenantDirectory to connect it to your tenant store." show-icon="true" />
}
@if (TempData["Message"] is string flash)
{
    <app-alert type="success" message="@flash" show-icon="true" closable="true" />
}
@if (TempData["Error"] is string problem)
{
    <app-alert type="error" message="@problem" show-icon="true" closable="true" />
}

<div class="m-card">
    <div class="m-card-header"><h2 class="m-card-title">Create a tenant</h2></div>
    <div class="m-card-body">
        <form method="post" asp-antiforgery="true" action="/admin/tenants/create" class="m-flex m-flex-wrap">
            <input class="ant-input" name="name" placeholder="Tenant name" aria-label="Tenant name" required />
            <input class="ant-input" name="domain" placeholder="tenant.example.com" aria-label="Domain" required />
            <app-button type="primary" html-type="submit">Create tenant</app-button>
        </form>
    </div>
</div>

<div class="m-card m-mt-24">
    <div class="m-card-header">
        <h2 class="m-card-title">Tenants</h2>
        <form method="get" class="m-card-actions">
            <input class="ant-input" type="search" name="q" value="@Context.Request.Query["q"].ToString()" placeholder="Search tenants..." aria-label="Search tenants" />
        </form>
    </div>
    <div class="m-card-body m-card-body-flush">
        @if (Model.Count == 0)
        {
            <div class="m-empty">
                <h3 class="m-empty-title">No tenants found</h3>
            </div>
        }
        else
        {
            <div class="ant-table-wrapper m-table-flush">
                <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                    <table style="table-layout:auto">
                        <thead class="ant-table-thead"><tr><th class="ant-table-cell">Name</th><th class="ant-table-cell">Domain</th><th class="ant-table-cell">Plan</th><th class="ant-table-cell">Status</th><th class="ant-table-cell">Members</th><th class="ant-table-cell"></th></tr></thead>
                        <tbody class="ant-table-tbody">
                            @foreach (var t in Model)
                            {
                                <tr class="ant-table-row">
                                    <td class="ant-table-cell"><strong>@t.Name</strong></td>
                                    <td class="ant-table-cell">@t.Domain</td>
                                    <td class="ant-table-cell">@t.Plan</td>
                                    <td class="ant-table-cell">@t.Status</td>
                                    <td class="ant-table-cell">@t.Members</td>
                                    <td class="ant-table-cell">
                                        <a class="ant-btn ant-btn-text ant-btn-sm" href="/admin/tenants/@t.Id/settings"><span>Settings</span></a>
                                        <a class="ant-btn ant-btn-text ant-btn-sm" href="/admin/tenants/@t.Id/members"><span>Members</span></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div></div></div>
            </div>
        }
    </div>
</div>

<style>
    .m-mt-24 { margin-top: 24px; }
</style>

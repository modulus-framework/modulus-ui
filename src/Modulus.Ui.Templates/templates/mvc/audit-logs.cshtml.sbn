@* Audit Logs page for MVC *@
@{
    ViewData["Title"] = "Audit Logs";
}

<div class="page-wrapper">
    <div class="container-xl">
        <div class="page-header d-mb-4">
            <div class="row align-items-center">
                <div class="col">
                    <h2 class="page-title">Audit Logs</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-deck row-cards">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <div class="row align-items-center">
                                <div class="col">
                                    <h3 class="card-title">Activity Timeline</h3>
                                </div>
                                <div class="col-auto">
                                    <div class="input-icon">
                                        <input type="text" class="form-control" placeholder="Search logs..." />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-vcenter card-table">
                                <thead>
                                    <tr>
                                        <th>Timestamp</th>
                                        <th>User</th>
                                        <th>Action</th>
                                        <th>Resource</th>
                                        <th>Status</th>
                                        <th>Details</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>2024-10-10 15:30:45</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar avatar-sm me-2" style="background-color: #00d4ff">JD</div>
                                                <span>John Doe</span>
                                            </div>
                                        </td>
                                        <td><span class="badge badge-success">CREATE</span></td>
                                        <td>User: admin@example.com</td>
                                        <td><span class="badge badge-success">Success</span></td>
                                        <td>
                                            <button class="btn btn-sm btn-ghost-primary" data-bs-toggle="modal" data-bs-target="#detailsModal">
                                                View
                                            </button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>2024-10-10 14:15:20</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar avatar-sm me-2" style="background-color: #0066cc">AD</div>
                                                <span>Admin User</span>
                                            </div>
                                        </td>
                                        <td><span class="badge badge-info">UPDATE</span></td>
                                        <td>Settings: App Config</td>
                                        <td><span class="badge badge-success">Success</span></td>
                                        <td>
                                            <button class="btn btn-sm btn-ghost-primary" data-bs-toggle="modal" data-bs-target="#detailsModal">
                                                View
                                            </button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>2024-10-10 13:45:10</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar avatar-sm me-2" style="background-color: #ff6b6b">SU</div>
                                                <span>System User</span>
                                            </div>
                                        </td>
                                        <td><span class="badge badge-danger">DELETE</span></td>
                                        <td>User: olduser@example.com</td>
                                        <td><span class="badge badge-success">Success</span></td>
                                        <td>
                                            <button class="btn btn-sm btn-ghost-primary" data-bs-toggle="modal" data-bs-target="#detailsModal">
                                                View
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="card-footer d-flex align-items-center">
                            <nav aria-label="Page navigation">
                                <ul class="pagination m-0 ms-auto">
                                    <li class="page-item disabled">
                                        <a class="page-link" href="#" tabindex="-1">Previous</a>
                                    </li>
                                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                                    <li class="page-item"><a class="page-link" href="#">Next</a></li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Analytics & Insights page for MVC *@
@{
    ViewData["Title"] = "Analytics";
}

<div class="page-wrapper">
    <div class="container-xl">
        <div class="page-header d-mb-4">
            <div class="row align-items-center">
                <div class="col">
                    <h2 class="page-title">Analytics & Insights</h2>
                </div>
                <div class="col-auto">
                    <select class="form-select" style="width: 150px;">
                        <option selected>Last 30 days</option>
                        <option>Last 7 days</option>
                        <option>Last 90 days</option>
                        <option>This year</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="page-body">
        <div class="container-xl">
            <!-- Key Metrics -->
            <div class="row row-deck row-cards mb-4">
                <div class="col-sm-6 col-lg-3">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex align-items-baseline">
                                <div class="h2 mb-0">@(ViewBag.PageViews ?? "0")</div>
                                <div class="ms-auto">
                                    <span class="badge badge-success">+12%</span>
                                </div>
                            </div>
                            <div class="text-secondary">Page Views</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex align-items-baseline">
                                <div class="h2 mb-0">@(ViewBag.UniqueUsers ?? "0")</div>
                                <div class="ms-auto">
                                    <span class="badge badge-success">+8%</span>
                                </div>
                            </div>
                            <div class="text-secondary">Unique Users</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex align-items-baseline">
                                <div class="h2 mb-0">@(ViewBag.AvgSessionDuration ?? "0s")</div>
                                <div class="ms-auto">
                                    <span class="badge badge-danger">-2%</span>
                                </div>
                            </div>
                            <div class="text-secondary">Avg. Session Duration</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex align-items-baseline">
                                <div class="h2 mb-0">@(ViewBag.ConversionRate ?? "0%")</div>
                                <div class="ms-auto">
                                    <span class="badge badge-success">+5%</span>
                                </div>
                            </div>
                            <div class="text-secondary">Conversion Rate</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Charts -->
            <div class="row row-deck row-cards">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Traffic Over Time</h3>
                        </div>
                        <div class="card-body" style="height: 300px;">
                            <canvas id="trafficChart" width="400" height="300"></canvas>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Top Pages</h3>
                        </div>
                        <div class="card-body">
                            <ul class="list-unstyled divide-y">
                                <li class="py-3">
                                    <div class="d-flex justify-content-between">
                                        <span>/dashboard</span>
                                        <span class="text-muted">1,234 views</span>
                                    </div>
                                </li>
                                <li class="py-3">
                                    <div class="d-flex justify-content-between">
                                        <span>/reports</span>
                                        <span class="text-muted">856 views</span>
                                    </div>
                                </li>
                                <li class="py-3">
                                    <div class="d-flex justify-content-between">
                                        <span>/settings</span>
                                        <span class="text-muted">432 views</span>
                                    </div>
                                </li>
                                <li class="py-3">
                                    <div class="d-flex justify-content-between">
                                        <span>/users</span>
                                        <span class="text-muted">298 views</span>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Chart.js would be included for actual charts
    // This is a placeholder for integration
</script>

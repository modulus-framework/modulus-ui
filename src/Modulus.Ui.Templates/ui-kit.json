{
  "version": "1.6.1",
  "name": "Modulus UI Kit",
  "description": "Admin template and components for MVC, Razor Pages, Blazor, and Fluid.",
  "engines": ["mvc", "razor-pages", "blazor", "fluid", "none"],
  "features": {
    "shell": {
      "description": "Shell layout with header, navbar/sidebar, footer.",
      "files": {
        "mvc": [
          "Views/Shared/_Layout.cshtml",
          "Views/Shared/Components/Shell/Default.cshtml"
        ],
        "razor-pages": [
          "Pages/Shared/_Layout.cshtml",
          "Pages/Shared/Components/Shell/Default.cshtml"
        ],
        "blazor": [
          "Components/Layout/AppShell.razor"
        ],
        "fluid": [
          "Templates/_layout.liquid"
        ]
      },
      "packages": {
        "mvc": ["Synvro.Modulus.AspNetCore.Mvc", "Synvro.Modulus.Ui.Assets", "Synvro.Modulus.Ui.Abstractions", "Synvro.Modulus.AspNetCore.Hosting"],
        "razor-pages": ["Synvro.Modulus.AspNetCore.Mvc", "Synvro.Modulus.Ui.Assets", "Synvro.Modulus.Ui.Abstractions", "Synvro.Modulus.AspNetCore.Hosting"],
        "blazor": ["Synvro.Modulus.Blazor", "Synvro.Modulus.Ui.Assets", "Synvro.Modulus.Ui.Abstractions", "Synvro.Modulus.AspNetCore.Hosting"],
        "fluid": ["Synvro.Modulus.AspNetCore.Fluid", "Synvro.Modulus.Ui.Assets", "Synvro.Modulus.AspNetCore.Hosting"]
      }
    },
    "crud": {
      "description": "CRUD pages for an entity of a module: a list with delete and a create/edit form, over the module's API through a typed client. Added by `modulus ui create-crud`.",
      "files": {
        "razor-pages": [
          "Pages/[Entities]/Index.cshtml",
          "Pages/[Entities]/Index.cshtml.cs",
          "Pages/[Entities]/Edit.cshtml",
          "Pages/[Entities]/Edit.cshtml.cs",
          "ApiClients/[Entity]ApiClient.cs",
          "Menu/[Entities]MenuContributor.cs"
        ],
        "blazor": [
          "Components/Pages/[Entities]/Index.razor",
          "Components/Pages/[Entities]/Edit.razor",
          "ApiClients/[Entity]ApiClient.cs",
          "Menu/[Entities]MenuContributor.cs"
        ]
      },
      "packages": {
        "razor-pages": ["Synvro.Modulus.AspNetCore.Mvc", "Synvro.Modulus.Ui.Abstractions"],
        "blazor": ["Synvro.Modulus.Blazor", "Synvro.Modulus.Ui.Abstractions"]
      }
    },
    "auth": {
      "description": "Authentication pages: sign-in, sign-out, register.",
      "files": {
        "mvc": [
          "Controllers/AuthController.cs",
          "Views/Auth/Login.cshtml",
          "Views/Auth/Register.cshtml"
        ],
        "razor-pages": [
          "Pages/Auth/Login.cshtml.cs",
          "Pages/Auth/Login.cshtml",
          "Pages/Auth/Register.cshtml.cs",
          "Pages/Auth/Register.cshtml"
        ],
        "blazor": [
          "Pages/Auth/Login.razor",
          "Pages/Auth/Register.razor"
        ],
        "fluid": [
          "Templates/login.liquid",
          "Templates/register.liquid"
        ]
      },
      "packages": {
        "mvc": ["Synvro.Modulus.Ui.Abstractions"],
        "razor-pages": ["Synvro.Modulus.Ui.Abstractions"],
        "blazor": ["Synvro.Modulus.Ui.Abstractions"],
        "fluid": []
      }
    },
    "errors": {
      "description": "Error pages: 404, 403, 500.",
      "files": {
        "mvc": [
          "Views/Shared/Error.cshtml"
        ],
        "razor-pages": [
          "Pages/Error.cshtml.cs",
          "Pages/Error.cshtml"
        ],
        "blazor": [
          "Components/Pages/Error.razor"
        ],
        "fluid": [
          "Templates/error.liquid"
        ]
      },
      "packages": {}
    },
    "state-store": {
      "description": "UI state store for saved views.",
      "files": {
        "mvc": [
          "Services/UiStateStore.cs"
        ],
        "razor-pages": [
          "Services/UiStateStore.cs"
        ],
        "blazor": [
          "Services/UiStateStore.cs"
        ],
        "fluid": []
      },
      "packages": {
        "mvc": ["Synvro.Modulus.Ui.Abstractions"],
        "razor-pages": ["Synvro.Modulus.Ui.Abstractions"],
        "blazor": ["Synvro.Modulus.Ui.Abstractions"],
        "fluid": []
      }
    },
    "admin": {
      "description": "Working admin dashboard starter: users, roles, tenants, notifications, audit, settings, dashboards and account pages over the Modulus.Ui.Abstractions.Admin services (sample data until you register your own). Pair with services.AddModulusAdminUi() for the matching navigation. Pages are yours to edit.",
      "files": {
        "mvc": [
          {
            "path": "Controllers/AdminController.cs",
            "template": "admin-controller.cs.sbn"
          },
          {
            "path": "Views/Admin/Users.cshtml",
            "template": "admin-users.cshtml.sbn"
          },
          {
            "path": "Views/Admin/Profile.cshtml",
            "template": "user-profile.cshtml.sbn"
          },
          {
            "path": "Views/Admin/Roles.cshtml",
            "template": "role-management.cshtml.sbn"
          },
          {
            "path": "Views/Admin/Tenants.cshtml",
            "template": "tenant-list.cshtml.sbn"
          },
          {
            "path": "Views/Admin/TenantSettings.cshtml",
            "template": "tenant-settings.cshtml.sbn"
          },
          {
            "path": "Views/Admin/TenantMembers.cshtml",
            "template": "tenant-members.cshtml.sbn"
          },
          {
            "path": "Views/Admin/Notifications.cshtml",
            "template": "notification-center.cshtml.sbn"
          },
          {
            "path": "Views/Admin/NotificationPreferences.cshtml",
            "template": "notification-preferences.cshtml.sbn"
          },
          {
            "path": "Views/Admin/Audit.cshtml",
            "template": "audit-logs.cshtml.sbn"
          },
          {
            "path": "Views/Admin/Settings.cshtml",
            "template": "admin-settings.cshtml.sbn"
          },
          {
            "path": "Views/Admin/Dashboard.cshtml",
            "template": "dashboard.cshtml.sbn"
          },
          {
            "path": "Views/Admin/Analytics.cshtml",
            "template": "analytics.cshtml.sbn"
          },
          {
            "path": "Views/Admin/Reports.cshtml",
            "template": "reports-dashboard.cshtml.sbn"
          },
          {
            "path": "Views/Admin/Health.cshtml",
            "template": "system-health.cshtml.sbn"
          }
        ],
        "razor-pages": [
          {
            "path": "Pages/Admin/Users.cshtml",
            "template": "admin-users.cshtml.sbn"
          },
          {
            "path": "Pages/Admin/Profile.cshtml",
            "template": "user-profile.cshtml.sbn"
          },
          {
            "path": "Pages/Admin/Roles.cshtml",
            "template": "role-management.cshtml.sbn"
          },
          {
            "path": "Pages/Admin/Tenants.cshtml",
            "template": "tenant-list.cshtml.sbn"
          },
          {
            "path": "Pages/Admin/TenantSettings.cshtml",
            "template": "tenant-settings.cshtml.sbn"
          },
          {
            "path": "Pages/Admin/TenantMembers.cshtml",
            "template": "tenant-members.cshtml.sbn"
          },
          {
            "path": "Pages/Admin/Notifications.cshtml",
            "template": "notification-center.cshtml.sbn"
          },
          {
            "path": "Pages/Admin/NotificationPreferences.cshtml",
            "template": "notification-preferences.cshtml.sbn"
          },
          {
            "path": "Pages/Admin/Audit.cshtml",
            "template": "audit-logs.cshtml.sbn"
          },
          {
            "path": "Pages/Admin/Settings.cshtml",
            "template": "admin-settings.cshtml.sbn"
          },
          {
            "path": "Pages/Admin/Dashboard.cshtml",
            "template": "dashboard.cshtml.sbn"
          },
          {
            "path": "Pages/Admin/Analytics.cshtml",
            "template": "analytics.cshtml.sbn"
          },
          {
            "path": "Pages/Admin/Reports.cshtml",
            "template": "reports-dashboard.cshtml.sbn"
          },
          {
            "path": "Pages/Admin/Health.cshtml",
            "template": "system-health.cshtml.sbn"
          }
        ],
        "blazor": [
          {
            "path": "Components/Pages/Admin/Users.razor",
            "template": "admin-users.razor.sbn"
          },
          {
            "path": "Components/Pages/Admin/Profile.razor",
            "template": "user-profile.razor.sbn"
          },
          {
            "path": "Components/Pages/Admin/Roles.razor",
            "template": "role-management.razor.sbn"
          },
          {
            "path": "Components/Pages/Admin/Tenants.razor",
            "template": "tenant-list.razor.sbn"
          },
          {
            "path": "Components/Pages/Admin/TenantSettings.razor",
            "template": "tenant-settings.razor.sbn"
          },
          {
            "path": "Components/Pages/Admin/TenantMembers.razor",
            "template": "tenant-members.razor.sbn"
          },
          {
            "path": "Components/Pages/Admin/Notifications.razor",
            "template": "notification-center.razor.sbn"
          },
          {
            "path": "Components/Pages/Admin/NotificationPreferences.razor",
            "template": "notification-preferences.razor.sbn"
          },
          {
            "path": "Components/Pages/Admin/Audit.razor",
            "template": "audit-logs.razor.sbn"
          },
          {
            "path": "Components/Pages/Admin/Settings.razor",
            "template": "admin-settings.razor.sbn"
          },
          {
            "path": "Components/Pages/Admin/Dashboard.razor",
            "template": "dashboard.razor.sbn"
          },
          {
            "path": "Components/Pages/Admin/Analytics.razor",
            "template": "analytics.razor.sbn"
          },
          {
            "path": "Components/Pages/Admin/Reports.razor",
            "template": "reports-dashboard.razor.sbn"
          },
          {
            "path": "Components/Pages/Admin/Health.razor",
            "template": "system-health.razor.sbn"
          }
        ]
      },
      "packages": {
        "mvc": [
          "Synvro.Modulus.AspNetCore.Mvc",
          "Synvro.Modulus.Ui.Abstractions"
        ],
        "razor-pages": [
          "Synvro.Modulus.AspNetCore.Mvc",
          "Synvro.Modulus.Ui.Abstractions"
        ],
        "blazor": [
          "Synvro.Modulus.Blazor",
          "Synvro.Modulus.Ui.Abstractions"
        ]
      },
      "setup": [
        "builder.Services.AddModulusAdminUi();  // navigation; options.Pages limits it to the pages you scaffolded"
      ]
    },
    "notifications": {
      "description": "Notification management: notification center and preferences. Required for ERP systems.",
      "files": {
        "mvc": [
          "Views/Notifications/Center.cshtml",
          "Views/Account/NotificationPreferences.cshtml"
        ],
        "razor-pages": [
          "Pages/Notifications/Center.cshtml",
          "Pages/Account/NotificationPreferences.cshtml"
        ],
        "blazor": [
          "Components/Pages/NotificationCenter.razor",
          "Components/Pages/NotificationPreferences.razor"
        ]
      },
      "packages": {
        "mvc": ["Synvro.Modulus.Ui.Abstractions"],
        "razor-pages": ["Synvro.Modulus.Ui.Abstractions"],
        "blazor": ["Synvro.Modulus.Ui.Abstractions"]
      }
    },
    "tenant-management": {
      "description": "Tenant management: list, settings, and members. Required for multi-tenant ERP systems.",
      "files": {
        "mvc": [
          "Views/Admin/Tenants/List.cshtml",
          "Views/Admin/Tenants/Settings.cshtml",
          "Views/Admin/Tenants/Members.cshtml"
        ],
        "razor-pages": [
          "Pages/Admin/Tenants/List.cshtml",
          "Pages/Admin/Tenants/Settings.cshtml",
          "Pages/Admin/Tenants/Members.cshtml"
        ],
        "blazor": [
          "Components/Pages/Admin/TenantList.razor",
          "Components/Pages/Admin/TenantSettings.razor",
          "Components/Pages/Admin/TenantMembers.razor"
        ]
      },
      "packages": {
        "mvc": ["Synvro.Modulus.Ui.Abstractions"],
        "razor-pages": ["Synvro.Modulus.Ui.Abstractions"],
        "blazor": ["Synvro.Modulus.Ui.Abstractions"]
      }
    },
    "user-management": {
      "description": "User profile and role management. Required for identity and access control.",
      "files": {
        "mvc": [
          "Views/Account/Profile.cshtml",
          "Views/Admin/Roles/Manage.cshtml"
        ],
        "razor-pages": [
          "Pages/Account/Profile.cshtml",
          "Pages/Admin/Roles/Manage.cshtml"
        ],
        "blazor": [
          "Components/Pages/Account/UserProfile.razor",
          "Components/Pages/Admin/RoleManagement.razor"
        ]
      },
      "packages": {
        "mvc": ["Synvro.Modulus.Ui.Abstractions"],
        "razor-pages": ["Synvro.Modulus.Ui.Abstractions"],
        "blazor": ["Synvro.Modulus.Ui.Abstractions"]
      }
    }
  },
  "templates": {
    "description": "Entry point method to add and use Modulus UI in Program.cs",
    "mvc": "builder.Services.AddModulusMvc(theme => builder.Configuration.GetSection(\"Modulus:Theme\").Bind(theme));",
    "razor-pages": "builder.Services.AddModulusMvc(theme => builder.Configuration.GetSection(\"Modulus:Theme\").Bind(theme));",
    "blazor": "builder.Services.AddModulusBlazor(theme => builder.Configuration.GetSection(\"Modulus:Theme\").Bind(theme));",
    "fluid": "builder.Services.AddSingleton(new ModulusLiquid(new ModulusLiquidOptions()));"
  }
}

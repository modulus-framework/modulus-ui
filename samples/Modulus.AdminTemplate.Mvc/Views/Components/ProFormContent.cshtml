@using Modulus.AdminTemplate.Mvc.Controllers
@model Customer

<div class="ant-form-item" style="margin-bottom: 16px;">
    <label class="ant-form-item-label">
        <span class="ant-form-item-required">Name</span>
    </label>
    <input type="text" name="Name" class="ant-input" placeholder="Enter name" value="@Model?.Name" required />
</div>

<div class="ant-form-item" style="margin-bottom: 16px;">
    <label class="ant-form-item-label">
        <span class="ant-form-item-required">Email</span>
    </label>
    <input type="email" name="Email" class="ant-input" placeholder="Enter email" value="@Model?.Email" required />
</div>

<div class="ant-form-item" style="margin-bottom: 16px;">
    <label class="ant-form-item-label">Phone</label>
    <input type="tel" name="Phone" class="ant-input" placeholder="Enter phone" value="@Model?.Phone" />
</div>

<div class="ant-form-item" style="margin-bottom: 16px;">
    <label class="ant-form-item-label">City</label>
    <input type="text" name="City" class="ant-input" placeholder="Enter city" value="@Model?.City" />
</div>

<div class="ant-form-item">
    <label class="ant-form-item-label">Status</label>
    <select name="Status" class="ant-input" style="padding: 4px 11px;">
        <option value="active" selected="@(Model?.Status == "active")">Active</option>
        <option value="inactive" selected="@(Model?.Status == "inactive")">Inactive</option>
    </select>
</div>

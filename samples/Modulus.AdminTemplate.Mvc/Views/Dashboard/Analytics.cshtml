@{
    ViewData["Title"] = "Analytics Dashboard";
}

<div style="max-width: 1400px;">
    <h1>Analytics Dashboard</h1>

    <!-- KPI Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px; margin: 24px 0;">
        <div class="ant-card" style="text-align: center;">
            <div style="padding: 16px;">
                <p style="margin: 0 0 16px 0; color: rgba(0,0,0,0.65); font-size: 12px;">Total Revenue</p>
                <div style="font-size: 28px; font-weight: bold; color: #1890ff; margin-bottom: 8px;">$48,500</div>
                <div style="font-size: 12px; color: #52c41a;">↑ 23% vs last month</div>
            </div>
        </div>

        <div class="ant-card" style="text-align: center;">
            <div style="padding: 16px;">
                <p style="margin: 0 0 16px 0; color: rgba(0,0,0,0.65); font-size: 12px;">Total Orders</p>
                <div style="font-size: 28px; font-weight: bold; color: #1890ff; margin-bottom: 8px;">1,850</div>
                <div style="font-size: 12px; color: #52c41a;">↑ 12% vs last month</div>
            </div>
        </div>

        <div class="ant-card" style="text-align: center;">
            <div style="padding: 16px;">
                <p style="margin: 0 0 16px 0; color: rgba(0,0,0,0.65); font-size: 12px;">Active Users</p>
                <div style="font-size: 28px; font-weight: bold; color: #1890ff; margin-bottom: 8px;">3,250</div>
                <div style="font-size: 12px; color: #ff7875;">↓ 5% vs last month</div>
            </div>
        </div>

        <div class="ant-card" style="text-align: center;">
            <div style="padding: 16px;">
                <p style="margin: 0 0 16px 0; color: rgba(0,0,0,0.65); font-size: 12px;">Conversion Rate</p>
                <div style="font-size: 28px; font-weight: bold; color: #1890ff; margin-bottom: 8px;">3.42%</div>
                <div style="font-size: 12px; color: #52c41a;">↑ 0.8% vs last month</div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin: 24px 0;">
        <div class="ant-card">
            <div style="padding: 16px;">
                <h3 style="margin: 0 0 16px 0;">Revenue Trend</h3>
                <div style="background: #fafafa; height: 300px; border-radius: 4px; display: flex; align-items: center; justify-content: center; color: #999;">
                    [Chart Placeholder - Line Chart]
                </div>
            </div>
        </div>

        <div class="ant-card">
            <div style="padding: 16px;">
                <h3 style="margin: 0 0 16px 0;">Order Status Distribution</h3>
                <div style="background: #fafafa; height: 300px; border-radius: 4px; display: flex; align-items: center; justify-content: center; color: #999;">
                    [Chart Placeholder - Pie Chart]
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="ant-card" style="margin: 24px 0;">
        <div style="padding: 16px;">
            <h3 style="margin: 0 0 16px 0;">Recent Transactions</h3>
            <table class="ant-table" style="width: 100%; border-collapse: collapse;">
                <thead style="background-color: #fafafa;">
                    <tr>
                        <th style="padding: 12px; text-align: left; border-bottom: 1px solid #d9d9d9;">Order ID</th>
                        <th style="padding: 12px; text-align: left; border-bottom: 1px solid #d9d9d9;">Customer</th>
                        <th style="padding: 12px; text-align: right; border-bottom: 1px solid #d9d9d9;">Amount</th>
                        <th style="padding: 12px; text-align: center; border-bottom: 1px solid #d9d9d9;">Status</th>
                        <th style="padding: 12px; text-align: left; border-bottom: 1px solid #d9d9d9;">Date</th>
                    </tr>
                </thead>
                <tbody>
                    <tr style="border-bottom: 1px solid #f0f0f0;">
                        <td style="padding: 12px;">ORD-5234</td>
                        <td style="padding: 12px;">John Smith</td>
                        <td style="padding: 12px; text-align: right;">$1,250.00</td>
                        <td style="padding: 12px; text-align: center;"><span style="background: #f6ffed; color: #52c41a; padding: 2px 8px; border-radius: 4px; font-size: 12px;">Completed</span></td>
                        <td style="padding: 12px;">2026-09-24</td>
                    </tr>
                    <tr style="border-bottom: 1px solid #f0f0f0;">
                        <td style="padding: 12px;">ORD-5233</td>
                        <td style="padding: 12px;">Jane Doe</td>
                        <td style="padding: 12px; text-align: right;">$875.50</td>
                        <td style="padding: 12px; text-align: center;"><span style="background: #e6f7ff; color: #1890ff; padding: 2px 8px; border-radius: 4px; font-size: 12px;">Processing</span></td>
                        <td style="padding: 12px;">2026-09-23</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .ant-card {
        border: 1px solid #d9d9d9;
        border-radius: 4px;
        background: white;
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02);
    }
</style>

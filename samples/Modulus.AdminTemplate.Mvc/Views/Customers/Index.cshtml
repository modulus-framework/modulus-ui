@{
    ViewData["Title"] = "Customers";
}

<div class="customers-container" x-data="{ modal: modal(), search: '', searchInput: '' }">
    <h1>Customers</h1>

    <div style="margin-top: 16px; display: flex; gap: 8px;">
        <button class="ant-btn ant-btn-primary" x-on:click="modal.open('Add Customer')" title="Opens modal with Alpine.js">
            <span class="ant-icon">➕</span> Add Customer (htmx Modal)
        </button>
        <input type="text"
               class="ant-input"
               placeholder="Search customers..."
               style="width: 300px;"
               x-model="searchInput"
               x-on:keyup="search = searchInput"
               hx-get="/Customers/GetTableBody"
               hx-trigger="change delay:500ms from:this"
               hx-vals='{"search": "PLACEHOLDER"}'
               hx-target="#table-body"
               hx-swap="innerHTML" />
    </div>

    <app-card title="Customer List (htmx-enabled)" class="mt-24">
        <table class="ant-table" style="width: 100%; border-collapse: collapse;">
            <thead style="background-color: #fafafa;">
                <tr>
                    <th style="width: 80px; padding: 12px; text-align: left; border-bottom: 1px solid #d9d9d9;">ID</th>
                    <th style="padding: 12px; text-align: left; border-bottom: 1px solid #d9d9d9;">Name</th>
                    <th style="padding: 12px; text-align: left; border-bottom: 1px solid #d9d9d9;">Email</th>
                    <th style="padding: 12px; text-align: left; border-bottom: 1px solid #d9d9d9;">Phone</th>
                    <th style="padding: 12px; text-align: left; border-bottom: 1px solid #d9d9d9;">City</th>
                    <th style="width: 100px; padding: 12px; text-align: left; border-bottom: 1px solid #d9d9d9;">Status</th>
                    <th style="width: 150px; padding: 12px; text-align: left; border-bottom: 1px solid #d9d9d9;">Actions</th>
                </tr>
            </thead>
            <tbody id="table-body">
                @if (Model != null)
                {
                    @foreach (var customer in Model)
                    {
                        <tr style="border-bottom: 1px solid #f0f0f0;">
                            <td style="padding: 12px;">@customer.Id</td>
                            <td style="padding: 12px;">@customer.Name</td>
                            <td style="padding: 12px;">@customer.Email</td>
                            <td style="padding: 12px;">@customer.Phone</td>
                            <td style="padding: 12px;">@customer.City</td>
                            <td style="padding: 12px;">
                                <span class="ant-tag @(customer.Status == "active" ? "ant-tag-success" : "ant-tag-error")">
                                    @(customer.Status == "active" ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td style="padding: 12px;">
                                <button class="ant-btn ant-btn-primary ant-btn-sm"
                                        x-on:click="htmx.ajax('GET', '/Customers/FormPartial?id=@customer.Id', '#modal-form-content'); modal.open('Edit Customer')">
                                    Edit
                                </button>
                                <button class="ant-btn ant-btn-dangerous ant-btn-sm"
                                        style="margin-left: 8px;"
                                        hx-delete="/Customers/@customer.Id"
                                        hx-confirm="Delete this customer?"
                                        hx-target="closest tr"
                                        hx-swap="outerHTML swap:1s">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </app-card>
</div>
<div>
    <!-- Alpine Modal for adding/editing customers via htmx -->
    <div class="ant-modal-wrap" x-show="modal.visible" x-transition>
        <div class="ant-modal ant-modal-centered" style="display: block;" x-on:click="if ($event.target === $el) modal.close()">
            <div class="ant-modal-content">
                <div class="ant-modal-header">
                    <div class="ant-modal-title" x-text="modal.title"></div>
                    <button class="ant-modal-close" x-on:click="modal.close()" type="button">
                        <span class="ant-modal-close-x"></span>
                    </button>
                </div>
                <div class="ant-modal-body">
                    <form id="modal-form">
                        <div id="modal-form-content">
                            <!-- Form content loaded via htmx when modal opens -->
                        </div>
                    </form>
                </div>
                <div class="ant-modal-footer">
                    <button class="ant-btn ant-btn-default" x-on:click="modal.close()">Close</button>
                    <button class="ant-btn ant-btn-primary"
                            hx-post="/Customers/FormSubmit"
                            hx-include="#modal-form"
                            hx-target="#modal-form-content"
                            hx-swap="innerHTML"
                            hx-on="htmx:responseError: if(event.detail.xhr.status >= 400) { } else { htmx.ajax('GET', '/Customers/GetTableBody', '#table-body'); modal.close(); }">
                        Save
                    </button>
                </div>
            </div>
        </div>
        <div class="ant-modal-mask" x-transition x-transition.opacity></div>
    </div>
</div>

<style>
    .customers-container {
        max-width: 1200px;
    }

    .mt-24 { margin-top: 24px; }

    .ant-icon {
        margin-right: 4px;
    }

    .ant-form-item-required::before {
        content: "* ";
        color: #ff7875;
    }
</style>

@section Scripts {
    <script type="module">
        import { ModulusAlpine } from '/lib/modulus-alpine.js';

        document.addEventListener('alpine:init', () => {
            const originalModal = ModulusAlpine.modal;

            // Extended modal with htmx integration
            Alpine.data('modal', () => {
                const data = originalModal();
                const originalOpen = data.open;

                data.open = function(title = 'Modal', customerId = null) {
                    originalOpen.call(this, title);

                    // Load form content via htmx
                    const url = customerId ? `/Customers/FormPartial?id=${customerId}` : '/Customers/FormPartial';
                    htmx.ajax('GET', url, '#modal-form-content');
                };

                return data;
            });
        });

        // Override the "Add Customer" button click to load form
        document.addEventListener('DOMContentLoaded', () => {
            const addBtn = document.querySelector('[x-on\\:click="modal.open(\'Add Customer\')"]');
            if (addBtn) {
                addBtn.addEventListener('click', (e) => {
                    Alpine.evaluate(addBtn, "modal.open('Add Customer')");
                });
            }
        });
    </script>
}

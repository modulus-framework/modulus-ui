<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Modulus Admin</title>
    <link rel="stylesheet" href="~/css/modulus-professional.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .admin-shell { background-color: #f0f2f5; }
        .admin-header {
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
        }
        .admin-header .logo {
            margin: 0;
            letter-spacing: -0.5px;
        }
        .admin-sider {
            box-shadow: inset -1px 0 0 rgba(255, 255, 255, 0.1);
        }
        .admin-content { background-color: #f0f2f5; }
        .px-24 { padding-left: 24px; padding-right: 24px; }
        .gap-16 { gap: 16px; }
        .d-flex { display: flex; }
    </style>
</head>
<body>
    <div class="admin-shell">
        <header class="admin-header">
            <div class="container-fluid d-flex justify-content-between align-items-center px-24">
                <h1 class="logo mb-0">Modulus</h1>
                <div class="d-flex gap-16">
                    <button class="btn btn-sm btn-outline-light" title="Search"><i class="bi bi-search"></i></button>
                    <button class="btn btn-sm btn-outline-light" title="Notifications"><i class="bi bi-bell"></i></button>
                    <button class="btn btn-sm btn-outline-light" title="User"><i class="bi bi-person"></i></button>
                </div>
            </div>
        </header>

        <div class="admin-body">
            <aside class="admin-sider">
                <nav class="ant-menu ant-menu-dark">
                    <a href="@Url.Action("Dashboard", "Home")" class="ant-menu-item">
                        <span style="display: inline-flex; align-items: center; gap: 8px;">
                            <span style="font-size: 16px;">📊</span>
                            <span>Dashboard</span>
                        </span>
                    </a>
                    <a href="@Url.Action("Analytics", "Dashboard")" class="ant-menu-item">
                        <span style="display: inline-flex; align-items: center; gap: 8px;">
                            <span style="font-size: 16px;">📈</span>
                            <span>Analytics</span>
                        </span>
                    </a>
                    <a href="@Url.Action("Index", "Customers")" class="ant-menu-item">
                        <span style="display: inline-flex; align-items: center; gap: 8px;">
                            <span style="font-size: 16px;">👥</span>
                            <span>Customers</span>
                        </span>
                    </a>
                    <a href="@Url.Action("Index", "Products")" class="ant-menu-item">
                        <span style="display: inline-flex; align-items: center; gap: 8px;">
                            <span style="font-size: 16px;">📦</span>
                            <span>Products</span>
                        </span>
                    </a>
                    <div style="border-top: 1px solid rgba(255, 255, 255, 0.1); margin: 8px 0;"></div>
                    <a href="@Url.Action("Profile", "Home")" class="ant-menu-item">
                        <span style="display: inline-flex; align-items: center; gap: 8px;">
                            <span style="font-size: 16px;">👤</span>
                            <span>Profile</span>
                        </span>
                    </a>
                    <a href="@Url.Action("Settings", "Home")" class="ant-menu-item">
                        <span style="display: inline-flex; align-items: center; gap: 8px;">
                            <span style="font-size: 16px;">⚙️</span>
                            <span>Settings</span>
                        </span>
                    </a>
                </nav>
            </aside>

            <main class="admin-content">
                @RenderBody()
            </main>
        </div>

        <footer class="admin-footer">
            <p class="text-center text-secondary mb-0">© 2026 Modulus. All rights reserved.</p>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script defer src="https://unpkg.com/htmx.org@1.9.10"></script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@{
    ViewData["Title"] = "My Profile";
}

<div style="max-width: 900px;">
    <h1>My Profile</h1>

    <div style="display: flex; gap: 24px; margin-top: 24px;">
        <!-- Profile Card -->
        <div style="width: 300px;">
            <div class="ant-card" style="text-align: center;">
                <div style="padding: 24px 16px;">
                    <div style="width: 100px; height: 100px; background: #1890ff; border-radius: 50%; margin: 0 auto 16px; display: flex; align-items: center; justify-content: center; color: white; font-size: 40px;">
                        👤
                    </div>
                    <h3 style="margin: 0 0 8px 0;">John Doe</h3>
                    <p style="margin: 0; color: #999; font-size: 12px;">Administrator</p>
                </div>
            </div>
        </div>

        <!-- Edit Profile Form -->
        <div style="flex: 1;">
            <div class="ant-card">
                <div style="padding: 24px 16px;">
                    <h3 style="margin: 0 0 16px 0;">Edit Profile</h3>

                    <form>
                        <div style="margin-bottom: 16px;">
                            <label style="display: block; margin-bottom: 8px; font-weight: bold;">Full Name</label>
                            <input type="text" class="ant-input" value="John Doe" />
                        </div>

                        <div style="margin-bottom: 16px;">
                            <label style="display: block; margin-bottom: 8px; font-weight: bold;">Email</label>
                            <input type="email" class="ant-input" value="john@example.com" />
                        </div>

                        <div style="margin-bottom: 16px;">
                            <label style="display: block; margin-bottom: 8px; font-weight: bold;">Phone</label>
                            <input type="tel" class="ant-input" value="+1 555-0101" />
                        </div>

                        <div style="margin-bottom: 16px;">
                            <label style="display: block; margin-bottom: 8px; font-weight: bold;">Department</label>
                            <select class="ant-input">
                                <option selected>Engineering</option>
                                <option>Sales</option>
                                <option>Marketing</option>
                                <option>Operations</option>
                            </select>
                        </div>

                        <div style="margin-bottom: 16px;">
                            <label style="display: block; margin-bottom: 8px; font-weight: bold;">Bio</label>
                            <textarea class="ant-input" style="padding: 8px 11px; font-family: monospace; min-height: 80px;">Senior Software Engineer with 10 years of experience in web development.</textarea>
                        </div>

                        <button type="submit" class="ant-btn ant-btn-primary">Save Changes</button>
                        <button type="button" class="ant-btn" style="margin-left: 8px;">Cancel</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="ant-card" style="margin-top: 24px;">
        <div style="padding: 24px 16px;">
            <h3 style="margin: 0 0 16px 0;">Recent Activity</h3>

            <div style="border-left: 2px solid #1890ff; padding-left: 16px;">
                <div style="margin-bottom: 16px;">
                    <p style="margin: 0; font-weight: bold;">Logged in</p>
                    <p style="margin: 4px 0 0 0; color: #999; font-size: 12px;">Today at 10:30 AM</p>
                </div>

                <div style="margin-bottom: 16px;">
                    <p style="margin: 0; font-weight: bold;">Updated profile</p>
                    <p style="margin: 4px 0 0 0; color: #999; font-size: 12px;">Yesterday at 3:15 PM</p>
                </div>

                <div style="margin-bottom: 16px;">
                    <p style="margin: 0; font-weight: bold;">Exported customer data</p>
                    <p style="margin: 4px 0 0 0; color: #999; font-size: 12px;">2 days ago</p>
                </div>

                <div>
                    <p style="margin: 0; font-weight: bold;">Created 5 new customers</p>
                    <p style="margin: 4px 0 0 0; color: #999; font-size: 12px;">1 week ago</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .ant-card {
        border: 1px solid #d9d9d9;
        border-radius: 4px;
        background: white;
    }

    .ant-input {
        width: 100%;
        padding: 4px 11px;
        border: 1px solid #d9d9d9;
        border-radius: 4px;
        font-size: 14px;
        box-sizing: border-box;
    }

    .ant-btn {
        padding: 4px 16px;
        border: 1px solid #d9d9d9;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
        background: white;
    }

    .ant-btn-primary {
        background: #1890ff;
        color: white;
        border-color: #1890ff;
    }

    .ant-btn-primary:hover {
        background: #40a9ff;
    }
</style>

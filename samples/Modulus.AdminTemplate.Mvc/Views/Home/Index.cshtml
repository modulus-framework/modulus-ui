@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .dashboard-container {
        max-width: 1200px;
    }

    .mb-24 { margin-bottom: 24px; }
    .mb-16 { margin-bottom: 16px; }
    .mt-24 { margin-top: 24px; }

    .stat-card {
        text-align: center;
        padding: 20px 0;
    }

    .stat-value {
        font-size: 32px;
        font-weight: 600;
        color: var(--ant-color-primary);
    }

    .stat-label {
        font-size: 14px;
        color: var(--ant-color-text-secondary);
        margin-top: 8px;
    }

    .ant-card {
        border: 1px solid var(--ant-color-border);
        border-radius: 4px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
        margin-bottom: 16px;
    }

    .ant-card-head-title {
        font-weight: 600;
        padding: 12px 16px;
    }

    .ant-card-body {
        padding: 16px;
    }
</style>

<div class="dashboard-container">
    <h1>Dashboard</h1>
    <p class="text-secondary">Welcome to your admin panel</p>

    <div class="row mt-24 mb-24">
        <div class="col-md-6 col-lg-3 mb-16">
            <div class="ant-card">
                <div class="ant-card-body">
                    <div class="stat-card">
                        <div class="stat-value">1,234</div>
                        <div class="stat-label">Total Customers</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3 mb-16">
            <div class="ant-card">
                <div class="ant-card-body">
                    <div class="stat-card">
                        <div class="stat-value">567</div>
                        <div class="stat-label">Active Orders</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3 mb-16">
            <div class="ant-card">
                <div class="ant-card-body">
                    <div class="stat-card">
                        <div class="stat-value">$45.2K</div>
                        <div class="stat-label">Monthly Revenue</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3 mb-16">
            <div class="ant-card">
                <div class="ant-card-body">
                    <div class="stat-card">
                        <div class="stat-value">89%</div>
                        <div class="stat-label">Conversion Rate</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="ant-card">
        <div class="ant-card-head-title">Recent Activity</div>
        <div class="ant-card-body">
            <p>📊 Sales dashboard updated</p>
            <p>👥 New customer registered</p>
            <p>✅ Order #12345 completed</p>
            <p>⚠️ Inventory low warning</p>
        </div>
    </div>
</div>

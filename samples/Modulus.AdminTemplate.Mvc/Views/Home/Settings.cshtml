@{
    ViewData["Title"] = "Settings";
}

<div style="max-width: 800px;">
    <h1>Settings</h1>

    <div style="margin-top: 24px;">
        <div class="ant-card" style="margin-bottom: 24px;">
            <div style="padding: 16px;">
                <h3 style="margin: 0 0 16px 0;">Theme Settings</h3>

                <div style="margin-bottom: 16px;">
                    <label style="display: block; margin-bottom: 8px;">Color Theme</label>
                    <select class="ant-input" style="padding: 4px 11px;">
                        <option>Blue (Default)</option>
                        <option>Green</option>
                        <option>Purple</option>
                        <option>Orange</option>
                    </select>
                </div>

                <div style="margin-bottom: 16px;">
                    <label style="display: flex; align-items: center; cursor: pointer;">
                        <input type="checkbox" style="margin-right: 8px;" checked />
                        <span>Compact Mode</span>
                    </label>
                </div>

                <div style="margin-bottom: 16px;">
                    <label style="display: flex; align-items: center; cursor: pointer;">
                        <input type="checkbox" style="margin-right: 8px;" />
                        <span>Enable RTL Layout</span>
                    </label>
                </div>

                <button class="ant-btn ant-btn-primary">Save Theme</button>
            </div>
        </div>

        <div class="ant-card" style="margin-bottom: 24px;">
            <div style="padding: 16px;">
                <h3 style="margin: 0 0 16px 0;">Notification Preferences</h3>

                <div style="margin-bottom: 16px;">
                    <label style="display: flex; align-items: center; cursor: pointer;">
                        <input type="checkbox" style="margin-right: 8px;" checked />
                        <span>Email Notifications</span>
                    </label>
                </div>

                <div style="margin-bottom: 16px;">
                    <label style="display: flex; align-items: center; cursor: pointer;">
                        <input type="checkbox" style="margin-right: 8px;" checked />
                        <span>Desktop Notifications</span>
                    </label>
                </div>

                <div style="margin-bottom: 16px;">
                    <label style="display: flex; align-items: center; cursor: pointer;">
                        <input type="checkbox" style="margin-right: 8px;" />
                        <span>SMS Notifications</span>
                    </label>
                </div>

                <button class="ant-btn ant-btn-primary">Save Preferences</button>
            </div>
        </div>

        <div class="ant-card">
            <div style="padding: 16px;">
                <h3 style="margin: 0 0 16px 0;">Danger Zone</h3>
                <p style="margin: 0 0 16px 0; color: #999;">These actions cannot be undone.</p>
                <button class="ant-btn ant-btn-dangerous">Delete Account</button>
            </div>
        </div>
    </div>
</div>

<style>
    .ant-card {
        border: 1px solid #d9d9d9;
        border-radius: 4px;
        background: white;
    }

    .ant-input {
        width: 100%;
        border: 1px solid #d9d9d9;
        border-radius: 4px;
    }

    .ant-btn {
        padding: 4px 16px;
        border: 1px solid #d9d9d9;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
    }

    .ant-btn-primary {
        background: #1890ff;
        color: white;
        border-color: #1890ff;
    }

    .ant-btn-primary:hover {
        background: #40a9ff;
    }

    .ant-btn-dangerous {
        background: #ff4d4f;
        color: white;
        border-color: #ff4d4f;
    }

    .ant-btn-dangerous:hover {
        background: #ff7875;
    }
</style>

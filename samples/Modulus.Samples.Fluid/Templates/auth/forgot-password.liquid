{% comment %} Forgot password for Fluid: email, sent (true after a valid request), antiforgery_token. Posts to /auth/forgot-password. The sample sends no mail. {% endcomment %}

<div class="m-page-header">
    <div class="m-page-header-text"><h1 class="m-page-title">Forgot password</h1></div>
</div>

{% if sent %}
<div class="ant-alert ant-alert-success ant-alert-with-description m-mb-16" role="status">
    <div class="ant-alert-content"><div class="ant-alert-message">If an account exists for that email, a reset link is on its way.</div></div>
</div>
{% endif %}

<div class="m-card">
    <div class="m-card-body">
        <form method="post" action="/auth/forgot-password" class="ant-form ant-form-vertical" novalidate>
            <input type="hidden" name="__RequestVerificationToken" value="{{ antiforgery_token }}" />
            <div class="ant-form-item">
                <div class="ant-form-item-label"><label for="forgot-email">Email</label></div>
                <div class="ant-form-item-control"><input id="forgot-email" type="email" name="email" value="{{ email }}" autocomplete="username" class="ant-input" required /></div>
            </div>
            <div class="m-form-actions m-mt-16">
                <button type="submit" class="ant-btn ant-btn-primary"><span>Send reset link</span></button>
            </div>
        </form>
        <p class="m-mt-16"><a href="/auth/login">Back to sign in</a></p>
    </div>
</div>

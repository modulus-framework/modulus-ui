<header class="m-page-header">
    <p class="m-muted"><a href="/">Invoices</a></p>
    <h1>Invoice {{ invoice.Number }}</h1>
    <p>{{ invoice.ClientCompany }} · {{ invoice.ClientName }} · {{ invoice.ClientEmail }}</p>
    <p>{{ status | status_badge: tone }}</p>
</header>
<div class="m-card">
    <div class="m-card-body">
        <div class="m-liquid-scroll">
            <table class="m-liquid-table">
            <thead><tr><th>Item</th><th>Description</th><th class="m-num">Qty</th><th class="m-num">Cost</th><th class="m-num">Total</th></tr></thead>
            <tbody>
            {% for line in invoice.Lines %}
                <tr>
                    <td>{{ line.Item }}</td>
                    <td>{{ line.Description }}</td>
                    <td class="m-num">{{ line.Qty }}</td>
                    <td class="m-num">{{ line.Cost | money }}</td>
                    <td class="m-num">{{ line.Total | money }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
        <dl class="m-plain-list" style="margin-top: 16px;">
            <li><span class="m-muted">Subtotal</span><span>{{ invoice.Subtotal | money }}</span></li>
            <li><span class="m-muted">Discount</span><span>{{ invoice.Discount | money }}</span></li>
            <li><span class="m-muted">Tax</span><span>{{ invoice.Tax | money }}</span></li>
            <li><span class="m-muted">Total</span><span>{{ invoice.Total | money }}</span></li>
            <li><span class="m-muted">Balance</span><span>{{ invoice.Balance | money }}</span></li>
        </dl>
        <p style="margin-top: 16px;">{% icon "file-text" %} Reference <span>{% barcode invoice.Number %}</span></p>
    </div>
</div>

@page "/customers" 
@using AntDesign
@using Modulus.Blazor.Components.General
@using Modulus.Blazor.Components.Layout
@using Modulus.Blazor.Components.DataDisplay
@using Modulus.Blazor.Components.Navigation
@using Modulus.Blazor.Components.DataEntry
@using Modulus.Blazor.Components.Feedback
@using Modulus.Blazor.Components.Pro
@using Modulus.Ui.Abstractions
@using Modulus.AdminTemplate.Blazor.Models 

<PageTitle>Customers</PageTitle>

<div class="customers-container">
    <AppTypography Variant="title" Level="1">Customers</AppTypography>

    <AppCard Title="Customer List" Class="mt-24">
        <table class="ant-table ant-table-striped" style="width: 100%;">
                <thead>
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>City</th>
                        <th>Status</th>
                        <th style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in customers)
                    {
                        <tr>
                            <td>@customer.Id</td>
                            <td>@customer.Name</td>
                            <td>@customer.Email</td>
                            <td>@customer.Phone</td>
                            <td>@customer.City</td>
                            <td>
                                <span class="@(customer.Status == "active" ? "ant-tag ant-tag-success" : "ant-tag ant-tag-error")">
                                    @(customer.Status == "active" ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                <button class="ant-btn ant-btn-primary ant-btn-sm" @onclick="@(() => HandleEdit(customer))">Edit</button>
                                <button class="ant-btn ant-btn-dangerous ant-btn-sm" style="margin-left: 8px;" @onclick="@(() => HandleDelete(customer))">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
    </AppCard>

    @if (selectedCustomer != null)
    {
        <AppCard Title="Customer Details" Class="mt-24" Bordered="false">
            <p><strong>ID:</strong> @selectedCustomer.Id</p>
            <p><strong>Name:</strong> @selectedCustomer.Name</p>
            <p><strong>Email:</strong> @selectedCustomer.Email</p>
            <p><strong>Phone:</strong> @selectedCustomer.Phone</p>
            <p><strong>City:</strong> @selectedCustomer.City</p>
            <p><strong>Status:</strong> @selectedCustomer.Status</p>
        </AppCard>
    }

    @if (showForm)
    {
        <ModalForm Title="@(isEditMode ? "Edit Customer" : "Add Customer")" Visible="@showForm"
            Model="@formCustomer" Fields="@GetFormFields()"
            OnFormSubmit="@HandleFormSubmit" OnClose="@(() => showForm = false)" />
    }
</div>

<style>
.customers-container {
    max-width: 1200px;
}

.mt-24 { margin-top: 24px; }
</style>

@code {
    private List<Customer> customers = new();
    private Customer? selectedCustomer = null;
    private Customer? formCustomer = null;
    private bool showForm = false;
    private bool isEditMode = false;

    protected override void OnInitialized()
    {
        customers = new()
        {
            new() { Id = 1, Name = "John Doe", Email = "john@example.com", Phone = "+1 555-0101", City = "New York", Status = "active" },
            new() { Id = 2, Name = "Jane Smith", Email = "jane@example.com", Phone = "+1 555-0102", City = "Los Angeles", Status = "active" },
            new() { Id = 3, Name = "Bob Johnson", Email = "bob@example.com", Phone = "+1 555-0103", City = "Chicago", Status = "inactive" },
            new() { Id = 4, Name = "Alice Brown", Email = "alice@example.com", Phone = "+1 555-0104", City = "Houston", Status = "active" },
            new() { Id = 5, Name = "Charlie Wilson", Email = "charlie@example.com", Phone = "+1 555-0105", City = "Phoenix", Status = "active" },
        };
    }


    private void HandleEdit(Customer customer)
    {
        selectedCustomer = customer;
        formCustomer = new Customer
        {
            Id = customer.Id,
            Name = customer.Name,
            Email = customer.Email,
            Phone = customer.Phone,
            City = customer.City,
            Status = customer.Status
        };
        isEditMode = true;
        showForm = true;
    }

    private void HandleDelete(Customer customer)
    {
        customers.RemoveAll(c => c.Id == customer.Id);
        selectedCustomer = null;
    }

    private void HandleAdd()
    {
        formCustomer = new Customer { Status = "active" };
        isEditMode = false;
        showForm = true;
    }

    private async Task HandleFormSubmit(object formData)
    {
        if (formData is Dictionary<string, object?> data)
        {
            if (isEditMode && formCustomer is not null)
            {
                var existing = customers.FirstOrDefault(c => c.Id == formCustomer.Id);
                if (existing is not null)
                {
                    existing.Name = data["Name"]?.ToString() ?? existing.Name;
                    existing.Email = data["Email"]?.ToString() ?? existing.Email;
                    existing.Phone = data["Phone"]?.ToString() ?? existing.Phone;
                    existing.City = data["City"]?.ToString() ?? existing.City;
                }
            }
            else
            {
                var newCustomer = new Customer
                {
                    Id = customers.Max(c => c.Id) + 1,
                    Name = data["Name"]?.ToString() ?? string.Empty,
                    Email = data["Email"]?.ToString() ?? string.Empty,
                    Phone = data["Phone"]?.ToString() ?? string.Empty,
                    City = data["City"]?.ToString() ?? string.Empty,
                    Status = "active"
                };
                customers.Add(newCustomer);
            }
        }
        showForm = false;
        await Task.CompletedTask;
    }

    private List<ProFormField> GetFormFields()
    {
        return new()
        {
            new() { Name = "Name", Label = "Name", FieldType = "text", Required = true, Placeholder = "Enter name" },
            new() { Name = "Email", Label = "Email", FieldType = "email", Required = true, Placeholder = "Enter email" },
            new() { Name = "Phone", Label = "Phone", FieldType = "text", Placeholder = "Enter phone" },
            new() { Name = "City", Label = "City", FieldType = "text", Placeholder = "Enter city" },
        };
    }
}

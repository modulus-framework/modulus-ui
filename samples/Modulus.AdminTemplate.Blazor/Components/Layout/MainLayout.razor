@inherits LayoutComponentBase
@using Modulus.Ui.Abstractions.Shell
@inject IHttpContextAccessor HttpContextAccessor

<AppShell TenantId="@TenantId" TenantIds="@TenantIds">@Body</AppShell>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong. <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss">×</button>
</div>

@code {
    // The tenant switcher writes cookies and reloads. The cookie is read while prerendering and carried into the
    // interactive circuit, which has no HttpContext.
    [PersistentState] public string? TenantId { get; set; }

    [PersistentState] public string? TenantIds { get; set; }

    protected override void OnInitialized()
    {
        var cookies = HttpContextAccessor.HttpContext?.Request.Cookies;
        TenantId ??= cookies?[ShellRenderer.TenantCookie];
        TenantIds ??= cookies?[ShellRenderer.TenantsCookie];
    }
}

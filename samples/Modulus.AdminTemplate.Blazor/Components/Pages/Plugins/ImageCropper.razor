@page "/plugins/image-cropper"
@using Modulus.Ui.Abstractions.Plugins

<PageTitle>Image cropper · Modulus</PageTitle>

<PageHeading Pretitle="Plugins" Title="Image cropper" Subtitle="Cropper.js draws a crop box over the picture. Pick a shape, then drag the box or its corners." />

<div class="m-row-cards m-cols-2">
    <div class="m-card">
        <div class="m-card-header"><div><h3 class="m-card-title">Crop a photo</h3><p class="m-card-subtitle">Free, square, 4:3 or 16:9</p></div></div>
        <div class="m-card-body">
            <AppImageCropper Id="photo-crop" Src="@PluginsContent.CropPicture" Alt="Alpine lake" Name="crop" Label="Crop the photo"
                             Crop="_crop" CropChanged="OnCrop" />
        </div>
    </div>
    <div class="m-card">
        <div class="m-card-header"><div><h3 class="m-card-title">Using the cropper</h3><p class="m-card-subtitle">What it sends and what it accepts</p></div></div>
        <div class="m-card-body">
            <ul class="m-plain-list">
                <li><span><code>Src</code>: a same-site path, an http(s) address or an image data URI. Other addresses are refused.</span></li>
                <li><span><code>Ratio</code>: the starting shape: <code>free</code>, <code>1</code>, <code>4/3</code> or <code>16/9</code>.</span></li>
                <li><span><code>Crop</code> and <code>CropChanged</code>: the crop in the photo's own pixels, as a <code>CropBox</code>.</span></li>
            </ul>
            <p class="m-muted">Last crop: @(_crop is { } c ? $"{c.Width} × {c.Height} px from {c.X}, {c.Y}" : "none yet")</p>
        </div>
    </div>
</div>

@code {
    private CropBox? _crop;

    private void OnCrop(CropBox? crop) => _crop = crop;
}

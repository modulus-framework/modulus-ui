@page "/auth/reset-password"
@layout AuthLayout
@inject NavigationManager Navigation

<PageTitle>Reset password · Modulus</PageTitle>

<div class="m-auth-card">
    <div class="m-auth-card-body">
        <h1 class="m-auth-title">Reset password</h1>
        <p class="m-auth-lead">Your new password must be different from previously used passwords.</p>
        <Form Model="_model" Layout="@FormLayout.Vertical" OnFinish="ResetAsync" RequiredMark="FormRequiredMark.None">
            <FormItem Label="New password">
                <InputPassword @bind-Value="context.Password" Placeholder="At least 8 characters" Prefix="@_lock" />
            </FormItem>
            <FormItem Label="Confirm password">
                <InputPassword @bind-Value="context.Confirm" Placeholder="Repeat the password" Prefix="@_lock" />
            </FormItem>
            <div class="m-auth-actions">
                <Button Type="@ButtonType.Primary" HtmlType="submit" Block Loading="_busy">Set new password</Button>
            </div>
        </Form>
    </div>
</div>
<div class="m-auth-foot"><a href="/auth/login">Back to sign in</a></div>

@code {
    private readonly ResetPasswordInput _model = new();
    private bool _busy;
    private readonly RenderFragment _lock = @<Icon Type="lock" />;

    private async Task ResetAsync()
    {
        _busy = true;
        await Task.Delay(400);
        Navigation.NavigateTo("/auth/login?reset=1");
    }
}

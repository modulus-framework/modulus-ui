@page "/auth/login"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout AuthLayout
@inject IJSRuntime JS

<PageTitle>Sign in · Modulus</PageTitle>

@if (Reset)
{
    <Alert Type="@AlertType.Success" ShowIcon="true" Message="Your password has been reset. Sign in with your new password." Class="m-mb-16" />
}
@if (Error)
{
    <Alert Type="@AlertType.Error" ShowIcon="true" Message="@SampleAuth.WrongCredentials" Class="m-mb-16" />
}
<div class="m-auth-card">
    <div class="m-auth-card-body">
        <h1 class="m-auth-title">Login to your account</h1>
        <p class="m-auth-hint">Sample account: <strong>serena.park@@modulus.dev</strong>, password <strong>modulus</strong>.</p>
        <Form Model="_model" Layout="@FormLayout.Vertical" OnFinish="SignInAsync" RequiredMark="FormRequiredMark.None">
            <FormItem Label="Email address">
                <Input @bind-Value="context.Email" Placeholder="your@email.com" Prefix="@_mail" />
            </FormItem>
            <FormItem Label="Password">
                <InputPassword @bind-Value="context.Password" Placeholder="Your password" Prefix="@_lock" />
            </FormItem>
            <div class="m-flex m-between">
                <Checkbox Checked="context.Remember" CheckedChanged="v => context.Remember = v">Remember me on this device</Checkbox>
                <a href="/auth/forgot-password" class="m-small">I forgot password</a>
            </div>
            <div class="m-auth-actions">
                <Button Type="@ButtonType.Primary" HtmlType="submit" Block Loading="_busy">Sign in</Button>
            </div>
        </Form>
        @* AntD validates above; this native form then posts the values to /auth/sign-in, which sets the cookie. *@
        <form @ref="_post" method="post" action="@PostUrl" hidden>
            <AntiforgeryToken />
            <input type="hidden" name="Email" value="@_model.Email" />
            <input type="hidden" name="Password" value="@_model.Password" />
            <input type="hidden" name="Remember" value="@(_model.Remember ? "true" : "false")" />
        </form>
    </div>
    <div class="m-hr-text"><span>or</span></div>
    <div class="m-auth-card-body">
        <div class="m-social">
            <a class="ant-btn ant-btn-default" href="/"><Ti Name="github" /><span>GitHub</span></a>
            <a class="ant-btn ant-btn-default" href="/"><Ti Name="google" /><span>Google</span></a>
        </div>
    </div>
</div>
<div class="m-auth-foot">Don't have account yet? <a href="/auth/register">Sign up</a></div>

@code {
    [SupplyParameterFromQuery] public bool Reset { get; set; }
    [SupplyParameterFromQuery] public bool Error { get; set; }
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private readonly LoginInput _model = new();
    private ElementReference _post;
    private bool _busy;

    private string PostUrl => "/auth/sign-in" + (string.IsNullOrEmpty(ReturnUrl) ? "" : "?returnUrl=" + Uri.EscapeDataString(ReturnUrl));

    protected override void OnInitialized() => _model.Email = Email ?? "";
    private readonly RenderFragment _mail = @<Icon Type="mail" />;
    private readonly RenderFragment _lock = @<Icon Type="lock" />;

    private async Task SignInAsync()
    {
        _busy = true;
        StateHasChanged(); // the hidden inputs carry the values the form just validated
        await Task.Yield();
        await JS.InvokeVoidAsync("modulusShell.submit", _post);
    }
}

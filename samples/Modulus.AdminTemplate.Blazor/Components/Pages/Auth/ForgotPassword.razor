@page "/auth/forgot-password"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout AuthLayout

<PageTitle>Forgot password · Modulus</PageTitle>

<div class="m-auth-card">
    <div class="m-auth-card-body">
        @if (_sent)
        {
            <span class="m-auth-icon m-bg-success-lt m-text-success"><Ti Name="ri:mail-send" /></span>
            <h1 class="m-auth-title">Check your inbox</h1>
            <p class="m-auth-lead">We sent a reset link to <strong>@_model.Email</strong>. It expires in 30 minutes.</p>
            <a class="ant-btn ant-btn-primary ant-btn-block" href="/auth/reset-password"><span>Open reset link</span></a>
        }
        else
        {
            <h1 class="m-auth-title">Forgot password</h1>
            <p class="m-auth-lead">Enter your email address and we'll send you a link to reset your password.</p>
            <Form Model="_model" Layout="@FormLayout.Vertical" OnFinish="SendAsync" RequiredMark="FormRequiredMark.None">
                <FormItem Label="Email address">
                    <Input @bind-Value="context.Email" Placeholder="your@email.com" Prefix="@_mail" />
                </FormItem>
                <div class="m-auth-actions">
                    <Button Type="@ButtonType.Primary" HtmlType="submit" Block Loading="_busy"><Ti Name="mail" /><span>Send me the reset link</span></Button>
                </div>
            </Form>
        }
    </div>
</div>
<div class="m-auth-foot">Forget it, <a href="/auth/login">send me back</a> to the sign in screen.</div>

@code {
    private readonly ForgotPasswordInput _model = new();
    private bool _busy, _sent;
    private readonly RenderFragment _mail = @<Icon Type="mail" />;

    private async Task SendAsync()
    {
        _busy = true;
        await Task.Delay(400);
        _busy = false;
        _sent = true;
    }
}

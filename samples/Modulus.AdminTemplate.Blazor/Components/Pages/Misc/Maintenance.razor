@page "/misc/maintenance"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout AuthLayout

<PageTitle>Maintenance · Modulus</PageTitle>

<div class="m-status-page">
    <span class="m-status-art m-bg-warning-lt m-text-warning"><Ti Name="tools" /></span>
    <h1 class="m-status-title">Temporarily down for maintenance</h1>
    <p class="m-status-text">We're performing scheduled maintenance and will be back online shortly. Thank you for your patience.</p>
    <div class="m-status-actions">
        <a class="ant-btn ant-btn-default" href="/pages/help-center"><Ti Name="lifebuoy" /><span>Status page</span></a>
        <a class="ant-btn ant-btn-primary" href="/"><Ti Name="refresh" /><span>Try again</span></a>
    </div>
</div>

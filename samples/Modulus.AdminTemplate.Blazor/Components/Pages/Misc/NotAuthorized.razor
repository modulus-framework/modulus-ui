@page "/misc/not-authorized"
@page "/forbidden"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout AuthLayout

<PageTitle>Not authorized · Modulus</PageTitle>

<div class="m-status-page">
    <div class="m-status-code">403</div>
    <h1 class="m-status-title">You are not authorized</h1>
    <p class="m-status-text">You don't have permission to access this page. Ask an administrator for access, or sign in with a different account.</p>
    <div class="m-status-actions">
        <a class="ant-btn ant-btn-default" href="/auth/login"><Ti Name="login" /><span>Sign in</span></a>
        <a class="ant-btn ant-btn-primary" href="/"><Ti Name="arrow-left" /><span>Take me home</span></a>
    </div>
</div>

@page "/tables/advanced"

@inject IMessageService Message

<PageTitle>Data table · Modulus</PageTitle>

@* Data table: search, filters, sorting, row drag and drop, paging, column picker, density, selection and CSV export (/tables/advanced/export,
   mapped in Program.cs). MVC and Razor Pages render the same page from Samples.Web Views/Shared/Ui/Tables/Advanced.cshtml. *@
<PageHeading Pretitle="Tables" Title="Data table" Subtitle="Search, filter, sort, page, pick columns and export to CSV." />

@* Rows drag by their handle to a new place (not while a column sort is on); EmployeeDirectory keeps the order.
   The search, filters, hidden columns, sort, column searches and page are in the URL (UrlState), with the MVC page's
   keys, so the Views dropdown saves the layout and back and forward step through it. Shift+click on a header adds a
   sort (MultiSort), and Group by groups the rows by department, office or status with payroll subtotals. *@
<ProTable TItem="Employee" @ref="_table" HeaderTitle="Employees" Request="LoadAsync" RowKey="e => e.Id" Selectable ScrollX="1140" FilterRow ColumnSettings="false" Exportable="false"
          OnRowMove="MoveRow" RowLabel="e => e.Name" UrlState UrlQuery="PageQuery" OnUrlChanged="ReadQuery" MultiSort
          GroupFields="EmployeeDirectory.GroupFields">
    <TitleExtra>
        <span class="m-badge m-badge-gray-lt">@_summary.Count</span>
        <span class="m-small m-muted m-medium" style="font-weight:400">avg. salary @Fmt.Money0(_summary.AverageSalary)</span>
    </TitleExtra>
    <ToolBar>
        @* The user's saved layouts of this table (Odoo's favourites); a starred one opens by default. *@
        <AppSavedViews Page="/tables/advanced" Id="employee-views" />
        <Input @bind-Value="_keyword" Placeholder="Search name, email, position…" AllowClear Class="m-table-toolbar-search" OnPressEnter="SearchAsync" OnClear="SearchAsync" Prefix="@_searchIcon" />
        <Dropdown Trigger="@(new[] { Trigger.Click })" Placement="Placement.BottomRight">
            <Overlay>
                <Menu Selectable="false">
                    @foreach (var (key, title) in EmployeeDirectory.OptionalColumns)
                    {
                        <MenuItem Key="@key" OnClick="() => ToggleColumn(key)">
                            <span class="m-column-toggle"><Icon Type="@(Shows(key) ? "check-square" : "border")" Theme="@(Shows(key) ? IconThemeType.Fill : IconThemeType.Outline)" />@title</span>
                        </MenuItem>
                    }
                </Menu>
            </Overlay>
            <ChildContent>
                <button type="button" class="ant-btn ant-btn-default m-table-columns-toggle" title="Show or hide columns"><Icon Type="setting" /><span>Columns</span></button>
            </ChildContent>
        </Dropdown>
        <a class="ant-btn ant-btn-default m-table-export" href="@ExportUrl()" title="Export the rows (after search and filters) to a CSV file" download><Icon Type="download" /><span>Export CSV</span></a>
    </ToolBar>
    <Filters>
        <Select TItemValue="string" TItem="string" Value="_department" ValueChanged="v => FilterAsync(() => _department = v)" DataSource="EmployeeDirectory.Departments" Placeholder="All departments" AllowClear />
        <Select TItemValue="string" TItem="string" Value="_office" ValueChanged="v => FilterAsync(() => _office = v)" DataSource="EmployeeDirectory.Offices" Placeholder="All offices" AllowClear />
        <Select TItemValue="EmployeeStatus?" TItem="string" Value="_status" ValueChanged="v => FilterAsync(() => _status = v)" Placeholder="Any status" AllowClear>
            <SelectOptions>
                @foreach (var s in Enum.GetValues<EmployeeStatus>())
                {
                    <SelectOption TItemValue="EmployeeStatus?" TItem="string" Value="s" Label="@EmployeeDirectory.StatusLabel(s)" />
                }
            </SelectOptions>
        </Select>
        <AppCreatableSelect Options="EmployeeLabels.Options" Value="@_label" ValueChanged="v => FilterAsync(() => _label = v)" OnAdd="AddLabelAsync"
                            Placeholder="Any label" AddPlaceholder="Label name" CreateText="Create new label" AllowClear AriaLabel="Label" />
        @if (Filtered)
        {
            <button type="button" class="ant-btn ant-btn-link" @onclick="ClearFiltersAsync"><span>Clear filters</span></button>
        }
    </Filters>
    <BatchActions Context="rows">
        <AppCreatableSelect Options="EmployeeLabels.Options" ValueChanged="v => ApplyLabelAsync(rows, v)" OnAdd="AddLabelAsync" Size="small"
                            Placeholder="Add label…" AddPlaceholder="Label name" CreateText="Create new label" AriaLabel="Add a label to the selected employees" Style="width: 160px" />
        <a class="ant-btn ant-btn-primary ant-btn-sm" href="@ExportUrl(rows.Select(r => r.Id))" download><span>Export selected</span></a>
    </BatchActions>
    <RowDetail Context="e">
        <div class="m-row-detail">
            <div class="m-entity">
                <span class="m-avatar m-av-@e.Tint" style="width: 48px; height: 48px; font-size: 16px">@Fmt.Initials(e.Name)</span>
                <div class="m-entity-text"><span class="m-entity-title">@e.Name</span><span class="m-entity-desc">@e.Position · @e.Department</span></div>
            </div>
            <Descriptions Size="DescriptionsSize.Small" Column="@DetailColumns">
                @foreach (var (label, value) in EmployeeDirectory.Details(e))
                {
                    <DescriptionsItem Title="@label">@value</DescriptionsItem>
                }
            </Descriptions>
        </div>
    </RowDetail>
    @* Optional columns are hidden rather than removed, so toggling one keeps the table's sort state. *@
    <Columns Context="row">
        @* Every header sorts and has a column search (ColumnHeader), as in the MVC table and the grids. *@
        <PropertyColumn Property="e => e.Name" Width="260" Class="@SortClass(nameof(Employee.Name))">
            <TitleTemplate><ColumnHeader Key="@nameof(Employee.Name)" Title="Employee" /></TitleTemplate>
            <ChildContent>
                <div class="m-entity">
                    <span class="m-avatar m-avatar-sm m-av-@row.Tint">@Fmt.Initials(row.Name)</span>
                    <div class="m-entity-text"><span class="m-entity-title">@row.Name@LabelTags(row.Id)</span><span class="m-entity-desc">@row.Email</span></div>
                </div>
            </ChildContent>
        </PropertyColumn>
        <PropertyColumn Hidden="@(!Shows("position"))" Property="e => e.Position" Width="190" Class="@SortClass(nameof(Employee.Position))">
            <TitleTemplate><ColumnHeader Key="@nameof(Employee.Position)" Title="Position" /></TitleTemplate>
            <ChildContent>@row.Position</ChildContent>
        </PropertyColumn>
        <PropertyColumn Hidden="@(!Shows("department"))" Property="e => e.Department" Width="150" Class="@SortClass(nameof(Employee.Department))">
            <TitleTemplate><ColumnHeader Key="@nameof(Employee.Department)" Title="Department" /></TitleTemplate>
            <ChildContent>@row.Department</ChildContent>
        </PropertyColumn>
        <PropertyColumn Hidden="@(!Shows("office"))" Property="e => e.Office" Width="150" Class="@SortClass(nameof(Employee.Office))">
            <TitleTemplate><ColumnHeader Key="@nameof(Employee.Office)" Title="Office" /></TitleTemplate>
            <ChildContent><span class="m-flex m-gap-6"><Icon Type="@(row.Office == "Remote" ? "home" : "environment")" />@row.Office</span></ChildContent>
        </PropertyColumn>
        <PropertyColumn Hidden="@(!Shows("start"))" Property="e => e.StartDate" Width="130" Class="@($"m-muted{SortClass(nameof(Employee.StartDate))}")">
            <TitleTemplate><ColumnHeader Key="@nameof(Employee.StartDate)" Title="Start date" Kind="ColumnKind.Date" /></TitleTemplate>
            <ChildContent>@Fmt.Date(row.StartDate)</ChildContent>
        </PropertyColumn>
        <PropertyColumn Hidden="@(!Shows("salary"))" Property="e => e.Salary" Width="120" Align="ColumnAlign.Right" Class="@SortClass(nameof(Employee.Salary))">
            <TitleTemplate><ColumnHeader Key="@nameof(Employee.Salary)" Title="Salary" Kind="ColumnKind.Number" /></TitleTemplate>
            <ChildContent><span class="m-num m-heading">@Fmt.Money0(row.Salary)</span></ChildContent>
        </PropertyColumn>
        <PropertyColumn Property="e => e.Status" Width="120" Class="@SortClass(nameof(Employee.Status))">
            <TitleTemplate><ColumnHeader Key="@nameof(Employee.Status)" Title="Status" /></TitleTemplate>
            <ChildContent><span class="m-badge @EmployeeDirectory.StatusBadge(row.Status)">@EmployeeDirectory.StatusLabel(row.Status)</span></ChildContent>
        </PropertyColumn>
    </Columns>
</ProTable>

@code {
    private ProTable<Employee>? _table;
    private string? _keyword, _department, _office, _label;
    private EmployeeStatus? _status;
    private HashSet<string> _hidden = [];
    private (int Count, decimal AverageSalary) _summary = EmployeeDirectory.Summary(new());
    private readonly RenderFragment _searchIcon = @<Icon Type="search" />;
    private static readonly Dictionary<string, int> DetailColumns = new() { ["xxl"] = 4, ["xl"] = 4, ["lg"] = 2, ["md"] = 2, ["sm"] = 1, ["xs"] = 1 };

    private EmployeeQuery Query => new(_keyword, _department, _office, _status, _label);

    private bool Filtered => !string.IsNullOrEmpty(_keyword) || _department is not null || _office is not null || _status is not null || _label is not null || _table?.Searches is not null;

    // The sorted column's cells are tinted, as Ant Design does.
    private string SortClass(string field) => _table?.SortOf(field) is null or Modulus.Ui.Abstractions.SortDirection.None ? "" : " ant-table-column-sort";

    private bool Shows(string column) => !_hidden.Contains(column);

    private Task<ProTableResponse<Employee>> LoadAsync(ProTableRequest request)
    {
        var query = Query with { Searches = request.Searches };
        _summary = EmployeeDirectory.Summary(query);
        return Task.FromResult(EmployeeDirectory.Query(query, request));
    }

    private static void MoveRow(Modulus.Ui.Abstractions.Plugins.RowMove move) => EmployeeDirectory.Reorder(move.Order);

    private void ToggleColumn(string key)
    {
        _hidden = EmployeeDirectory.ParseHidden(EmployeeDirectory.ToggleHidden(_hidden, key));
        _table?.SyncUrl();
    }

    // The page's own keys in the URL, as the MVC page names them.
    private IEnumerable<KeyValuePair<string, string?>> PageQuery()
    {
        yield return new("keyword", _keyword);
        yield return new("department", _department);
        yield return new("office", _office);
        yield return new("status", _status?.ToString());
        yield return new("label", _label);
        yield return new("hide", _hidden.Count == 0 ? null : string.Join(',', _hidden));
    }

    private void ReadQuery(IReadOnlyList<KeyValuePair<string, string?>> query)
    {
        string? Value(string key) => query.LastOrDefault(q => q.Key == key).Value is { Length: > 0 } v ? v : null;
        _keyword = Value("keyword");
        _department = Value("department");
        _office = Value("office");
        _status = Enum.TryParse<EmployeeStatus>(Value("status"), out var status) ? status : null;
        _label = Value("label");
        _hidden = EmployeeDirectory.ParseHidden(Value("hide"));
    }

    private string ExportUrl(IEnumerable<int>? ids = null)
    {
        var query = new List<KeyValuePair<string, string?>>();
        if (ids is not null) query.AddRange(ids.Select(id => new KeyValuePair<string, string?>("ids", id.ToString())));
        else
        {
            if (!string.IsNullOrEmpty(_keyword)) query.Add(new("keyword", _keyword));
            if (_department is not null) query.Add(new("department", _department));
            if (_office is not null) query.Add(new("office", _office));
            if (_status is { } s) query.Add(new("status", s.ToString()));
            if (_label is not null) query.Add(new("label", _label));
            foreach (var (field, search) in _table?.Searches ?? new Dictionary<string, string?>()) query.Add(new(ColumnSearch.Prefix + field, search));
        }
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/tables/advanced/export", query);
    }

    private Task SearchAsync() => _table!.ReloadAsync(resetPage: true);

    // Labels are shared by the filter and the batch bar, so a label added in either shows up in both.
    private static Task<(GridOption? Added, string? Error)> AddLabelAsync(string label, string color) =>
        Task.FromResult(EmployeeLabels.Add(label, color));

    private async Task ApplyLabelAsync(IReadOnlyList<Employee> rows, string? value)
    {
        if (value is null || EmployeeLabels.Find(value) is not { } label) return;
        var count = EmployeeLabels.Apply(rows.Select(r => r.Id), value);
        await _table!.ReloadAsync();
        _ = Message.SuccessAsync(count == 0 ? $"Everyone selected already has “{label.Label}”" : $"Added “{label.Label}” to {count} {(count == 1 ? "employee" : "employees")}");
    }

    private static RenderFragment LabelTags(int id) => __builder =>
    {
        foreach (var value in EmployeeLabels.Of(id))
        {
            if (EmployeeLabels.Find(value) is { } label)
            {
                <span class="@($"ant-tag ant-tag-{label.Color} m-label-tag")">@label.Label</span>
            }
        }
    };

    private async Task FilterAsync(Action set)
    {
        set();
        await _table!.ReloadAsync(resetPage: true);
    }

    private async Task ClearFiltersAsync()
    {
        (_keyword, _department, _office, _status, _label) = (null, null, null, null, null);
        await _table!.ClearSearchesAsync();
    }
}

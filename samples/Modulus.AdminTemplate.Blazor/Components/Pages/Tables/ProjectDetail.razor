@* The expanded row of the editable grid: the notes, budget use, and every field (hidden columns included). *@
<div class="m-grid-detail">
    <div>
        <h4>@(Row["project"] ?? "New project")</h4>
        <p>@(string.IsNullOrEmpty(Row["notes"]) ? "No notes yet." : Row["notes"])</p>
        @if (ProjectGridStore.BurnRate(Row) is { } burn)
        {
            <div style="margin-top: 12px">
                <span class="m-small m-muted">Budget used</span>
                <Progress Percent="(double)Math.Min(burn, 100)" Size="ProgressSize.Small" Status="@(burn > 100 ? ProgressStatus.Exception : ProgressStatus.Normal)"
                          Format="@(_ => $"{burn:0}%")" />
            </div>
        }
    </div>
    <Descriptions Size="DescriptionsSize.Small" Column="@(new Dictionary<string, int> { ["xxl"] = 3, ["xl"] = 3, ["lg"] = 2, ["md"] = 2, ["sm"] = 1, ["xs"] = 1 })">
        @foreach (var c in Columns.Where(c => c.Key is not ("project" or "notes")))
        {
            <DescriptionsItem Title="@c.Title">@(GridSchema.Format(c, Row[c.Key]) is { Length: > 0 } text ? text : "—")</DescriptionsItem>
        }
    </Descriptions>
</div>

@code {
    [Parameter, EditorRequired] public GridRecord Row { get; set; } = default!;

    [Parameter, EditorRequired] public IReadOnlyList<GridColumn> Columns { get; set; } = [];
}

@page "/tables/ask"
@using Modulus.Samples.Shared
@using Modulus.Ui.Abstractions.Chat
@using Modulus.Ui.Abstractions.Language

<PageTitle>Ask your data · Modulus</PageTitle>

@* Ask your data: a question becomes a filter on the shipments (the same one the query builder makes), and the rows it leaves are
   listed below. The MVC and Razor Pages samples post the same questions to /tables/ask (Views/Shared/Ui/Tables/Ask.cshtml). *@
<PageHeading Pretitle="Tables" Title="Ask your data" Subtitle="Ask in plain words. The answer is a filter on the shipments, the same one the query builder would make, and the rows it leaves are listed below." />

<div class="m-card">
    <div class="m-card-body">
        <AppChat Turns="_view.Turns" OnAsk="AskAsync" Busy="_busy" Placeholder="@AskView.Examples" Label="Your question" Button="Ask" />
    </div>
</div>

<div class="m-query-summary">
    <span class="m-badge m-badge-gray-lt">@_view.Results.Matches.ToString("N0")</span>
    <span>shipments match</span>
    <span class="m-muted">· @_view.Results.Sentence</span>
    <span class="m-query-total">Total <strong>@_view.Results.Total.ToString("N2")</strong></span>
</div>

<div class="m-card">
    <table class="ant-table m-query-table" aria-label="Shipments that match the question">
        <thead class="ant-table-thead">
            <tr>
                <th class="ant-table-cell">Reference</th>
                <th class="ant-table-cell">Customer</th>
                <th class="ant-table-cell">City</th>
                <th class="ant-table-cell">Status</th>
                <th class="ant-table-cell" style="text-align: right;">Amount</th>
                <th class="ant-table-cell">Date</th>
            </tr>
        </thead>
        <tbody class="ant-table-tbody">
            @foreach (var s in _view.Results.Rows)
            {
                <tr class="ant-table-row">
                    <td class="ant-table-cell">@s.Reference</td>
                    <td class="ant-table-cell">@s.Customer</td>
                    <td class="ant-table-cell">@s.City</td>
                    <td class="ant-table-cell">@s.Status</td>
                    <td class="ant-table-cell" style="text-align: right;">@s.Amount.ToString("N2")</td>
                    <td class="ant-table-cell">@s.Date.ToString("yyyy-MM-dd")</td>
                </tr>
            }
            @if (_view.Results.Rows.Count == 0)
            {
                <tr class="ant-table-placeholder"><td class="ant-table-cell" colspan="6">No shipments match this question.</td></tr>
            }
        </tbody>
    </table>
    @if (_view.Results.Matches > _view.Results.Rows.Count)
    {
        <div class="m-muted m-query-more">Showing the first @_view.Results.Rows.Count of @_view.Results.Matches.ToString("N0") rows.</div>
    }
</div>

@code {
    private static readonly ILanguageModel Model = AskPage.Model();
    private AskView _view = null!;
    private bool _busy;

    protected override async Task OnInitializedAsync() => _view = await AskPage.AskAsync(null, null, null, Model);

    private async Task AskAsync(string question)
    {
        _busy = true;
        try
        {
            _view = await AskPage.AskAsync(_view.Transcript, _view.Filter, question, Model);
        }
        finally
        {
            _busy = false;
        }
    }
}

@page "/dashboards/erp"

<PageTitle>ERP analytics · Modulus</PageTitle>

@* Finance, sales, receivables, inventory and operations on one page, built from the business charts. MVC and Razor Pages render the same page from Samples.Web Views/Shared/Ui/Dashboards/Erp.cshtml. *@
<PageHeading Pretitle="Dashboards" Title="ERP analytics" Subtitle="Fiscal year 2026 · all entities · figures in USD">
    <Actions>
        <a class="ant-btn" href="/ui/charts"><Ti Name="pie-chart" /><span>All charts</span></a>
        <a class="ant-btn ant-btn-primary" href="/apps/invoice/list"><Ti Name="file-text" /><span>Open invoices</span></a>
    </Actions>
</PageHeading>

<div class="m-row-cards">
    <div class="m-row-cards m-cols-4">
        @foreach (var k in ErpShowcase.Kpis)
        {
            var good = (k.Delta >= 0) != k.LowerIsBetter;
            <div class="m-card">
                <div class="m-card-body">
                    <div class="m-kpi-head">
                        <span class="m-subheader">@k.Label</span>
                        <span class="m-delta @(good ? "m-delta-up" : "m-delta-down")" style="margin-left:auto">
                            @(k.Delta >= 0 ? "+" : "")@k.Delta.ToString("0.0")% <Ti Name="@(k.Delta >= 0 ? "trending-up" : "fall")" />
                        </span>
                    </div>
                    <div class="m-kpi-value"><span class="m-h1">@k.Value</span></div>
                    <div class="m-kpi-foot">@k.Note</div>
                    <div class="m-kpi-chart"><Sparkline Data="k.Trend" AriaLabel="@($"{k.Label} per month")" /></div>
                </div>
            </div>
        }
    </div>

    <div class="m-row-cards m-cols-8-4">
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Revenue against budget</h3><p class="m-card-subtitle">Invoiced revenue per month; the line is the approved budget</p></div>
            </div>
            <div class="m-card-body">
                <ComboChart Labels="ErpShowcase.Months" Columns="ErpShowcase.RevenueActual" Lines="ErpShowcase.RevenueBudget" Prefix="$" Title="Revenue against budget per month" Height="260" />
            </div>
        </div>
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Order to cash</h3><p class="m-card-subtitle">Opportunities surviving each step</p></div>
            </div>
            <div class="m-card-body">
                <FunnelChart Stages="ErpShowcase.OrderToCash" Title="Order-to-cash funnel" />
            </div>
        </div>
    </div>

    <div class="m-row-cards m-cols-3">
        <div class="m-card">
            <div class="m-card-header"><div><h3 class="m-card-title">On time in full</h3><p class="m-card-subtitle">Share of order lines delivered complete and on the promised date</p></div></div>
            <div class="m-card-body"><GaugeChart Value="ErpShowcase.OnTimeInFull" Max="100" Target="ErpShowcase.OnTimeTarget" ValueFormat="N1" Suffix="%" Caption="OTIF, last 90 days" Title="On time in full" /></div>
        </div>
        <div class="m-card">
            <div class="m-card-header"><div><h3 class="m-card-title">Capacity utilization</h3><p class="m-card-subtitle">Machine hours used against hours available</p></div></div>
            <div class="m-card-body"><GaugeChart Value="ErpShowcase.Utilization" Max="100" Target="ErpShowcase.UtilizationTarget" ValueFormat="N1" Suffix="%" Caption="All plants, this month" Title="Capacity utilization" /></div>
        </div>
        <div class="m-card">
            <div class="m-card-header"><div><h3 class="m-card-title">Operating budget used</h3><p class="m-card-subtitle">The target tick marks how much of the year has passed</p></div></div>
            <div class="m-card-body"><GaugeChart Value="ErpShowcase.BudgetConsumed" Max="100" Target="ErpShowcase.BudgetElapsed" ValueFormat="N1" Suffix="%" Caption="Of the annual opex budget" Title="Operating budget used" /></div>
        </div>
    </div>

    <div class="m-card">
        <div class="m-card-header">
            <div><h3 class="m-card-title">Profit bridge</h3><p class="m-card-subtitle">From revenue to net profit, full year</p></div>
        </div>
        <div class="m-card-body">
            <WaterfallChart Steps="ErpShowcase.ProfitBridge" Prefix="$" Title="Profit bridge from revenue to net profit" Height="300" />
        </div>
    </div>
    <div class="m-row-cards m-cols-2">
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Budget variance by department</h3><p class="m-card-subtitle">Spend minus budget, year to date; overspend is unfavorable</p></div>
            </div>
            <div class="m-card-body">
                <VarianceChart Items="ErpShowcase.BudgetVariance" PositiveIsFavorable="false" Prefix="$" Title="Budget variance by department" />
            </div>
        </div>
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Targets</h3><p class="m-card-subtitle">Year to date against plan; grey bands mark poor, fair and good</p></div>
            </div>
            <div class="m-card-body">
                <BulletChart Items="ErpShowcase.Targets" ValueFormat="#,0.#" Title="Key results against targets" />
            </div>
        </div>
    </div>

    <div class="m-row-cards m-cols-2">
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Top customers</h3><p class="m-card-subtitle">Revenue year to date</p></div>
            </div>
            <div class="m-card-body">
                <RankedBarChart Items="ErpShowcase.TopCustomers" Limit="8" ShowShare Prefix="$" Title="Top customers by revenue" />
            </div>
        </div>
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Receivables aging</h3><p class="m-card-subtitle">Open balance per customer by days past due</p></div>
            </div>
            <div class="m-card-body">
                <StackedBarChart Rows="ErpShowcase.AgingCustomers" Series="ErpShowcase.Aging" Normalize Ordinal Prefix="$" Title="Receivables aging by customer" />
            </div>
        </div>
    </div>

    <div class="m-row-cards m-cols-2">
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">ABC analysis</h3><p class="m-card-subtitle">Revenue share per SKU; A items make the first 80 %</p></div>
            </div>
            <div class="m-card-body">
                <ParetoChart Items="ErpShowcase.SkuRevenue" Prefix="$" ValueName="Revenue share" Title="ABC analysis of revenue by SKU" Height="260" MaxXLabels="10" />
            </div>
        </div>
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Inventory value</h3><p class="m-card-subtitle">Stock on hand by category</p></div>
            </div>
            <div class="m-card-body">
                <TreemapChart Items="ErpShowcase.InventoryValue" Prefix="$" Title="Inventory value by category" Height="260" Aspect="2" />
            </div>
        </div>
    </div>

    <div class="m-row-cards m-cols-2">
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Product portfolio</h3><p class="m-card-subtitle">Revenue against gross margin; bubble size is units sold</p></div>
            </div>
            <div class="m-card-body">
                <ScatterChart Points="ErpShowcase.ProductPortfolio" Groups="ErpShowcase.ProductLines" XTitle="Revenue" YTitle="Gross margin (%)" SizeTitle="Units sold" XPrefix="$" ValueFormat="N1" Suffix="%" Quadrants Title="Product portfolio: revenue against gross margin" Height="280" />
            </div>
        </div>
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Sales by region</h3><p class="m-card-subtitle">Revenue year to date by product line</p></div>
            </div>
            <div class="m-card-body">
                <StackedBarChart Rows="ErpShowcase.Regions" Series="ErpShowcase.RegionSales" Prefix="$" Title="Sales by region and product line" />
            </div>
        </div>
    </div>
</div>

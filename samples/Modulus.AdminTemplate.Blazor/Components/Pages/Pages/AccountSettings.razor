@page "/pages/account-settings"
@inject SampleStore Store
@inject IMessageService Message
@inject NavigationManager Navigation

<PageTitle>Account settings · Modulus</PageTitle>

<PageHeading Pretitle="Pages" Title="Account settings" />

<div class="m-card m-card-tabs m-mb-16">
    <nav class="m-tabs-nav" aria-label="Account sections">
        @foreach (var (key, label, icon) in Tabs)
        {
            <a href="/pages/account-settings?tab=@key" aria-current="@(key == Current ? "page" : null)"><Ti Name="@icon" />@label</a>
        }
    </nav>
</div>

@switch (Current)
{
    case "security":
        <div class="m-row-cards">
            <div class="m-card">
                <div class="m-card-header"><div><h2 class="m-card-title">Change password</h2><p class="m-card-subtitle">Use a password you don't use anywhere else</p></div></div>
                <div class="m-card-body">
                    <Form @ref="_passwordForm" Model="_password" Layout="@FormLayout.Vertical" OnFinish="ChangePasswordAsync" RequiredMark="FormRequiredMark.None">
                        <div class="m-form-grid">
                            <FormItem Label="Current password" Class="m-span-2" Style="max-width:calc(50% - 10px)">
                                <InputPassword @bind-Value="context.Current" Placeholder="Current password" />
                            </FormItem>
                            <FormItem Label="New password">
                                <InputPassword @bind-Value="context.New" Placeholder="At least 8 characters" />
                            </FormItem>
                            <FormItem Label="Confirm new password">
                                <InputPassword @bind-Value="context.Confirm" Placeholder="Repeat the new password" />
                            </FormItem>
                        </div>
                        <div class="m-subheader m-mb-8">Password requirements</div>
                        <ul class="m-check-list m-mt-0 m-small">
                            <li><Ti Name="check" /><span>Minimum 8 characters long — the more, the better</span></li>
                            <li><Ti Name="check" /><span>At least one lowercase and one uppercase character</span></li>
                            <li><Ti Name="check" /><span>At least one number</span></li>
                        </ul>
                        <div class="m-form-actions">
                            <Button Type="@ButtonType.Primary" HtmlType="submit">Save changes</Button>
                            <Button OnClick="ResetPassword">Reset</Button>
                        </div>
                    </Form>
                </div>
            </div>

            <div class="m-card">
                <div class="m-card-header"><div><h2 class="m-card-title">Two-step verification</h2><p class="m-card-subtitle">Keep your account secure with an authentication step</p></div></div>
                <div class="m-card-body">
                    <div class="m-flex m-gap-12" style="align-items:flex-start">
                        <span class="m-icon-tile m-tile-@(_twoFactor ? "success" : "gray")-lt"><Ti Name="ri:lock-2" /></span>
                        <div style="flex:1">
                            <div class="m-h3">Two-factor authentication is @(_twoFactor ? "on" : "off")</div>
                            <p class="m-muted m-mt-4 m-mb-0">Two-factor authentication adds an additional layer of security to your account by requiring more than just a password to sign in.</p>
                        </div>
                        <Button Type="@(_twoFactor ? ButtonType.Default : ButtonType.Primary)" Danger="_twoFactor" OnClick="ToggleTwoFactorAsync">@(_twoFactor ? "Disable" : "Enable two-factor")</Button>
                    </div>
                </div>
            </div>

            <div class="m-card">
                <div class="m-card-header"><h2 class="m-card-title">Recent devices</h2></div>
                <div class="ant-table-wrapper m-table-flush">
                    <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                        <table style="table-layout:auto">
                            <thead class="ant-table-thead"><tr><th class="ant-table-cell">Browser</th><th class="ant-table-cell">Device</th><th class="ant-table-cell">Location</th><th class="ant-table-cell">Recent activity</th></tr></thead>
                            <tbody class="ant-table-tbody">
                                @foreach (var d in SampleContent.Devices())
                                {
                                    <tr class="ant-table-row">
                                        <td class="ant-table-cell"><span class="m-flex m-gap-12"><span class="m-icon-tile m-tile-sm m-tile-gray-lt"><Ti Name="@d.Icon" /></span><span class="m-heading m-medium">@d.Browser</span></span></td>
                                        <td class="ant-table-cell m-muted">@d.Device</td>
                                        <td class="ant-table-cell m-muted">@d.Location</td>
                                        <td class="ant-table-cell m-muted">@Fmt.Relative(d.At)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div></div></div>
                </div>
            </div>
        </div>
        break;

    case "billing":
        <div class="m-row-cards">
            <div class="m-card">
                <div class="m-card-header"><h2 class="m-card-title">Current plan</h2></div>
                <div class="m-card-body">
                    <div class="m-row-cards m-cols-2">
                        <div>
                            <div class="m-h3">Your current plan is Standard</div>
                            <p class="m-muted m-mt-4">A simple start for growing teams.</p>
                            <div class="m-h3 m-mt-16">Active until @Fmt.Date(RenewsOn)</div>
                            <p class="m-muted m-mt-4">We will send you a notification upon subscription expiration.</p>
                            <div class="m-h3 m-mt-16">$49 per month <span class="m-badge m-badge-primary-lt">Popular</span></div>
                            <p class="m-muted m-mt-4">Standard plan for small to medium businesses.</p>
                        </div>
                        <div>
                            <div class="ant-alert ant-alert-warning m-mb-16" role="alert"><span class="ant-alert-icon m-text-warning"><Ti Name="warning" /></span><div class="ant-alert-content"><div class="ant-alert-message m-medium">We need your attention!</div><div class="ant-alert-description">Your plan requires an update.</div></div></div>
                            <div class="m-plan-box">
                                <div class="m-flex m-between m-small"><span class="m-medium">Days</span><span class="m-muted">@DaysUsed of 30 days</span></div>
                                <div class="m-progress m-mt-8"><div class="m-progress-bar" style="width:@Fmt.Pct(DaysUsed, 30)%"></div></div>
                                <div class="m-xsmall m-muted m-mt-8">@(30 - DaysUsed) days remaining until your plan requires an update</div>
                            </div>
                        </div>
                    </div>
                    <div class="m-form-actions m-mt-16">
                        <a class="ant-btn ant-btn-primary" href="/pages/pricing"><span>Upgrade plan</span></a>
                        <button type="button" class="ant-btn ant-btn-default ant-btn-dangerous" @onclick="CancelSubscriptionAsync"><span>Cancel subscription</span></button>
                    </div>
                </div>
            </div>

            <div class="m-row-cards m-cols-2">
                <div class="m-card">
                    <div class="m-card-header"><h2 class="m-card-title">Payment methods</h2><div class="m-card-actions"><button type="button" class="ant-btn ant-btn-default ant-btn-sm" @onclick="AddCardAsync"><Ti Name="plus" /><span>Add card</span></button></div></div>
                    <div class="m-card-body">
                        @foreach (var (brand, name, number, expires, primary) in Cards)
                        {
                            <div class="m-pay-method">
                                <span class="m-card-brand"><Ti Name="@brand" /></span>
                                <div class="m-list-item-text"><span class="m-list-item-title">@name @if (primary) { <span class="m-badge m-badge-primary-lt">Primary</span> }</span><span class="m-list-item-sub">•••• @number · Expires @expires</span></div>
                                <button type="button" class="ant-btn ant-btn-default ant-btn-sm" @onclick="EditCardAsync"><span>Edit</span></button>
                            </div>
                        }
                    </div>
                </div>
                <div class="m-card">
                    <div class="m-card-header"><h2 class="m-card-title">Billing address</h2><div class="m-card-actions"><a class="ant-btn ant-btn-default ant-btn-sm" href="/pages/account-settings?tab=account"><Ti Name="edit" /><span>Edit</span></a></div></div>
                    <div class="m-card-body">
                        <dl class="m-dl">
                            <dt>Company</dt><dd>@_account.Organization</dd>
                            <dt>Billing email</dt><dd>@_account.Email</dd>
                            <dt>Tax ID</dt><dd>US 94-8120376</dd>
                            <dt>Address</dt><dd>@_account.Address, @_account.City @_account.Zip</dd>
                            <dt>Country</dt><dd>@_account.Country</dd>
                            <dt>Phone</dt><dd>@_account.Phone</dd>
                        </dl>
                    </div>
                </div>
            </div>

            <div class="m-card">
                <div class="m-card-header"><h2 class="m-card-title">Billing history</h2><div class="m-card-actions"><a class="ant-btn ant-btn-default ant-btn-sm" href="/apps/invoice/list"><span>All invoices</span></a></div></div>
                <div class="ant-table-wrapper m-table-flush">
                    <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                        <table style="table-layout:auto">
                            <thead class="ant-table-thead"><tr><th class="ant-table-cell">Invoice</th><th class="ant-table-cell">Date</th><th class="ant-table-cell">Plan</th><th class="ant-table-cell">Status</th><th class="ant-table-cell" style="text-align:right">Amount</th></tr></thead>
                            <tbody class="ant-table-tbody">
                                @for (var i = 0; i < 5; i++)
                                {
                                    <tr class="ant-table-row">
                                        <td class="ant-table-cell"><span class="m-medium">#@(5021 - i)</span></td>
                                        <td class="ant-table-cell m-muted">@Fmt.Date(RenewsOn.AddMonths(-1 - i))</td>
                                        <td class="ant-table-cell m-muted">Standard · monthly</td>
                                        <td class="ant-table-cell"><span class="m-badge m-badge-success-lt">Paid</span></td>
                                        <td class="ant-table-cell m-num m-heading" style="text-align:right">$49.00</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div></div></div>
                </div>
            </div>
        </div>
        break;

    case "notifications":
        <div class="m-card">
            <div class="m-card-header"><div><h2 class="m-card-title">Notifications</h2><p class="m-card-subtitle">Choose how you want to hear about activity. You need to allow browser notifications for the Browser channel.</p></div></div>
            <div class="ant-table-wrapper m-table-flush m-table-center">
                <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                    <table style="table-layout:auto">
                        <thead class="ant-table-thead"><tr><th class="ant-table-cell">Type</th>@foreach (var ch in NotificationPrefs.Channels){<th class="ant-table-cell">@ch</th>}</tr></thead>
                        <tbody class="ant-table-tbody">
                            @foreach (var ev in NotificationPrefs.Events)
                            {
                                <tr class="ant-table-row">
                                    <td class="ant-table-cell m-heading">@ev</td>
                                    @foreach (var ch in NotificationPrefs.Channels)
                                    {
                                        var key = NotificationPrefs.Key(ev, ch);
                                        <td class="ant-table-cell"><Checkbox Checked="_prefs.Contains(key)" CheckedChanged="on => Toggle(key, on)" aria-label="@($"{ev} by {ch}")" /></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div></div></div>
            </div>
            <div class="m-card-footer m-form-actions">
                <button type="button" class="ant-btn ant-btn-primary" @onclick="SaveNotificationsAsync"><span>Save changes</span></button>
                <button type="button" class="ant-btn ant-btn-default" @onclick="ResetNotifications"><span>Discard</span></button>
            </div>
        </div>
        break;

    case "connections":
        <div class="m-row-cards m-cols-2">
            <div class="m-card">
                <div class="m-card-header"><div><h2 class="m-card-title">Connected accounts</h2><p class="m-card-subtitle">Display content from your connected accounts on your site</p></div></div>
                <div class="m-card-body-flush">
                    @foreach (var app in SampleContent.ConnectedApps)
                    {
                        <div class="m-switch-row">
                            <span class="m-icon-tile m-tile-gray-lt"><Ti Name="@app.Icon" /></span>
                            <div class="m-list-item-text"><span class="m-list-item-title">@app.Name</span><span class="m-list-item-sub">@app.Description</span></div>
                            <Switch Checked="Store.IsAppConnected(app.Name)" CheckedChanged="on => ConnectAsync(app.Name, on)" />
                        </div>
                    }
                </div>
            </div>
            <div class="m-card">
                <div class="m-card-header"><div><h2 class="m-card-title">Social accounts</h2><p class="m-card-subtitle">Sign in faster with a linked account</p></div></div>
                <div class="m-card-body-flush">
                    @foreach (var (icon, name, handle) in Socials)
                    {
                        <div class="m-switch-row">
                            <span class="m-icon-tile m-tile-gray-lt"><Ti Name="@icon" /></span>
                            <div class="m-list-item-text"><span class="m-list-item-title">@name</span><span class="m-list-item-sub">@(handle ?? "Not connected")</span></div>
                            @if (handle is null)
                            {
                                <button type="button" class="ant-btn ant-btn-default ant-btn-sm ant-btn-icon-only" aria-label="Connect @name" @onclick="() => DemoConnectionAsync(name)"><Ti Name="link" /></button>
                            }
                            else
                            {
                                <button type="button" class="ant-btn ant-btn-default ant-btn-sm ant-btn-icon-only ant-btn-dangerous" aria-label="Disconnect @name" @onclick="() => DemoConnectionAsync(name)"><Ti Name="delete" /></button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
        break;

    default:
        <div class="m-row-cards">
            <div class="m-card">
                <div class="m-card-header"><h2 class="m-card-title">Profile details</h2></div>
                <div class="m-card-body">
                    <div class="m-upload-row m-mb-24">
                        <span class="m-avatar m-avatar-xl m-avatar-rounded m-av-1">@Fmt.Initials(CurrentUser.Name)</span>
                        <div>
                            <div class="m-form-actions">
                                <label class="ant-btn ant-btn-primary"><input type="file" accept="image/png,image/jpeg" hidden /><Ti Name="upload" /><span>Upload new photo</span></label>
                                <button type="button" class="ant-btn ant-btn-default"><span>Reset</span></button>
                            </div>
                            <div class="m-small m-muted m-mt-8">Allowed JPG or PNG. Max size of 800 KB.</div>
                        </div>
                    </div>
                    <Form @ref="_accountForm" Model="_account" Layout="@FormLayout.Vertical" OnFinish="SaveAccountAsync" RequiredMark="FormRequiredMark.None">
                        <div class="m-form-grid">
                            <FormItem Label="First name"><Input @bind-Value="context.FirstName" /></FormItem>
                            <FormItem Label="Last name"><Input @bind-Value="context.LastName" /></FormItem>
                            <FormItem Label="Email"><Input @bind-Value="context.Email" /></FormItem>
                            <FormItem Label="Organization"><Input @bind-Value="context.Organization" /></FormItem>
                            <FormItem Label="Phone number"><Input @bind-Value="context.Phone" /></FormItem>
                            <FormItem Label="Address"><Input @bind-Value="context.Address" /></FormItem>
                            <FormItem Label="City"><Input @bind-Value="context.City" /></FormItem>
                            <FormItem Label="Zip code"><Input @bind-Value="context.Zip" /></FormItem>
                            <FormItem Label="Country"><Select TItemValue="string" TItem="string" @bind-Value="context.Country" DataSource="Lookups.Countries" /></FormItem>
                            <FormItem Label="Language"><Select TItemValue="string" TItem="string" @bind-Value="context.Language" DataSource="Lookups.Languages" /></FormItem>
                            <FormItem Label="Time zone"><Select TItemValue="string" TItem="string" @bind-Value="context.TimeZone" DataSource="Lookups.TimeZones" /></FormItem>
                            <FormItem Label="Currency"><Select TItemValue="string" TItem="string" @bind-Value="context.Currency" DataSource="Lookups.Currencies" /></FormItem>
                        </div>
                        <div class="m-form-actions m-mt-8">
                            <Button Type="@ButtonType.Primary" HtmlType="submit">Save changes</Button>
                            <Button OnClick="ResetAccount">Reset</Button>
                        </div>
                    </Form>
                </div>
            </div>

            <div class="m-card m-danger-zone">
                <div class="m-card-header"><h2 class="m-card-title">Delete account</h2></div>
                <div class="m-card-body">
                    <div class="ant-alert ant-alert-warning m-mb-16" role="alert"><span class="ant-alert-icon m-text-warning"><Ti Name="warning" /></span><div class="ant-alert-content"><div class="ant-alert-message m-medium">Are you sure you want to delete your account?</div><div class="ant-alert-description">Once you delete your account, there is no going back. Please be certain.</div></div></div>
                    <Checkbox Checked="_confirmDelete" CheckedChanged="v => _confirmDelete = v">I confirm my account deactivation</Checkbox>
                    <div class="m-mt-16"><button type="button" class="ant-btn ant-btn-primary ant-btn-dangerous" disabled="@(!_confirmDelete)" @onclick="DeactivateAsync"><span>Deactivate account</span></button></div>
                </div>
            </div>
        </div>
        break;
}

@code {
    private static readonly (string Key, string Label, string Icon)[] Tabs =
        [("account", "Account", "user"), ("security", "Security", "lock"), ("billing", "Billing & plans", "account-book"), ("notifications", "Notifications", "bell"), ("connections", "Connections", "link")];

    private static IReadOnlyList<(string Brand, string Name, string Number, string Expires, bool Primary)> Cards => SampleContent.PaymentCards;
    private static IReadOnlyList<(string Icon, string Name, string? Handle)> Socials => SampleContent.SocialAccounts;
    private static DateTime RenewsOn => SampleContent.PlanRenewsOn;
    private static int DaysUsed => SampleContent.PlanDaysUsed;

    [SupplyParameterFromQuery] public string? Tab { get; set; }

    private string Current => Tabs.Any(t => t.Key == Tab) ? Tab! : "account";

    private ProfileSettingsInput _account = new();
    private ChangePasswordInput _password = new();
    private HashSet<string> _prefs = [];
    private bool _twoFactor, _confirmDelete;
    private Form<ProfileSettingsInput>? _accountForm;
    private Form<ChangePasswordInput>? _passwordForm;

    protected override void OnInitialized()
    {
        _account = Store.Account();
        _prefs = Store.Notifications().Enabled;
        _twoFactor = Store.TwoFactorEnabled;
    }

    private async Task SaveAccountAsync()
    {
        Store.SaveAccount(_account);
        await Message.SuccessAsync("Profile details saved");
    }

    private void ResetAccount() => _account = Store.Account();

    private async Task ChangePasswordAsync()
    {
        _password = new();
        await Message.SuccessAsync("Password changed");
    }

    private void ResetPassword() => _password = new();

    private async Task ToggleTwoFactorAsync()
    {
        _twoFactor = Store.TwoFactorEnabled = !_twoFactor;
        await Message.SuccessAsync(_twoFactor ? "Two-factor authentication enabled" : "Two-factor authentication disabled");
    }

    private void Toggle(string key, bool on)
    {
        if (on) _prefs.Add(key); else _prefs.Remove(key);
    }

    private async Task SaveNotificationsAsync()
    {
        Store.SaveNotifications(_prefs);
        await Message.SuccessAsync("Notification preferences saved");
    }

    private void ResetNotifications() => _prefs = Store.Notifications().Enabled;

    private async Task ConnectAsync(string name, bool on)
    {
        Store.SetAppConnected(name, on);
        await Message.SuccessAsync(on ? $"{name} connected" : $"{name} disconnected");
    }

    private Task CancelSubscriptionAsync() => Message.WarningAsync("Your subscription stays active until " + Fmt.Date(RenewsOn));
    private Task AddCardAsync() => Message.InfoAsync("Adding cards is disabled in the demo");
    private Task EditCardAsync() => Message.InfoAsync("Editing cards is disabled in the demo");
    private Task DemoConnectionAsync(string name) => Message.InfoAsync($"{name} is a demo connection");
    private Task DeactivateAsync() => Message.WarningAsync("Deactivation is disabled in the demo");
}

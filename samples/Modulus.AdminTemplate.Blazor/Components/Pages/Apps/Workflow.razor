@page "/apps/workflow"
@using Modulus.Samples.Shared

<PageTitle>Approvals · Modulus</PageTitle>

<PageHeading Pretitle="Apps" Title="Approvals" Subtitle="Purchase order PO-2041 going through approval: its steps, and the audit trail of every change." />

<div class="m-workflow-grid">
    <div class="m-card">
        <div class="m-card-body">
            <div class="m-workflow-title">
                <span class="m-heading m-medium">@_order.Number</span>
                <StatusBadge Tone="@_order.StatusTone">@_order.Status</StatusBadge>
            </div>
            <ApprovalTimeline Steps="_order.Steps" AriaLabel="Approval steps" />
        </div>
    </div>
    <div class="m-card">
        <div class="m-card-body">
            <div class="m-heading m-medium" style="margin-bottom:12px">Audit trail</div>
            <AuditTrail Entries="_order.Trail" @bind-Action="_action" AriaLabel="Audit trail" />
        </div>
    </div>
</div>

@code {
    private readonly WorkflowPage.Order _order = WorkflowPage.Board(DateTime.Today);
    private string? _action;
}

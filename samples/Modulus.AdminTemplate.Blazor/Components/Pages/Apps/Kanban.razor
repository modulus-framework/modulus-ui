@page "/apps/kanban"
@using Modulus.Ui.Abstractions.Kanban
@using Modulus.Samples.Shared
@inject SampleStore Store
@inject IMessageService Message

<PageTitle>Kanban · Modulus</PageTitle>

<PageHeading Pretitle="Apps" Title="Kanban" Subtitle="Drag cards between columns, or use a card's menu to move it." />

<KanbanBoard Columns="SampleStore.KanbanColumns" Cards="_cards" Labels="Lookups.KanbanLabels" DoneColumnId="@KanbanPage.DoneColumn"
             OnMove="MoveAsync" OnAdd="AddAsync" OnDelete="DeleteAsync" />

@code {
    private IReadOnlyList<KanbanCard> _cards = [];

    protected override void OnInitialized() => Reload();

    private void Reload() => _cards = KanbanPage.Cards(Store.Tasks());

    private Task MoveAsync(KanbanMove move)
    {
        Store.MoveTask(move.CardId, move.ColumnId, move.Index);
        Reload();
        return Task.CompletedTask;
    }

    private Task AddAsync(KanbanNewCard card)
    {
        Store.AddTask(new KanbanTaskInput { Title = card.Title, Column = card.ColumnId, Label = card.Label });
        _ = Message.SuccessAsync("Task added");
        Reload();
        return Task.CompletedTask;
    }

    private Task DeleteAsync(int id)
    {
        Store.DeleteTask(id);
        _ = Message.SuccessAsync("Task deleted");
        Reload();
        return Task.CompletedTask;
    }
}

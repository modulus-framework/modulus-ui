@page "/apps/users/view/{Id:int}"
@inject SampleStore Store
@inject IMessageService Message
@inject NavigationManager Navigation

@if (_user is null) return;
@{
    var u = _user;
    var baseUrl = $"/apps/users/view/{u.Id}";
    var plan = SampleContent.UserPlan(u.Plan);
    var self = u.Id == CurrentUser.Id;
    var suspended = u.Status == UserStatus.Inactive;
}
<PageTitle>@u.Name · Modulus</PageTitle>

<PageHeading Pretitle="Users" Title="@u.Name">
    <Actions>
        <a class="ant-btn ant-btn-default" href="/apps/users/list"><Ti Name="arrow-left" /><span>All users</span></a>
    </Actions>
</PageHeading>

<div id="user-view" class="m-row-cards m-cols-side m-align-start">
    <div class="m-row-cards">
        <div class="m-card">
            <div class="m-card-body">
                <div class="m-user-card">
                    <span class="m-avatar m-avatar-xl m-av-@u.Tint">@Fmt.Initials(u.Name)</span>
                    <h2 class="m-user-card-name">@u.Name</h2>
                    <div class="m-flex m-gap-8 m-mt-8">
                        <span class="m-badge m-badge-@SampleUi.RoleTone(u.Role)-lt">@u.Role</span>
                        <span class="m-badge @SampleUi.UserBadge(u.Status)">@u.Status</span>
                    </div>
                    <div class="m-user-stats">
                        <div class="m-user-stat">
                            <span class="m-icon-tile m-tile-primary-lt"><Ti Name="checks" /></span>
                            <div><div class="m-h3">@u.TasksDone.ToString("N0")</div><div class="m-xsmall m-muted">Tasks done</div></div>
                        </div>
                        <div class="m-user-stat">
                            <span class="m-icon-tile m-tile-primary-lt"><Ti Name="briefcase" /></span>
                            <div><div class="m-h3">@u.Projects</div><div class="m-xsmall m-muted">Projects</div></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="m-card-body m-card-body-divided">
                <div class="m-subheader m-mb-12">Details</div>
                <dl class="m-dl">
                    <dt>Username</dt><dd>@@@u.Username</dd>
                    <dt>Email</dt><dd class="m-truncate">@u.Email</dd>
                    <dt>Company</dt><dd>@(u.Company is { Length: > 0 } ? u.Company : "—")</dd>
                    <dt>Contact</dt><dd>@(u.Phone is { Length: > 0 } ? u.Phone : "—")</dd>
                    <dt>Language</dt><dd>@u.Language</dd>
                    <dt>Country</dt><dd>@(u.Country is { Length: > 0 } ? u.Country : "—")</dd>
                    <dt>Joined</dt><dd>@Fmt.Date(u.JoinedAt)</dd>
                    <dt>Last active</dt><dd>@Fmt.Relative(u.LastActiveAt)</dd>
                </dl>
                <div class="m-user-actions">
                    <button type="button" class="ant-btn ant-btn-primary" @onclick="Edit"><Ti Name="edit" /><span>Edit</span></button>
                    @if (!self)
                    {
                        <Popconfirm Title="@(suspended ? $"Reactivate {u.Name}?" : $"Suspend {u.Name}? They won't be able to sign in.")" OkText="@(suspended ? "Reactivate" : "Suspend")"
                                    OkButtonProps="@(suspended ? null : new ButtonProps { Danger = true })" OnConfirm="ToggleStatusAsync">
                            <button type="button" class="ant-btn @(suspended ? "ant-btn-default" : "ant-btn-default ant-btn-dangerous")">
                                <Ti Name="@(suspended ? "player-play" : "ban")" /><span>@(suspended ? "Reactivate" : "Suspend")</span>
                            </button>
                        </Popconfirm>
                    }
                </div>
            </div>
        </div>

        <div class="m-card">
            <div class="m-card-body">
                <div class="m-flex m-between" style="align-items:flex-start">
                    <span class="m-badge m-badge-primary-lt">@u.Plan</span>
                    <div class="m-plan-card-price"><sup>$</sup><span class="m-h1">@plan.Monthly.ToString("0")</span><span class="m-small m-muted">/month</span></div>
                </div>
                <ul class="m-check-list" style="margin:16px 0 0">
                    @foreach (var f in plan.Features)
                    {
                        <li><Ti Name="circle-check" />@f</li>
                    }
                </ul>
                <div class="m-flex m-between m-mt-16 m-small"><span class="m-heading m-medium">Days</span><span class="m-muted">@SampleContent.PlanDaysUsed of 30 days</span></div>
                <div class="m-progress m-mt-8"><div class="m-progress-bar" style="width:@Fmt.Pct(SampleContent.PlanDaysUsed, 30)%"></div></div>
                <div class="m-xsmall m-muted m-mt-8">@(30 - SampleContent.PlanDaysUsed) days remaining</div>
                <a class="ant-btn ant-btn-primary ant-btn-block m-mt-16" href="/pages/pricing"><span>Upgrade plan</span></a>
            </div>
        </div>
    </div>

    <div class="m-row-cards">
        <div class="m-card m-card-tabs">
            <nav class="m-tabs-nav" aria-label="User sections">
                @foreach (var (key, label, icon) in Tabs)
                {
                    <a href="@baseUrl?tab=@key" aria-current="@(key == _tab ? "page" : null)"><Ti Name="@icon" />@label</a>
                }
            </nav>
        </div>

        @switch (_tab)
        {
            case "security":
                <div class="m-card">
                    <div class="m-card-header"><div><h3 class="m-card-title">Change password</h3><p class="m-card-subtitle">Set a new password for @u.Name; they'll be signed out everywhere</p></div></div>
                    <div class="m-card-body">
                        <Form @ref="_passwordForm" Model="_password" Layout="@FormLayout.Vertical" OnFinish="ChangePasswordAsync" RequiredMark="FormRequiredMark.None">
                            <div class="m-form-grid">
                                <FormItem Label="New password">
                                    <InputPassword @bind-Value="context.New" Placeholder="At least 8 characters" />
                                </FormItem>
                                <FormItem Label="Confirm new password">
                                    <InputPassword @bind-Value="context.Confirm" Placeholder="Repeat the new password" />
                                </FormItem>
                            </div>
                            <div class="m-form-actions"><Button Type="@ButtonType.Primary" HtmlType="submit">Change password</Button></div>
                        </Form>
                    </div>
                </div>
                <div class="m-card">
                    <div class="m-card-header"><div><h3 class="m-card-title">Two-step verification</h3><p class="m-card-subtitle">A second step after the password when signing in</p></div></div>
                    <div class="m-card-body">
                        <div class="m-flex m-gap-12">
                            <span class="m-icon-tile m-tile-green-lt"><Ti Name="ant:mobile" /></span>
                            <div class="m-truncate">
                                <div class="m-heading m-medium">SMS</div>
                                <div class="m-small m-muted">@(u.Phone is { Length: > 0 } ? u.Phone : "No phone number on file")</div>
                            </div>
                            <span class="m-badge m-badge-green-lt" style="margin-left:auto">Enabled</span>
                        </div>
                    </div>
                </div>
                <div class="m-card">
                    <div class="m-card-header"><h3 class="m-card-title">Recent devices</h3></div>
                    <div class="ant-table-wrapper m-table-flush">
                        <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                            <table style="table-layout:auto">
                                <thead class="ant-table-thead"><tr><th class="ant-table-cell">Browser</th><th class="ant-table-cell">Device</th><th class="ant-table-cell">Location</th><th class="ant-table-cell">Recent activity</th></tr></thead>
                                <tbody class="ant-table-tbody">
                                    @foreach (var d in SampleContent.Devices())
                                    {
                                        <tr class="ant-table-row">
                                            <td class="ant-table-cell"><span class="m-flex m-gap-12"><span class="m-icon-tile m-tile-sm m-tile-gray-lt"><Ti Name="@d.Icon" /></span><span class="m-heading m-medium">@d.Browser</span></span></td>
                                            <td class="ant-table-cell m-muted">@d.Device</td>
                                            <td class="ant-table-cell m-muted">@d.Location</td>
                                            <td class="ant-table-cell m-muted">@Fmt.Relative(d.At)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div></div></div>
                    </div>
                </div>
                break;

            case "billing":
                <div class="m-card">
                    <div class="m-card-header"><h3 class="m-card-title">Current plan</h3></div>
                    <div class="m-card-body">
                        <div class="m-plan-box m-flex m-between m-gap-12">
                            <div>
                                <div class="m-heading m-medium">Your current plan is @u.Plan</div>
                                <div class="m-small m-muted m-mt-4">@Fmt.Money0(plan.Monthly) per month · renews @Fmt.Date(SampleContent.PlanRenewsOn)</div>
                            </div>
                            <a class="ant-btn ant-btn-primary" href="/pages/pricing"><span>Change plan</span></a>
                        </div>
                    </div>
                </div>
                <div class="m-card">
                    <div class="m-card-header"><h3 class="m-card-title">Payment methods</h3></div>
                    <div class="m-card-body">
                        @foreach (var c in SampleContent.PaymentCards)
                        {
                            <div class="m-pay-method">
                                <span class="m-card-brand"><Ti Name="@c.Brand" /></span>
                                <div class="m-list-item-text"><span class="m-list-item-title">@u.Name @if (c.Primary) { <span class="m-badge m-badge-primary-lt">Primary</span> }</span><span class="m-list-item-sub">•••• @c.Number · Expires @c.Expires</span></div>
                            </div>
                        }
                    </div>
                </div>
                <div class="m-card">
                    <div class="m-card-header">
                        <h3 class="m-card-title">Recent invoices</h3>
                        <div class="m-card-actions"><a class="ant-btn ant-btn-default ant-btn-sm" href="/apps/invoice/list"><span>View all</span></a></div>
                    </div>
                    <div class="ant-table-wrapper m-table-flush">
                        <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                            <table style="table-layout:auto">
                                <thead class="ant-table-thead"><tr><th class="ant-table-cell">Invoice</th><th class="ant-table-cell">Status</th><th class="ant-table-cell">Issued</th><th class="ant-table-cell" style="text-align:right">Total</th></tr></thead>
                                <tbody class="ant-table-tbody">
                                    @foreach (var i in _invoices)
                                    {
                                        <tr class="ant-table-row">
                                            <td class="ant-table-cell"><a class="m-medium" href="/apps/invoice/preview/@i.Id">@i.Number</a></td>
                                            <td class="ant-table-cell"><span class="m-badge @SampleUi.InvoiceBadge(i.Status)">@SampleUi.Label(i.Status)</span></td>
                                            <td class="ant-table-cell m-muted">@Fmt.Date(i.IssuedAt)</td>
                                            <td class="ant-table-cell m-num m-heading" style="text-align:right">@Fmt.Money(i.Total)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div></div></div>
                    </div>
                </div>
                break;

            default:
                <div class="m-card">
                    <div class="m-card-header"><h3 class="m-card-title">Projects</h3></div>
                    <div class="ant-table-wrapper m-table-flush">
                        <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                            <table style="table-layout:auto">
                                <thead class="ant-table-thead"><tr><th class="ant-table-cell">Project</th><th class="ant-table-cell">Tasks</th><th class="ant-table-cell" style="width:30%">Progress</th><th class="ant-table-cell">Team</th></tr></thead>
                                <tbody class="ant-table-tbody">
                                    @foreach (var p in SampleContent.UserProjects(u))
                                    {
                                        <tr class="ant-table-row">
                                            <td class="ant-table-cell">
                                                <div class="m-flex m-gap-12">
                                                    <span class="m-icon-tile m-tile-sm m-tile-@SampleUi.Tone(p.Id)-lt"><Ti Name="@p.Icon" /></span>
                                                    <div class="m-truncate"><div class="m-heading m-medium">@p.Name</div><div class="m-xsmall m-muted">@p.Client</div></div>
                                                </div>
                                            </td>
                                            <td class="ant-table-cell m-muted m-num">@p.TasksDone/@p.TasksTotal</td>
                                            <td class="ant-table-cell">
                                                <div class="m-flex m-gap-8"><div class="m-progress" style="flex:1"><div class="m-progress-bar" style="width:@p.Progress%"></div></div><span class="m-small m-num">@p.Progress%</span></div>
                                            </td>
                                            <td class="ant-table-cell">
                                                <div class="m-avatar-list">
                                                    @foreach (var m in p.Team.Take(3))
                                                    {
                                                        <span class="m-avatar m-avatar-sm m-av-@Fmt.Tint(m)" title="@m">@Fmt.Initials(m)</span>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div></div></div>
                    </div>
                </div>
                <div class="m-card">
                    <div class="m-card-header"><h3 class="m-card-title">Activity timeline</h3></div>
                    <div class="m-card-body">
                        <ul class="m-timeline">
                            @foreach (var a in SampleContent.UserActivity(u))
                            {
                                <li class="m-timeline-item">
                                    <span class="m-timeline-icon"><Ti Name="@a.Icon" /></span>
                                    <div class="m-timeline-body">
                                        <div><strong>@a.Who</strong> <span class="m-secondary">@a.What</span> @a.Target</div>
                                        <div class="m-timeline-time">@Fmt.Relative(a.At)</div>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
                break;
        }
    </div>
</div>

<DrawerForm TModel="UserInput" Title="Edit user" @bind-Visible="_drawerOpen" Model="_input" OnFinish="SaveAsync" SubmitText="Save changes">
    <UserFormFields Model="context" />
</DrawerForm>

@code {
    private static readonly (string Key, string Label, string Icon)[] Tabs =
        [("account", "Account", "user"), ("security", "Security", "lock"), ("billing", "Billing & plan", "credit-card")];

    [Parameter] public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    private AppUser? _user;
    private string _tab = "account";
    private IReadOnlyList<Invoice> _invoices = [];
    private UserPasswordInput _password = new();
    private Form<UserPasswordInput>? _passwordForm;
    private UserInput _input = new();
    private bool _drawerOpen;

    protected override void OnParametersSet()
    {
        _user = Store.FindUser(Id);
        if (_user is null)
        {
            Navigation.NotFound();
            return;
        }
        _tab = Tabs.Any(t => t.Key == Tab) ? Tab! : "account";
        _invoices = Store.QueryInvoices(new InvoiceQuery(), new ProTableRequest { PageSize = 5 }).Data;
    }

    private void Edit()
    {
        _input = UserInput.From(_user!);
        _drawerOpen = true;
    }

    private async Task<bool> SaveAsync(UserInput input)
    {
        Store.UpdateUser(Id, input);
        await Message.SuccessAsync($"Saved {input.Name}");
        return true;
    }

    private async Task ToggleStatusAsync()
    {
        var suspend = _user!.Status != UserStatus.Inactive;
        Store.SetUserStatus(Id, suspend ? UserStatus.Inactive : UserStatus.Active);
        await Message.SuccessAsync(suspend ? "User suspended" : "User reactivated");
    }

    private async Task ChangePasswordAsync()
    {
        _ = Message.SuccessAsync($"Password changed for {_user!.Name}");
        _password = new();
        await Task.CompletedTask;
    }
}

@page "/apps/calendar"
@inject SampleStore Store
@inject IMessageService Message

<PageTitle>Calendar · Modulus</PageTitle>

<PageHeading Pretitle="Apps" Title="Calendar" />

<div class="m-card m-app m-app-calendar">
    <aside class="m-app-side">
        <div class="m-app-side-head">
            <button type="button" class="ant-btn ant-btn-primary ant-btn-block" @onclick="() => Add(DateTime.Today)"><Ti Name="plus" /><span>Add event</span></button>
        </div>
        <div class="m-app-side-body">
            <div class="m-subheader m-app-nav-title" style="margin-top:0">Event filters</div>
            <div class="m-cal-filters">
                @foreach (var c in CalendarView.AllCategories)
                {
                    var category = c;
                    <Checkbox Style="@($"--c:{SampleUi.EventColor(c)}")" Checked="_categories.Contains(c)" CheckedChanged="on => Filter(category, on)">@c</Checkbox>
                }
            </div>
            <div class="m-subheader m-app-nav-title">Upcoming</div>
            @{ var upcoming = _view.Events.Where(e => e.End >= DateTime.Now).OrderBy(e => e.Start).Take(4).ToList(); }
            @if (upcoming.Count == 0)
            {
                <div class="m-small m-muted" style="padding:0 8px">Nothing coming up this month</div>
            }
            @foreach (var e in upcoming)
            {
                <button type="button" class="m-cal-agenda-row" @onclick="() => Edit(e)">
                    <span class="m-app-dot" style="--c:@SampleUi.EventColor(e.Category)"></span>
                    <span class="m-truncate" style="flex:1"><span class="m-heading m-medium">@e.Title</span><br /><span class="m-xsmall m-muted">@e.Start.ToString("ddd, MMM d", System.Globalization.CultureInfo.InvariantCulture) · @CalendarView.TimeLabel(e)</span></span>
                </button>
            }
        </div>
    </aside>

    <section class="m-app-main" aria-label="@_view.Title">
        <div class="m-cal-toolbar">
            <div class="ant-btn-group" style="display:inline-flex">
                <button type="button" class="ant-btn ant-btn-default ant-btn-icon-only" aria-label="Previous month" title="Previous month" @onclick="() => Go(_month.AddMonths(-1))"><Ti Name="chevron-left" /></button>
                <button type="button" class="ant-btn ant-btn-default ant-btn-icon-only" aria-label="Next month" title="Next month" @onclick="() => Go(_month.AddMonths(1))"><Ti Name="chevron-right" /></button>
            </div>
            <button type="button" class="ant-btn ant-btn-default" @onclick="() => Go(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1))"><span>Today</span></button>
            <h2 class="m-cal-title">@_view.Title</h2>
            <span class="m-spacer"></span>
            <div class="ant-segmented" role="group" aria-label="View">
                <div class="ant-segmented-group">
                    <button type="button" class="ant-segmented-item@(_list ? "" : " ant-segmented-item-selected")" aria-pressed="@(!_list)" @onclick="() => SetList(false)"><div class="ant-segmented-item-label">Month</div></button>
                    <button type="button" class="ant-segmented-item@(_list ? " ant-segmented-item-selected" : "")" aria-pressed="@_list" @onclick="() => SetList(true)"><div class="ant-segmented-item-label">List</div></button>
                </div>
            </div>
        </div>
        @if (_list)
        {
            var agenda = _view.Agenda.ToList();
            @if (agenda.Count == 0)
            {
                <div class="m-table-empty" style="padding:64px 0">No events this month</div>
            }
            @foreach (var (day, events) in agenda)
            {
                <div class="m-cal-agenda-day@(day == DateTime.Today ? " today" : "")">
                    <div class="m-cal-agenda-date">@day.ToString("ddd, MMM d", System.Globalization.CultureInfo.InvariantCulture)@(day == DateTime.Today ? " · Today" : "")</div>
                    <div>
                        @foreach (var e in events)
                        {
                            <button type="button" class="m-cal-agenda-row" @onclick="() => Edit(e)">
                                <time>@CalendarView.TimeLabel(e)</time>
                                <span class="m-app-dot" style="--c:@SampleUi.EventColor(e.Category)"></span>
                                <span class="m-heading m-medium">@e.Title</span>
                                @if (e.Location is { Length: > 0 }) { <span class="m-small m-muted m-truncate">@e.Location</span> }
                            </button>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="m-cal-head" aria-hidden="true">
                @foreach (var d in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" }) { <div>@d</div> }
            </div>
            <div class="m-cal-grid">
                @foreach (var day in _view.Days)
                {
                    var date = day;
                    var events = _view.On(day).ToList();
                    <div class="@CellClass(day)">
                        <button type="button" class="m-cal-add" aria-label="Add event on @day.ToString("MMMM d", System.Globalization.CultureInfo.InvariantCulture)" @onclick="() => Add(date)"></button>
                        <span class="m-cal-num">@day.Day</span>
                        @foreach (var e in events.Take(3))
                        {
                            <button type="button" class="m-cal-event@(e.AllDay ? " allday" : "")" style="--c:@SampleUi.EventColor(e.Category)" title="@e.Title" @onclick="() => Edit(e)">
                                @if (!e.AllDay) { <span class="m-cal-dot"></span><time>@CalendarView.TimeLabel(e)</time> }
                                <span>@e.Title</span>
                            </button>
                        }
                        @if (events.Count > 3)
                        {
                            <span class="m-cal-more">+@(events.Count - 3) more</span>
                        }
                    </div>
                }
            </div>
        }
    </section>
</div>

<DrawerForm TModel="EventInput" Title="@(_input.Id is null ? "Add event" : "Edit event")" @bind-Visible="_drawerOpen" Model="_input" OnFinish="SaveAsync" SubmitText="@(_input.Id is null ? "Add event" : "Save changes")">
    <ChildContent>
        <FormItem Label="Title"><Input @bind-Value="context.Title" Placeholder="Event title" /></FormItem>
        <FormItem Label="Category">
            <Select TItemValue="EventCategory" TItem="string" @bind-Value="context.Category">
                <SelectOptions>
                    @foreach (var c in CalendarView.AllCategories)
                    {
                        <SelectOption TItemValue="EventCategory" TItem="string" Value="c" Label="@c.ToString()" />
                    }
                </SelectOptions>
            </Select>
        </FormItem>
        <FormItem Label="All day"><Switch @bind-Checked="context.AllDay" aria-label="All day" /></FormItem>
        <FormItem Label="Starts"><DatePicker TValue="DateTime?" @bind-Value="context.Start" ShowTime="true" Format="MM/dd/yyyy, hh:mm tt" Style="width:100%" /></FormItem>
        <FormItem Label="Ends"><DatePicker TValue="DateTime?" @bind-Value="context.End" ShowTime="true" Format="MM/dd/yyyy, hh:mm tt" Style="width:100%" /></FormItem>
        @if (_endError is not null)
        {
            <div class="ant-form-item-explain-error" style="margin:-16px 0 16px">@_endError</div>
        }
        <FormItem Label="Location"><Input @bind-Value="context.Location" Placeholder="Room, address or link" /></FormItem>
        <FormItem Label="Description"><TextArea @bind-Value="context.Description" Rows="3" /></FormItem>
    </ChildContent>
    <FooterStart>
        @if (_input.Id is { } id)
        {
            <Popconfirm Title="Delete this event?" OkText="Delete" OkButtonProps="@(new ButtonProps { Danger = true })" OnConfirm="() => Delete(id)">
                <Button Danger>Delete</Button>
            </Popconfirm>
        }
    </FooterStart>
</DrawerForm>

@code {
    [SupplyParameterFromQuery] public string? Month { get; set; }

    [SupplyParameterFromQuery] public string? View { get; set; }

    private DateTime _month;
    private bool _list;
    private readonly HashSet<EventCategory> _categories = [.. CalendarView.AllCategories];
    private CalendarView _view = default!;
    private EventInput _input = new();
    private bool _drawerOpen;
    private string? _endError;

    protected override void OnInitialized()
    {
        _month = CalendarView.ParseMonth(Month);
        _list = View == "list";
        Load();
    }

    private string CellClass(DateTime day) =>
        "m-cal-cell" + (day.Month != _month.Month ? " other" : "") + (day == DateTime.Today ? " today" : "");

    private void Load() => _view = CalendarView.Load(Store, _month, _list, _categories);

    private void Go(DateTime month)
    {
        _month = month;
        Load();
    }

    private void SetList(bool list)
    {
        _list = list;
        Load();
    }

    private void Filter(EventCategory category, bool on)
    {
        if (on) _categories.Add(category);
        else _categories.Remove(category);
        Load();
    }

    private void Add(DateTime day)
    {
        var start = day.Date.AddHours(9);
        _input = new EventInput { Start = start, End = start.AddHours(1) };
        _endError = null;
        _drawerOpen = true;
    }

    private void Edit(CalendarEvent e)
    {
        _input = EventInput.From(e);
        _endError = null;
        _drawerOpen = true;
    }

    private Task<bool> SaveAsync(EventInput input)
    {
        _endError = input.Start is { } s && input.End is { } e && e < s ? "End must be after the start" : null;
        if (_endError is not null) return Task.FromResult(false);
        Store.SaveEvent(input);
        _ = Message.SuccessAsync(input.Id is null ? "Event added" : "Event saved");
        Load();
        return Task.FromResult(true);
    }

    private void Delete(int id)
    {
        Store.DeleteEvent(id);
        _ = Message.SuccessAsync("Event deleted");
        _drawerOpen = false;
        Load();
    }
}

@page "/apps/gantt"
@using Modulus.Samples.Shared
@using Modulus.Ui.Abstractions.Gantt

<PageTitle>Gantt · Modulus</PageTitle>

<PageHeading Pretitle="Apps" Title="Gantt" Subtitle="The website relaunch, planned in weeks. Drag a bar to another day (or select it and press the arrow keys). Bars fill to their progress; the red line is today; arrows are dependencies, and a red arrow is one the dates break." />

@if (_refused)
{
    <div class="ant-alert ant-alert-error" role="alert">That move would break a dependency, so nothing changed.</div>
}

<Gantt Tasks="_tasks" From="_from" To="_to" Today="_today" OnMove="MoveAsync" />

@code {
    private DateTime _today = DateTime.Today;
    private DateTime _from;
    private DateTime _to;
    private bool _refused;
    private IReadOnlyList<GanttTask> _tasks = [];

    protected override void OnInitialized() => Load();

    private void Load()
    {
        _from = GanttPage.From(_today);
        _to = GanttPage.To(_today);
        _tasks = GanttPage.Tasks(_today);
    }

    private Task MoveAsync(GanttMove move)
    {
        _refused = !GanttPage.Move(move, _today);
        Load();
        return Task.CompletedTask;
    }
}

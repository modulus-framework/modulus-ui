@page "/ui/icons"
@inject NavigationManager Nav

<PageTitle>Icons · Modulus</PageTitle>

@* Every Ant Design icon, drawn from the AntDesign package (no sprite). A click copies the Blazor markup. MVC and Razor Pages
   render the same page from Samples.Web Views/Shared/Ui/Ui/Icons.cshtml, where a click copies the tag helper. *@
<PageHeading Pretitle="User interface" Title="Icons" Subtitle="Every Ant Design icon in the three themes. Click an icon to copy its markup." />

<div class="m-card" data-m-copy-scope>
    <div class="m-card-header m-filter-bar">
        <div class="ant-segmented" role="group" aria-label="Icon theme">
            <div class="ant-segmented-group">
                @foreach (var t in UiContent.IconThemes)
                {
                    var qs = m.QueryString(t.Key);
                    <a class="ant-segmented-item @(t.Key == m.Theme.Key ? "ant-segmented-item-selected" : "")" href="/ui/icons@(qs == "" ? "" : "?" + qs)" aria-current="@(t.Key == m.Theme.Key ? "true" : null)">
                        <div class="ant-segmented-item-label">@t.Label</div>
                    </a>
                }
            </div>
        </div>
        <form class="m-icon-search" method="get" action="/ui/icons" role="search">
            @if (m.Theme.Key != "outline")
            {
                <input type="hidden" name="theme" value="@m.Theme.Key" />
            }
            <span class="ant-input-affix-wrapper">
                <span class="ant-input-prefix"><Icon Type="search" /></span>
                <input class="ant-input" type="search" name="q" value="@m.Query" placeholder="Search icons…" aria-label="Search icons" />
            </span>
        </form>
        <span class="m-muted m-small">@m.Total.ToString("N0") @(m.Total == 1 ? "icon" : "icons")</span>
    </div>
    <div class="m-card-body">
        @if (m.Total == 0)
        {
            <div class="m-empty"><span class="m-empty-icon"><Icon Type="search" /></span><p class="m-empty-title">No icons match “@m.Query”</p><p class="m-empty-subtitle">Try a shorter name, such as “arrow” or “file”.</p></div>
        }
        else
        {
            <ul class="m-icon-grid">
                @foreach (var name in m.Names)
                {
                    var snippet = m.BlazorSnippet(name);
                    <li>
                        <button type="button" class="m-icon-tile-btn" data-m-copy="@snippet" title="Copy @snippet">
                            <span class="anticon" role="img" aria-hidden="true">@((MarkupString)(AntIconSvg.Svg(name, m.Theme.Value) ?? ""))</span>
                            <span class="m-icon-name">@name</span>
                        </button>
                    </li>
                }
            </ul>
            if (m.Pages > 1)
            {
                <Pagination Current="m.Page" Total="m.Total" PageSize="m.PageSize" ShowSizeChanger="false" OnChange="Go" Style="margin-top: 16px" />
            }
        }
        <span class="m-sr-only" role="status" aria-live="polite" data-m-copy-live></span>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "theme")] public string? ThemeKey { get; set; }
    [SupplyParameterFromQuery] public int? Current { get; set; }

    private IconGallery m = default!;

    protected override void OnParametersSet() => m = UiContent.Icons(Q, ThemeKey, Current ?? 1);

    private void Go(PaginationEventArgs e)
    {
        var qs = m.QueryString();
        Nav.NavigateTo($"/ui/icons?current={e.Page}{(qs == "" ? "" : "&" + qs)}");
    }
}

@page "/ui/charts"

<PageTitle>Charts · Modulus</PageTitle>

@* Every chart type in Modulus (server-rendered SVG/HTML, hover tooltips, light and dark). MVC and Razor Pages render the same page from Samples.Web Views/Shared/Ui/Ui/Charts.cshtml. *@
<PageHeading Pretitle="User interface" Title="Charts" Subtitle="Server-rendered charts with hover tooltips. No chart library or client script needed." />

<div class="m-row-cards">
    <div class="m-row-cards m-cols-2">
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Line chart</h3><p class="m-card-subtitle">Visitors per month by source</p></div>
                <div class="m-card-actions"><span class="m-heading m-medium m-num">@Fmt.Number(Traffic.Sum(s => s.Values[^1]))</span><span class="m-small m-muted">in December</span></div>
            </div>
            <div class="m-card-body">
                <LineChart Labels="UiShowcase.Months" Series="Traffic" Title="Visitors per month by source" Height="280" />
            </div>
        </div>
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Area chart</h3><p class="m-card-subtitle">Sessions per month, thousands</p></div>
            </div>
            <div class="m-card-body">
                <LineChart Labels="UiShowcase.Months" Series="UiShowcase.Sessions" Area Suffix="k" Title="Sessions per month, this year and last year" Height="280" />
            </div>
        </div>
    </div>

    <div class="m-row-cards m-cols-2">
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Grouped columns</h3><p class="m-card-subtitle">Earning and expense per month</p></div>
            </div>
            <div class="m-card-body">
                <ColumnChart Labels="UiShowcase.Months" Series="UiShowcase.Finance" Prefix="$" Title="Earning and expense per month" Height="280" />
            </div>
        </div>
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Stacked columns</h3><p class="m-card-subtitle">Revenue per quarter by channel</p></div>
            </div>
            <div class="m-card-body">
                <ColumnChart Labels="UiShowcase.Quarters" Series="UiShowcase.Channels" Stacked Prefix="$" Title="Revenue per quarter by channel" Height="280" />
            </div>
        </div>
    </div>

    <div class="m-row-cards m-cols-8-4">
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Bar chart</h3><p class="m-card-subtitle">Sign-ups per day, last 14 days</p></div>
                <div class="m-card-actions"><span class="m-delta m-delta-up">+18.2% <Ti Name="trending-up" /></span></div>
            </div>
            <div class="m-card-body">
                <BarChart Data="UiShowcase.Signups" Title="Sign-ups per day" Height="280" MaxXLabels="7" />
            </div>
        </div>
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Donut chart</h3><p class="m-card-subtitle">Sessions by device</p></div>
            </div>
            <div class="m-card-body">
                <DonutChart Slices="UiShowcase.Devices" CenterLabel="Sessions" Title="Sessions by device" Size="168" />
            </div>
        </div>
    </div>

    <div class="m-card">
        <div class="m-card-header">
            <div><h3 class="m-card-title">Heatmap</h3><p class="m-card-subtitle">Orders by weekday and time of day</p></div>
        </div>
        <div class="m-card-body">
            <HeatmapChart Rows="UiShowcase.Weekdays" Columns="UiShowcase.HourBlocks" Values="UiShowcase.Activity" Title="Orders by weekday and two-hour block" />
        </div>
    </div>

    <h2 class="m-section-title">Small charts</h2>
    <div class="m-row-cards m-cols-4">
        <div class="m-card">
            <div class="m-card-body">
                <div class="m-kpi-head"><span class="m-subheader">Response time</span><span class="m-delta m-delta-up" style="margin-left:auto">-29.7% <Ti Name="trending-down" /></span></div>
                <div class="m-kpi-value"><span class="m-h1">128 ms</span></div>
                <div class="m-kpi-chart"><Sparkline Data="UiShowcase.ResponseTime" AriaLabel="Response time per month" /></div>
            </div>
        </div>
        <div class="m-card">
            <div class="m-card-body">
                <div class="m-kpi-head"><span class="m-subheader">Open tickets</span><span class="m-delta m-delta-up" style="margin-left:auto">-14.3% <Ti Name="trending-down" /></span></div>
                <div class="m-kpi-value"><span class="m-h1">36</span></div>
                <div class="m-kpi-chart"><MiniBar Data="UiShowcase.Tickets" AriaLabel="Open tickets per month" /></div>
            </div>
        </div>
        <div class="m-card">
            <div class="m-card-body">
                <div class="m-kpi-head"><span class="m-subheader">Line only</span></div>
                <div class="m-kpi-value"><span class="m-h1">@Fmt.Number(UiShowcase.Signups[^1].Value)</span><span class="m-muted">sign-ups today</span></div>
                <div class="m-kpi-chart"><Sparkline Data="UiShowcase.Signups" Area="false" AriaLabel="Sign-ups per day" /></div>
            </div>
        </div>
        <div class="m-card">
            <div class="m-card-body">
                <div class="m-kpi-head"><span class="m-subheader">Device share</span></div>
                <div class="m-progress m-progress-lg m-mt-12">
                    @for (var i = 0; i < UiShowcase.Devices.Length; i++)
                    {
                        var d = UiShowcase.Devices[i]; var n = i + 1;
                        <div class="m-progress-bar" style="width:@Fmt.Pct(d.Value, Total)%;--c:var(--m-series-@n)" title="@($"{d.Label}: {Fmt.Percent(d.Value / Total)}")"></div>
                    }
                </div>
                <ul class="m-progress-legend">
                    @for (var i = 0; i < UiShowcase.Devices.Length; i++)
                    {
                        var d = UiShowcase.Devices[i]; var n = i + 1;
                        <li><span class="m-key m-key-rect" style="--c:var(--m-series-@n)"></span>@d.Label <span class="m-muted m-num">@Fmt.Percent(d.Value / Total)</span></li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

@code {
    private static readonly ChartSeries[] Traffic = UiShowcase.Traffic;
    private static readonly double Total = UiShowcase.Devices.Sum(d => d.Value);
}

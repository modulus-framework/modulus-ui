@page "/ui/charts"

<PageTitle>Charts · Modulus</PageTitle>

@* Every chart type in Modulus (server-rendered SVG/HTML, hover tooltips, light and dark). MVC and Razor Pages render the same page from Samples.Web Views/Shared/Ui/Ui/Charts.cshtml. *@
<PageHeading Pretitle="User interface" Title="Charts" Subtitle="Server-rendered charts with hover tooltips. No chart library or client script needed." />

<div class="m-row-cards">
    <div class="m-row-cards m-cols-2">
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Line chart</h3><p class="m-card-subtitle">Visitors per month by source</p></div>
                <div class="m-card-actions"><span class="m-heading m-medium m-num">@Fmt.Number(Traffic.Sum(s => s.Values[^1]))</span><span class="m-small m-muted">in December</span></div>
            </div>
            <div class="m-card-body">
                <LineChart Labels="UiShowcase.Months" Series="Traffic" Title="Visitors per month by source" Height="280" />
            </div>
        </div>
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Area chart</h3><p class="m-card-subtitle">Sessions per month, thousands</p></div>
            </div>
            <div class="m-card-body">
                <LineChart Labels="UiShowcase.Months" Series="UiShowcase.Sessions" Area Suffix="k" Title="Sessions per month, this year and last year" Height="280" />
            </div>
        </div>
    </div>

    <div class="m-row-cards m-cols-2">
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Grouped columns</h3><p class="m-card-subtitle">Earning and expense per month</p></div>
            </div>
            <div class="m-card-body">
                <ColumnChart Labels="UiShowcase.Months" Series="UiShowcase.Finance" Prefix="$" Title="Earning and expense per month" Height="280" />
            </div>
        </div>
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Stacked columns</h3><p class="m-card-subtitle">Revenue per quarter by channel</p></div>
            </div>
            <div class="m-card-body">
                <ColumnChart Labels="UiShowcase.Quarters" Series="UiShowcase.Channels" Stacked Prefix="$" Title="Revenue per quarter by channel" Height="280" />
            </div>
        </div>
    </div>

    <div class="m-row-cards m-cols-8-4">
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Bar chart</h3><p class="m-card-subtitle">Sign-ups per day, last 14 days</p></div>
                <div class="m-card-actions"><span class="m-delta m-delta-up">+18.2% <Ti Name="rise" /></span></div>
            </div>
            <div class="m-card-body">
                <BarChart Data="UiShowcase.Signups" Title="Sign-ups per day" Height="280" MaxXLabels="7" />
            </div>
        </div>
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Donut chart</h3><p class="m-card-subtitle">Sessions by device</p></div>
            </div>
            <div class="m-card-body">
                <DonutChart Slices="UiShowcase.Devices" CenterLabel="Sessions" Title="Sessions by device" Size="168" />
            </div>
        </div>
    </div>

    <div class="m-card">
        <div class="m-card-header">
            <div><h3 class="m-card-title">Heatmap</h3><p class="m-card-subtitle">Orders by weekday and time of day</p></div>
        </div>
        <div class="m-card-body">
            <HeatmapChart Rows="UiShowcase.Weekdays" Columns="UiShowcase.HourBlocks" Values="UiShowcase.Activity" Title="Orders by weekday and two-hour block" />
        </div>
    </div>

    <h2 class="m-section-title">Small charts</h2>
    <div class="m-row-cards m-cols-4">
        <div class="m-card">
            <div class="m-card-body">
                <div class="m-kpi-head"><span class="m-subheader">Response time</span><span class="m-delta m-delta-up" style="margin-left:auto">-29.7% <Ti Name="fall" /></span></div>
                <div class="m-kpi-value"><span class="m-h1">128 ms</span></div>
                <div class="m-kpi-chart"><Sparkline Data="UiShowcase.ResponseTime" AriaLabel="Response time per month" /></div>
            </div>
        </div>
        <div class="m-card">
            <div class="m-card-body">
                <div class="m-kpi-head"><span class="m-subheader">Open tickets</span><span class="m-delta m-delta-up" style="margin-left:auto">-14.3% <Ti Name="fall" /></span></div>
                <div class="m-kpi-value"><span class="m-h1">36</span></div>
                <div class="m-kpi-chart"><MiniBar Data="UiShowcase.Tickets" AriaLabel="Open tickets per month" /></div>
            </div>
        </div>
        <div class="m-card">
            <div class="m-card-body">
                <div class="m-kpi-head"><span class="m-subheader">Line only</span></div>
                <div class="m-kpi-value"><span class="m-h1">@Fmt.Number(UiShowcase.Signups[^1].Value)</span><span class="m-muted">sign-ups today</span></div>
                <div class="m-kpi-chart"><Sparkline Data="UiShowcase.Signups" Area="false" AriaLabel="Sign-ups per day" /></div>
            </div>
        </div>
        <div class="m-card">
            <div class="m-card-body">
                <div class="m-kpi-head"><span class="m-subheader">Device share</span></div>
                <div class="m-progress m-progress-lg m-mt-12">
                    @for (var i = 0; i < UiShowcase.Devices.Length; i++)
                    {
                        var d = UiShowcase.Devices[i]; var n = i + 1;
                        <div class="m-progress-bar" style="width:@Fmt.Pct(d.Value, Total)%;--c:var(--m-series-@n)" title="@($"{d.Label}: {Fmt.Percent(d.Value / Total)}")"></div>
                    }
                </div>
                <ul class="m-progress-legend">
                    @for (var i = 0; i < UiShowcase.Devices.Length; i++)
                    {
                        var d = UiShowcase.Devices[i]; var n = i + 1;
                        <li><span class="m-key m-key-rect" style="--c:var(--m-series-@n)"></span>@d.Label <span class="m-muted m-num">@Fmt.Percent(d.Value / Total)</span></li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="m-section-head">
        <h2 class="m-section-title">Business charts</h2>
        <a class="ant-btn ant-btn-link" href="/dashboards/erp"><span>See them on the ERP dashboard</span><Ti Name="arrow-right" /></a>
    </div>
    <div class="m-row-cards m-cols-2">
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Combo chart</h3><p class="m-card-subtitle">Actual revenue against budget, one shared axis</p></div>
            </div>
            <div class="m-card-body">
                <ComboChart Labels="ErpShowcase.Months" Columns="ErpShowcase.RevenueActual" Lines="ErpShowcase.RevenueBudget" Prefix="$" Title="Revenue against budget per month" Height="260" />
            </div>
        </div>
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Waterfall</h3><p class="m-card-subtitle">Profit bridge from revenue to net profit</p></div>
            </div>
            <div class="m-card-body">
                <WaterfallChart Steps="ErpShowcase.ProfitBridge" Prefix="$" Title="Profit bridge" Height="260" />
            </div>
        </div>
    </div>
    <div class="m-row-cards m-cols-2">
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Variance</h3><p class="m-card-subtitle">Spend minus budget; overspend is unfavorable</p></div>
            </div>
            <div class="m-card-body">
                <VarianceChart Items="ErpShowcase.BudgetVariance" PositiveIsFavorable="false" Prefix="$" Title="Budget variance by department" />
            </div>
        </div>
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Ranked bars</h3><p class="m-card-subtitle">Top customers; the tail folds into “Other”</p></div>
            </div>
            <div class="m-card-body">
                <RankedBarChart Items="ErpShowcase.TopCustomers" Limit="8" ShowShare Prefix="$" Title="Top customers by revenue" />
            </div>
        </div>
    </div>
    <div class="m-row-cards m-cols-8-4">
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Bullet chart</h3><p class="m-card-subtitle">Key results against target over poor / fair / good bands</p></div>
            </div>
            <div class="m-card-body">
                <BulletChart Items="ErpShowcase.Targets" ValueFormat="#,0.#" Title="Key results against targets" />
            </div>
        </div>
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Gauge</h3><p class="m-card-subtitle">One measure with its target</p></div>
            </div>
            <div class="m-card-body">
                <GaugeChart Value="ErpShowcase.OnTimeInFull" Max="100" Target="ErpShowcase.OnTimeTarget" ValueFormat="N1" Suffix="%" Caption="On time in full" Title="On time in full" />
            </div>
        </div>
    </div>
    <div class="m-row-cards m-cols-2">
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Funnel</h3><p class="m-card-subtitle">Order to cash, with conversion per stage</p></div>
            </div>
            <div class="m-card-body">
                <FunnelChart Stages="ErpShowcase.OrderToCash" Title="Order-to-cash funnel" />
            </div>
        </div>
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Stacked bars, 100 %</h3><p class="m-card-subtitle">Receivables aging on the ordinal ramp</p></div>
            </div>
            <div class="m-card-body">
                <StackedBarChart Rows="ErpShowcase.AgingCustomers" Series="ErpShowcase.Aging" Normalize Ordinal Prefix="$" Title="Receivables aging by customer" />
            </div>
        </div>
    </div>
    <div class="m-row-cards m-cols-2">
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Pareto</h3><p class="m-card-subtitle">ABC analysis: share and cumulative share on one percent axis</p></div>
            </div>
            <div class="m-card-body">
                <ParetoChart Items="ErpShowcase.SkuRevenue" Prefix="$" ValueName="Revenue share" Title="ABC analysis of revenue by SKU" Height="260" MaxXLabels="10" />
            </div>
        </div>
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Treemap</h3><p class="m-card-subtitle">Inventory value by category, up to eight tiles</p></div>
            </div>
            <div class="m-card-body">
                <TreemapChart Items="ErpShowcase.InventoryValue" Prefix="$" Title="Inventory value by category" Height="260" Aspect="2" />
            </div>
        </div>
    </div>
    <div class="m-card">
        <div class="m-card-header">
            <div><h3 class="m-card-title">Bubble chart</h3><p class="m-card-subtitle">Revenue against gross margin by product line; size is units sold, lines mark the averages</p></div>
        </div>
        <div class="m-card-body">
            <ScatterChart Points="ErpShowcase.ProductPortfolio" Groups="ErpShowcase.ProductLines" XTitle="Revenue" YTitle="Gross margin (%)" SizeTitle="Units sold" XPrefix="$" ValueFormat="N1" Suffix="%" Quadrants Title="Product portfolio" Height="300" />
        </div>
    </div>
</div>

@code {
    private static readonly ChartSeries[] Traffic = UiShowcase.Traffic;
    private static readonly double Total = UiShowcase.Devices.Sum(d => d.Value);
}

@page "/extra/gallery"

<PageTitle>Gallery · Modulus</PageTitle>

<PageHeading Pretitle="Extra" Title="Gallery" Subtitle="@($"{photos.Count} photos · click one to open the lightbox")">
    <Actions>
    <a class="ant-btn ant-btn-primary" href="/extra/gallery"><Ti Name="upload" /><span>Upload photos</span></a>
    </Actions>
</PageHeading>

<div class="m-filter-bar m-mb-16">
    <div class="ant-segmented" role="group" aria-label="Category">
        <div class="ant-segmented-group">
            @foreach (var c in ExtraContent.GalleryCategories)
            {
                var active = c.Key == cat || (c.Key == "" && !ExtraContent.GalleryCategories.Any(x => x.Key == cat));
                <a class="ant-segmented-item @(active ? "ant-segmented-item-selected" : "")" href="/extra/gallery@(c.Key == "" ? "" : "?category=" + c.Key)" aria-current="@(active ? "true" : null)">
                    <div class="ant-segmented-item-label">@c.Label</div>
                </a>
            }
        </div>
    </div>
</div>

<div class="m-card">
    <div class="m-card-body">
        <AppLightbox Items="ExtraContent.Lightbox(photos)" MinWidth="220" />
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Category { get; set; }

    private string cat => Category ?? "";
    private IReadOnlyList<GalleryPhoto> photos => ExtraContent.GalleryPhotos(Category);
}

@* Tabler sign-in frame: brand above a narrow centred card. Nested in _BlankLayout. *@
@inject Microsoft.Extensions.Options.IOptions<Modulus.Ui.Abstractions.Theming.ModulusThemeOptions> ThemeOptions
@{
    Layout = "_BlankLayout";
}
<main class="m-auth-page">
    <div class="m-auth-container">
        <div class="m-auth-brand">@Html.Raw(ShellRenderer.Brand(ThemeOptions.Value))</div>
        @RenderBody()
    </div>
</main>

@model string
@* Reload + density buttons at the right of a datagrid toolbar (model: the grid's current URL).
   Density needs the card's x-data="tableSelection" scope. *@
<div class="m-table-toolbar-settings">
    <a class="ant-btn ant-btn-text ant-btn-icon-only" href="@Model" aria-label="Reload" title="Reload"><app-icon type="reload" /></a>
    <app-dropdown placement="bottomRight">
        <button type="button" class="ant-btn ant-btn-text ant-btn-icon-only" aria-label="Table density" title="Density"><app-icon type="column-height" /></button>
        <dropdown-menu>
            <app-dropdown-item @@click="setDensity('')">Default</app-dropdown-item>
            <app-dropdown-item @@click="setDensity('ant-table-middle')">Middle</app-dropdown-item>
            <app-dropdown-item @@click="setDensity('ant-table-small')">Compact</app-dropdown-item>
        </dropdown-menu>
    </app-dropdown>
</div>

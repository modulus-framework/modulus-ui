@{
    var email = Context.Request.Query["email"].ToString();
}
<div class="m-auth-card">
    <div class="m-auth-card-body m-center">
        <span class="m-auth-icon m-bg-primary-lt m-text-primary"><app-ti name="ri:mail-open" /></span>
        <h1 class="m-auth-title">Verify your email</h1>
        <p class="m-auth-lead">We sent an activation link to <strong>@(string.IsNullOrEmpty(email) ? CurrentUser.Email : email)</strong>. Follow the link inside to continue.</p>
        <a class="ant-btn ant-btn-primary ant-btn-block" href="/"><span>Skip for now</span></a>
        <form method="post" class="m-auth-foot">Didn't get the mail? <button type="submit" class="m-link-btn">Resend</button></form>
    </div>
</div>

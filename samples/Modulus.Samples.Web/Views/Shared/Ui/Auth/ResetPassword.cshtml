@model ResetPasswordInput
<div class="m-auth-card">
    <div class="m-auth-card-body">
        <h1 class="m-auth-title">Reset password</h1>
        <p class="m-auth-lead">Your new password must be different from previously used passwords.</p>
        <form method="post" class="ant-form ant-form-vertical ant-form-hide-required-mark" novalidate>
            <app-form-item asp-for="Password" label="New password">
                <app-input asp-for="Password" type="password" placeholder="At least 8 characters" prefix-icon="lock" autocomplete="new-password" />
            </app-form-item>
            <app-form-item asp-for="Confirm" label="Confirm password">
                <app-input asp-for="Confirm" type="password" placeholder="Repeat the password" prefix-icon="lock" autocomplete="new-password" />
            </app-form-item>
            <div class="m-auth-actions">
                <app-button type="primary" html-type="submit" block>Set new password</app-button>
            </div>
        </form>
    </div>
</div>
<div class="m-auth-foot"><a href="/auth/login">Back to sign in</a></div>

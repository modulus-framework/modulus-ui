@model ForgotPasswordInput
<div class="m-auth-card">
    <div class="m-auth-card-body">
        @if (ViewData["Sent"] is true)
        {
            <span class="m-auth-icon m-bg-success-lt m-text-success"><app-ti name="ri:mail-send" /></span>
            <h1 class="m-auth-title">Check your inbox</h1>
            <p class="m-auth-lead">We sent a reset link to <strong>@Model.Email</strong>. It expires in 30 minutes.</p>
            <a class="ant-btn ant-btn-primary ant-btn-block" href="/auth/reset-password"><span>Open reset link</span></a>
        }
        else
        {
            <h1 class="m-auth-title">Forgot password</h1>
            <p class="m-auth-lead">Enter your email address and we'll send you a link to reset your password.</p>
            <form method="post" class="ant-form ant-form-vertical ant-form-hide-required-mark" novalidate>
                <app-form-item asp-for="Email" label="Email address">
                    <app-input asp-for="Email" placeholder="your@email.com" prefix-icon="mail" autocomplete="email" />
                </app-form-item>
                <div class="m-auth-actions">
                    <button type="submit" class="ant-btn ant-btn-primary ant-btn-block"><app-ti name="mail" /><span>Send me the reset link</span></button>
                </div>
            </form>
        }
    </div>
</div>
<div class="m-auth-foot">Forget it, <a href="/auth/login">send me back</a> to the sign in screen.</div>

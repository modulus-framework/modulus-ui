@model (HelpCategory Category, HelpArticle Article)
@{
    var (category, article) = Model;
}
<app-page-header pretitle="@category.Title" title="@article.Title">
    <a class="ant-btn ant-btn-default" href="/pages/help-center"><app-ti name="arrow-left" /><span>Help center</span></a>
</app-page-header>

<div class="m-row-cards m-cols-8-4">
    <div class="m-card">
        <div class="m-card-body m-article">
            <p class="m-mt-0">@article.Excerpt</p>
            <ol class="m-article-steps">
                @foreach (var step in article.Body)
                {
                    <li>@step</li>
                }
            </ol>
        </div>
        <div class="m-card-footer m-feedback" x-data="{ voted: false }">
            <span class="m-muted">Was this article helpful?</span>
            <span class="m-text-success m-medium" x-show="voted" x-cloak><app-ti name="circle-check" /> Thanks for your feedback!</span>
            <button type="button" class="ant-btn ant-btn-default ant-btn-sm" x-show="!voted" x-on:click="voted = true"><app-ti name="thumb-up" /><span>Yes</span></button>
            <button type="button" class="ant-btn ant-btn-default ant-btn-sm" x-show="!voted" x-on:click="voted = true"><span>No</span></button>
        </div>
    </div>
    <div class="m-card">
        <div class="m-card-header"><h2 class="m-card-title">In this section</h2></div>
        <div class="m-card-body">
            <ul class="m-link-list">
                @foreach (var a in category.Articles)
                {
                    <li><a href="/pages/help-center/@a.Slug" class="@(a.Slug == article.Slug ? "m-text-primary m-medium" : "")"><app-ti name="file-text" />@a.Title</a></li>
                }
            </ul>
        </div>
    </div>
</div>

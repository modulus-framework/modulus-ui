@model AccountSettingsPage
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var RenewsOn = SampleContent.PlanRenewsOn;
    var DaysUsed = SampleContent.PlanDaysUsed;
    var Cards = SampleContent.PaymentCards;
    var Socials = SampleContent.SocialAccounts;
    static IEnumerable<SelectListItem> Items(IEnumerable<string> values) => values.Select(v => new SelectListItem(v, v));
}
<app-page-header pretitle="Pages" title="Account settings"></app-page-header>

<div class="m-card m-card-tabs m-mb-16">
    <nav class="m-tabs-nav" aria-label="Account sections">
        @foreach (var (key, label, icon) in AccountSettingsPage.Tabs)
        {
            <a href="/pages/account-settings?tab=@key" aria-current="@(key == Model.Tab ? "page" : null)"><app-ti name="@icon" />@label</a>
        }
    </nav>
</div>

@switch (Model.Tab)
{
    case "security":
        <div class="m-row-cards">
            <div class="m-card">
                <div class="m-card-header"><div><h2 class="m-card-title">Change password</h2><p class="m-card-subtitle">Use a password you don't use anywhere else</p></div></div>
                <div class="m-card-body">
                    <form method="post" action="/pages/account-settings/password" asp-antiforgery="true" class="ant-form ant-form-vertical ant-form-hide-required-mark" novalidate>
                        <div class="m-form-grid">
                            <app-form-item asp-for="Password.Current" label="Current password" class="m-span-2" style="max-width:calc(50% - 10px)">
                                <app-input asp-for="Password.Current" type="password" placeholder="Current password" autocomplete="current-password" />
                            </app-form-item>
                            <app-form-item asp-for="Password.New" label="New password">
                                <app-input asp-for="Password.New" type="password" placeholder="At least 8 characters" autocomplete="new-password" />
                            </app-form-item>
                            <app-form-item asp-for="Password.Confirm" label="Confirm new password">
                                <app-input asp-for="Password.Confirm" type="password" placeholder="Repeat the new password" autocomplete="new-password" />
                            </app-form-item>
                        </div>
                        <div class="m-subheader m-mb-8">Password requirements</div>
                        <ul class="m-check-list m-mt-0 m-small">
                            <li><app-ti name="check" /><span>Minimum 8 characters long — the more, the better</span></li>
                            <li><app-ti name="check" /><span>At least one lowercase and one uppercase character</span></li>
                            <li><app-ti name="check" /><span>At least one number</span></li>
                        </ul>
                        <div class="m-form-actions">
                            <app-button type="primary" html-type="submit">Save changes</app-button>
                            <a class="ant-btn ant-btn-default" href="/pages/account-settings?tab=security"><span>Reset</span></a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="m-card">
                <div class="m-card-header"><div><h2 class="m-card-title">Two-step verification</h2><p class="m-card-subtitle">Keep your account secure with an authentication step</p></div></div>
                <div class="m-card-body">
                    <form method="post" action="/pages/account-settings/twofactor" asp-antiforgery="true" class="m-flex m-gap-12" style="align-items:flex-start">
                        <span class="m-icon-tile m-tile-@(Model.TwoFactor ? "success" : "gray")-lt"><app-ti name="ri:lock-2" /></span>
                        <div style="flex:1">
                            <div class="m-h3">Two-factor authentication is @(Model.TwoFactor ? "on" : "off")</div>
                            <p class="m-muted m-mt-4 m-mb-0">Two-factor authentication adds an additional layer of security to your account by requiring more than just a password to sign in.</p>
                        </div>
                        <app-button type="@(Model.TwoFactor ? "default" : "primary")" danger="Model.TwoFactor" html-type="submit">@(Model.TwoFactor ? "Disable" : "Enable two-factor")</app-button>
                    </form>
                </div>
            </div>

            <div class="m-card">
                <div class="m-card-header"><h2 class="m-card-title">Recent devices</h2></div>
                <div class="ant-table-wrapper m-table-flush">
                    <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                        <table style="table-layout:auto">
                            <thead class="ant-table-thead"><tr><th class="ant-table-cell">Browser</th><th class="ant-table-cell">Device</th><th class="ant-table-cell">Location</th><th class="ant-table-cell">Recent activity</th></tr></thead>
                            <tbody class="ant-table-tbody">
                                @foreach (var d in SampleContent.Devices())
                                {
                                    <tr class="ant-table-row">
                                        <td class="ant-table-cell"><span class="m-flex m-gap-12"><span class="m-icon-tile m-tile-sm m-tile-gray-lt"><app-ti name="@d.Icon" /></span><span class="m-heading m-medium">@d.Browser</span></span></td>
                                        <td class="ant-table-cell m-muted">@d.Device</td>
                                        <td class="ant-table-cell m-muted">@d.Location</td>
                                        <td class="ant-table-cell m-muted">@Fmt.Relative(d.At)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div></div></div>
                </div>
            </div>
        </div>
        break;

    case "billing":
        <div class="m-row-cards">
            <div class="m-card">
                <div class="m-card-header"><h2 class="m-card-title">Current plan</h2></div>
                <div class="m-card-body">
                    <div class="m-row-cards m-cols-2">
                        <div>
                            <div class="m-h3">Your current plan is Standard</div>
                            <p class="m-muted m-mt-4">A simple start for growing teams.</p>
                            <div class="m-h3 m-mt-16">Active until @Fmt.Date(RenewsOn)</div>
                            <p class="m-muted m-mt-4">We will send you a notification upon subscription expiration.</p>
                            <div class="m-h3 m-mt-16">$49 per month <span class="m-badge m-badge-primary-lt">Popular</span></div>
                            <p class="m-muted m-mt-4">Standard plan for small to medium businesses.</p>
                        </div>
                        <div>
                            <div class="ant-alert ant-alert-warning m-mb-16" role="alert"><span class="ant-alert-icon m-text-warning"><app-ti name="warning" /></span><div class="ant-alert-content"><div class="ant-alert-message m-medium">We need your attention!</div><div class="ant-alert-description">Your plan requires an update.</div></div></div>
                            <div class="m-plan-box">
                                <div class="m-flex m-between m-small"><span class="m-medium">Days</span><span class="m-muted">@DaysUsed of 30 days</span></div>
                                <div class="m-progress m-mt-8"><div class="m-progress-bar" style="width:@Fmt.Pct(DaysUsed, 30)%"></div></div>
                                <div class="m-xsmall m-muted m-mt-8">@(30 - DaysUsed) days remaining until your plan requires an update</div>
                            </div>
                        </div>
                    </div>
                    <div class="m-form-actions m-mt-16">
                        <a class="ant-btn ant-btn-primary" href="/pages/pricing"><span>Upgrade plan</span></a>
                        <button type="button" class="ant-btn ant-btn-default ant-btn-dangerous" x-data x-on:click="modulusMessage('warning', 'Your subscription stays active until @Fmt.Date(RenewsOn)')"><span>Cancel subscription</span></button>
                    </div>
                </div>
            </div>

            <div class="m-row-cards m-cols-2">
                <div class="m-card">
                    <div class="m-card-header"><h2 class="m-card-title">Payment methods</h2><div class="m-card-actions"><button type="button" class="ant-btn ant-btn-default ant-btn-sm" x-data x-on:click="modulusMessage('info', 'Adding cards is disabled in the demo')"><app-ti name="plus" /><span>Add card</span></button></div></div>
                    <div class="m-card-body">
                        @foreach (var (brand, name, number, expires, primary) in Cards)
                        {
                            <div class="m-pay-method">
                                <span class="m-card-brand"><app-ti name="@brand" /></span>
                                <div class="m-list-item-text"><span class="m-list-item-title">@name @if (primary) { <span class="m-badge m-badge-primary-lt">Primary</span> }</span><span class="m-list-item-sub">•••• @number · Expires @expires</span></div>
                                <button type="button" class="ant-btn ant-btn-default ant-btn-sm" x-data x-on:click="modulusMessage('info', 'Editing cards is disabled in the demo')"><span>Edit</span></button>
                            </div>
                        }
                    </div>
                </div>
                <div class="m-card">
                    <div class="m-card-header"><h2 class="m-card-title">Billing address</h2><div class="m-card-actions"><a class="ant-btn ant-btn-default ant-btn-sm" href="/pages/account-settings?tab=account"><app-ti name="edit" /><span>Edit</span></a></div></div>
                    <div class="m-card-body">
                        <dl class="m-dl">
                            <dt>Company</dt><dd>@Model.Account.Organization</dd>
                            <dt>Billing email</dt><dd>@Model.Account.Email</dd>
                            <dt>Tax ID</dt><dd>US 94-8120376</dd>
                            <dt>Address</dt><dd>@Model.Account.Address, @Model.Account.City @Model.Account.Zip</dd>
                            <dt>Country</dt><dd>@Model.Account.Country</dd>
                            <dt>Phone</dt><dd>@Model.Account.Phone</dd>
                        </dl>
                    </div>
                </div>
            </div>

            <div class="m-card">
                <div class="m-card-header"><h2 class="m-card-title">Billing history</h2><div class="m-card-actions"><a class="ant-btn ant-btn-default ant-btn-sm" href="/apps/invoice/list"><span>All invoices</span></a></div></div>
                <div class="ant-table-wrapper m-table-flush">
                    <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                        <table style="table-layout:auto">
                            <thead class="ant-table-thead"><tr><th class="ant-table-cell">Invoice</th><th class="ant-table-cell">Date</th><th class="ant-table-cell">Plan</th><th class="ant-table-cell">Status</th><th class="ant-table-cell" style="text-align:right">Amount</th></tr></thead>
                            <tbody class="ant-table-tbody">
                                @for (var i = 0; i < 5; i++)
                                {
                                    <tr class="ant-table-row">
                                        <td class="ant-table-cell"><span class="m-medium">#@(5021 - i)</span></td>
                                        <td class="ant-table-cell m-muted">@Fmt.Date(RenewsOn.AddMonths(-1 - i))</td>
                                        <td class="ant-table-cell m-muted">Standard · monthly</td>
                                        <td class="ant-table-cell"><span class="m-badge m-badge-success-lt">Paid</span></td>
                                        <td class="ant-table-cell m-num m-heading" style="text-align:right">$49.00</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div></div></div>
                </div>
            </div>
        </div>
        break;

    case "notifications":
        <form method="post" action="/pages/account-settings/notifications" asp-antiforgery="true" class="m-card">
            <div class="m-card-header"><div><h2 class="m-card-title">Notifications</h2><p class="m-card-subtitle">Choose how you want to hear about activity. You need to allow browser notifications for the Browser channel.</p></div></div>
            <div class="ant-table-wrapper m-table-flush m-table-center">
                <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                    <table style="table-layout:auto">
                        <thead class="ant-table-thead"><tr><th class="ant-table-cell">Type</th>@foreach (var ch in NotificationPrefs.Channels){<th class="ant-table-cell">@ch</th>}</tr></thead>
                        <tbody class="ant-table-tbody">
                            @foreach (var ev in NotificationPrefs.Events)
                            {
                                <tr class="ant-table-row">
                                    <td class="ant-table-cell m-heading">@ev</td>
                                    @foreach (var ch in NotificationPrefs.Channels)
                                    {
                                        var key = NotificationPrefs.Key(ev, ch);
                                        <td class="ant-table-cell"><app-checkbox name="enabled" value="@key" checked="Model.Notifications.Contains(key)" aria-label="@($"{ev} by {ch}")" /></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div></div></div>
            </div>
            <div class="m-card-footer m-form-actions">
                <button type="submit" class="ant-btn ant-btn-primary"><span>Save changes</span></button>
                <a class="ant-btn ant-btn-default" href="/pages/account-settings?tab=notifications"><span>Discard</span></a>
            </div>
        </form>
        break;

    case "connections":
        <div class="m-row-cards m-cols-2">
            <div class="m-card">
                <div class="m-card-header"><div><h2 class="m-card-title">Connected accounts</h2><p class="m-card-subtitle">Display content from your connected accounts on your site</p></div></div>
                <div class="m-card-body-flush">
                    @foreach (var app in SampleContent.ConnectedApps)
                    {
                        <form method="post" action="/pages/account-settings/connection" asp-antiforgery="true" class="m-switch-row" x-data x-on:change="$el.requestSubmit()">
                            <input type="hidden" name="app" value="@app.Name" />
                            <span class="m-icon-tile m-tile-gray-lt"><app-ti name="@app.Icon" /></span>
                            <div class="m-list-item-text"><span class="m-list-item-title">@app.Name</span><span class="m-list-item-sub">@app.Description</span></div>
                            <app-switch name="connected" checked="Model.ConnectedApps.Contains(app.Name)" aria-label="@($"Connect {app.Name}")" />
                        </form>
                    }
                </div>
            </div>
            <div class="m-card">
                <div class="m-card-header"><div><h2 class="m-card-title">Social accounts</h2><p class="m-card-subtitle">Sign in faster with a linked account</p></div></div>
                <div class="m-card-body-flush">
                    @foreach (var (icon, name, handle) in Socials)
                    {
                        <div class="m-switch-row">
                            <span class="m-icon-tile m-tile-gray-lt"><app-ti name="@icon" /></span>
                            <div class="m-list-item-text"><span class="m-list-item-title">@name</span><span class="m-list-item-sub">@(handle ?? "Not connected")</span></div>
                            @if (handle is null)
                            {
                                <button type="button" class="ant-btn ant-btn-default ant-btn-sm ant-btn-icon-only" aria-label="Connect @name" x-data x-on:click="modulusMessage('info', '@name is a demo connection')"><app-ti name="link" /></button>
                            }
                            else
                            {
                                <button type="button" class="ant-btn ant-btn-default ant-btn-sm ant-btn-icon-only ant-btn-dangerous" aria-label="Disconnect @name" x-data x-on:click="modulusMessage('info', '@name is a demo connection')"><app-ti name="delete" /></button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
        break;

    default:
        <div class="m-row-cards">
            <div class="m-card">
                <div class="m-card-header"><h2 class="m-card-title">Profile details</h2></div>
                <div class="m-card-body">
                    <div class="m-upload-row m-mb-24">
                        <span class="m-avatar m-avatar-xl m-avatar-rounded m-av-1">@Fmt.Initials(CurrentUser.Name)</span>
                        <div>
                            <div class="m-form-actions">
                                <label class="ant-btn ant-btn-primary"><input type="file" accept="image/png,image/jpeg" hidden /><app-ti name="upload" /><span>Upload new photo</span></label>
                                <button type="button" class="ant-btn ant-btn-default"><span>Reset</span></button>
                            </div>
                            <div class="m-small m-muted m-mt-8">Allowed JPG or PNG. Max size of 800 KB.</div>
                        </div>
                    </div>
                    <form method="post" action="/pages/account-settings/account" asp-antiforgery="true" class="ant-form ant-form-vertical ant-form-hide-required-mark" novalidate>
                        <div class="m-form-grid">
                            <app-form-item asp-for="Account.FirstName" label="First name"><app-input asp-for="Account.FirstName" /></app-form-item>
                            <app-form-item asp-for="Account.LastName" label="Last name"><app-input asp-for="Account.LastName" /></app-form-item>
                            <app-form-item asp-for="Account.Email" label="Email"><app-input asp-for="Account.Email" /></app-form-item>
                            <app-form-item asp-for="Account.Organization" label="Organization"><app-input asp-for="Account.Organization" /></app-form-item>
                            <app-form-item asp-for="Account.Phone" label="Phone number"><app-input asp-for="Account.Phone" /></app-form-item>
                            <app-form-item asp-for="Account.Address" label="Address"><app-input asp-for="Account.Address" /></app-form-item>
                            <app-form-item asp-for="Account.City" label="City"><app-input asp-for="Account.City" /></app-form-item>
                            <app-form-item asp-for="Account.Zip" label="Zip code"><app-input asp-for="Account.Zip" /></app-form-item>
                            <app-form-item asp-for="Account.Country" label="Country"><app-select asp-for="Account.Country" items="Items(Lookups.Countries)" /></app-form-item>
                            <app-form-item asp-for="Account.Language" label="Language"><app-select asp-for="Account.Language" items="Items(Lookups.Languages)" /></app-form-item>
                            <app-form-item asp-for="Account.TimeZone" label="Time zone"><app-select asp-for="Account.TimeZone" items="Items(Lookups.TimeZones)" /></app-form-item>
                            <app-form-item asp-for="Account.Currency" label="Currency"><app-select asp-for="Account.Currency" items="Items(Lookups.Currencies)" /></app-form-item>
                        </div>
                        <div class="m-form-actions m-mt-8">
                            <app-button type="primary" html-type="submit">Save changes</app-button>
                            <a class="ant-btn ant-btn-default" href="/pages/account-settings"><span>Reset</span></a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="m-card m-danger-zone" x-data="{ confirm: false }">
                <div class="m-card-header"><h2 class="m-card-title">Delete account</h2></div>
                <div class="m-card-body">
                    <div class="ant-alert ant-alert-warning m-mb-16" role="alert"><span class="ant-alert-icon m-text-warning"><app-ti name="warning" /></span><div class="ant-alert-content"><div class="ant-alert-message m-medium">Are you sure you want to delete your account?</div><div class="ant-alert-description">Once you delete your account, there is no going back. Please be certain.</div></div></div>
                    <span x-on:change="confirm = $event.target.checked"><app-checkbox name="confirm" value="true">I confirm my account deactivation</app-checkbox></span>
                    <div class="m-mt-16"><button type="button" class="ant-btn ant-btn-primary ant-btn-dangerous" disabled x-bind:disabled="!confirm" x-on:click="modulusMessage('warning', 'Deactivation is disabled in the demo')"><span>Deactivate account</span></button></div>
                </div>
            </div>
        </div>
        break;
}

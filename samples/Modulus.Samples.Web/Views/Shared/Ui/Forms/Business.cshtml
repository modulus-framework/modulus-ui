@model BusinessFormInput
@* Every business field on one sales order. Rules are data annotations on BusinessFormInput, shared with the Blazor
   sample; each field posts a hidden input with its invariant value. The product lookup searches /forms/business/products. *@
<app-page-header pretitle="Forms" title="Business fields" subtitle="Money, quantities, durations, lookups and the other fields ERP forms are made of."></app-page-header>

<div class="m-row-cards m-cols-8-4">
    <div class="m-card">
        <form method="post" action="/forms/business" asp-antiforgery="true" class="ant-form ant-form-vertical" novalidate>
            <div class="m-card-header"><div><h2 class="m-card-title">Sales order</h2><p class="m-card-subtitle">Submit the empty form to see every message.</p></div></div>
            <div class="m-card-body">
                <app-form-item asp-for="Stage" label="Status"><app-status-bar asp-for="Stage" stages="BusinessFormsDemo.Stages" aria-label="Order status" /></app-form-item>
                <div class="m-form-grid">
                    <app-form-item asp-for="Customer" label="Customer" help="Type a name or code, or press F4">
                        <app-lookup asp-for="Customer" items="BusinessFormsDemo.Customers" columns="BusinessFormsDemo.CustomerColumns" title="Search customers" aria-label="Customer" placeholder="Azure Interior" />
                    </app-form-item>
                    <app-form-item asp-for="Product" label="Product" help="@($"{BusinessFormsDemo.Products.Count} products, searched on the server")">
                        <app-lookup asp-for="Product" search-href="/forms/business/products" label="@BusinessFormsDemo.ProductLabel(Model.Product)" columns="BusinessFormsDemo.ProductColumns" title="Search products" aria-label="Product" placeholder="Office chair" />
                    </app-form-item>
                    <app-form-item asp-for="UnitPrice" label="Unit price"><app-money-input asp-for="UnitPrice" currency-for="Currency" aria-label="Unit price" /></app-form-item>
                    <app-form-item asp-for="Quantity" label="Quantity"><app-quantity-input asp-for="Quantity" unit-for="Unit" aria-label="Quantity" /></app-form-item>
                    <app-form-item asp-for="SetupMinutes" label="Setup time" help="1:30, 1.5, 90m or 1h 30m"><app-duration-input asp-for="SetupMinutes" aria-label="Setup time" /></app-form-item>
                    <app-form-item asp-for="LeadTo" label="Delivery window"><app-number-range from-for="LeadFrom" to-for="LeadTo" decimals="0" suffix="days" aria-label="Delivery window" /></app-form-item>
                    <app-form-item asp-for="Phone" label="Contact phone"><app-phone-input asp-for="Phone" default-country="US" placeholder="202 555 0111" aria-label="Contact phone" /></app-form-item>
                    <app-form-item asp-for="TaxId" label="Tax id"><app-masked-input asp-for="TaxId" mask="@BusinessFormsDemo.TaxIdMask" aria-label="Tax id" /></app-form-item>
                    <app-form-item asp-for="ApprovalCode" label="Approval code" help="The 6-digit code sent to the approver" class="m-span-2"><app-otp-input asp-for="ApprovalCode" length="6" separator="3" aria-label="Approval code" /></app-form-item>
                    <app-form-item asp-for="Notes" label="Terms and notes" class="m-span-2"><app-rich-text asp-for="Notes" placeholder="Payment terms, delivery instructions…" aria-label="Terms and notes" /></app-form-item>
                    <app-form-item asp-for="Signature" label="Customer signature" class="m-span-2"><app-signature-pad asp-for="Signature" aria-label="Customer signature" /></app-form-item>
                </div>
            </div>
            <div class="m-card-footer m-form-actions">
                <app-button type="primary" html-type="submit">Save order</app-button>
                <a class="ant-btn ant-btn-default" href="/forms/business"><span>Reset</span></a>
            </div>
        </form>
    </div>

    <div class="m-card">
        <div class="m-card-header"><h2 class="m-card-title">What each field posts</h2></div>
        <div class="m-card-body">
            <ul class="m-check-list m-mt-0 m-small">
                @foreach (var (field, stores) in BusinessFormsDemo.Storage)
                {
                    <li><app-ti name="check" /><span><span class="m-heading m-medium">@field</span><br /><span class="m-muted">@stores</span></span></li>
                }
            </ul>
        </div>
    </div>
</div>

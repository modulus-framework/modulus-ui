@model EmailPage
@{
    const string Base = "/apps/email";
    var current = Context.Request.Path + Context.Request.QueryString;
    var inTrash = Model.Folder == MailFolder.Trash && Model.Label is null;
}
<app-page-header pretitle="Apps" title="Email"></app-page-header>

@* Folder links, search, open / back are boosted GETs that swap #mail-app; actions post and fire mail:refresh. *@
<div id="mail-app" class="m-card m-app" hx-boost="true" hx-target="#mail-app" hx-select="#mail-app" hx-swap="outerHTML" hx-push-url="true">
    <div hidden hx-get="@current" hx-trigger="mail:refresh from:body" hx-push-url="false"></div>
    <aside class="m-app-side">
        <div class="m-app-side-head">
            <button type="button" class="ant-btn ant-btn-primary ant-btn-block" @@click="$store.drawer.load('@Base/compose', 'Compose mail', 560)"><app-ti name="edit" /><span>Compose</span></button>
        </div>
        <nav class="m-app-side-body" aria-label="Mail folders">
            <ul class="m-app-nav">
                @foreach (var (folder, icon) in SampleUi.MailFolders)
                {
                    var active = Model.Label is null && Model.Folder == folder;
                    <li>
                        <a class="m-app-nav-link@(active ? " active" : "")" href="@Base@SampleUi.MailScope(folder, null)" aria-current="@(active ? "page" : null)">
                            <app-ti name="@icon" /><span>@folder</span>
                            @if (Model.Counts.TryGetValue(folder, out var count) && count > 0)
                            {
                                <span class="m-badge @SampleUi.MailCountBadge(folder)">@count</span>
                            }
                        </a>
                    </li>
                }
            </ul>
            <div class="m-subheader m-app-nav-title">Labels</div>
            <ul class="m-app-nav">
                @foreach (var label in Lookups.MailLabels)
                {
                    var active = Model.Label == label;
                    <li><a class="m-app-nav-link@(active ? " active" : "")" href="@Base?label=@Uri.EscapeDataString(label)" aria-current="@(active ? "page" : null)"><span class="m-app-dot" style="--c:@SampleUi.LabelColor(label)"></span><span>@label</span></a></li>
                }
            </ul>
        </nav>
    </aside>

    <section class="m-app-main" x-data="tableSelection" @@change="sync()" aria-label="@(Model.Open is null ? "Messages" : "Message")">
        @if (Model.Open is { } m)
        {
            <div class="m-app-bar">
                <a class="ant-btn ant-btn-text ant-btn-icon-only" href="@Model.ListUrl" aria-label="Back to @(Model.Label ?? Model.Folder.ToString())" title="Back"><app-ti name="arrow-left" /></a>
                <h2 class="m-h3 m-truncate" style="margin:0;flex:1">@m.Subject</h2>
                <button type="button" class="ant-btn ant-btn-text ant-btn-icon-only" aria-label="@(m.Starred ? "Unstar" : "Star")" title="@(m.Starred ? "Unstar" : "Star")"
                        hx-post="@Base/star/@m.Id" hx-swap="none"><app-ti name="star" class="@(m.Starred ? "m-text-warning" : null)" /></button>
                <button type="button" class="ant-btn ant-btn-text ant-btn-icon-only" aria-label="Mark as unread" title="Mark as unread"
                        hx-post="@Base/read" hx-vals='{"ids": @m.Id, "read": false}' hx-swap="none"><app-ti name="mail" /></button>
                <form method="post" action="@Base/move@(Model.Scope)" asp-antiforgery="true" hx-boost="false" class="m-flex">
                    <input type="hidden" name="ids" value="@m.Id" />
                    <input type="hidden" name="to" value="@(m.Folder == MailFolder.Spam ? "Inbox" : "Spam")" />
                    <button type="submit" class="ant-btn ant-btn-text ant-btn-icon-only" aria-label="@(m.Folder == MailFolder.Spam ? "Not spam" : "Report spam")" title="@(m.Folder == MailFolder.Spam ? "Not spam" : "Report spam")"><app-ti name="stop" /></button>
                </form>
                <form method="post" action="@Base/move@(Model.Scope)" asp-antiforgery="true" hx-boost="false" class="m-flex">
                    <input type="hidden" name="ids" value="@m.Id" />
                    <input type="hidden" name="to" value="Trash" />
                    <button type="submit" class="ant-btn ant-btn-text ant-btn-icon-only m-danger-hover" aria-label="@(m.Folder == MailFolder.Trash ? "Delete forever" : "Move to trash")" title="@(m.Folder == MailFolder.Trash ? "Delete forever" : "Move to trash")"><app-ti name="delete" /></button>
                </form>
            </div>
            <div class="m-app-scroll">
                <article class="m-mail-read">
                    <div class="m-mail-read-head">
                        <span class="m-avatar m-av-@m.Tint">@Fmt.Initials(m.FromName)</span>
                        <div style="flex:1;min-width:0">
                            <div class="m-heading m-medium">@m.FromName <span class="m-muted m-small">&lt;@m.FromEmail&gt;</span></div>
                            <div class="m-small m-muted">to @(m.To == CurrentUser.Email ? "me" : m.To)</div>
                        </div>
                        <div class="m-small m-muted m-nowrap">@Fmt.DateTime(m.At)</div>
                    </div>
                    @if (m.Labels.Count > 0)
                    {
                        <div class="m-flex m-gap-8 m-mt-16">
                            @foreach (var label in m.Labels)
                            {
                                <span class="m-status"><span class="m-app-dot" style="--c:@SampleUi.LabelColor(label)"></span>@label</span>
                            }
                        </div>
                    }
                    <div class="m-mail-body">
                        @foreach (var paragraph in m.Body)
                        {
                            <p>@paragraph</p>
                        }
                    </div>
                    @if (m.Attachments.Count > 0)
                    {
                        <div class="m-mail-attachments">
                            @foreach (var a in m.Attachments)
                            {
                                <a class="m-mail-attachment" href="#" hx-boost="false" @@click.prevent><app-ti name="paper-clip" /><span class="m-medium">@a.Name</span><span class="m-xsmall m-muted">@a.Size</span></a>
                            }
                        </div>
                    }
                    <div class="m-flex m-gap-8 m-mt-24">
                        <button type="button" class="ant-btn ant-btn-default" @@click="$store.drawer.load('@Base/compose?reply=@m.Id', 'Reply', 560)"><app-ti name="undo" /><span>Reply</span></button>
                        <button type="button" class="ant-btn ant-btn-default" @@click="$store.drawer.load('@Base/compose?forward=@m.Id', 'Forward', 560)"><app-ti name="redo" /><span>Forward</span></button>
                    </div>
                </article>
            </div>
        }
        else
        {
            <div class="m-app-bar">
                <form method="get" action="@Base" class="m-flex" style="flex:1" role="search">
                    @if (Model.Label is { } lbl) { <input type="hidden" name="label" value="@lbl" /> }
                    else if (Model.Folder != MailFolder.Inbox) { <input type="hidden" name="folder" value="@Model.Folder.ToString().ToLowerInvariant()" /> }
                    <span class="ant-input-affix-wrapper ant-input-affix-wrapper-borderless" style="flex:1">
                        <span class="ant-input-prefix"><app-ti name="search" /></span>
                        <input class="ant-input" type="search" name="keyword" value="@Model.Keyword" placeholder="Search mail" aria-label="Search mail" />
                    </span>
                </form>
            </div>
            <div class="m-app-bar">
                <app-checkbox aria-label="Select all messages" data-select-all @@change="toggleAll($event.target.checked)" />
                <div class="m-flex m-gap-8" x-show="count > 0" x-cloak>
                    <button type="button" class="ant-btn ant-btn-text ant-btn-icon-only" aria-label="Mark as read" title="Mark as read"
                            hx-post="@Base/read" hx-vals='{"read": true}' hx-include="#mail-list input[name='ids']:checked" hx-swap="none"><app-ti name="tb:mail-opened" /></button>
                    <button type="button" class="ant-btn ant-btn-text ant-btn-icon-only" aria-label="Mark as unread" title="Mark as unread"
                            hx-post="@Base/read" hx-vals='{"read": false}' hx-include="#mail-list input[name='ids']:checked" hx-swap="none"><app-ti name="mail" /></button>
                    <button type="button" class="ant-btn ant-btn-text ant-btn-icon-only m-danger-hover" aria-label="@(inTrash ? "Delete forever" : "Move to trash")" title="@(inTrash ? "Delete forever" : "Move to trash")"
                            hx-post="@Base/move" hx-vals='{"to": "Trash"}' hx-include="#mail-list input[name='ids']:checked" hx-swap="none"
                            @(inTrash ? "hx-confirm=\"Delete the selected messages forever?\" data-confirm-danger data-confirm-ok=\"Delete\"" : "")><app-ti name="delete" /></button>
                </div>
                <span class="m-spacer"></span>
                <span class="m-small m-muted">@Model.Messages.Count @(Model.Messages.Count == 1 ? "message" : "messages")</span>
                <a class="ant-btn ant-btn-text ant-btn-icon-only" href="@current" aria-label="Refresh" title="Refresh"><app-ti name="reload" /></a>
            </div>
            <div class="m-app-scroll" id="mail-list">
                @if (Model.Messages.Count == 0)
                {
                    <div class="m-table-empty" style="padding:64px 0">@(Model.Keyword is { Length: > 0 } ? "No messages match your search" : "No messages here")</div>
                }
                @foreach (var msg in Model.Messages)
                {
                    <div class="m-mail-item@(msg.Read ? "" : " unread")">
                        <app-checkbox name="ids" value="@msg.Id.ToString()" aria-label="@($"Select {msg.Subject}")" />
                        <button type="button" class="m-mail-star@(msg.Starred ? " on" : "")" aria-label="@(msg.Starred ? "Unstar" : "Star")" aria-pressed="@(msg.Starred ? "true" : "false")"
                                hx-post="@Base/star/@msg.Id" hx-swap="none"><app-ti name="star" /></button>
                        <a class="m-mail-text" href="@Base/@msg.Id@(Model.Scope)">
                            <span class="m-avatar m-avatar-sm m-av-@msg.Tint">@Fmt.Initials(msg.FromName)</span>
                            <span class="m-mail-from">@(Model.Folder is MailFolder.Sent or MailFolder.Draft ? $"To: {msg.To}" : msg.FromName)</span>
                            <span class="m-mail-line"><span class="m-mail-subject">@msg.Subject</span> — @msg.Preview</span>
                        </a>
                        <span class="m-mail-meta">
                            @foreach (var label in msg.Labels)
                            {
                                <span class="m-app-dot" style="--c:@SampleUi.LabelColor(label)" title="@label"></span>
                            }
                            @if (msg.Attachments.Count > 0) { <app-ti name="paper-clip" /> }
                            <time datetime="@msg.At.ToString("o")">@(msg.At.Date == DateTime.Today ? Fmt.Time(msg.At) : msg.At.ToString("MMM d"))</time>
                        </span>
                    </div>
                }
            </div>
        }
    </section>
</div>

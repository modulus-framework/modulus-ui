@* The workflow designer: the editor posts its graph as JSON in the "Workflow" field, so a plain form saves it and runs it. Run is the
   real engine on the server (FlowDemo.Run); the canvas shows each node's status from the result. The same page is the MVC and Razor Pages sample. *@
@using Modulus.Samples.Shared
@using Modulus.Ui.Abstractions.Flow
@model FlowView
<app-page-header pretitle="Apps" title="Workflow designer" subtitle="Drag nodes from the palette, draw connections from an output dot to an input dot, press Delete to remove. Run sends a customer message through the workflow and lights up each node.">
</app-page-header>

<form method="post" action="/apps/flow" asp-antiforgery="true" hx-boost="false">
    <div class="m-row-cards">
        <div class="m-card">
            <div class="m-card-header">
                <div><h3 class="m-card-title">Support desk</h3><p class="m-card-subtitle">@Model.Graph.Nodes.Count nodes, @Model.Graph.Edges.Count connections · @(Model.Saved ? "your saved version" : "the sample")</p></div>
                <div class="m-card-actions" style="min-width: min(420px, 100%)">
                    <input class="ant-input" name="message" aria-label="Customer message" value="@Model.Run?.Message" placeholder="@FlowDemo.SampleMessage" />
                    <button type="submit" class="ant-btn ant-btn-primary" formaction="/apps/flow/run"><span>Run</span></button>
                </div>
            </div>
            <div class="m-card-body" style="padding: 0">
                <app-flow-editor graph="Model.Graph" name="Workflow" height="600" label="Support desk workflow" />
            </div>
            <div class="m-card-footer m-form-actions">
                <button type="submit" class="ant-btn ant-btn-primary"><span>Save workflow</span></button>
                <button type="submit" class="ant-btn ant-btn-default" formaction="/apps/flow/reset"><span>Reset to the sample</span></button>
            </div>
        </div>

        @if (Model.Run is { } run)
        {
            <div class="m-card">
                <div class="m-card-header">
                    <div><h3 class="m-card-title">Last run</h3><p class="m-card-subtitle">"@run.Message" · @run.Result.Steps.Count nodes in @run.Result.Duration.TotalMilliseconds.ToString("0") ms · @run.Result.Status</p></div>
                </div>
                <div class="m-card-body">
                    <ul class="m-flow-issues">
                        @foreach (var step in run.Result.Steps)
                        {
                            var node = Model.Graph.Nodes.FirstOrDefault(n => n.Id == step.NodeId);
                            var title = node is null ? step.NodeId : node.Title ?? FlowCatalog.Default.Find(node.Type)?.Title ?? node.Type;
                            <li class="@(step.Status == FlowStatus.Error ? "m-flow-issue-error" : step.Status == FlowStatus.Success ? "m-flow-issue-ok" : "m-flow-issue-warn")"><strong>@title</strong> <span class="m-muted">@FlowDemo.Describe(step)</span></li>
                        }
                    </ul>
                </div>
            </div>
        }

        <div class="m-card">
            <div class="m-card-header"><div><h3 class="m-card-title">Checks</h3><p class="m-card-subtitle">What the saved workflow would need before it can run</p></div></div>
            <div class="m-card-body">
                @if (Model.Issues.Count == 0)
                {
                    <p class="m-muted">The workflow is ready to run.</p>
                }
                else
                {
                    <ul class="m-flow-issues">
                        @foreach (var issue in Model.Issues)
                        {
                            <li class="@(issue.Level == FlowIssueLevel.Error ? "m-flow-issue-error" : "m-flow-issue-warn")"><strong>@issue.Level</strong> @issue.Message</li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</form>

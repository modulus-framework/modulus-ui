@model PaymentInput
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var invoice = (Invoice)ViewData["Invoice"]!;
}
@* Record a payment against an invoice (drawer). *@
<form class="m-drawer-form ant-form ant-form-vertical ant-form-hide-required-mark" hx-post="/apps/invoice/preview/@invoice.Id/payment" hx-target="#modulus-drawer-body" hx-swap="innerHTML" novalidate>
    <div class="m-drawer-form-body">
        <div class="m-plan-box m-flex m-between m-mb-16"><span class="m-muted">Invoice balance</span><span class="m-h3 m-num">@Fmt.Money(invoice.Balance)</span></div>
        <app-form-item asp-for="Amount" label="Payment amount"><app-input asp-for="Amount" type="number" prefix="$" placeholder="@invoice.Balance.ToString("0.00")" /></app-form-item>
        <app-form-item asp-for="PaidAt" label="Payment date"><input type="date" class="ant-input" name="PaidAt" id="PaidAt" value="@Model.PaidAt?.ToString("yyyy-MM-dd")" /></app-form-item>
        <app-form-item asp-for="Method" label="Payment method"><app-select asp-for="Method" items="PaymentInput.Methods.Select(m => new SelectListItem(m, m))" /></app-form-item>
        <app-form-item asp-for="Note" label="Internal note"><textarea class="ant-input" name="Note" id="Note" rows="3" placeholder="Visible to your team only">@Model.Note</textarea></app-form-item>
    </div>
    <div class="m-drawer-form-footer">
        <app-button @@click="$store.drawer.hide()">Cancel</app-button>
        <app-button type="primary" html-type="submit">Record payment</app-button>
    </div>
</form>

@model CalendarView
@{
    const string Base = "/apps/calendar";
    var today = DateTime.Today;
    var upcoming = Model.Events.Where(e => e.End >= DateTime.Now).OrderBy(e => e.Start).Take(4).ToList();
}
<app-page-header pretitle="Apps" title="Calendar"></app-page-header>

@* Month / view / filter changes are boosted GETs; the drawer saves fire calendar:refresh. *@
<div id="calendar-app" class="m-card m-app m-app-calendar" hx-boost="true" hx-target="#calendar-app" hx-select="#calendar-app" hx-swap="outerHTML" hx-push-url="true">
    <div hidden hx-get="@Base@Model.Query()" hx-trigger="calendar:refresh from:body" hx-push-url="false"></div>
    <aside class="m-app-side">
        <div class="m-app-side-head">
            <button type="button" class="ant-btn ant-btn-primary ant-btn-block" @@click="$store.drawer.load('@Base/form', 'Add event')"><app-ti name="plus" /><span>Add event</span></button>
        </div>
        <div class="m-app-side-body">
            <form method="get" action="@Base" @@change="$el.requestSubmit()">
                <input type="hidden" name="month" value="@Model.Month.ToString("yyyy-MM")" />
                @if (Model.List) { <input type="hidden" name="view" value="list" /> }
                <input type="hidden" name="filtered" value="true" />
                <div class="m-subheader m-app-nav-title" style="margin-top:0">Event filters</div>
                <div class="m-cal-filters">
                    @foreach (var c in CalendarView.AllCategories)
                    {
                        var on = Model.Categories.Contains(c);
                        <label class="ant-checkbox-wrapper@(on ? " ant-checkbox-wrapper-checked" : "")" style="--c:@SampleUi.EventColor(c)">
                            <span class="ant-checkbox@(on ? " ant-checkbox-checked" : "")"><input type="checkbox" class="ant-checkbox-input" name="cat" value="@c" checked="@on" /><span class="ant-checkbox-inner"></span></span>
                            <span>@c</span>
                        </label>
                    }
                </div>
            </form>
            <div class="m-subheader m-app-nav-title">Upcoming</div>
            @if (upcoming.Count == 0)
            {
                <div class="m-small m-muted" style="padding:0 8px">Nothing coming up this month</div>
            }
            @foreach (var e in upcoming)
            {
                <button type="button" class="m-cal-agenda-row" @@click="$store.drawer.load('@Base/form/@e.Id', 'Edit event')">
                    <span class="m-app-dot" style="--c:@SampleUi.EventColor(e.Category)"></span>
                    <span class="m-truncate" style="flex:1"><span class="m-heading m-medium">@e.Title</span><br /><span class="m-xsmall m-muted">@e.Start.ToString("ddd, MMM d", System.Globalization.CultureInfo.InvariantCulture) · @CalendarView.TimeLabel(e)</span></span>
                </button>
            }
        </div>
    </aside>

    <section class="m-app-main" aria-label="@Model.Title">
        <div class="m-cal-toolbar">
            <div class="ant-btn-group" style="display:inline-flex">
                <a class="ant-btn ant-btn-default ant-btn-icon-only" href="@Base@Model.Query(Model.Month.AddMonths(-1))" aria-label="Previous month" title="Previous month"><app-ti name="chevron-left" /></a>
                <a class="ant-btn ant-btn-default ant-btn-icon-only" href="@Base@Model.Query(Model.Month.AddMonths(1))" aria-label="Next month" title="Next month"><app-ti name="chevron-right" /></a>
            </div>
            <a class="ant-btn ant-btn-default" href="@Base@Model.Query(new DateTime(today.Year, today.Month, 1))"><span>Today</span></a>
            <h2 class="m-cal-title">@Model.Title</h2>
            <span class="m-spacer"></span>
            <div class="ant-segmented" role="group" aria-label="View">
                <div class="ant-segmented-group">
                    <a class="ant-segmented-item@(Model.List ? "" : " ant-segmented-item-selected")" href="@Base@Model.Query(list: false)" aria-current="@(Model.List ? null : "page")"><div class="ant-segmented-item-label">Month</div></a>
                    <a class="ant-segmented-item@(Model.List ? " ant-segmented-item-selected" : "")" href="@Base@Model.Query(list: true)" aria-current="@(Model.List ? "page" : null)"><div class="ant-segmented-item-label">List</div></a>
                </div>
            </div>
        </div>
        @if (Model.List)
        {
            var agenda = Model.Agenda.ToList();
            @if (agenda.Count == 0)
            {
                <div class="m-table-empty" style="padding:64px 0">No events this month</div>
            }
            @foreach (var (day, events) in agenda)
            {
                <div class="m-cal-agenda-day@(day == today ? " today" : "")">
                    <div class="m-cal-agenda-date">@day.ToString("ddd, MMM d", System.Globalization.CultureInfo.InvariantCulture)@(day == today ? " · Today" : "")</div>
                    <div>
                        @foreach (var e in events)
                        {
                            <button type="button" class="m-cal-agenda-row" @@click="$store.drawer.load('@Base/form/@e.Id', 'Edit event')">
                                <time>@CalendarView.TimeLabel(e)</time>
                                <span class="m-app-dot" style="--c:@SampleUi.EventColor(e.Category)"></span>
                                <span class="m-heading m-medium">@e.Title</span>
                                @if (e.Location is { Length: > 0 }) { <span class="m-small m-muted m-truncate">@e.Location</span> }
                            </button>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="m-cal-head" aria-hidden="true">
                @foreach (var d in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" }) { <div>@d</div> }
            </div>
            <div class="m-cal-grid">
                @foreach (var day in Model.Days)
                {
                    var events = Model.On(day).ToList();
                    <div class="m-cal-cell@(day.Month != Model.Month.Month ? " other" : "")@(day == today ? " today" : "")">
                        <button type="button" class="m-cal-add" aria-label="Add event on @day.ToString("MMMM d", System.Globalization.CultureInfo.InvariantCulture)"
                                @@click="$store.drawer.load('@Base/form?date=@day.ToString("yyyy-MM-dd")', 'Add event')"></button>
                        <span class="m-cal-num">@day.Day</span>
                        @foreach (var e in events.Take(3))
                        {
                            <button type="button" class="m-cal-event@(e.AllDay ? " allday" : "")" style="--c:@SampleUi.EventColor(e.Category)" title="@e.Title"
                                    @@click="$store.drawer.load('@Base/form/@e.Id', 'Edit event')">
                                @if (!e.AllDay) { <span class="m-cal-dot"></span><time>@CalendarView.TimeLabel(e)</time> }
                                <span>@e.Title</span>
                            </button>
                        }
                        @if (events.Count > 3)
                        {
                            <span class="m-cal-more">+@(events.Count - 3) more</span>
                        }
                    </div>
                }
            </div>
        }
    </section>
</div>

@model Modulus.Ui.Abstractions.Kanban.KanbanBoardView
@* The board is app-kanban (KanbanTagHelper): drag, the card menus and the add forms post over htmx, and every change
   reloads the board. The Blazor sample draws the same board with <KanbanBoard>. *@
<app-page-header pretitle="Apps" title="Kanban" subtitle="Drag cards between columns, or use a card's menu to move it."></app-page-header>

<app-kanban board="Model" url="/apps/kanban" />

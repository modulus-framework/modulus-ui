@model CustomerListPage
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    const string Base = "/apps/customers";
    var grid = new Grid(Context.Request, Model.Request);
    var q = Model.Query;
    var s = Model.Stats;
    (string Label, string Value, string Note, string Icon, string Tone)[] tiles =
    [
        ("Customers", s.Total.ToString("N0"), "Accounts with at least one order", "team", "primary"),
        ("Active", s.Active.ToString("N0"), $"{Fmt.Percent(s.Active / (double)Math.Max(1, s.Total))} of all customers", "tb:user-plus", "green"),
        ("On trial", s.Trial.ToString("N0"), "Evaluating a paid plan", "hourglass", "azure"),
        ("Lifetime revenue", Fmt.Money0(s.Revenue), $"{s.Churned} churned accounts", "dollar", "yellow"),
    ];
}
<app-page-header pretitle="eCommerce" title="Customers" subtitle="Companies buying from the store, their plan and lifetime value.">
    <app-button type="primary" icon="plus" @@click="$store.drawer.load('@Base/form', 'Add customer')">Add customer</app-button>
</app-page-header>

<div id="customers-page" class="m-row-cards"
     hx-boost="true" hx-target="#customers-page" hx-select="#customers-page" hx-swap="outerHTML" hx-push-url="true">
    <div hidden hx-get="@grid.Current" hx-trigger="customers:refresh from:body" hx-push-url="false"></div>
    <div class="m-row-cards m-cols-4">
        @foreach (var (label, value, note, icon, tone) in tiles)
        {
            <div class="m-card"><div class="m-card-body">
                <div class="m-flex m-between" style="align-items:flex-start">
                    <div>
                        <div class="m-subheader">@label</div>
                        <div class="m-h1 m-mt-4">@value</div>
                        <div class="m-small m-muted m-mt-4">@note</div>
                    </div>
                    <span class="m-icon-tile m-tile-@tone-lt"><app-ti name="@icon" /></span>
                </div>
            </div></div>
        }
    </div>

    <div class="ant-card m-table-card" x-data="tableSelection" @@change="sync()">
        <div class="ant-card-body">
            <div class="m-table-toolbar">
                <div class="m-table-toolbar-title">All customers</div>
                <div class="m-table-toolbar-actions">
                    <span class="m-table-toolbar-search ant-input-affix-wrapper">
                        <span class="ant-input-prefix"><app-ti name="search" /></span>
                        <input class="ant-input" type="search" name="keyword" value="@q.Keyword" placeholder="Search customers…" aria-label="Search customers" form="customers-filter" />
                    </span>
                    <app-table-settings reload-href="@grid.Current" clear-href="@grid.ClearLink("keyword", "status", "tier", "city")" />
                </div>
            </div>

            <form id="customers-filter" class="m-table-filters" method="get" action="@Base" @@change="$el.requestSubmit()">
                <app-select name="status" items="Enum.GetValues<CustomerStatus>().Select(v => new SelectListItem(v.ToString(), v.ToString(), v == q.Status))" placeholder="Status" aria-label="Status" />
                <app-select name="tier" items="Enum.GetValues<CustomerTier>().Select(v => new SelectListItem(v.ToString(), v.ToString(), v == q.Tier))" placeholder="Tier" aria-label="Tier" />
                <app-select name="city" items="Model.Cities.Select(c => new SelectListItem(c, c, c == q.City))" placeholder="City" aria-label="City" />
                @if (Model.Request.SortField is { } sortField)
                {
                    <input type="hidden" name="sortField" value="@sortField" />
                    <input type="hidden" name="sortOrder" value="@Model.Request.SortOrder" />
                }
                <input type="hidden" name="pageSize" value="@Model.Request.PageSize" />
            </form>

            <div class="ant-alert ant-alert-info m-table-alert" role="status" x-show="count > 0" x-cloak>
                <div class="ant-alert-content">
                    <div class="ant-alert-message">
                        <span>Selected <strong x-text="count"></strong> <span x-text="count === 1 ? 'item' : 'items'"></span></span>
                        <button type="button" class="ant-btn ant-btn-link ant-btn-sm" @@click="clear()"><span>Clear</span></button>
                        <span class="m-spacer"></span>
                        <app-button danger size="small"
                                    hx-post="@Base/delete" hx-include="#customers-table input[name='ids']:checked" hx-swap="none"
                                    hx-confirm="Delete the selected customers?" data-confirm-danger data-confirm-ok="Delete">Delete selected</app-button>
                    </div>
                </div>
            </div>

            <div class="ant-table-wrapper" id="customers-table">
                <div class="ant-table ant-table-scroll-horizontal" :class="density">
                    <div class="ant-table-container">
                        <div class="ant-table-content" style="overflow: auto hidden;">
                            <table style="width: 1000px; min-width: 100%; table-layout: fixed;">
                                <colgroup>
                                    <col style="width:48px" /><col style="width:300px" />
                                    @for (var i = 0; i < 5; i++) { <col style="width: calc((1000px - 478px) / 5)" /> }
                                    <col style="width:130px" />
                                </colgroup>
                                <thead class="ant-table-thead">
                                    <tr>
                                        <th class="ant-table-cell ant-table-selection-column">
                                            <app-checkbox aria-label="Select all rows" data-select-all @@change="toggleAll($event.target.checked)" />
                                        </th>
                                        @grid.SortTh(nameof(Customer.Name), "Customer")
                                        <th class="ant-table-cell">Company</th>
                                        <th class="ant-table-cell">City</th>
                                        <th class="ant-table-cell">Tier</th>
                                        @grid.SortTh(nameof(Customer.Revenue), "Revenue", "text-align: right")
                                        <th class="ant-table-cell">Status</th>
                                        <th class="ant-table-cell" style="text-align:right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="ant-table-tbody">
                                    @if (Model.Page.Data.Count == 0)
                                    {
                                        <tr class="ant-table-placeholder"><td class="ant-table-cell" colspan="8"><div class="m-table-empty">No customers match these filters</div></td></tr>
                                    }
                                    @foreach (var c in Model.Page.Data)
                                    {
                                        <tr class="ant-table-row ant-table-row-level-0">
                                            <td class="ant-table-cell ant-table-selection-column">
                                                <app-checkbox name="ids" value="@c.Id.ToString()" aria-label="@($"Select {c.Name}")" />
                                            </td>
                                            <td class="ant-table-cell@(grid.SortClass(nameof(Customer.Name)))">
                                                <div class="m-entity">
                                                    <span class="m-avatar m-avatar-sm m-av-@Fmt.Tint(c.Name)">@Fmt.Initials(c.Name)</span>
                                                    <div class="m-entity-text">
                                                        <a class="m-entity-title" href="@Base/@c.Id" hx-boost="false" data-m-page>@c.Name</a>
                                                        <span class="m-entity-desc">@c.Email</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="ant-table-cell"><span class="m-heading">@c.Company</span></td>
                                            <td class="ant-table-cell"><span class="m-muted">@c.City</span></td>
                                            <td class="ant-table-cell"><span class="m-badge m-badge-@SampleUi.TierTone(c.Tier)-lt">@c.Tier</span></td>
                                            <td class="ant-table-cell@(grid.SortClass(nameof(Customer.Revenue)))" style="text-align:right"><span class="m-num m-heading">@Fmt.Money0(c.Revenue)</span></td>
                                            <td class="ant-table-cell"><span class="m-badge @SampleUi.CustomerBadge(c.Status)">@c.Status</span></td>
                                            <td class="ant-table-cell" style="text-align:right">
                                                <div class="m-row-actions">
                                                    <a class="ant-btn ant-btn-text ant-btn-sm ant-btn-icon-only" href="@Base/@c.Id" hx-boost="false" data-m-page aria-label="View @c.Name" title="View"><app-ti name="eye" /></a>
                                                    <button type="button" class="ant-btn ant-btn-text ant-btn-sm ant-btn-icon-only" aria-label="Edit @c.Name" title="Edit"
                                                            @@click="$store.drawer.load('@Base/form/@c.Id', 'Edit customer')"><app-ti name="edit" /></button>
                                                    <button type="button" class="ant-btn ant-btn-text ant-btn-sm ant-btn-icon-only m-danger-hover" aria-label="Delete @c.Name" title="Delete"
                                                            hx-post="@Base/delete" hx-vals='{"ids": @c.Id}' hx-swap="none"
                                                            hx-confirm="@($"Delete {c.Name}?")" data-confirm-danger data-confirm-ok="Delete"><app-ti name="delete" /></button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                @grid.Pager(Model.Page.Total)
            </div>
        </div>
    </div>
</div>

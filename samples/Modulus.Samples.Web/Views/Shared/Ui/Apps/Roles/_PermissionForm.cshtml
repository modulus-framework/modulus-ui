@model PermissionInput
@{
    var id = ViewData["Id"] as int?;
}
@* Add / edit permission drawer. *@
<form class="m-drawer-form ant-form ant-form-vertical ant-form-hide-required-mark" hx-post="/apps/permissions/save/@id" hx-target="#modulus-drawer-body" hx-swap="innerHTML" novalidate>
    <div class="m-drawer-form-body">
        @if (id is not null)
        {
            <div class="ant-alert ant-alert-warning m-mb-16" role="alert">
                <span class="anticon ant-alert-icon"><app-ti name="alert-triangle" /></span>
                <div class="ant-alert-content"><div class="ant-alert-message">Changing a permission affects every role it's assigned to.</div></div>
            </div>
        }
        <app-form-item asp-for="Name" label="Permission name"><app-input asp-for="Name" placeholder="e.g. Export reports" autocomplete="off" /></app-form-item>
        <app-form-item label="Assign to roles">
            <div class="m-check-grid">
                @foreach (var role in Lookups.Roles)
                {
                    <app-checkbox name="Roles" value="@role" checked="Model.Roles.Contains(role)">@role</app-checkbox>
                }
            </div>
        </app-form-item>
        <app-form-item><app-checkbox asp-for="Core">Core permission (can't be deleted)</app-checkbox></app-form-item>
    </div>
    <div class="m-drawer-form-footer">
        <app-button @@click="$store.drawer.hide()">Cancel</app-button>
        <app-button type="primary" html-type="submit">@(id is null ? "Add permission" : "Save changes")</app-button>
    </div>
</form>

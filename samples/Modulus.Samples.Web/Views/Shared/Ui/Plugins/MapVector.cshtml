@* Map vector: a world choropleth from jsVectorMap: hover a country for its value, click to select it. *@
<app-page-header pretitle="Plugins" title="Map vector" subtitle="A world choropleth from jsVectorMap: hover a country for its value, click to select it."></app-page-header>

<div class="m-row-cards">
    <div class="m-vector-layout">
        <div class="m-card">
            <div class="m-card-header"><div><h3 class="m-card-title">Sales by country</h3><p class="m-card-subtitle">This year, in US dollars; darker is more</p></div></div>
            <div class="m-card-body"><app-vector-map id="sales-map" data="PluginsContent.SalesMap" label="Sales by country" /></div>
        </div>
        <div class="m-card">
            <div class="m-card-header"><div><h3 class="m-card-title">Top markets</h3><p class="m-card-subtitle">@PluginsContent.Money(PluginsContent.SalesTotal) in @PluginsContent.SalesByCountry.Count countries</p></div></div>
            <div class="m-card-body">
                <ul class="m-market-list">
                    @foreach (var (code, value) in PluginsContent.TopMarkets(8))
                    {
                        <li><span class="m-market-name">@PluginsContent.CountryName(code)</span><span class="m-market-value">@PluginsContent.Money(value)</span><span class="m-market-bar"><span style="width: @((value / PluginsContent.TopMarkets(1)[0].Value * 100).ToString("0.#", CultureInfo.InvariantCulture))%"></span></span></li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

@* Dropzone: drag-and-drop uploads on Uppy (previews, progress, type / size / count limits, remove) and a one-file button upload.
   Files go to POST /plugins/dropzone/upload (the same URL in every sample), which checks them and throws them away. *@
@{
    var limits = $"PDF or images, up to {PluginsContent.MaxUploadMb} MB each, at most {PluginsContent.MaxUploadFiles} files.";
}
<app-page-header pretitle="Plugins" title="Dropzone" subtitle="Drop files or click to pick them. Each file uploads at once and shows its progress."></app-page-header>

<div class="m-row-cards">
    <div class="m-card">
        <div class="m-card-header"><div><h3 class="m-card-title">Drag and drop, with previews</h3><p class="m-card-subtitle">@limits A file that breaks a rule is refused with the reason.</p></div></div>
        <div class="m-card-body">
            <app-uploader id="dropzone-uppy" action="/plugins/dropzone/upload" accept="@PluginsContent.UploadAccept" max-size="@(PluginsContent.MaxUploadMb * 1024L * 1024)"
                          max-count="@PluginsContent.MaxUploadFiles" note="@limits" label="Drop files to upload" />
        </div>
    </div>

    <div class="m-row-cards m-cols-2">
        <div class="m-card">
            <div class="m-card-header"><div><h3 class="m-card-title">Button upload</h3><p class="m-card-subtitle">One file at a time, uploaded at once</p></div></div>
            <div class="m-card-body">
                <app-upload name="file" accept=".pdf" max-size="@PluginsContent.MaxUploadMb" action="/plugins/dropzone/upload" text="Upload a PDF" hint="PDF only; the new file replaces the old one." />
            </div>
        </div>
        <div class="m-card">
            <div class="m-card-header"><div><h3 class="m-card-title">What the server checks</h3><p class="m-card-subtitle">The browser checks first; the endpoint checks again</p></div></div>
            <div class="m-card-body">
                <ul class="m-plain-list">
                    <li><app-icon type="file-protect" /><span>Type: <code>@PluginsContent.UploadAccept</code></span></li>
                    <li><app-icon type="column-height" /><span>Size: up to @PluginsContent.MaxUploadMb MB per file</span></li>
                    <li><app-icon type="ordered-list" /><span>Count: at most @PluginsContent.MaxUploadFiles files in the drop area</span></li>
                    <li><app-icon type="delete" /><span>Nothing is stored: the demo endpoint answers and discards the file</span></li>
                </ul>
            </div>
        </div>
    </div>
</div>

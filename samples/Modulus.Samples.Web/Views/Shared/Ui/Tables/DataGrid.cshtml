@model PurchaseTablePage
@using Modulus.AspNetCore.Mvc
@{
    var grid = new Grid(Context.Request, Model.Request);
    var columns = DataGridAuto.Columns<PurchaseOrder>();
    var keyOf = DataGridAuto.RowKeyOf<PurchaseOrder>();
}
<app-page-header pretitle="Tables" title="Data grid" subtitle="One tag: the columns come from the row type, on the server or in memory — and the same grid turns into a schema-driven nested table."></app-page-header>

<div class="m-stack">
    <div id="orders" class="ant-card m-table-card" x-data="tableSelection" hx-boost="true" hx-target="#orders" hx-select="#orders" hx-swap="outerHTML" hx-push-url="true">
        <div class="ant-card-body">
            <div class="m-table-toolbar">
                <div class="m-table-toolbar-title">
                    Purchase orders
                    <span class="m-muted m-small">server-side</span>
                    <span title="Every column, its search and the sort were discovered from the row type">@Html.Raw(AntIcons.Span("info-circle", cssClass: "m-muted"))</span>
                    <span class="m-badge m-badge-gray-lt">@Model.Page.Total</span>
                </div>
                <div class="m-table-toolbar-actions">
                    <button type="button" class="ant-btn ant-btn-primary">@Html.Raw(AntIcons.Span("plus"))<span>New order</span></button>
                    <app-table-settings reload-href="@grid.Current" clear-href="@(grid.Filtered() ? grid.ClearHref() : null)" filter-row columns="false" export="false" />
                </div>
            </div>

            <app-table density="true">
                <thead class="ant-table-thead">
                    <tr>
                        <th class="ant-table-cell ant-table-selection-column" style="width: 48px; min-width: 48px;"><label class="ant-checkbox-wrapper"><span class="ant-checkbox"><input type="checkbox" class="ant-checkbox-input" value=""><span class="ant-checkbox-inner"></span></span></label></th>
                        @foreach (var c in columns)
                        {
                            @grid.SortTh(c.Key, c.Title, c.Width is { } w ? $"width: {w}px; min-width: {w}px;" : null, searchable: true, kind: c.Kind)
                        }
                    </tr>
                </thead>
                <tbody class="ant-table-tbody">
                    @if (Model.Page.Data.Count == 0)
                    {
                        <tr class="ant-table-placeholder"><td class="ant-table-cell" colspan="@(columns.Count + 1)"><div class="m-table-empty">No orders match these searches</div></td></tr>
                    }
                    @foreach (var o in Model.Page.Data)
                    {
                        <tr class="ant-table-row ant-table-row-level-0" data-row-key="@keyOf(o)">
                            <td class="ant-table-cell ant-table-selection-column"><label class="ant-checkbox-wrapper"><span class="ant-checkbox"><input type="checkbox" class="ant-checkbox-input" value=""><span class="ant-checkbox-inner"></span></span></label></td>
                            @foreach (var c in columns)
                            {
                                <td class="ant-table-cell@(grid.SortClass(c.Key))" style="@(c.AlignRight ? "text-align: right;" : null)">@c.Text(o)</td>
                            }
                        </tr>
                    }
                </tbody>
                <table-footer>@grid.Pager(Model.Page.Total)</table-footer>
            </app-table>
        </div>
    </div>

    <div class="ant-card m-table-card" x-data="tableSelection">
        <div class="ant-card-body">
            <div class="m-table-toolbar">
                <div class="m-table-toolbar-title">
                    Same type, in memory
                    <span class="m-muted m-small">client-side</span>
                    <span title="ServerSide off: the query runs once, then paging, sorting and searching happen in the browser">@Html.Raw(AntIcons.Span("info-circle", cssClass: "m-muted"))</span>
                </div>
                <div class="m-table-toolbar-actions">
                    <button type="button" class="ant-btn ant-btn-default m-table-columns" aria-haspopup="dialog" aria-expanded="false" title="Show or hide columns">@Html.Raw(AntIcons.Span("setting"))<span>Columns</span></button>
                    <button type="button" class="ant-btn ant-btn-default m-table-export" title="Export the rows shown to a CSV file">@Html.Raw(AntIcons.Span("download"))<span>Export CSV</span></button>
                    <div class="m-table-toolbar-settings">
                        <button type="button" class="ant-btn ant-btn-text ant-btn-icon-only" aria-label="Reload" title="Reload">@Html.Raw(AntIcons.Span("reload"))</button>
                        <button type="button" class="ant-btn ant-btn-text ant-btn-icon-only" aria-label="Table density" title="Density">@Html.Raw(AntIcons.Span("column-height"))</button>
                    </div>
                </div>
            </div>

            <app-table density="true">
                <thead class="ant-table-thead">
                    <tr>
                        @foreach (var c in columns)
                        {
                            <th class="ant-table-cell" style="@(c.Width is { } w ? $"width: {w}px; min-width: {w}px;" : null)">
                                <div class="ant-table-column-sorters"><span class="ant-table-column-title">@c.Title</span><span class="ant-table-column-sorter"><div class="ant-table-column-sorter-inner"><span class="anticon anticon-caret-up ant-table-column-sorter-up" role="img" aria-label="caret-up"><svg viewBox="0 0 1024 1024" focusable="false" class="" data-icon="caret-up" width="1em" height="1em" fill="currentColor" aria-hidden="true"><path d="M858.9 689L530.5 308.2c-9.4-10.9-27.5-10.9-37 0L165.1 689c-12.2 14.2-1.2 35 18.5 35h656.8c19.7 0 30.7-20.8 18.5-35z"></path></svg></span><span class="anticon anticon-caret-down ant-table-column-sorter-down" role="img" aria-label="caret-down"><svg viewBox="0 0 1024 1024" focusable="false" class="" data-icon="caret-down" width="1em" height="1em" fill="currentColor" aria-hidden="true"><path d="M840.4 300H183.6c-19.7 0-30.7 20.8-18.5 35l328.4 380.8c9.4 10.9 27.5 10.9 37 0L858.9 335c12.2-14.2 1.2-35-18.5-35z"></path></svg></span></div></span></div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody class="ant-table-tbody">
                    @foreach (var o in Model.Page.Data.Take(5))
                    {
                        <tr class="ant-table-row ant-table-row-level-0">
                            @foreach (var c in columns)
                            {
                                <td class="ant-table-cell" style="@(c.AlignRight ? "text-align: right;" : null)">@c.Text(o)</td>
                            }
                        </tr>
                    }
                </tbody>
                <table-footer>
                    <div data-m-swallow>
                        <app-pagination total="Model.Page.Total" page-size="5" current="1" size="small" url="#" htmx="false" />
                    </div>
                </table-footer>
            </app-table>
        </div>
    </div>

    <partial name="Ui/Tables/_NestedLevel" model="Model.Top" />
</div>

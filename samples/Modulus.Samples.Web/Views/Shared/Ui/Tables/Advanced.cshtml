@model EmployeeTablePage
@using Microsoft.AspNetCore.Mvc.Rendering
@using Modulus.Ui.Abstractions.Plugins
@* Tabler datagrid: search, filters, sorting, paging, column picker, density, selection and CSV export.
   All state is in the URL; the card is boosted with htmx so each change swaps just the grid. The Blazor sample renders the same page. *@
@{
    const string Base = "/tables/advanced";
    var grid = new Grid(Context.Request, Model.Request);
    var q = Model.Query;
    static IEnumerable<SelectListItem> Items(IEnumerable<string> values, string? selected) => values.Select(v => new SelectListItem(v, v, v == selected));
    var statuses = Enum.GetValues<EmployeeStatus>().Select(s => new SelectListItem(EmployeeDirectory.StatusLabel(s), s.ToString(), s == q.Status));
    var exportQuery = Context.Request.QueryString.Value ?? "";
    var visible = 3 + EmployeeDirectory.OptionalColumns.Count(c => Model.Shows(c.Key));
    // Rows drag by their handle (modulus-plugins.js moves the row, then the hidden "move" input posts it); a column sort locks them.
    // (data-m-sort-disabled is written with Html.Raw: Razor keeps a data-* attribute even when its value is null.)
    var dragLocked = Model.Request.SortField is not null || Model.Request.GroupBy is not null;
    const string DragHelp = "employees-drag-help";
    // Same colgroup as the Blazor ProTable renders.
    string ColStyle(string width) => $"width: {width}; min-width: {width};";
    // Group by (?groupBy=): a header row before each group's first row, a subtotal after its last, totals under the table.
    var groupTitle = EmployeeDirectory.GroupFields.FirstOrDefault(f => f.Key == Model.Request.GroupBy)?.Title;
    var groupBy = EmployeeDirectory.GroupFields.Select(f => new SelectListItem(f.Title, f.Key, f.Key == Model.Request.GroupBy));
    IReadOnlyList<TableGroupSpan> spans = groupTitle is null ? [] : TableGroups.Spans(Model.Page.Groups, Model.Page.Data.Count);
    // Job and Employment bands over the column titles (a multi-level header), over the columns shown, as ProTable renders them.
    string?[] shown = [null, null, null, nameof(Employee.Name),
        ..new[] { ("position", nameof(Employee.Position)), ("department", nameof(Employee.Department)), ("office", nameof(Employee.Office)), ("start", nameof(Employee.StartDate)), ("salary", nameof(Employee.Salary)) }
            .Where(c => Model.Shows(c.Item1)).Select(c => c.Item2),
        nameof(Employee.Status)];
    TableGroupSpan? SpanAt(int index)
    {
        foreach (var s in spans) if (index >= s.First && index <= s.Last) return s;
        return null;
    }
    // Label tags after the name, in the colours picked when the labels were added.
    Microsoft.AspNetCore.Html.IHtmlContent LabelTags(int id) => new Microsoft.AspNetCore.Html.HtmlString(string.Concat(EmployeeLabels.Of(id).Select(EmployeeLabels.Find).OfType<GridOption>()
        .Select(l => $"<span class=\"ant-tag ant-tag-{l.Color} m-label-tag\">{System.Net.WebUtility.HtmlEncode(l.Label)}</span>")));
}
<app-page-header pretitle="Tables" title="Data table" subtitle="Search, filter, sort, page, pick columns and export to CSV."></app-page-header>

<div id="employees" class="ant-card m-table-card m-resizable" x-data="tableSelection" @@change="sync()"
     hx-boost="true" hx-target="#employees" hx-select="#employees" hx-swap="outerHTML" hx-push-url="true"
     data-m-sort-rows="employees" data-m-sort-root data-m-sort-title="Employees" @Html.Raw(dragLocked ? "data-m-sort-disabled" : "")>
    @* A dropped row posts its move here (the query keeps the page, filters and searches); the grid comes back in the new order. *@
    <input type="hidden" name="move" data-m-sort-result hx-post="@Base/move@(exportQuery)" hx-trigger="change" hx-push-url="false" />
    @Html.Raw(SortableHtml.RowsHelp(DragHelp))
    <div class="ant-card-body">
        <div class="m-table-toolbar">
            <div class="m-table-toolbar-title">
                Employees
                <span class="m-badge m-badge-gray-lt">@Model.Summary.Count</span>
                <span class="m-small m-muted m-medium" style="font-weight:400">avg. salary @Fmt.Money0(Model.Summary.AverageSalary)</span>
            </div>
            <div class="m-table-toolbar-actions">
                @* The user's saved layouts of this table (Odoo's favourites); a starred one opens by default. *@
                <app-saved-views page="@Base" id="employee-views" />
                <span class="m-table-toolbar-search ant-input-affix-wrapper" x-data="{ value: @(string.IsNullOrEmpty(q.Keyword) ? "''" : "true") }">
                    <span class="ant-input-prefix"><app-icon type="search" /></span>
                    <input class="ant-input" type="text" name="keyword" value="@q.Keyword" placeholder="Search name, email, position…" aria-label="Search employees" form="employees-filter" x-ref="input" @@input="value = $el.value" />
                    <span class="ant-input-suffix">
                        <button type="button" class="ant-input-clear-icon m-input-clear" :class="value ? '' : 'ant-input-clear-icon-hidden'" aria-label="Clear search" tabindex="-1"
                                @@click="$refs.input.value = ''; value = ''; document.getElementById('employees-filter').requestSubmit()"><app-icon type="close-circle" theme="Fill" /></button>
                    </span>
                </span>
                <app-table-columns columns="EmployeeDirectory.OptionalColumns" hidden="Model.Hidden" href="@(hide => grid.Href(("hide", hide), ("current", Model.Request.Current.ToString())))" />
                <a class="ant-btn ant-btn-default m-table-export" href="@Base/export@(exportQuery)" hx-boost="false" title="Export the rows (after search and filters) to a CSV file" download><app-icon type="download" /><span>Export CSV</span></a>
                <app-table-settings reload-href="@grid.Current" filter-row columns="false" export="false" />
            </div>
        </div>

        <form id="employees-filter" class="m-table-filters" method="get" action="@Base" @@change="$el.requestSubmit()">
            <app-select name="department" items="Items(EmployeeDirectory.Departments, q.Department)" placeholder="All departments" aria-label="Department" />
            <app-select name="office" items="Items(EmployeeDirectory.Offices, q.Office)" placeholder="All offices" aria-label="Office" />
            <app-select name="status" items="statuses" placeholder="Any status" aria-label="Status" />
            <app-creatable-select name="label" options="EmployeeLabels.Options" value="@q.Label" placeholder="Any label" add-placeholder="Label name" create-text="Create new label" add-href="@Base/labels" allow-clear aria-label="Label" />
            <app-select name="groupBy" items="groupBy" placeholder="No grouping" aria-label="Group by" />
            @if (Model.Request.SortField is { } sortField)
            {
                <input type="hidden" name="sortField" value="@sortField" />
                <input type="hidden" name="sortOrder" value="@Model.Request.SortOrder" />
            }
            @if (Model.Hidden.Count > 0)
            {
                <input type="hidden" name="hide" value="@string.Join(',', Model.Hidden)" />
            }
            <input type="hidden" name="pageSize" value="@Model.Request.PageSize" />
            @foreach (var (field, search) in grid.Searches)
            {
                <input type="hidden" name="@(ColumnSearch.Prefix + field)" value="@search" />
            }
            @if (!string.IsNullOrEmpty(q.Keyword) || q.Department is not null || q.Office is not null || q.Status is not null || q.Label is not null || grid.Searches.Count > 0)
            {
                <a class="ant-btn ant-btn-link" href="@grid.ClearHref("keyword", "department", "office", "status", "label")"><span>Clear filters</span></a>
            }
        </form>

        <div class="ant-alert ant-alert-info m-table-alert" role="status" x-show="count > 0" x-cloak>
            <div class="ant-alert-content">
                <div class="ant-alert-message">
                    <span>Selected <strong x-text="count"></strong> <span x-text="count === 1 ? 'item' : 'items'"></span></span>
                    <button type="button" class="ant-btn ant-btn-link ant-btn-sm" @@click="clear()"><span>Clear</span></button>
                    <span class="m-spacer"></span>
                    @* Picking (or adding) a label gives it to the selected rows; the grid comes back with the toast. *@
                    <app-creatable-select name="applyLabel" options="EmployeeLabels.Options" size="small" placeholder="Add label…" add-placeholder="Label name" create-text="Create new label" add-href="@Base/labels"
                                          aria-label="Add a label to the selected employees" style="width: 160px"
                                          @@change.stop="htmx.ajax('POST', '@Base/tag' + location.search, { source: $el, target: '#employees', select: '#employees', swap: 'outerHTML', values: { label: $el.querySelector('input[name=applyLabel]').value, ids: [...document.querySelectorAll('#employees input[name=ids]:checked')].map(b => b.value) } })" />
                    <button type="button" class="ant-btn ant-btn-primary ant-btn-sm"
                            @@click="location.href = '@Base/export?' + [...$root.querySelectorAll('input[name=ids]:checked')].map(b => 'ids=' + b.value).join('&')"><span>Export selected</span></button>
                </div>
            </div>
        </div>

        <app-table density="true" scroll-x="1198" layout="fixed" hidden-columns="Model.Hidden">
            <colgroup>
                <col style="@ColStyle($"{SortableHtml.RowHandleWidth}px")" /><col style="@ColStyle("48px")" /><col class="ant-table-expand-icon-col" style="@ColStyle("48px")" /><col style="@ColStyle("260px")" />
                <col data-col="position" style="@ColStyle("190px")" />
                <col data-col="department" style="@ColStyle("150px")" />
                <col data-col="office" style="@ColStyle("150px")" />
                <col data-col="start" style="@ColStyle("130px")" />
                <col data-col="salary" style="@ColStyle("120px")" />
                <col style="@ColStyle("120px")" />
            </colgroup>
            <thead class="ant-table-thead">
                @Html.Raw(HeaderGroups.Rows(shown, EmployeeDirectory.HeaderBands))
                <tr>
                    <th class="ant-table-cell m-row-drag-cell"><span class="m-sr-only">Reorder</span></th>
                    <th class="ant-table-cell ant-table-selection-column">
                        <app-checkbox aria-label="Select all rows" data-select-all @@change="toggleAll($event.target.checked)" />
                    </th>
                    <th class="ant-table-cell ant-table-row-expand-icon-cell"></th>
                    @grid.SortTh(nameof(Employee.Name), "Employee", searchable: true, multiSort: true)
                    @grid.SortTh(nameof(Employee.Position), "Position", col: "position", searchable: true, multiSort: true)
                    @grid.SortTh(nameof(Employee.Department), "Department", col: "department", multiSort: true, values: EmployeeDirectory.SearchValues(nameof(Employee.Department)))
                    @grid.SortTh(nameof(Employee.Office), "Office", col: "office", multiSort: true, values: EmployeeDirectory.SearchValues(nameof(Employee.Office)))
                    @grid.SortTh(nameof(Employee.StartDate), "Start date", col: "start", searchable: true, kind: ColumnKind.Date, multiSort: true)
                    @grid.SortTh(nameof(Employee.Salary), "Salary", "text-align: right", col: "salary", searchable: true, kind: ColumnKind.Number, multiSort: true)
                    @grid.SortTh(nameof(Employee.Status), "Status", multiSort: true, values: EmployeeDirectory.SearchValues(nameof(Employee.Status)))
                </tr>
            </thead>
            <tbody class="ant-table-tbody">
                @if (Model.Page.Data.Count == 0)
                {
                    <tr class="ant-table-placeholder"><td class="ant-table-cell" colspan="@(visible + 2)"><div class="m-table-empty">No employees match these filters</div></td></tr>
                }
                @for (var i = 0; i < Model.Page.Data.Count; i++)
                {
                    var e = Model.Page.Data[i];
                    var span = SpanAt(i);
                    var inGroup = span is { } g ? Html.Raw(TableGroups.RowAttribute(g.Group)) : null;
                    if (span is { } head && head.First == i)
                    {
                        @Html.Raw(TableGroups.HeaderRow(head.Group, groupTitle, visible + 2))
                    }
                    <tr class="ant-table-row ant-table-row-level-0" data-row-key="@e.Id"@inGroup>
                        <td class="ant-table-cell m-row-drag-cell">@Html.Raw(SortableHtml.RowHandle(e.Id.ToString(), e.Name, DragHelp, dragLocked))</td>
                        <td class="ant-table-cell ant-table-selection-column"><app-checkbox name="ids" value="@e.Id.ToString()" aria-label="@($"Select {e.Name}")" /></td>
                        <td class="ant-table-cell ant-table-row-expand-icon-cell"><button type="button" class="ant-table-row-expand-icon ant-table-row-expand-icon-collapsed" aria-label="Expand row" aria-expanded="false" data-toggle-detail></button></td>
                        <td class="ant-table-cell@(grid.SortClass(nameof(Employee.Name)))">
                            <div class="m-entity">
                                <span class="m-avatar m-avatar-sm m-av-@e.Tint">@Fmt.Initials(e.Name)</span>
                                <div class="m-entity-text"><span class="m-entity-title">@e.Name@(LabelTags(e.Id))</span><span class="m-entity-desc">@e.Email</span></div>
                            </div>
                        </td>
                        <td data-col="position" class="ant-table-cell@(grid.SortClass(nameof(Employee.Position)))">@e.Position</td>
                        <td data-col="department" class="ant-table-cell@(grid.SortClass(nameof(Employee.Department)))">@e.Department</td>
                        <td data-col="office" class="ant-table-cell@(grid.SortClass(nameof(Employee.Office)))"><span class="m-flex m-gap-6"><app-icon type="@(e.Office == "Remote" ? "home" : "environment")" />@e.Office</span></td>
                        <td data-col="start" class="ant-table-cell m-muted@(grid.SortClass(nameof(Employee.StartDate)))">@Fmt.Date(e.StartDate)</td>
                        <td data-col="salary" class="ant-table-cell@(grid.SortClass(nameof(Employee.Salary)))" style="text-align:right"><span class="m-num m-heading">@Fmt.Money0(e.Salary)</span></td>
                        <td class="ant-table-cell@(grid.SortClass(nameof(Employee.Status)))"><span class="m-badge @EmployeeDirectory.StatusBadge(e.Status)">@EmployeeDirectory.StatusLabel(e.Status)</span></td>
                    </tr>
                    @* The expanded row, as ProTable's RowDetail renders it on the Blazor page. *@
                    <tr class="ant-table-expanded-row ant-table-expanded-row-level-1" data-detail-for="@e.Id"@inGroup hidden>
                        <td class="ant-table-cell" colspan="@(visible + 2)">
                            <div class="m-row-detail">
                                <div class="m-entity">
                                    <span class="m-avatar m-av-@e.Tint" style="width: 48px; height: 48px; font-size: 16px">@Fmt.Initials(e.Name)</span>
                                    <div class="m-entity-text"><span class="m-entity-title">@e.Name</span><span class="m-entity-desc">@e.Position · @e.Department</span></div>
                                </div>
                                <app-descriptions size="small" column="4">
                                    @foreach (var (label, value) in EmployeeDirectory.Details(e))
                                    {
                                        <app-descriptions-item label="@label">@value</app-descriptions-item>
                                    }
                                </app-descriptions>
                            </div>
                        </td>
                    </tr>
                    if (span is { } foot && foot.Last == i)
                    {
                        @Html.Raw(TableGroups.FooterRow(foot.Group, visible + 2))
                    }
                }
            </tbody>
            <table-footer>@Html.Raw(TableGroups.Totals(Model.Page.Totals, Model.Page.Total))@grid.Pager(Model.Page.Total)</table-footer>
        </app-table>
    </div>
</div>

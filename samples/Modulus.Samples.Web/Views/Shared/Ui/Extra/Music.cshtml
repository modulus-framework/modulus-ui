@{
    int.TryParse(Context.Request.Query["track"], out var no);
    var now = ExtraContent.Tracks.FirstOrDefault(t => t.No == no) ?? ExtraContent.Tracks[0];
    var album = ExtraContent.Albums[now.Album];
    var elapsed = now.Seconds * 2 / 5;
}
<app-page-header pretitle="Extra" title="Music" subtitle="Your library, playlists and what's playing now">
    <a class="ant-btn ant-btn-default" href="/extra/music"><app-ti name="tb:playlist" /><span>New playlist</span></a>
</app-page-header>

<div class="m-row-cards">
    <div class="m-card">
        <div class="m-player">
            <div class="m-player-now">
                <img src="@ExtraContent.Cover(album)" alt="@album.Title cover" />
                <div style="min-width:0">
                    <div class="m-subheader">Now playing</div>
                    <div class="m-h3 m-truncate">@now.Title</div>
                    <div class="m-muted m-small m-truncate">@album.Artist · @album.Title</div>
                </div>
            </div>
            <div class="m-player-controls">
                <button type="button" class="ant-btn ant-btn-text ant-btn-icon-only" aria-label="Shuffle"><app-ti name="tb:arrows-shuffle" /></button>
                <a class="ant-btn ant-btn-text ant-btn-icon-only" href="/extra/music?track=@(now.No == 1 ? ExtraContent.Tracks.Count : now.No - 1)" aria-label="Previous track"><app-ti name="step-backward" /></a>
                <button type="button" class="ant-btn ant-btn-primary m-player-play" aria-label="Pause"><app-ti name="pause" /></button>
                <a class="ant-btn ant-btn-text ant-btn-icon-only" href="/extra/music?track=@(now.No % ExtraContent.Tracks.Count + 1)" aria-label="Next track"><app-ti name="step-forward" /></a>
                <button type="button" class="ant-btn ant-btn-text ant-btn-icon-only" aria-label="Repeat"><app-ti name="tb:repeat" /></button>
            </div>
            <div class="m-player-progress">
                <span>@ExtraContent.Duration(elapsed)</span>
                <div class="m-progress" role="progressbar" aria-label="Playback position" aria-valuemin="0" aria-valuemax="@now.Seconds" aria-valuenow="@elapsed"><div class="m-progress-bar" style="width:@Fmt.Pct(elapsed, now.Seconds)%"></div></div>
                <span>@ExtraContent.Duration(now.Seconds)</span>
                <app-ti name="sound" />
            </div>
        </div>
    </div>

    <div class="m-card">
        <div class="m-card-header"><h3 class="m-card-title">Albums</h3></div>
        <div class="m-card-body">
            <div class="m-albums">
                @for (var i = 0; i < ExtraContent.Albums.Count; i++)
                {
                    var a = ExtraContent.Albums[i];
                    var first = ExtraContent.Tracks.FirstOrDefault(t => t.Album == i);
                    <a class="m-album" href="/extra/music@(first is null ? "" : "?track=" + first.No)">
                        <img src="@ExtraContent.Cover(a)" alt="" loading="lazy" />
                        <span class="m-album-title">@a.Title</span>
                        <span class="m-album-artist">@a.Artist · @a.Year</span>
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="m-card">
        <div class="m-card-header"><h3 class="m-card-title">Top tracks</h3></div>
        <div class="ant-table-wrapper m-table-flush">
            <div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                <table style="table-layout:auto">
                    <thead class="ant-table-thead"><tr><th class="ant-table-cell" style="width:48px">#</th><th class="ant-table-cell">Title</th><th class="ant-table-cell">Album</th><th class="ant-table-cell m-right">Plays</th><th class="ant-table-cell m-right"><app-ti name="clock-circle" /><span class="m-sr-only">Duration</span></th></tr></thead>
                    <tbody class="ant-table-tbody">
                        @foreach (var t in ExtraContent.Tracks)
                        {
                            var a = ExtraContent.Albums[t.Album];
                            var playing = t.No == now.No;
                            <tr class="ant-table-row @(playing ? "m-track-playing" : "")">
                                <td class="ant-table-cell m-muted">@if (playing) { <app-ti name="sound" class="m-text-primary" /> } else { @t.No }</td>
                                <td class="ant-table-cell">
                                    <a class="m-flex m-gap-12" style="align-items:center" href="/extra/music?track=@t.No" aria-current="@(playing ? "true" : null)">
                                        <img class="m-cover-sm" src="@ExtraContent.Cover(a)" alt="" loading="lazy" />
                                        <span><span class="m-track-title" style="display:block">@t.Title</span><span class="m-muted m-small">@a.Artist</span></span>
                                    </a>
                                </td>
                                <td class="ant-table-cell m-muted">@a.Title</td>
                                <td class="ant-table-cell m-right m-muted">@Fmt.Number(t.Plays)</td>
                                <td class="ant-table-cell m-right m-muted">@ExtraContent.Duration(t.Seconds)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div></div></div>
        </div>
    </div>
</div>

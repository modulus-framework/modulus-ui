<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Server-rendered page bodies shared by the MVC and Razor Pages samples. Both apps serve the same
       URLs and render these partials; only the routing (controllers vs. page models) differs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\src\Modulus.AspNetCore.Hosting\Modulus.AspNetCore.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Modulus.AspNetCore.Mvc\Modulus.AspNetCore.Mvc.csproj" />
    <ProjectReference Include="..\Modulus.Samples.Shared\Modulus.Samples.Shared.csproj" />
  </ItemGroup>

  <!-- The views are compiled into the assembly. Publishing the .cshtml sources too makes an app that references two Razor
       libraries fail (NETSDK1152: both ship Views/_ViewImports.cshtml), so they stay out of the publish output. -->
  <ItemGroup>
    <Content Update="Views\**\*.cshtml" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
